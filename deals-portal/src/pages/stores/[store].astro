---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { STORES_DATA, COUPONS_DATA, type StoreProfile } from '../../data/couponsData';

export const prerender = true;

export async function getStaticPaths() {
  return STORES_DATA.map(store => ({
    params: { store: store.slug },
    props: { store }
  }));
}

interface Props {
  store: StoreProfile;
}

const { store } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const storeDeals = COUPONS_DATA.filter(deal => deal.storeSlug === store.slug);
const otherStores = STORES_DATA.filter(s => s.slug !== store.slug).slice(0, 4);

// Alternative & Similar Stores in the same category for link equity
const categoryAlternatives = STORES_DATA.filter(s => s.slug !== store.slug && s.category === store.category);
const similarStores = categoryAlternatives.length > 0 ? categoryAlternatives : otherStores;

const initials = store.name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();

// Schema.org Structured Data
const storeSchema = {
  "@context": "https://schema.org",
  "@type": "Store",
  "name": store.name,
  "description": store.shortDesc || store.fullDesc,
  "url": `https://promoradar.store/stores/${store.slug}/`,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "184",
    "bestRating": "5",
    "worstRating": "1"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://promoradar.store/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Stores",
      "item": "https://promoradar.store/stores/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": store.name,
      "item": `https://promoradar.store/stores/${store.slug}/`
    }
  ]
};

const faqSchema = (store.faqs && store.faqs.length > 0) ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": store.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
} : null;

const offersSchemas = storeDeals.map((deal, idx) => ({
  "@context": "https://schema.org",
  "@type": "SaleEvent",
  "name": deal.title,
  "description": deal.description,
  "url": `https://promoradar.store/stores/${store.slug}/`,
  "startDate": "2026-10-01",
  "endDate": "2026-12-31",
  "eventAttendanceMode": "https://schema.org/OnlineEventAttendanceMode",
  "eventStatus": "https://schema.org/EventScheduled",
  "organizer": {
    "@type": "Organization",
    "name": store.name,
    "url": `https://promoradar.store/stores/${store.slug}/`
  }
}));

const pageSchemas = [storeSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : []), ...offersSchemas];
---

<BaseLayout
  title={`${store.name} Promo Codes & Vouchers (October 2026) — PromoRadar`}
  description={`Active and verified ${store.name} promo codes, discount coupons, and checkout vouchers. Tested October 2026 via verified merchant partner networks.`}
  activePath={`/stores/${store.slug}/`}
  schemas={pageSchemas}
>
  <Header activePath={`/stores/${store.slug}/`} />

  <main class="flex-1">
    <!-- Breadcrumbs & Quick Switcher -->
    <div class="border-b border-slate-200 bg-white py-3">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <nav class="flex items-center gap-2 text-xs text-slate-500" aria-label="Breadcrumb">
            <a href={`${base}/`} class="hover:text-indigo-600 transition-colors">Home</a>
            <span>/</span>
            <a href={`${base}/stores/`} class="hover:text-indigo-600 transition-colors">Stores</a>
            <span>/</span>
            <span class="text-slate-900 font-bold">{store.name}</span>
          </nav>

          <div class="flex items-center gap-2">
            <span class="text-xs text-slate-500 hidden sm:inline">Switch Brand:</span>
            <select
              id="brandSwitcherSelect"
              class="text-xs font-semibold bg-slate-100 border border-slate-200 rounded-xl px-3 py-1.5 text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500"
            >
              {STORES_DATA.map(s => (
                <option value={`${base}/stores/${s.slug}/`} selected={s.slug === store.slug}>
                  {s.name}
                </option>
              ))}
            </select>
          </div>
        </div>
      </div>
    </div>

    <!-- Store Hero Header -->
    <div class="bg-white border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
        <div class="bg-slate-50 rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-sm">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="flex items-start sm:items-center gap-5">
              <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-br from-indigo-600 via-indigo-700 to-rose-600 text-white font-extrabold text-2xl sm:text-3xl flex items-center justify-center shadow-md shrink-0">
                {initials}
              </div>
              <div>
                <div class="flex flex-wrap items-center gap-2 mb-1.5">
                  <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
                    {store.name} Promo Codes &amp; Coupons
                  </h1>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    Verified Merchant Partner
                  </span>
                </div>
                <p class="text-xs sm:text-sm text-slate-600 max-w-2xl leading-relaxed">
                  {store.fullDesc}
                </p>
              </div>
            </div>

            <div class="shrink-0 flex items-center gap-3">
              <a
                href={store.primaryAffiliateUrl}
                target="_blank"
                rel="nofollow sponsored"
                class="px-5 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs sm:text-sm shadow-md transition flex items-center gap-2"
              >
                <span>Visit {store.name} Store ↗</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content Grid (8 cols Deals + 4 cols Sidebar) -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- Left Sidebar (4 cols) -->
        <aside class="lg:col-span-4 space-y-6 order-2 lg:order-1">
          <!-- Verification Metrics -->
          <div class="bg-white rounded-3xl p-6 border border-slate-200/90 shadow-sm space-y-5">
            <h3 class="text-sm font-extrabold text-slate-900 flex items-center gap-2">
              <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
              </svg>
              <span>Store Verification Metrics</span>
            </h3>
            <div class="grid grid-cols-2 gap-3 text-center">
              <div class="bg-slate-50/80 rounded-2xl p-3.5 border border-slate-100">
                <div class="text-xl font-black text-indigo-600">4.9 ★</div>
                <div class="text-[11px] text-slate-500 font-medium">Shopper Rating</div>
              </div>
              <div class="bg-slate-50/80 rounded-2xl p-3.5 border border-slate-100">
                <div class="text-xl font-black text-emerald-600">99%</div>
                <div class="text-[11px] text-slate-500 font-medium">Code Success Rate</div>
              </div>
            </div>
            <div class="text-xs text-slate-600 space-y-2.5 pt-3 border-t border-slate-100">
              <div class="flex justify-between">
                <span class="text-slate-500">Offer Source:</span>
                <span class="font-semibold text-slate-900">Direct Partner Feed</span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-500">Last Tested:</span>
                <span class="font-semibold text-emerald-600">Today, Active</span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-500">Category:</span>
                <span class="font-semibold text-slate-900">{store.category}</span>
              </div>
            </div>
          </div>

          <!-- How to Apply Guide -->
          <div class="bg-white rounded-3xl p-6 border border-slate-200/90 shadow-sm space-y-3.5">
            <h3 class="text-sm font-extrabold text-slate-900 flex items-center gap-2">
              <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
              </svg>
              <span>How to Redeem a Promo Code</span>
            </h3>
            <ol class="text-xs text-slate-600 space-y-2.5 list-decimal list-inside leading-relaxed">
              {store.howToApply.map(step => (
                <li>{step}</li>
              ))}
            </ol>
          </div>

          <!-- Lead Magnet: Deal Drop Alerts -->
          <div class="glass-panel-dark text-white rounded-3xl p-6 border border-indigo-500/30 shadow-xl space-y-3.5 relative overflow-hidden">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
              </svg>
              <h3 class="text-sm font-extrabold text-white">Get {store.name} Deal Alerts</h3>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">
              Never miss a 50%+ discount or exclusive flash voucher. Get instant notification when new tested codes drop.
            </p>
            <form id="dealAlertForm" class="space-y-2.5">
              <input
                type="email"
                required
                placeholder="Enter your email..."
                class="w-full px-3.5 py-2.5 text-xs rounded-xl bg-white/10 text-white placeholder-slate-400 border border-white/20 focus:outline-none focus:ring-2 focus:ring-indigo-400"
              />
              <button
                type="submit"
                class="w-full py-2.5 px-3.5 rounded-xl code-peel text-white font-bold text-xs shadow-md transition cursor-pointer"
              >
                Notify Me ⚡
              </button>
            </form>
            <div id="dealAlertSuccess" class="hidden text-center text-[11px] font-semibold text-emerald-300 bg-emerald-950/60 p-2.5 rounded-xl border border-emerald-500/30">
              ✓ Subscribed! You will receive notifications for {store.name}.
            </div>
          </div>

          <!-- Other Recommended Stores -->
          <div class="bg-white rounded-2xl p-5 border border-slate-200/90 shadow-sm space-y-3">
            <h3 class="text-sm font-extrabold text-slate-900">More Verified Brands</h3>
            <div class="space-y-2">
              {otherStores.map(s => (
                <a
                  href={`${base}/stores/${s.slug}/`}
                  class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-50 transition border border-transparent hover:border-slate-200 text-xs"
                >
                  <span class="font-bold text-slate-800">{s.name}</span>
                  <span class="text-indigo-600 font-semibold">{s.category} →</span>
                </a>
              ))}
            </div>
          </div>
        </aside>

        <!-- Main Column: Active Coupons (8 cols) -->
        <div class="lg:col-span-8 space-y-6 order-1 lg:order-2">
          <div>
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-lg font-extrabold text-slate-900">
                Active Promo Codes &amp; Deals for {store.name}
              </h2>
              <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-indigo-50 text-indigo-700">
                {storeDeals.length} offers active
              </span>
            </div>

            <!-- List of Coupons -->
            <div class="space-y-4">
              {storeDeals.map((deal) => {
                const isCode = deal.code && deal.code.trim().length > 0;
                return (
                  <article class="bg-white rounded-2xl border border-slate-200/90 p-5 card-hover shadow-sm flex flex-col justify-between">
                    <div>
                      <div class="flex items-start justify-between gap-3 mb-3">
                        <div class="flex items-center gap-2">
                          <span class="text-xs font-extrabold px-2.5 py-1 rounded-xl bg-rose-50 text-rose-600 border border-rose-200/80">
                            {deal.discountBadge}
                          </span>
                          <span class={`text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md ${
                            isCode ? 'bg-indigo-50 text-indigo-700 border border-indigo-200' : 'bg-emerald-50 text-emerald-700 border border-emerald-200'
                          }`}>
                            {isCode ? 'PROMO CODE' : 'DIRECT DEAL'}
                          </span>
                        </div>
                        <span class="text-[11px] text-slate-400 font-medium">
                          Expires: {deal.expiryDate}
                        </span>
                      </div>

                      <h3 class="text-base font-extrabold text-slate-900 mb-1.5 leading-snug">
                        {deal.title}
                      </h3>
                      <p class="text-xs text-slate-600 leading-relaxed mb-4">
                        {deal.description}
                      </p>
                    </div>

                    <div class="pt-3.5 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                      <div class="flex items-center gap-2 text-xs text-slate-500">
                        <span class="inline-flex items-center gap-1 text-emerald-600 font-semibold">
                          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                          Verified on Checkout
                        </span>
                        <span>•</span>
                        <span>Success: <strong class="text-slate-800">{deal.successRate}</strong></span>
                      </div>

                      {isCode ? (
                        <button
                          type="button"
                          class="code-peel text-white rounded-xl px-4 py-2.5 text-xs font-bold flex items-center justify-center gap-2 shrink-0 shadow-sm cursor-pointer"
                          data-reveal-deal={JSON.stringify({
                            id: deal.id,
                            title: deal.title,
                            desc: deal.description,
                            code: deal.code,
                            storeName: store.name,
                            badge: deal.discountBadge,
                            affiliateUrl: deal.affiliateUrl
                          })}
                        >
                          <span>Get Code</span>
                          <span class="font-mono text-[11px] bg-black/25 px-2 py-0.5 rounded border border-white/20">
                            •••{deal.code.slice(-3)}
                          </span>
                        </button>
                      ) : (
                        <a
                          href={deal.affiliateUrl}
                          target="_blank"
                          rel="nofollow sponsored"
                          class="bg-slate-900 hover:bg-indigo-600 text-white rounded-xl px-4 py-2.5 text-xs font-bold flex items-center justify-center gap-1.5 shrink-0 transition shadow-sm"
                        >
                          <span>Activate Deal ↗</span>
                        </a>
                      )}
                    </div>
                  </article>
                );
              })}
            </div>
          </div>

          <!-- Recently Expired Deals for SEO Archive -->
          <div class="bg-white rounded-2xl p-5 border border-slate-200/80 opacity-75 shadow-sm">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-400">
                Recently Expired Offers (SEO Archive)
              </span>
              <span class="text-[11px] px-2 py-0.5 rounded bg-slate-100 text-slate-500 font-semibold">
                Expired
              </span>
            </div>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-2">
              <div>
                <h4 class="text-sm font-bold text-slate-600 line-through">
                  Extra 15% Off Seasonal Checkout Coupon for {store.name}
                </h4>
                <p class="text-xs text-slate-400">
                  Expired codes occasionally remain active on select partner checkouts.
                </p>
              </div>
              <span class="font-mono text-xs px-3 py-1.5 rounded-lg bg-slate-100 text-slate-500 border border-slate-200 shrink-0 text-center">
                ARCHIVE15
              </span>
            </div>
          </div>

          <!-- Brand FAQs -->
          {store.faqs && store.faqs.length > 0 && (
            <div class="bg-white rounded-2xl p-6 border border-slate-200/90 shadow-sm space-y-4">
              <h3 class="text-base font-extrabold text-slate-900">
                {store.name} Promo Code FAQ
              </h3>
              <div class="space-y-3">
                {store.faqs.map(faq => (
                  <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100">
                    <h4 class="text-xs font-bold text-slate-900 mb-1">{faq.question}</h4>
                    <p class="text-xs text-slate-600 leading-relaxed">{faq.answer}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Similar Stores & Best Alternatives (Link Equity & Internal Flow) -->
          {similarStores && similarStores.length > 0 && (
            <div class="bg-gradient-to-br from-white to-indigo-50/30 rounded-3xl p-6 sm:p-7 border border-indigo-100 shadow-sm">
              <div class="flex items-center justify-between mb-4">
                <div>
                  <h3 class="text-base font-extrabold text-slate-900 flex items-center gap-2">
                    <span>Similar Stores & Best Alternatives</span>
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-indigo-100 text-indigo-700 uppercase tracking-wide">
                      {store.category}
                    </span>
                  </h3>
                  <p class="text-xs text-slate-500 mt-0.5">Compare active checkout codes across related verified merchants</p>
                </div>
                <a href={`${base}/stores/`} class="text-xs font-bold text-indigo-600 hover:text-indigo-800 transition">
                  Browse All Stores →
                </a>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                {similarStores.slice(0, 6).map(alt => (
                  <a
                    href={`${base}/stores/${alt.slug}/`}
                    class="group p-4 rounded-2xl bg-white border border-slate-200/80 hover:border-indigo-400 hover:shadow-md transition flex items-center gap-3.5"
                  >
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-slate-900 to-indigo-800 text-white font-extrabold text-xs flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition-transform">
                      {alt.name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase()}
                    </div>
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center justify-between gap-1">
                        <span class="text-xs font-extrabold text-slate-900 group-hover:text-indigo-600 truncate transition-colors">
                          {alt.name}
                        </span>
                        <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-700">
                          {alt.couponsCount} deals
                        </span>
                      </div>
                      <p class="text-[11px] text-slate-500 truncate mt-0.5">
                        {alt.bestDiscount ? `Up to ${alt.bestDiscount}` : alt.category}
                      </p>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>

      </div>
    </div>
  </main>

  <Footer />

  <!-- Reveal Modal Container -->
  <div id="storeCodeModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-950/70 backdrop-blur-sm">
    <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-7 shadow-2xl border border-slate-200 relative">
      <button id="closeStoreCodeModalBtn" type="button" class="absolute right-4 top-4 w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center font-bold text-sm">✕</button>
      
      <div class="flex items-center gap-3.5 mb-4">
        <div class="w-12 h-12 rounded-2xl bg-indigo-600 text-white font-extrabold text-lg flex items-center justify-center shadow-md shrink-0">
          {initials}
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="font-extrabold text-slate-900 text-base">{store.name}</span>
            <span id="modalDiscountTag" class="text-xs font-extrabold px-2 py-0.5 rounded-md bg-rose-100 text-rose-700">Verified</span>
          </div>
          <p class="text-xs text-slate-500">Official Merchant Partner Offer</p>
        </div>
      </div>

      <h3 id="modalStoreDealTitle" class="text-lg font-extrabold text-slate-900 mb-2 leading-snug"></h3>
      <p id="modalStoreDealDesc" class="text-xs text-slate-600 mb-5 leading-relaxed"></p>

      <div class="bg-indigo-50/80 border-2 border-dashed border-indigo-300 rounded-2xl p-4 mb-4">
        <div class="text-[11px] font-bold uppercase tracking-wider text-indigo-600 mb-1.5 text-center">Your Verified Promo Code</div>
        <div class="flex items-center justify-between gap-2 bg-white rounded-xl p-2 pl-4 border border-indigo-200 shadow-sm">
          <span id="modalStoreCodeValue" class="font-mono font-extrabold text-lg tracking-wider text-slate-900 select-all"></span>
          <button id="copyStoreCodeBtn" type="button" class="px-4 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs transition shrink-0">
            📋 Copy Code
          </button>
        </div>
      </div>

      <a
        id="modalStoreAffiliateLink"
        href="#"
        target="_blank"
        rel="nofollow sponsored"
        class="w-full py-3.5 px-5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm flex items-center justify-center gap-2 shadow-lg transition mb-4"
      >
        <span>Go to {store.name} Official Store ↗</span>
      </a>

      <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
        <span>Did this code work today?</span>
        <div class="flex items-center gap-2">
          <button type="button" class="vote-feedback px-3 py-1 rounded-lg bg-slate-100 hover:bg-emerald-50 hover:text-emerald-700 font-semibold transition">👍 Yes, worked</button>
          <button type="button" class="vote-feedback px-3 py-1 rounded-lg bg-slate-100 hover:bg-rose-50 hover:text-rose-700 font-semibold transition">👎 No</button>
        </div>
      </div>
      <div id="storeModalFeedback" class="hidden mt-2 text-center text-xs font-semibold text-emerald-600">
        Thank you! Your feedback has been recorded in our live verification radar.
      </div>
    </div>
  </div>

  <script is:inline>
    const switcher = document.getElementById('brandSwitcherSelect');
    switcher?.addEventListener('change', (e) => {
      window.location.href = e.target.value;
    });

    const modal = document.getElementById('storeCodeModal');
    const closeBtn = document.getElementById('closeStoreCodeModalBtn');
    const copyBtn = document.getElementById('copyStoreCodeBtn');
    const feedback = document.getElementById('storeModalFeedback');

    document.querySelectorAll('[data-reveal-deal]').forEach(btn => {
      btn.addEventListener('click', () => {
        const data = JSON.parse(btn.getAttribute('data-reveal-deal') || '{}');
        document.getElementById('modalStoreDealTitle').textContent = data.title || '';
        document.getElementById('modalStoreDealDesc').textContent = data.desc || '';
        document.getElementById('modalStoreCodeValue').textContent = data.code || '';
        document.getElementById('modalDiscountTag').textContent = data.badge || 'Verified';
        document.getElementById('modalStoreAffiliateLink').href = data.affiliateUrl || '#';
        feedback?.classList.add('hidden');
        modal?.classList.remove('hidden');
        modal?.classList.add('flex');

        // Auto-copy promo code (Honey / RetailMeNot UX)
        if (data.code && data.code.trim().length > 0) {
          navigator.clipboard?.writeText(data.code).catch(() => {});
        }

        // Open partner store in background/new tab
        if (data.affiliateUrl) {
          window.open(data.affiliateUrl, '_blank', 'noopener,noreferrer');
        }
      });
    });

    closeBtn?.addEventListener('click', () => {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
    });

    copyBtn?.addEventListener('click', () => {
      const code = document.getElementById('modalStoreCodeValue')?.textContent || '';
      if (code) {
        navigator.clipboard.writeText(code).then(() => {
          copyBtn.textContent = '✓ Copied!';
          setTimeout(() => { copyBtn.textContent = '📋 Copy Code'; }, 2000);
        });
      }
    });

    document.querySelectorAll('.vote-feedback').forEach(b => {
      b.addEventListener('click', () => {
        feedback?.classList.remove('hidden');
      });
    });

    const alertForm = document.getElementById('dealAlertForm');
    const alertSuccess = document.getElementById('dealAlertSuccess');
    alertForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      alertForm.classList.add('hidden');
      alertSuccess?.classList.remove('hidden');
    });
  </script>
</BaseLayout>
