---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BrandLogo from '../../components/BrandLogo.astro';
import { STORES_DATA, COUPONS_DATA, type StoreProfile } from '../../data/couponsData';

import { getStoreDomain } from '../../data/storeDomains';

export const prerender = true;

export async function getStaticPaths() {
  return STORES_DATA.map(store => ({
    params: { store: store.slug },
    props: { store }
  }));
}

interface Props {
  store: StoreProfile;
}

const { store } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const storeDeals = COUPONS_DATA.filter(deal => deal.storeSlug === store.slug);
const otherStores = STORES_DATA.filter(s => s.slug !== store.slug).slice(0, 4);

// Alternative & Similar Stores in the same category for link equity
const categoryAlternatives = STORES_DATA.filter(s => s.slug !== store.slug && s.category === store.category);
const similarStores = categoryAlternatives.length > 0 ? categoryAlternatives : otherStores;

// Helper to calculate genuine remaining validity & urgency
function getExpiryBadge(expiryDateStr: string) {
  if (!expiryDateStr) return { text: '⚡ Verified Oct 2026', class: 'bg-emerald-50 text-emerald-700 border-emerald-200/80 dark:bg-emerald-500/15 dark:text-emerald-300 dark:border-emerald-500/30' };
  const expiry = new Date(expiryDateStr);
  const now = new Date('2026-10-19');
  const diffDays = Math.ceil((expiry.getTime() - now.getTime()) / (1000 * 60 * 60 * 24));
  if (diffDays <= 7 && diffDays > 0) {
    return { text: `⏳ Ends in ${diffDays}d`, class: 'bg-rose-50 text-rose-700 border-rose-200/80 dark:bg-rose-500/15 dark:text-rose-300 dark:border-rose-500/30 font-bold' };
  } else if (diffDays <= 45 && diffDays > 0) {
    return { text: `⏳ Ends in ${diffDays}d`, class: 'bg-amber-50 text-amber-800 border-amber-200/80 dark:bg-amber-500/15 dark:text-amber-300 dark:border-amber-500/30 font-bold' };
  } else {
    return { text: '⚡ Verified for Oct 2026', class: 'bg-slate-100 text-slate-600 border-slate-200/80 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700/60' };
  }
}

const initials = store.name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
const storeDomain = getStoreDomain(store.name) || getStoreDomain(store.slug) || store.cleanDomain || 'promoradar.store';

// Schema.org Structured Data: Organization + Store
const storeOrgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": store.name,
  "url": `https://${storeDomain}`,
  "logo": `https://logo.clearbit.com/${storeDomain}`,
  "description": store.shortDesc || store.fullDesc
};

const storeSchema = {
  "@context": "https://schema.org",
  "@type": "Store",
  "name": store.name,
  "description": store.shortDesc || store.fullDesc,
  "url": `https://promoradar.store/stores/${store.slug}/`,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "184",
    "bestRating": "5",
    "worstRating": "1"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://promoradar.store/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Stores",
      "item": "https://promoradar.store/stores/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": store.name,
      "item": `https://promoradar.store/stores/${store.slug}/`
    }
  ]
};

// FAQPage Schema with accordion items
const faqSchema = (store.faqs && store.faqs.length > 0) ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": store.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
} : null;

// Organization + Offer List Schema on /stores/[slug]
const offersListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": storeDeals.map((deal, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "item": {
      "@type": "Offer",
      "name": deal.title,
      "description": deal.description,
      "category": deal.storeCategory,
      "availability": "https://schema.org/InStock",
      "validFrom": "2026-10-01",
      "priceSpecification": {
        "@type": "PriceSpecification",
        "description": deal.discountBadge || "Special Promotion"
      },
      "seller": {
        "@type": "Organization",
        "name": store.name,
        "url": `https://${storeDomain}`
      }
    }
  }))
};

const pageSchemas = [storeOrgSchema, storeSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : []), offersListSchema];
---

<BaseLayout
  title={`${store.name} Promo Codes & Vouchers (October 2026) — PromoRadar`}
  description={`Active and verified ${store.name} promo codes, discount coupons, and checkout vouchers. Tested October 2026 via verified merchant partner networks.`}
  activePath={`/stores/${store.slug}/`}
  schemas={pageSchemas}
>
  <Header activePath={`/stores/${store.slug}/`} />

  <main class="flex-1">
    <!-- Breadcrumbs & Quick Switcher -->
    <div class="border-b border-slate-200 dark:border-slate-800/80 bg-white dark:bg-slate-900/90 py-3">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400" aria-label="Breadcrumb">
            <a href={`${base}/`} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Home</a>
            <span>/</span>
            <a href={`${base}/stores/`} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Stores</a>
            <span>/</span>
            <span class="text-slate-900 dark:text-white font-bold">{store.name}</span>
          </nav>

          <div class="flex items-center gap-2">
            <span class="text-xs text-slate-500 dark:text-slate-400 hidden sm:inline">Switch Brand:</span>
            <select
              id="brandSwitcherSelect"
              class="text-xs font-semibold bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-3 py-1.5 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500"
            >
              {STORES_DATA.map(s => (
                <option value={`${base}/stores/${s.slug}/`} selected={s.slug === store.slug}>
                  {s.name}
                </option>
              ))}
            </select>
          </div>
        </div>
      </div>
    </div>

    <!-- Store Hero Header -->
    <div class="bg-white dark:bg-slate-950/60 border-b border-slate-200 dark:border-slate-800/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
        <div class="bg-slate-50 dark:bg-slate-900/90 rounded-3xl p-6 sm:p-8 border border-slate-200/90 dark:border-slate-800 shadow-sm relative overflow-hidden">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 relative z-10">
            <div class="flex items-start sm:items-center gap-5">
              <BrandLogo store={store} size="xl" />
              <div>
                <div class="flex flex-wrap items-center gap-2 mb-1.5">
                  <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
                    {store.name} Promo Codes &amp; Coupons
                  </h1>
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200/80 dark:bg-emerald-500/15 dark:text-emerald-400 dark:border-emerald-500/30">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    Verified Merchant Partner
                  </span>
                </div>
                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed">
                  {store.fullDesc}
                </p>
              </div>
            </div>

            <div class="shrink-0 flex items-center gap-3">
              <a
                href={store.primaryAffiliateUrl}
                target="_blank"
                rel="nofollow sponsored"
                class="px-5 py-3 rounded-xl bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-500 hover:to-indigo-600 text-white font-bold text-xs sm:text-sm shadow-md hover:shadow-indigo-500/25 transition-all flex items-center gap-2"
              >
                <span>Visit {store.name} Store ↗</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content Grid (8 cols Deals + 4 cols Sidebar) -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- Left Sidebar (4 cols) -->
        <aside class="lg:col-span-4 space-y-6 order-2 lg:order-1">
          <!-- Interactive Cart Savings Estimator Widget -->
          <div class="bg-gradient-to-br from-indigo-900 via-slate-900 to-indigo-950 text-white rounded-3xl p-6 border border-indigo-500/30 shadow-xl relative overflow-hidden">
            <div class="absolute -right-10 -bottom-10 w-32 h-32 bg-indigo-500/10 rounded-full blur-2xl pointer-events-none"></div>
            <div class="flex items-center gap-2 mb-3">
              <span class="p-2 rounded-xl bg-indigo-500/20 text-indigo-400 border border-indigo-400/20">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                </svg>
              </span>
              <div>
                <h3 class="text-sm font-extrabold text-white">Quick Savings Estimator</h3>
                <p class="text-[11px] text-indigo-200/80">Calculate your final price with best active code</p>
              </div>
            </div>

            <div class="space-y-3.5 pt-2">
              <div>
                <label class="block text-[11px] font-semibold text-slate-300 uppercase tracking-wider mb-1.5">Cart Order Subtotal ($)</label>
                <div class="relative">
                  <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 font-bold">$</span>
                  <input
                    type="number"
                    id="savingsCalcInput"
                    min="1"
                    step="1"
                    value="100"
                    placeholder="100"
                    class="w-full bg-slate-800/80 border border-slate-700 rounded-xl pl-8 pr-4 py-2.5 text-sm font-bold text-white placeholder-slate-500 focus:outline-none focus:border-indigo-400 focus:ring-1 focus:ring-indigo-400 transition"
                  />
                </div>
              </div>

              <!-- Calculation Result Display -->
              <div id="savingsCalcResults" class="bg-slate-800/60 rounded-2xl p-4 border border-slate-700/60 space-y-2.5">
                <div class="flex justify-between items-center text-xs">
                  <span class="text-slate-400">Best Applied Code:</span>
                  <span id="savingsCalcBestCode" class="font-mono font-bold text-indigo-300 bg-indigo-950/80 px-2 py-0.5 rounded border border-indigo-700/50">...</span>
                </div>
                <div class="flex justify-between items-center text-xs">
                  <span class="text-slate-400">Estimated Savings:</span>
                  <span id="savingsCalcDiscountAmount" class="font-bold text-emerald-400">-$0.00</span>
                </div>
                <div class="pt-2 border-t border-slate-700/60 flex justify-between items-center">
                  <span class="text-xs font-semibold text-white">Estimated Total:</span>
                  <span id="savingsCalcFinalTotal" class="text-lg font-black text-white">$0.00</span>
                </div>
              </div>

              <button
                type="button"
                id="savingsCalcApplyBtn"
                class="w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-indigo-500 to-indigo-600 hover:from-indigo-400 hover:to-indigo-500 text-white font-bold text-xs shadow-md transition flex items-center justify-center gap-1.5"
              >
                <span>Copy Best Code & Redeem ↗</span>
              </button>
            </div>
          </div>

          <!-- Verification Metrics -->
          <div class="bg-white dark:bg-slate-900/90 rounded-3xl p-6 border border-slate-200/90 dark:border-slate-800 shadow-sm space-y-5">
            <h3 class="text-sm font-extrabold text-slate-900 dark:text-white flex items-center gap-2">
              <svg class="w-4 h-4 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
              </svg>
              <span>Store Verification Metrics</span>
            </h3>
            <div class="grid grid-cols-2 gap-3 text-center">
              <div class="bg-slate-50 dark:bg-slate-800/70 rounded-2xl p-3.5 border border-slate-200/70 dark:border-slate-700/60 shadow-inner">
                <div class="text-xl font-black text-amber-500 dark:text-amber-400 flex items-center justify-center gap-0.5">
                  <span>4.9</span>
                  <span class="text-amber-400">★</span>
                </div>
                <div class="text-[11px] text-slate-500 dark:text-slate-400 font-medium mt-0.5">Shopper Rating</div>
              </div>
              <div class="bg-slate-50 dark:bg-slate-800/70 rounded-2xl p-3.5 border border-slate-200/70 dark:border-slate-700/60 shadow-inner">
                <div class="text-xl font-black text-emerald-600 dark:text-emerald-400">99%</div>
                <div class="text-[11px] text-slate-500 dark:text-slate-400 font-medium mt-0.5">Code Success Rate</div>
              </div>
            </div>
            <div class="text-xs text-slate-600 dark:text-slate-400 space-y-2.5 pt-3 border-t border-slate-100 dark:border-slate-800/80">
              <div class="flex justify-between items-center">
                <span class="text-slate-500 dark:text-slate-400">Offer Source:</span>
                <span class="font-semibold text-slate-900 dark:text-slate-200">Direct Partner Feed</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-slate-500 dark:text-slate-400">Last Tested:</span>
                <span class="font-semibold text-emerald-600 dark:text-emerald-400 flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                  Today, Active
                </span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-slate-500 dark:text-slate-400">Category:</span>
                <span class="font-semibold text-slate-900 dark:text-slate-200">{store.category}</span>
              </div>
            </div>
          </div>

          <!-- How to Apply Guide -->
          <div class="bg-white dark:bg-slate-900/90 rounded-3xl p-6 border border-slate-200/90 dark:border-slate-800 shadow-sm space-y-3.5">
            <h3 class="text-sm font-extrabold text-slate-900 dark:text-white flex items-center gap-2">
              <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
              </svg>
              <span>How to Redeem a Promo Code</span>
            </h3>
            <ol class="text-xs text-slate-600 dark:text-slate-300 space-y-2.5 list-decimal list-inside leading-relaxed">
              {store.howToApply.map(step => (
                <li class="marker:text-indigo-500 dark:marker:text-indigo-400 marker:font-bold">{step}</li>
              ))}
            </ol>
          </div>

          <!-- Lead Magnet: Deal Drop Alerts -->
          <div class="bg-gradient-to-br from-indigo-950 via-slate-900 to-indigo-900 text-white rounded-3xl p-6 border border-indigo-500/30 shadow-xl space-y-3.5 relative overflow-hidden">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
              </svg>
              <h3 class="text-sm font-extrabold text-white">Get {store.name} Deal Alerts</h3>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">
              Never miss a 50%+ discount or exclusive flash voucher. Get instant notification when new tested codes drop.
            </p>
            <form id="dealAlertForm" class="space-y-2.5">
              <input
                type="email"
                required
                placeholder="Enter your email..."
                class="w-full px-3.5 py-2.5 text-xs rounded-xl bg-slate-800/90 text-white placeholder-slate-400 border border-slate-700/80 focus:outline-none focus:ring-2 focus:ring-indigo-400"
              />
              <button
                type="submit"
                class="w-full py-2.5 px-3.5 rounded-xl bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-500 hover:to-indigo-600 text-white font-bold text-xs shadow-md transition cursor-pointer"
              >
                Notify Me ⚡
              </button>
            </form>
            <div id="dealAlertSuccess" class="hidden text-center text-[11px] font-semibold text-emerald-300 bg-emerald-950/60 p-2.5 rounded-xl border border-emerald-500/30">
              ✓ Subscribed! You will receive notifications for {store.name}.
            </div>
          </div>

          <!-- Other Recommended Stores -->
          <div class="bg-white dark:bg-slate-900/90 rounded-2xl p-5 border border-slate-200/90 dark:border-slate-800 shadow-sm space-y-3">
            <h3 class="text-sm font-extrabold text-slate-900 dark:text-white">More Verified Brands</h3>
            <div class="space-y-2">
              {otherStores.map(s => (
                <a
                  href={`${base}/stores/${s.slug}/`}
                  class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800/60 transition border border-transparent hover:border-slate-200 dark:hover:border-slate-700 text-xs"
                >
                  <span class="font-bold text-slate-800 dark:text-slate-200">{s.name}</span>
                  <span class="text-indigo-600 dark:text-indigo-400 font-semibold">{s.category} →</span>
                </a>
              ))}
            </div>
          </div>
        </aside>

        <!-- Main Column: Active Coupons (8 cols) -->
        <div class="lg:col-span-8 space-y-6 order-1 lg:order-2">
          <div>
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-lg font-extrabold text-slate-900 dark:text-white">
                Active Promo Codes &amp; Deals for {store.name}
              </h2>
              <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200 dark:bg-indigo-500/15 dark:text-indigo-300 dark:border-indigo-500/30">
                {storeDeals.length} offers active
              </span>
            </div>

            <!-- List of Coupons -->
            <div class="space-y-4">
              {storeDeals.map((deal, idx) => {
                const isCode = deal.code && deal.code.trim().length > 0;
                const isTopDeal = idx === 0;
                const expiryBadge = getExpiryBadge(deal.expiryDate);
                return (
                  <article class={`bg-white dark:bg-slate-900/90 rounded-2xl border border-slate-200/90 dark:border-slate-800 p-5 card-hover shadow-sm flex flex-col justify-between dark:shadow-[inset_0_1px_0_0_rgba(255,255,255,0.06)] ${isTopDeal ? 'ring-1 ring-amber-400/30' : ''}`}>
                    <div>
                      <div class="flex items-start justify-between gap-3 mb-3">
                        <div class="flex items-center gap-2 flex-wrap">
                          <span class="text-xs font-extrabold px-2.5 py-1 rounded-xl bg-rose-50 text-rose-600 border border-rose-200/80 dark:bg-rose-500/15 dark:text-rose-300 dark:border-rose-500/30">
                            {deal.discountBadge}
                          </span>
                          <span class={`text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md ${
                            isCode ? 'bg-indigo-50 text-indigo-700 border border-indigo-200 dark:bg-indigo-500/15 dark:text-indigo-300 dark:border-indigo-500/30' : 'bg-emerald-50 text-emerald-700 border border-emerald-200 dark:bg-emerald-500/15 dark:text-emerald-300 dark:border-emerald-500/30'
                          }`}>
                            {isCode ? 'PROMO CODE' : 'DIRECT DEAL'}
                          </span>
                          {isTopDeal && (
                            <span class="inline-flex items-center gap-1 text-[10px] font-extrabold px-2 py-0.5 rounded-md bg-amber-50 text-amber-800 border border-amber-200/80 dark:bg-amber-500/15 dark:text-amber-300 dark:border-amber-500/30 shrink-0">
                              <span class="text-amber-500">★</span> Editor's Pick
                            </span>
                          )}
                        </div>
                        <div class="flex items-center gap-1.5 shrink-0">
                          <span class={`text-[10px] px-2 py-0.5 rounded-md border shrink-0 ${expiryBadge.class}`}>
                            {expiryBadge.text}
                          </span>
                          <button
                            type="button"
                            class="deal-share-btn w-7 h-7 rounded-lg border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 dark:hover:bg-indigo-950/40 dark:hover:text-indigo-400 transition cursor-pointer"
                            data-share-title={deal.title}
                            data-share-desc={deal.description}
                            data-share-url={`https://promoradar.store/stores/${store.slug}/`}
                            title="Share Discount"
                            aria-label="Share Discount"
                          >
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
                            </svg>
                          </button>
                        </div>
                      </div>

                      <h3 class="text-base font-extrabold text-slate-900 dark:text-white mb-1.5 leading-snug">
                        {deal.title}
                      </h3>
                      <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
                        {deal.description}
                      </p>
                    </div>

                    <div class="space-y-2.5 pt-3.5 border-t border-slate-100 dark:border-slate-800/80">
                      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs text-slate-500 dark:text-slate-400">
                          <span class="inline-flex items-center gap-1 text-emerald-600 dark:text-emerald-400 font-semibold">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                            Verified on Checkout
                          </span>
                          <span>•</span>
                          <span>Success: <strong class="text-slate-800 dark:text-slate-200">{deal.successRate || '99%'}</strong></span>
                          {deal.terms && (
                            <>
                              <span>•</span>
                              <button type="button" class="deal-terms-toggle text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 underline underline-offset-2 font-medium cursor-pointer">
                                Terms ▾
                              </button>
                            </>
                          )}
                        </div>

                        {isCode ? (
                          <button
                            type="button"
                            class="code-peel text-white rounded-xl px-4 py-2.5 text-xs font-bold flex items-center justify-center gap-2 shrink-0 shadow-sm cursor-pointer"
                            data-reveal-deal={JSON.stringify({
                              id: deal.id,
                              title: deal.title,
                              desc: deal.description,
                              code: deal.code,
                              storeName: store.name,
                              storeSlug: store.slug,
                              badge: deal.discountBadge,
                              affiliateUrl: deal.affiliateUrl,
                              successRate: deal.successRate
                            })}
                          >
                            <span>Get Code</span>
                            <span class="font-mono text-[11px] bg-black/25 px-2 py-0.5 rounded border border-white/20">
                              •••{deal.code.slice(-3)}
                            </span>
                          </button>
                        ) : (
                          <button
                            type="button"
                            class="bg-slate-900 hover:bg-indigo-600 dark:bg-indigo-600 dark:hover:bg-indigo-500 text-white rounded-xl px-4 py-2.5 text-xs font-bold flex items-center justify-center gap-1.5 shrink-0 transition shadow-sm cursor-pointer"
                            data-reveal-deal={JSON.stringify({
                              id: deal.id,
                              title: deal.title,
                              desc: deal.description,
                              code: '',
                              storeName: store.name,
                              storeSlug: store.slug,
                              badge: deal.discountBadge,
                              affiliateUrl: deal.affiliateUrl,
                              successRate: deal.successRate
                            })}
                          >
                            <span>Activate Deal ↗</span>
                          </button>
                        )}
                      </div>

                      {/* Expandable Terms & Exclusions Drawer */}
                      {deal.terms && (
                        <div class="deal-terms-drawer hidden text-[11px] text-slate-600 dark:text-slate-300 bg-slate-50 dark:bg-slate-800/60 p-3 rounded-xl border border-slate-200/70 dark:border-slate-700/60 space-y-1">
                          <div class="font-bold text-slate-800 dark:text-slate-200 flex items-center justify-between">
                            <span>Terms &amp; Restrictions:</span>
                            <span class="text-[10px] text-slate-400 font-mono">Expires {deal.expiryDate}</span>
                          </div>
                          <p class="leading-relaxed">{deal.terms}</p>
                        </div>
                      )}
                    </div>
                  </article>
                );
              })}
            </div>
          </div>

          <!-- Recently Expired Deals for SEO Archive -->
          <div class="bg-white dark:bg-slate-900/60 rounded-2xl p-5 border border-slate-200/80 dark:border-slate-800/80 opacity-80 shadow-sm">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
                Recently Expired Offers (SEO Archive)
              </span>
              <span class="text-[11px] px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 font-semibold border border-slate-200/60 dark:border-slate-700/60">
                Expired
              </span>
            </div>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-2">
              <div>
                <h4 class="text-sm font-bold text-slate-600 dark:text-slate-400 line-through">
                  Extra 15% Off Seasonal Checkout Coupon for {store.name}
                </h4>
                <p class="text-xs text-slate-400 dark:text-slate-500">
                  Expired codes occasionally remain active on select partner checkouts.
                </p>
              </div>
              <span class="font-mono text-xs px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-slate-700 shrink-0 text-center">
                ARCHIVE15
              </span>
            </div>
          </div>

          <!-- Brand FAQs -->
          {store.faqs && store.faqs.length > 0 && (
            <div class="bg-white dark:bg-slate-900/90 rounded-2xl p-6 border border-slate-200/90 dark:border-slate-800 shadow-sm space-y-4">
              <h3 class="text-base font-extrabold text-slate-900 dark:text-white">
                {store.name} Promo Code FAQ
              </h3>
              <div class="space-y-3">
                {store.faqs.map(faq => (
                  <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-700/60">
                    <h4 class="text-xs font-bold text-slate-900 dark:text-white mb-1">{faq.question}</h4>
                    <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">{faq.answer}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Similar Stores & Best Alternatives (Link Equity & Internal Flow) -->
          {similarStores && similarStores.length > 0 && (
            <div class="bg-slate-50/80 dark:bg-slate-900/90 rounded-3xl p-6 sm:p-7 border border-slate-200/90 dark:border-slate-800 shadow-sm">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
                <div>
                  <h3 class="text-base font-extrabold text-slate-900 dark:text-white flex items-center gap-2">
                    <span>Similar Stores &amp; Best Alternatives</span>
                    <span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200/80 dark:bg-indigo-500/15 dark:text-indigo-300 dark:border-indigo-500/30 uppercase tracking-wide">
                      {store.category}
                    </span>
                  </h3>
                  <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Compare active checkout codes across related verified merchants</p>
                </div>
                <a href={`${base}/stores/`} class="text-xs font-bold text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300 transition shrink-0">
                  Browse All Stores →
                </a>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                {similarStores.slice(0, 6).map(alt => (
                  <a
                    href={`${base}/stores/${alt.slug}/`}
                    class="group p-4 rounded-2xl bg-white dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 hover:border-indigo-400 dark:hover:border-indigo-500/60 hover:shadow-md transition flex items-center gap-3.5"
                  >
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-700 to-indigo-900 dark:from-indigo-600 dark:to-indigo-800 text-white font-extrabold text-xs flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition-transform">
                      {alt.name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase()}
                    </div>
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center justify-between gap-1">
                        <span class="text-xs font-extrabold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 truncate transition-colors">
                          {alt.name}
                        </span>
                        <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200/60 dark:bg-emerald-500/15 dark:text-emerald-300 dark:border-emerald-500/30">
                          {alt.couponsCount} deals
                        </span>
                      </div>
                      <p class="text-[11px] text-slate-500 dark:text-slate-400 truncate mt-0.5">
                        {alt.bestDiscount ? `Up to ${alt.bestDiscount}` : alt.category}
                      </p>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>

      </div>
    </div>
  </main>

  <Footer />

  <script is:inline define:vars={{ rawDeals: storeDeals, storeName: store.name, storeAffiliateUrl: store.primaryAffiliateUrl }}>
    const switcher = document.getElementById('brandSwitcherSelect');
    switcher?.addEventListener('change', (e) => {
      window.location.href = e.target.value;
    });

    // Quick Savings Estimator Calculator Logic
    const calcInput = document.getElementById('savingsCalcInput');
    const calcCode = document.getElementById('savingsCalcBestCode');
    const calcDiscount = document.getElementById('savingsCalcDiscountAmount');
    const calcTotal = document.getElementById('savingsCalcFinalTotal');
    const calcApplyBtn = document.getElementById('savingsCalcApplyBtn');

    function calculateSavings() {
      const subtotal = parseFloat(calcInput?.value) || 0;
      if (subtotal <= 0) {
        if (calcDiscount) calcDiscount.textContent = '-$0.00';
        if (calcTotal) calcTotal.textContent = '$0.00';
        return;
      }

      let bestDiscountVal = 0;
      let bestDeal = null;

      (rawDeals || []).forEach(deal => {
        let discountDollars = 0;
        const discountStr = (deal.discount || deal.title || '').toUpperCase();
        const percentMatch = discountStr.match(/(\d+)%/);
        const dollarMatch = discountStr.match(/\$(\d+)/);

        if (percentMatch) {
          const pct = parseFloat(percentMatch[1]);
          discountDollars = (subtotal * pct) / 100;
        } else if (dollarMatch) {
          discountDollars = parseFloat(dollarMatch[1]);
        } else {
          // Default minimal baseline savings if active
          discountDollars = subtotal * 0.15;
        }

        if (discountDollars > bestDiscountVal) {
          bestDiscountVal = discountDollars;
          bestDeal = deal;
        }
      });

      if (!bestDeal && rawDeals && rawDeals.length > 0) {
        bestDeal = rawDeals[0];
        bestDiscountVal = subtotal * 0.15;
      }

      const cappedDiscount = Math.min(bestDiscountVal, subtotal);
      const finalPrice = Math.max(0, subtotal - cappedDiscount);

      if (calcCode) calcCode.textContent = (bestDeal && bestDeal.code) ? bestDeal.code : 'DIRECT_DEAL';
      if (calcDiscount) calcDiscount.textContent = `-$${cappedDiscount.toFixed(2)}`;
      if (calcTotal) calcTotal.textContent = `$${finalPrice.toFixed(2)}`;

      if (calcApplyBtn) {
        calcApplyBtn.onclick = () => {
          const promoCode = (bestDeal && bestDeal.code) ? bestDeal.code : '';
          const url = (bestDeal && bestDeal.affiliateUrl) ? bestDeal.affiliateUrl : storeAffiliateUrl;
          if (promoCode) {
            navigator.clipboard?.writeText(promoCode).catch(() => {});
          }
          window.dispatchEvent(new CustomEvent('promoradar_deal_revealed', {
            detail: {
              code: promoCode || 'ACTIVE_DEAL',
              store: storeName,
              affiliateUrl: url
            }
          }));
          if (url) {
            window.open(url, '_blank', 'noopener,noreferrer');
          }
        };
      }
    }

    calcInput?.addEventListener('input', calculateSavings);
    calculateSavings();

    // Terms Drawers Toggle
    document.querySelectorAll('.deal-terms-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const card = btn.closest('article');
        const drawer = card?.querySelector('.deal-terms-drawer');
        drawer?.classList.toggle('hidden');
      });
    });

    const alertForm = document.getElementById('dealAlertForm');
    const alertSuccess = document.getElementById('dealAlertSuccess');
    alertForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      alertForm.classList.add('hidden');
      alertSuccess?.classList.remove('hidden');
    });
  </script>
</BaseLayout>
