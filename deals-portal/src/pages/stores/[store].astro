                        <td class="py-3.5 px-3">
                          <span class="font-bold text-slate-700 dark:text-slate-300">
                            {item.dealsCount} {item.dealsCount === 1 ? 'deal' : 'deals'}
                          </span>
                        </td>

                        <!-- Code Availability -->
                        <td class="py-3.5 px-3">
                          {item.codesCount > 0 ? (
                            <span class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-600 dark:text-emerald-400">
                              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                              </svg>
                              <span>{item.codesCount} Promo {item.codesCount === 1 ? 'Code' : 'Codes'}</span>
                            </span>
                          ) : (
                            <span class="text-[11px] font-medium text-slate-400 dark:text-slate-500">
                              Direct Deals Only
                            </span>
                          )}
                        </td>

                        <!-- Checkout Success -->
                        <td class="py-3.5 px-3">
                          <div class="flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                            <span class="font-bold text-slate-800 dark:text-slate-200">{item.successRate}</span>
                          </div>
                        </td>

                        <!-- Actions & Head-to-Head Link -->
                        <td class="py-3.5 px-4 text-right">
                          <div class="flex items-center justify-end gap-2">
                            {item.compareUrl && (
                              <a
                                href={item.compareUrl}
                                class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-bold text-[11px] transition shrink-0"
                                title="View Detailed Head-to-Head Comparison"
                              >
                                <span>Compare ↗</span>
                              </a>
                            )}
                            {item.isCurrent ? (
                              <span class="px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 text-xs font-bold">
                                Viewing
                              </span>
                            ) : (
                              <a
                                href={`${base}/stores/${item.store.slug}/`}
                                class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs transition shadow-sm shrink-0"
                              >
                                <span>Deals →</span>
                              </a>
                            )}
                          </div>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>

            <!-- Mobile Stacked Cards (below md) -->
            <div class="md:hidden space-y-3">
              {comparisonMatrixList.map(item => {
                const compDomain = getStoreDomain(item.store.name) || getStoreDomain(item.store.slug) || item.store.cleanDomain || 'promoradar.store';
                return (
                  <div class={`p-4 rounded-2xl border transition-all ${
                    item.isCurrent
                      ? 'bg-indigo-50/50 dark:bg-indigo-950/20 border-indigo-200 dark:border-indigo-800/80 ring-1 ring-indigo-500/20'
                      : 'bg-slate-50/60 dark:bg-slate-800/50 border-slate-200/80 dark:border-slate-700/60'
                  }`}>
                    <div class="flex items-start justify-between gap-3 mb-3">
                      <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700/80 flex items-center justify-center overflow-hidden shrink-0 shadow-sm">
                          <img
                            src={`https://logo.clearbit.com/${compDomain}`}
                            alt={`${item.store.name} logo`}
                            class="w-6 h-6 object-contain"
                            loading="lazy"
                            onerror="this.onerror=null; this.src='https://www.google.com/s2/favicons?domain=' + this.alt + '&sz=64';"
                          />
                        </div>
                        <div>
                          <div class="flex items-center gap-1.5">
                            <h4 class="font-extrabold text-sm text-slate-900 dark:text-white">
                              {item.store.name}
                            </h4>
                            {item.isCurrent && (
                              <span class="text-[9px] font-extrabold px-1.5 py-0.5 rounded bg-indigo-600 text-white uppercase tracking-wider">
                                Current
                              </span>
                            )}
                          </div>
                          <span class="text-[11px] text-slate-400 dark:text-slate-500">
                            {item.store.cleanDomain || compDomain}
                          </span>
                        </div>
                      </div>
                      <span class="font-extrabold text-xs px-2.5 py-1 rounded-xl bg-rose-50 text-rose-600 border border-rose-200/80 dark:bg-rose-500/15 dark:text-rose-300 dark:border-rose-500/30 shrink-0">
                        {item.bestDiscount}
                      </span>
                    </div>

                    <div class="grid grid-cols-2 gap-2 text-xs py-2 border-y border-slate-200/60 dark:border-slate-700/60 mb-3">
                      <div>
                        <span class="text-slate-400 dark:text-slate-500 text-[11px] block">Active Offers</span>
                        <span class="font-bold text-slate-800 dark:text-slate-200">{item.dealsCount} verified deals</span>
                      </div>
                      <div>
                        <span class="text-slate-400 dark:text-slate-500 text-[11px] block">Checkout Success</span>
                        <span class="font-bold text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
                          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                          {item.successRate}
                        </span>
                      </div>
                    </div>

                    <div class="flex items-center justify-between gap-2">
                      <span class="text-xs text-slate-500 dark:text-slate-400">
                        {item.codesCount > 0 ? `🔥 ${item.codesCount} Promo Codes` : 'Direct Discounts'}
                      </span>
                      <div class="flex items-center gap-2">
                        {item.compareUrl && (
                          <a
                            href={item.compareUrl}
                            class="px-2.5 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 font-bold text-xs transition"
                          >
                            Compare ↗
                          </a>
                        )}
                        {item.isCurrent ? (
                          <span class="text-xs font-bold text-slate-400 px-3 py-1.5">Viewing</span>
                        ) : (
                          <a
                            href={`${base}/stores/${item.store.slug}/`}
                            class="px-3.5 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs transition shadow-sm"
                          >
                            View Deals →
                          </a>
                        )}
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>

          <!-- Brand FAQs -->
          {store.faqs && store.faqs.length > 0 && (
            <div class="bg-white dark:bg-slate-900/90 rounded-2xl p-6 border border-slate-200/90 dark:border-slate-800 shadow-sm space-y-4">
              <h3 class="text-base font-extrabold text-slate-900 dark:text-white">
                {store.name} Promo Code FAQ
              </h3>
              <div class="space-y-3">
                {store.faqs.map(faq => (
                  <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-700/60">
                    <h4 class="text-xs font-bold text-slate-900 dark:text-white mb-1">{faq.question}</h4>
                    <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">{faq.answer}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Similar Stores & Best Alternatives (Link Equity & Internal Flow) -->
          {similarStores && similarStores.length > 0 && (
            <div class="bg-slate-50/80 dark:bg-slate-900/90 rounded-3xl p-6 sm:p-7 border border-slate-200/90 dark:border-slate-800 shadow-sm">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
                <div>
                  <h3 class="text-base font-extrabold text-slate-900 dark:text-white flex items-center gap-2">
                    <span>Similar Stores &amp; Best Alternatives</span>
                    <span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200/80 dark:bg-indigo-500/15 dark:text-indigo-300 dark:border-indigo-500/30 uppercase tracking-wide">
                      {store.category}
                    </span>
                  </h3>
                  <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Compare active checkout codes across related verified merchants</p>
                </div>
                <a href={`${base}/stores/`} class="text-xs font-bold text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300 transition shrink-0">
                  Browse All Stores →
                </a>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                {similarStores.slice(0, 6).map(alt => (
                  <a
                    href={`${base}/stores/${alt.slug}/`}
                    class="group p-4 rounded-2xl bg-white dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 hover:border-indigo-400 dark:hover:border-indigo-500/60 hover:shadow-md transition flex items-center gap-3.5"
                  >
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-700 to-indigo-900 dark:from-indigo-600 dark:to-indigo-800 text-white font-extrabold text-xs flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition-transform">
                      {alt.name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase()}
                    </div>
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center justify-between gap-1">
                        <span class="text-xs font-extrabold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 truncate transition-colors">
                          {alt.name}
                        </span>
                        <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200/60 dark:bg-emerald-500/15 dark:text-emerald-300 dark:border-emerald-500/30">
                          {alt.couponsCount} deals
                        </span>
                      </div>
                      <p class="text-[11px] text-slate-500 dark:text-slate-400 truncate mt-0.5">
                        {alt.bestDiscount ? `Up to ${alt.bestDiscount}` : alt.category}
                      </p>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>

      </div>
    </div>
  </main>

  <Footer />

  <script is:inline define:vars={{ rawDeals: storeDeals, storeName: store.name, storeAffiliateUrl: store.primaryAffiliateUrl }}>
    const switcher = document.getElementById('brandSwitcherSelect');
    switcher?.addEventListener('change', (e) => {
      window.location.href = e.target.value;
    });

    // Quick Savings Estimator Calculator Logic
    const calcInput = document.getElementById('savingsCalcInput');
    const calcCode = document.getElementById('savingsCalcBestCode');
    const calcDiscount = document.getElementById('savingsCalcDiscountAmount');
    const calcTotal = document.getElementById('savingsCalcFinalTotal');
    const calcApplyBtn = document.getElementById('savingsCalcApplyBtn');

    function calculateSavings() {
      const subtotal = parseFloat(calcInput?.value) || 0;
      if (subtotal <= 0) {
        if (calcDiscount) calcDiscount.textContent = '-$0.00';
        if (calcTotal) calcTotal.textContent = '$0.00';
        return;
      }

      let bestDiscountVal = 0;
      let bestDeal = null;

      (rawDeals || []).forEach(deal => {
        let discountDollars = 0;
        const discountStr = (deal.discount || deal.title || '').toUpperCase();
        const percentMatch = discountStr.match(/(\d+)%/);
        const dollarMatch = discountStr.match(/\$(\d+)/);

        if (percentMatch) {
          const pct = parseFloat(percentMatch[1]);
          discountDollars = (subtotal * pct) / 100;
        } else if (dollarMatch) {
          discountDollars = parseFloat(dollarMatch[1]);
        } else {
          // Default minimal baseline savings if active
          discountDollars = subtotal * 0.15;
        }

        if (discountDollars > bestDiscountVal) {
          bestDiscountVal = discountDollars;
          bestDeal = deal;
        }
      });

      if (!bestDeal && rawDeals && rawDeals.length > 0) {
        bestDeal = rawDeals[0];
        bestDiscountVal = subtotal * 0.15;
      }

      const cappedDiscount = Math.min(bestDiscountVal, subtotal);
      const finalPrice = Math.max(0, subtotal - cappedDiscount);
      const effectiveRate = subtotal > 0 ? Math.round((cappedDiscount / subtotal) * 100) : 0;

      const calcEffective = document.getElementById('savingsCalcEffectiveRate');
      if (calcEffective) calcEffective.textContent = `${effectiveRate}% OFF`;
      if (calcCode) calcCode.textContent = (bestDeal && bestDeal.code) ? bestDeal.code : 'DIRECT_DEAL';
      if (calcDiscount) calcDiscount.textContent = `-$${cappedDiscount.toFixed(2)}`;
      if (calcTotal) calcTotal.textContent = `$${finalPrice.toFixed(2)}`;

      if (calcApplyBtn) {
        calcApplyBtn.onclick = () => {
          const promoCode = (bestDeal && bestDeal.code) ? bestDeal.code : '';
          const url = (bestDeal && bestDeal.affiliateUrl) ? bestDeal.affiliateUrl : storeAffiliateUrl;
          if (promoCode) {
            navigator.clipboard?.writeText(promoCode).catch(() => {});
            if (window.showPromoToast) {
              window.showPromoToast(`Code ${promoCode} copied! Opening ${storeName} checkout...`);
            }
          }
          window.dispatchEvent(new CustomEvent('promoradar_deal_revealed', {
            detail: {
              code: promoCode || 'ACTIVE_DEAL',
              store: storeName,
              storeName: storeName,
              badge: bestDeal?.discountBadge || 'Verified Deal',
              affiliateUrl: url
            }
          }));
          if (url) {
            window.open(url, '_blank', 'noopener,noreferrer');
          }
        };
      }
    }

    // Preset Buttons Listener
    document.querySelectorAll('.store-calc-preset').forEach(btn => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-val');
        if (calcInput && val) {
          calcInput.value = val;
          document.querySelectorAll('.store-calc-preset').forEach(b => {
            const isTarget = b === btn;
            b.className = isTarget
              ? 'store-calc-preset px-1.5 py-0.5 rounded text-[10px] font-bold bg-indigo-600 text-white border border-indigo-500 transition cursor-pointer'
              : 'store-calc-preset px-1.5 py-0.5 rounded text-[10px] font-bold bg-slate-800 hover:bg-slate-700 text-indigo-300 border border-slate-700 transition cursor-pointer';
          });
          calculateSavings();
        }
      });
    });

    calcInput?.addEventListener('input', calculateSavings);
    calculateSavings();

    // Terms Drawers Toggle
    document.querySelectorAll('.deal-terms-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const card = btn.closest('article');
        const drawer = card?.querySelector('.deal-terms-drawer');
        drawer?.classList.toggle('hidden');
      });
    });

    // Persistent Verified Deal Drop Alerts Engine
    const alertForm = document.getElementById('dealAlertForm');
    const alertSuccess = document.getElementById('dealAlertSuccess');
    const alertSuccessMsg = document.getElementById('dealAlertSuccessMsg');
    const alertEmailInput = document.getElementById('dealAlertEmail');
    const alertErrorEl = document.getElementById('dealAlertEmailError');
    const alertManageBtn = document.getElementById('dealAlertManageBtn');
    const alertStoreSlug = window.location.pathname.split('/').filter(Boolean).pop() || 'store';

    function checkExistingAlert() {
      try {
        const stored = JSON.parse(localStorage.getItem('promoradar_deal_alerts') || '{}');
        const alert = stored[alertStoreSlug];
        if (alert && alert.email) {
          if (alertForm) alertForm.classList.add('hidden');
          if (alertSuccess) alertSuccess.classList.remove('hidden');
          if (alertSuccessMsg) {
            const thresholdText = alert.threshold === '50plus' ? '50%+ discounts' : 'all new verified coupons';
            alertSuccessMsg.textContent = `Alert active for ${alert.email} (${thresholdText}).`;
          }
        }
      } catch (e) {}
    }

    checkExistingAlert();

    alertForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = (alertEmailInput?.value || '').trim();
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        if (alertErrorEl) {
          alertErrorEl.textContent = 'Please enter a valid email address.';
          alertErrorEl.classList.remove('hidden');
        }
        return;
      }

      if (alertErrorEl) alertErrorEl.classList.add('hidden');

      const selectedThreshold = (document.querySelector('input[name="alertThreshold"]:checked')?.value) || '50plus';

      try {
        const stored = JSON.parse(localStorage.getItem('promoradar_deal_alerts') || '{}');
        stored[alertStoreSlug] = {
          email,
          threshold: selectedThreshold,
          storeName: storeName,
          timestamp: new Date().toISOString()
        };
        localStorage.setItem('promoradar_deal_alerts', JSON.stringify(stored));
      } catch (err) {}

      if (alertForm) alertForm.classList.add('hidden');
      if (alertSuccess) alertSuccess.classList.remove('hidden');
      if (alertSuccessMsg) {
        const thresholdText = selectedThreshold === '50plus' ? '50%+ discounts' : 'all new verified coupons';
        alertSuccessMsg.textContent = `Subscribed! ${email} will receive alerts for ${thresholdText}.`;
      }

      if (window.showPromoToast) {
        window.showPromoToast(`⚡ Deal alerts active for ${storeName}!`);
      }

      // Dispatch GA4 custom event
      window.dispatchEvent(new CustomEvent('promoradar_alert_subscribed', {
        detail: { email, store: storeName, threshold: selectedThreshold }
      }));
    });

    alertManageBtn?.addEventListener('click', () => {
      if (alertSuccess) alertSuccess.classList.add('hidden');
      if (alertForm) alertForm.classList.remove('hidden');
      if (alertEmailInput) alertEmailInput.focus();
    });

    // Faceted Filtering & Sorting Engine for Store Coupons
    let currentStoreFilter = 'all';
    let currentStoreSort = 'recommended';
    const storeCards = Array.from(document.querySelectorAll('.store-deal-card'));
    const storeGrid = document.getElementById('storeCouponsGrid');
    const storeCountEl = document.getElementById('storeFilteredCount');
    const storeEmptyEl = document.getElementById('storeFiltersEmptyState');

    function applyStoreFilters() {
      let visibleCount = 0;

      // Filter cards
      storeCards.forEach(card => {
        const dealType = card.getAttribute('data-deal-type') || 'deal';
        const matchType = currentStoreFilter === 'all' || dealType === currentStoreFilter;
        if (matchType) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      // Sort cards if container exists
      if (storeGrid && visibleCount > 0) {
        const sorted = [...storeCards].sort((a, b) => {
          if (currentStoreSort === 'discount') {
            const valA = parseFloat(a.getAttribute('data-discount-val') || '0');
            const valB = parseFloat(b.getAttribute('data-discount-val') || '0');
            return valB - valA;
          } else if (currentStoreSort === 'expiry') {
            const expA = parseFloat(a.getAttribute('data-expiry-ts') || '0');
            const expB = parseFloat(b.getAttribute('data-expiry-ts') || '0');
            return expA - expB;
          } else {
            const orderA = parseInt(a.getAttribute('data-default-order') || '0', 10);
            const orderB = parseInt(b.getAttribute('data-default-order') || '0', 10);
            return orderA - orderB;
          }
        });
        sorted.forEach(card => storeGrid.appendChild(card));
        if (storeEmptyEl) storeGrid.appendChild(storeEmptyEl);
      }

      if (storeCountEl) storeCountEl.textContent = visibleCount;
      if (storeEmptyEl) {
        if (visibleCount === 0) storeEmptyEl.classList.remove('hidden');
        else storeEmptyEl.classList.add('hidden');
      }
    }

    document.querySelectorAll('.store-facet-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        currentStoreFilter = tab.getAttribute('data-filter') || 'all';
        document.querySelectorAll('.store-facet-tab').forEach(t => {
          const isActive = t === tab;
          t.classList.toggle('active', isActive);
          t.classList.toggle('bg-white', isActive);
          t.classList.toggle('dark:bg-slate-900', isActive);
          t.classList.toggle('text-slate-900', isActive);
          t.classList.toggle('dark:text-white', isActive);
          t.classList.toggle('shadow-xs', isActive);
          t.classList.toggle('text-slate-600', !isActive);
          t.classList.toggle('dark:text-slate-400', !isActive);
        });
        applyStoreFilters();
      });
    });

    document.getElementById('storeSortSelect')?.addEventListener('change', (e) => {
      currentStoreSort = e.target.value;
      applyStoreFilters();
    });

    document.getElementById('resetStoreFilterBtn')?.addEventListener('click', () => {
      const allTab = document.querySelector('.store-facet-tab[data-filter="all"]');
      if (allTab) allTab.click();
    });
  </script>
</BaseLayout>
