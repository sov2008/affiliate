---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BrandLogo from '../components/BrandLogo.astro';
import { COUPONS_DATA, STORES_DATA } from '../data/couponsData';
import { STORE_DOMAINS_MAP } from '../data/storeDomains';
import { getDealLivePulse } from '../data/pulseEngine';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Group unique categories with fallback to eliminate empty or undefined values
const categoriesList = Array.from(
  new Set(
    COUPONS_DATA.map(d => (d.storeCategory && d.storeCategory.trim()) || 'Software & Utilities')
  )
).filter(c => Boolean(c && c.trim()));

// Registries for instant Live Spotlight Auto-suggest
const storesRegistry = STORES_DATA.map(s => ({
  slug: s.slug,
  name: s.name,
  category: s.category
}));

const dealsRegistry = COUPONS_DATA.map(d => ({
  id: d.id,
  title: d.title,
  desc: d.description,
  storeName: d.storeName,
  storeSlug: d.storeSlug,
  code: d.code,
  badge: d.discountBadge,
  affiliateUrl: d.affiliateUrl,
  successRate: d.successRate
}));

const categoriesRegistry = [
  { slug: 'privacy-security', name: 'Privacy, VPN & Cybersecurity', categoryName: 'Privacy & Security', icon: '🛡' },
  { slug: 'dating-lifestyle', name: 'Dating & Lifestyle Services', categoryName: 'Dating & Lifestyle', icon: '💬' },
  { slug: 'fashion-apparel', name: 'Fashion & Apparel', categoryName: 'Fashion & Apparel', icon: '👗' },
  { slug: 'eyewear-health', name: 'Eyewear & Optical Health', categoryName: 'Eyewear & Health', icon: '👓' },
  { slug: 'travel-tours', name: 'Travel, Desert Safaris & Tours', categoryName: 'Travel & Tours', icon: '✈️' },
  { slug: 'ecommerce-wholesale', name: 'E-Commerce & Department Stores', categoryName: 'E-Commerce & Wholesale', icon: '📦' },
  { slug: 'electronics-gadgets', name: 'Electronics & Portable Power', categoryName: 'Electronics & Gadgets', icon: '⚡' },
  { slug: 'education-learning', name: 'Education & Online Learning', categoryName: 'Education & Learning', icon: '🎓' },
  { slug: 'beauty-fragrances', name: 'Beauty, Cosmetics & Fragrances', categoryName: 'Beauty & Fragrances', icon: '✨' },
  { slug: 'insurance-finance', name: 'Insurance & Financial Protection', categoryName: 'Insurance & Finance', icon: '💰' },
  { slug: 'web-hosting-domains', name: 'Web Hosting, Domains & Servers', categoryName: 'Web Hosting & Domains', icon: '🌐' }
];

// Brand Visual Styling Helper (Honey / Slickdeals style branded identity)
const BRAND_THEMES: Record<string, { bg: string; text: string; border: string; badgeBg: string }> = {
  'expressvpn': { bg: 'from-rose-600 to-red-700', text: 'text-white', border: 'border-red-200', badgeBg: 'bg-rose-50 text-rose-600 border border-rose-200 dark:bg-rose-500/15 dark:text-rose-300 dark:border-rose-500/30' },
  'purevpn': { bg: 'from-emerald-600 to-teal-700', text: 'text-white', border: 'border-emerald-200', badgeBg: 'bg-emerald-50 text-emerald-700 border border-emerald-200 dark:bg-emerald-500/15 dark:text-emerald-300 dark:border-emerald-500/30' },
  'huawei': { bg: 'from-red-600 via-rose-600 to-red-800', text: 'text-white', border: 'border-red-200', badgeBg: 'bg-rose-50 text-rose-600 border border-rose-200 dark:bg-rose-500/15 dark:text-rose-300 dark:border-rose-500/30' },
  'alibaba': { bg: 'from-amber-500 to-orange-600', text: 'text-white', border: 'border-amber-200', badgeBg: 'bg-amber-50 text-amber-700 border border-amber-200 dark:bg-amber-500/15 dark:text-amber-300 dark:border-amber-500/30' },
  'allpowers': { bg: 'from-slate-900 to-emerald-900', text: 'text-emerald-400', border: 'border-emerald-300', badgeBg: 'bg-emerald-50 text-emerald-700 border border-emerald-200 dark:bg-emerald-500/15 dark:text-emerald-300 dark:border-emerald-500/30' },
  'chicme': { bg: 'from-pink-500 to-rose-600', text: 'text-white', border: 'border-pink-200', badgeBg: 'bg-rose-50 text-rose-600 border border-rose-200 dark:bg-rose-500/15 dark:text-rose-300 dark:border-rose-500/30' },
  'vogacloset': { bg: 'from-purple-600 to-indigo-700', text: 'text-white', border: 'border-purple-200', badgeBg: 'bg-indigo-50 text-indigo-700 border border-indigo-200 dark:bg-indigo-500/15 dark:text-indigo-300 dark:border-indigo-500/30' },
  'airalo': { bg: 'from-orange-500 to-amber-600', text: 'text-white', border: 'border-orange-200', badgeBg: 'bg-amber-50 text-amber-700 border border-amber-200 dark:bg-amber-500/15 dark:text-amber-300 dark:border-amber-500/30' },
  'keepersecurity': { bg: 'from-slate-900 to-indigo-950', text: 'text-amber-400', border: 'border-amber-300', badgeBg: 'bg-amber-50 text-amber-700 border border-amber-200 dark:bg-amber-500/15 dark:text-amber-300 dark:border-amber-500/30' },
  'qustodio': { bg: 'from-cyan-600 to-blue-700', text: 'text-white', border: 'border-cyan-200', badgeBg: 'bg-rose-50 text-rose-600 border border-rose-200 dark:bg-rose-500/15 dark:text-rose-300 dark:border-rose-500/30' },
  'touch': { bg: 'from-violet-600 to-indigo-700', text: 'text-white', border: 'border-violet-200', badgeBg: 'bg-amber-50 text-amber-700 border border-amber-200 dark:bg-amber-500/15 dark:text-amber-300 dark:border-amber-500/30' },
  'nazih': { bg: 'from-rose-500 to-purple-600', text: 'text-white', border: 'border-rose-200', badgeBg: 'bg-rose-50 text-rose-600 border border-rose-200 dark:bg-rose-500/15 dark:text-rose-300 dark:border-rose-500/30' },
  'vperfumes': { bg: 'from-amber-600 to-stone-800', text: 'text-amber-200', border: 'border-amber-300', badgeBg: 'bg-amber-50 text-amber-700 border border-amber-200 dark:bg-amber-500/15 dark:text-amber-300 dark:border-amber-500/30' },
  'raynatours': { bg: 'from-blue-600 to-indigo-700', text: 'text-white', border: 'border-blue-200', badgeBg: 'bg-rose-50 text-rose-600 border border-rose-200 dark:bg-rose-500/15 dark:text-rose-300 dark:border-rose-500/30' },
  'abelssoft': { bg: 'from-blue-600 to-indigo-800', text: 'text-white', border: 'border-blue-200', badgeBg: 'bg-blue-50 text-blue-700 border border-blue-200 dark:bg-blue-500/15 dark:text-blue-300 dark:border-blue-500/30' },
  '945industries': { bg: 'from-stone-800 to-amber-900', text: 'text-amber-300', border: 'border-amber-300', badgeBg: 'bg-amber-50 text-amber-700 border border-amber-200 dark:bg-amber-500/15 dark:text-amber-300 dark:border-amber-500/30' }
};

// Helper for top-right discount pills
function getDiscountBadgeClasses(badge: string): string {
  const b = (badge || '').toUpperCase();
  if (b.includes('$') || b.includes('AED') || b.includes('UAH') || (b.includes('SAVE') && !b.includes('%'))) {
    return 'badge-cash-rebate';
  }
  if (b.includes('FREE') || b.includes('EXTRA') || b.includes('CASHBACK') || b.includes('VIP') || b.includes('GIFTS') || b.includes('+')) {
    return 'badge-bonus-deal';
  }
  return 'badge-standard-discount';
}

// Store Target Regions mapping for geo filtering
const STORE_REGIONS: Record<string, string[]> = {
  'chicme': ['GLOBAL', 'EU', 'US'],
  'glasseslit': ['GLOBAL', 'US', 'EU'],
  'raynatours': ['GCC', 'GLOBAL'],
  'purevpn': ['GLOBAL', 'EU', 'US', 'GCC'],
  'expressvpn': ['GLOBAL', 'EU', 'US', 'GCC', 'UA'],
  'alibaba': ['GLOBAL', 'EU', 'GCC', 'US'],
  'thedealoutlet': ['GCC'],
  'vogacloset': ['GCC', 'GLOBAL'],
  'kodland': ['GLOBAL', 'EU', 'UA'],
  'airalo': ['GLOBAL', 'EU', 'GCC', 'US', 'UA'],
  'keepersecurity': ['GLOBAL', 'EU', 'US'],
  'qustodio': ['GLOBAL', 'EU', 'US'],
  'allpowers': ['UA', 'GLOBAL', 'EU'],
  'huawei': ['GCC', 'GLOBAL', 'EU'],
  'nazih': ['GCC'],
  'touch': ['UA'],
  'onlinesim': ['GLOBAL', 'EU', 'UA'],
  'jashanmal': ['GCC'],
  'dabdoob': ['GCC'],
  'vperfumes': ['GCC'],
  'aovica': ['GLOBAL', 'EU', 'US'],
  'markformelle': ['GLOBAL', 'EU'],
  'elitedate': ['EU'],
  'verified-match': ['US', 'GLOBAL'],
  'discreet-local': ['US', 'GLOBAL'],
  'spokeo': ['US'],
  'polis': ['UA', 'EU'],
  'hostinger': ['GLOBAL', 'US', 'EU', 'UA', 'GCC'],
  'abelssoft': ['GLOBAL', 'EU', 'US'],
  '945industries': ['US', 'GLOBAL', 'EU']
};

// Region badge display config
const REGION_BADGES: Record<string, { label: string; class: string }> = {
  'UA': { label: '🇺🇦 UA', class: 'deal-region-badge' },
  'GCC': { label: '🇦🇪 UAE & GCC', class: 'deal-region-badge' },
  'US': { label: '🇺🇸 US', class: 'deal-region-badge' },
  'EU': { label: '🇪🇺 EU', class: 'deal-region-badge' },
  'GLOBAL': { label: '🌐 Worldwide', class: 'deal-region-badge' }
};

// Map store domain and store lookup map
const STORES_MAP: Record<string, typeof STORES_DATA[0]> = {};
const STORE_DOMAINS: Record<string, string> = {};
for (const s of STORES_DATA) {
  STORES_MAP[s.slug] = s;
  try {
    const u = new URL(s.websiteUrl);
    STORE_DOMAINS[s.slug] = u.hostname.replace(/^www\./, '');
  } catch (e) {
    STORE_DOMAINS[s.slug] = '';
  }
}

// Distinct high-urgency offers for "Deals Expiring Soon" (Fix #3: no duplication with top grid cards)
const TARGET_EXPIRING_SLUGS = ['vogacloset', 'keepersecurity', 'allpowers', 'alibaba'];
const endingSoonDeals: typeof COUPONS_DATA = [];
const pickedStoreSlugs = new Set<string>();

// First pick distinct priority high-urgency offers
for (const slug of TARGET_EXPIRING_SLUGS) {
  const match = COUPONS_DATA.find(d => d.storeSlug === slug && d.code && d.code.length > 0 && !pickedStoreSlugs.has(d.storeSlug));
  if (match) {
    endingSoonDeals.push(match);
    pickedStoreSlugs.add(match.storeSlug);
  }
}

// Fallback fill to 4 if needed with other unique stores
if (endingSoonDeals.length < 4) {
  for (const d of COUPONS_DATA) {
    if (d.code && d.code.length > 0 && !pickedStoreSlugs.has(d.storeSlug)) {
      pickedStoreSlugs.add(d.storeSlug);
      endingSoonDeals.push(d);
      if (endingSoonDeals.length === 4) break;
    }
  }
}

// Count total coupons per store for "+X more [Store Name] deals →"
const storeCouponCounts: Record<string, number> = {};
for (const d of COUPONS_DATA) {
  storeCouponCounts[d.storeName] = (storeCouponCounts[d.storeName] || 0) + 1;
}

// Round-robin brand interleaving for main deals grid to prevent same-brand walls
const storeBuckets: Record<string, typeof COUPONS_DATA> = {};
for (const d of COUPONS_DATA) {
  if (!storeBuckets[d.storeSlug]) storeBuckets[d.storeSlug] = [];
  storeBuckets[d.storeSlug].push(d);
}

const CONFIRMED_PRIORITY = [
  'abelssoft',
  '945industries',
  'touch',
  'alibaba',
  'hostinger',
  'chicme',
  'glasseslit',
  'raynatours',
  'polis',
  'purevpn',
  'expressvpn'
];

const interleavedDeals: typeof COUPONS_DATA = [];
const storeKeys = Object.keys(storeBuckets).sort((a, b) => {
  const aIdx = CONFIRMED_PRIORITY.indexOf(a);
  const bIdx = CONFIRMED_PRIORITY.indexOf(b);
  if (aIdx !== -1 && bIdx !== -1) return aIdx - bIdx;
  if (aIdx !== -1) return -1;
  if (bIdx !== -1) return 1;
  return a.localeCompare(b);
});
let hasMore = true;
let round = 0;
while (hasMore) {
  hasMore = false;
  for (const slug of storeKeys) {
    if (storeBuckets[slug][round]) {
      interleavedDeals.push(storeBuckets[slug][round]);
      if (storeBuckets[slug][round + 1]) {
        hasMore = true;
      }
    }
  }
  round++;
}

// Identify Top Store Deal for "Editor's Pick" badge
const topStoreDealIds = new Set<string>();
for (const slug of Object.keys(storeBuckets)) {
  if (storeBuckets[slug] && storeBuckets[slug].length > 0) {
    topStoreDealIds.add(storeBuckets[slug][0].id);
  }
}

// Helper to calculate genuine remaining validity & urgency
function getExpiryBadge(expiryDateStr: string) {
  if (!expiryDateStr) return { text: '⚡ Verified Oct 2026', class: 'bg-emerald-50 text-emerald-700 border-emerald-200/80 dark:bg-emerald-500/15 dark:text-emerald-300 dark:border-emerald-500/30' };
  const expiry = new Date(expiryDateStr);
  const now = new Date('2026-10-19');
  const diffDays = Math.ceil((expiry.getTime() - now.getTime()) / (1000 * 60 * 60 * 24));
  if (diffDays <= 7 && diffDays > 0) {
    return { text: `⏳ Ends in ${diffDays}d`, class: 'bg-rose-50 text-rose-700 border-rose-200/80 dark:bg-rose-500/15 dark:text-rose-300 dark:border-rose-500/30 font-bold' };
  } else if (diffDays <= 45 && diffDays > 0) {
    return { text: `⏳ Ends in ${diffDays}d`, class: 'bg-amber-50 text-amber-800 border-amber-200/80 dark:bg-amber-500/15 dark:text-amber-300 dark:border-amber-500/30 font-bold' };
  } else {
    return { text: '⚡ Verified for Oct 2026', class: 'bg-slate-100 text-slate-600 border-slate-200/80 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700/60' };
  }
}

