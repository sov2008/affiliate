// Distinct high-urgency offers for "Deals Expiring Soon" (Fix #3: no duplication with top grid cards)
const TARGET_EXPIRING_SLUGS = [
  'vogacloset', 'keepersecurity', 'allpowers', 'alibaba',
  'hostinger', 'expressvpn', 'qustodio', 'touch', 'polis',
  'onlinesim', 'airalo', 'dabdoob', 'honor-uae', 'answear',
  'casetify', 'redmagic', 'harfington', 'corsair'
];
const endingSoonDeals: typeof COUPONS_DATA = [];
const pickedStoreSlugs = new Set<string>();

for (const slug of TARGET_EXPIRING_SLUGS) {
  const match = COUPONS_DATA.find(d => d.storeSlug === slug && d.code && d.code.length > 0 && !pickedStoreSlugs.has(d.storeSlug));
  if (match) {
    endingSoonDeals.push(match);
    pickedStoreSlugs.add(match.storeSlug);
  }
}

for (const d of COUPONS_DATA) {
  if (endingSoonDeals.length >= 16) break;
  if (d.code && d.code.length > 0 && !pickedStoreSlugs.has(d.storeSlug) && !isJunkTestOffer(d.storeName, d.title)) {
    pickedStoreSlugs.add(d.storeSlug);
    endingSoonDeals.push(d);
  }
}

const validCouponsData = COUPONS_DATA.filter(d => !isJunkTestOffer(d.storeName, d.title));

// 1. Strict Offer Deduplication via Composite Fingerprint
const seenDealFps = new Set<string>();
const deduplicatedCoupons = validCouponsData.filter(deal => {
  const fp = deal.storeSlug + "::" + deal.discountBadge + "::" + (deal.code || "").toLowerCase() + "::" + deal.title.toLowerCase().slice(0, 30);
  if (seenDealFps.has(fp)) return false;
  seenDealFps.add(fp);
  return true;
});

// Pre-resolve merchant identity and discount badge for every coupon
const enrichedDeals = deduplicatedCoupons.map(d => {
  const identity = resolveMerchantIdentity(d);
  const smartBadge = extractSmartDiscountBadge(d.discountBadge, d.title);
  const canonicalSlug = getCanonicalStoreSlug(identity.brand);
  const smartCategory = resolveSmartCategory(d.storeCategory, identity.brand, d.title);
  return {
    ...d,
    cleanBrand: identity.brand,
    canonicalSlug,
    smartCategory,
    resolvedDomain: identity.domain,
    cleanBadge: smartBadge
  };
});

