// Helper for top-right discount pills
function getDiscountBadgeClasses(badge: string): string {
  const b = (badge || '').toUpperCase();
  if (b === 'SPECIAL DEAL') {
    return 'bg-indigo-500/12 text-indigo-700 dark:text-indigo-300 border-indigo-500/30';
  }
  if (b === 'VIP RATE') {
    return 'bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 border-emerald-500/30';
  }
  if (b.includes('$') || b.includes('AED') || b.includes('UAH') || (b.includes('SAVE') && !b.includes('%'))) {
    return 'badge-cash-rebate';
  }
  if (b.includes('FREE') || b.includes('BOGO') || b.includes('TRIAL') || b.includes('EXTRA') || b.includes('CASHBACK') || b.includes('VIP') || b.includes('GIFTS') || b.includes('+')) {
    return 'badge-bonus-deal';
  }
  return 'badge-standard-discount';
}

