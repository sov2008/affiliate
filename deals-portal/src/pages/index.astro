    function renderHeroSpotlight(query) {
      if (!query || query.trim().length < 2) {
        heroSpotlight?.classList.add('hidden');
        return;
      }

      const q = query.trim().toLowerCase();
      if (heroSpotlightStatus) heroSpotlightStatus.textContent = `Suggestions for "${query.trim()}"`;

      // 1. Match Stores (filter junk names)
      const matchedStores = (storesRegistry || []).filter(s => {
        const name = (s.name || '').toLowerCase();
        // Skip junk campaigns
        if (name.includes('get 1%') || name.includes('1929b') || name.includes('tested fr')) return false;
        return name.includes(q) || (s.category || '').toLowerCase().includes(q) || (s.slug || '').includes(q);
      }).slice(0, 5);

      // 2. Match Categories
      const matchedCategories = (categoriesRegistry || []).filter(c =>
        (c.name || '').toLowerCase().includes(q) || (c.categoryName || '').toLowerCase().includes(q) || (c.slug || '').includes(q)
      ).slice(0, 3);

      // 3. Match Deals / Promo Codes
      const matchedDeals = (dealsRegistry || []).filter(d => {
        const title = (d.title || '').toLowerCase();
        const sName = (d.storeName || '').toLowerCase();
        if (title.includes('1929b') || sName.includes('get 1%')) return false;
        return title.includes(q) || sName.includes(q) || (d.code || '').toLowerCase().includes(q);
      }).slice(0, 4);

      const totalMatches = matchedStores.length + matchedCategories.length + matchedDeals.length;

      if (totalMatches === 0) {
        heroSpotlightStoresSection?.classList.add('hidden');
        heroSpotlightCategoriesSection?.classList.add('hidden');
        heroSpotlightDealsSection?.classList.add('hidden');
        heroSpotlightEmpty?.classList.remove('hidden');
        heroSpotlight?.classList.remove('hidden');
        return;
      }

      heroSpotlightEmpty?.classList.add('hidden');

      // Render Stores
      if (matchedStores.length > 0) {
        heroSpotlightStoresSection?.classList.remove('hidden');
        if (heroSpotlightStoresList) {
          heroSpotlightStoresList.innerHTML = matchedStores.map(s => {
            const domain = (storeDomainsRegistry && (storeDomainsRegistry[s.slug] || storeDomainsRegistry[s.name])) || '';
            const logoUrl = domain ? `https://logo.clearbit.com/${domain}` : '';
            const fallbackUrl = domain ? `https://www.google.com/s2/favicons?domain=${domain}&sz=64` : '';
            const count = (dealsRegistry || []).filter(d => d.storeSlug === s.slug).length;

            return `
              <a href="${baseUrl}/stores/${s.slug}/" class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-colors group">
                <div class="flex items-center gap-3 min-w-0 pr-2">
                  <div class="w-9 h-9 rounded-xl bg-white border border-slate-200 dark:border-slate-700/80 p-1 flex items-center justify-center shrink-0 overflow-hidden shadow-xs">
                    ${domain ? `<img src="${logoUrl}" onerror="this.onerror=null;this.src='${fallbackUrl}';" alt="${s.name}" class="w-full h-full object-contain" />` : `<span class="text-indigo-600 dark:text-indigo-400 font-extrabold text-[11px]">${s.name.slice(0, 2).toUpperCase()}</span>`}
                  </div>
                  <div class="truncate">
                    <div class="text-xs font-bold text-slate-900 dark:text-slate-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition truncate">${s.name}</div>
                    <div class="text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold">${count} active offers · ${s.category}</div>
                  </div>
                </div>
                <span class="text-[10px] font-bold text-indigo-600 dark:text-indigo-300 bg-indigo-50 dark:bg-indigo-950/80 border border-indigo-100 dark:border-indigo-800/50 px-2.5 py-1 rounded-lg shrink-0 group-hover:bg-indigo-600 group-hover:text-white dark:group-hover:bg-indigo-500 transition shadow-2xs">Store →</span>
              </a>
            `;
          }).join('');
        }
      } else {
        heroSpotlightStoresSection?.classList.add('hidden');
      }

      // Render Categories
      if (matchedCategories.length > 0) {
        heroSpotlightCategoriesSection?.classList.remove('hidden');
        if (heroSpotlightCategoriesList) {
          heroSpotlightCategoriesList.innerHTML = matchedCategories.map(c => {
            return `
              <a href="${baseUrl}/categories/${c.slug}/" class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-colors group">
                <div class="flex items-center gap-2.5">
                  <span class="text-base">${c.icon}</span>
                  <span class="text-xs font-bold text-slate-900 dark:text-slate-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition">${c.name}</span>
                </div>
                <span class="text-[10px] font-bold text-indigo-600 dark:text-indigo-300 bg-indigo-50 dark:bg-indigo-950/80 border border-indigo-100 dark:border-indigo-800/50 px-2.5 py-1 rounded-lg shrink-0 group-hover:bg-indigo-600 group-hover:text-white dark:group-hover:bg-indigo-500 transition">Category →</span>
              </a>
            `;
          }).join('');
        }
      } else {
        heroSpotlightCategoriesSection?.classList.add('hidden');
      }

      // Render Deals
      if (matchedDeals.length > 0) {
        heroSpotlightDealsSection?.classList.remove('hidden');
        if (heroSpotlightDealsList) {
          heroSpotlightDealsList.innerHTML = matchedDeals.map(d => {
            const domain = (storeDomainsRegistry && (storeDomainsRegistry[d.storeSlug] || storeDomainsRegistry[d.storeName])) || '';
            const dealJson = JSON.stringify({
              id: d.id,
              title: d.title,
              desc: d.desc,
              code: d.code,
              storeName: d.storeName,
              storeSlug: d.storeSlug,
              domain: domain,
              badge: d.badge,
              affiliateUrl: d.affiliateUrl,
              successRate: d.successRate
            }).replace(/"/g, '&quot;');

            return `
              <button
                type="button"
                data-reveal-deal="${dealJson}"
                class="w-full text-left flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-colors cursor-pointer group"
              >
                <div class="min-w-0 pr-2">
                  <div class="flex items-center gap-1.5">
                    <span class="text-xs font-bold text-slate-900 dark:text-slate-100 truncate">${d.storeName}</span>
                    <span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-rose-50 text-rose-700 dark:bg-rose-500/20 dark:text-rose-300 border border-rose-200/60 dark:border-rose-500/30">${d.badge}</span>
                  </div>
                  <p class="text-[11px] text-slate-600 dark:text-slate-300 truncate mt-0.5">${d.title}</p>
                </div>
                <span class="font-mono text-xs font-bold text-indigo-700 bg-indigo-50 dark:bg-indigo-950 dark:text-indigo-300 px-2.5 py-1 rounded-lg border border-indigo-200 dark:border-indigo-800/70 shrink-0 group-hover:bg-indigo-600 group-hover:text-white dark:group-hover:bg-indigo-500 transition shadow-2xs">
                  ${d.code ? '••• ' + d.code.slice(-3) : 'Redeem →'}
                </span>
              </button>
            `;
          }).join('');
        }
      } else {
        heroSpotlightDealsSection?.classList.add('hidden');
      }

      heroSpotlight?.classList.remove('hidden');
    }

    // Search Inputs
