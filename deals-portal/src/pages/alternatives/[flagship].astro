---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { STORES_DATA, COUPONS_DATA } from '../../data/couponsData';
import { getUniqueCleanStores, resolveMerchantIdentity, extractSmartDiscountBadge, getCanonicalStoreSlug } from '../../utils/dealNormalizer';
import { getDealLivePulse } from '../../data/pulseEngine';

export const prerender = true;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Curated list of high-intent target flagship brands that users search alternatives for
