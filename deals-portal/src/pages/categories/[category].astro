---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { COUPONS_DATA, STORES_DATA } from '../../data/couponsData';

export const prerender = true;

export async function getStaticPaths() {
  const CATEGORIES_DEF = [
    {
      slug: 'privacy-security',
      name: 'Privacy, VPN & Cybersecurity',
      categoryName: 'Privacy & Security',
      icon: '🛡',
      desc: 'Military-grade VPNs, encrypted zero-knowledge password vaults, family screen time parental controls, and virtual phone numbers for instant SMS activation.',
      maxDiscount: 'Up to 81% OFF'
    },
    {
      slug: 'dating-lifestyle',
      name: 'Dating & Lifestyle Services',
      categoryName: 'Dating & Lifestyle',
      icon: '💬',
      desc: 'Camera-verified dating platforms with priority compatibility scoring, anonymous stealth matching passes, and zero bot guarantees.',
      maxDiscount: '100% Free VIP'
    },
    {
      slug: 'fashion-apparel',
      name: 'Fashion & Apparel',
      categoryName: 'Fashion & Apparel',
      icon: '👗',
      desc: 'Worldwide on-trend women\'s fashion, seasonal dresses, swimwear, and footwear with stackable voucher discounts.',
      maxDiscount: '12% OFF Code'
    },
    {
      slug: 'eyewear-health',
      name: 'Eyewear & Optical Health',
      categoryName: 'Eyewear & Health',
      icon: '👓',
      desc: 'Factory-direct prescription optical frames, anti-blue-light lenses, bifocals, and polarized sunglasses without retail markup.',
      maxDiscount: '$8 OFF Voucher'
    },
    {
      slug: 'travel-tours',
      name: 'Travel, Desert Safaris & Tours',
      categoryName: 'Travel & Tours',
      icon: '✈️',
      desc: 'UAE desert safaris, Dubai Marina luxury dhow dinner cruises, Burj Khalifa observation deck admissions, and global sightseeing excursions.',
      maxDiscount: '20% OFF Booking'
    },
    {
      slug: 'ecommerce-wholesale',
      name: 'E-Commerce & Department Stores',
      categoryName: 'E-Commerce & Wholesale',
      icon: '📦',
      desc: 'Global B2B wholesale platforms, luxury department stores, and Trade Assurance factory-direct sourcing with voucher discounts.',
      maxDiscount: 'Up to 75% OFF'
    },
    {
      slug: 'electronics-gadgets',
      name: 'Electronics, Solar & Hardware',
      categoryName: 'Electronics & Gadgets',
      icon: '⚡',
      desc: 'Portable power stations, solar panels, and smart gadgets with verified merchant coupons.',
      maxDiscount: 'Up to $800 OFF'
    },
    {
      slug: 'education-learning',
      name: 'Online Education & Coding',
      categoryName: 'Education & Learning',
      icon: '🎓',
      desc: 'Interactive coding academies, English lessons, and digital skills courses for kids and adults.',
      maxDiscount: 'Up to 30% OFF'
    },
    {
      slug: 'beauty-fragrances',
      name: 'Beauty, Fragrances & Oud',
      categoryName: 'Beauty & Fragrances',
      icon: '✨',
      desc: 'Authentic French and oriental perfumes, niche fragrances, oud oils, and luxury cosmetics.',
      maxDiscount: 'Free Express Shipping'
    },
    {
      slug: 'insurance-finance',
      name: 'Insurance & Financial Services',
      categoryName: 'Insurance & Finance',
      icon: '💼',
      desc: 'Online auto MTPL, international Green Card travel policies, medical insurance, and digital micro-loans comparison with instant electronic delivery.',
      maxDiscount: 'Up to 15% OFF'
    },
    {
      slug: 'web-hosting-domains',
      name: 'Web Hosting, Servers & Cloud',
      categoryName: 'Web Hosting & Domains',
      icon: '🌐',
      desc: 'High-performance NVMe cloud hosting, free custom domains, 1-click WordPress stacks, and SSL certificates with money-back guarantees.',
      maxDiscount: 'Up to 75% OFF'
    }
  ];

  return CATEGORIES_DEF.map(cat => {
    const deals = COUPONS_DATA.filter(d => d.storeCategory === cat.categoryName);
    const stores = STORES_DATA.filter(s => s.category === cat.categoryName);
    return {
      params: { category: cat.slug },
      props: { cat, deals, stores }
    };
  });
}

const { cat, deals, stores } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const codesCount = deals.filter(d => d.code && d.code.trim().length > 0).length;
const directDealsCount = deals.filter(d => !d.code || d.code.trim().length === 0).length;

function parseDiscountValue(badge: string): number {
  if (!badge) return 0;
  const match = badge.match(/(\d+)/);
  if (match) return parseInt(match[1], 10);
  if (badge.toUpperCase().includes('FREE') || badge.toUpperCase().includes('VIP')) return 99;
  return 10;
}

// Helper to calculate genuine remaining validity & urgency
function getExpiryBadge(expiryDateStr: string) {
  if (!expiryDateStr) return { text: '⚡ Verified Oct 2026', class: 'bg-emerald-50 text-emerald-700 border-emerald-200/80 dark:bg-emerald-500/15 dark:text-emerald-300 dark:border-emerald-500/30' };
  const expiry = new Date(expiryDateStr);
  const now = new Date('2026-10-19');
  const diffDays = Math.ceil((expiry.getTime() - now.getTime()) / (1000 * 60 * 60 * 24));
  if (diffDays <= 7 && diffDays > 0) {
    return { text: `⏳ Ends in ${diffDays}d`, class: 'bg-rose-50 text-rose-700 border-rose-200/80 dark:bg-rose-500/15 dark:text-rose-300 dark:border-rose-500/30 font-bold' };
  } else if (diffDays <= 45 && diffDays > 0) {
    return { text: `⏳ Ends in ${diffDays}d`, class: 'bg-amber-50 text-amber-800 border-amber-200/80 dark:bg-amber-500/15 dark:text-amber-300 dark:border-amber-500/30 font-bold' };
  } else {
    return { text: '⚡ Verified for Oct 2026', class: 'bg-slate-100 text-slate-600 border-slate-200/80 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700/60' };
  }
}

const breadcrumbs = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://promoradar.store/" },
      { "@type": "ListItem", "position": 2, "name": "Categories", "item": "https://promoradar.store/categories/" },
      { "@type": "ListItem", "position": 3, "name": cat.name, "item": `https://promoradar.store/categories/${cat.slug}/` }
    ]
  }
];
---

<BaseLayout
  title={`${cat.name} Promo Codes & Vouchers (October 2026) — PromoRadar`}
  description={`Active and verified ${cat.name} promo codes, discount coupons, and checkout vouchers. Save ${cat.maxDiscount} with direct merchant partner feeds.`}
  activePath={`/categories/${cat.slug}/`}
  schemas={breadcrumbs}
>
  <Header activePath="/categories" />

  <main class="flex-1">
    <!-- Header -->
    <div class="bg-gradient-to-b from-indigo-950 via-slate-900 to-slate-900 text-white py-12 px-4 sm:px-6 lg:px-8 border-b border-slate-800">
      <div class="max-w-5xl mx-auto text-center space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/20 border border-indigo-400/30 text-indigo-300 text-xs font-semibold">
          <span class="text-base">{cat.icon}</span>
          <span>Verified Category Collection</span>
          <span>•</span>
          <span class="text-emerald-400">{deals.length} Active Deals</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">
          {cat.name} Promo Codes
        </h1>
        <p class="text-slate-300 text-xs sm:text-sm max-w-2xl mx-auto leading-relaxed">
          {cat.desc}
        </p>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 space-y-10">
      
      <!-- Participating Stores Row -->
      {stores.length > 0 && (
        <div class="bg-white dark:bg-slate-900/90 rounded-2xl p-6 border border-slate-200/90 dark:border-slate-800 shadow-sm space-y-3">
          <div class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            Featured Brands in this Category
          </div>
          <div class="flex flex-wrap gap-2">
            {stores.map(store => (
              <a
                href={`${base}/stores/${store.slug}/`}
                class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 dark:bg-slate-800/80 dark:hover:bg-slate-800 dark:text-slate-200 dark:hover:text-indigo-400 text-slate-800 font-bold text-xs transition border border-transparent hover:border-indigo-200 dark:hover:border-indigo-500/40"
              >
                <span>{store.name}</span>
                <span class="text-[10px] text-slate-400 font-normal">→</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Deals List Grid -->
      <div class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-2">
          <div>
            <h2 class="text-xl font-extrabold text-slate-900 dark:text-white flex items-center gap-2">
              <span>Active Coupons &amp; Verified Offers</span>
              <span id="catFilteredCount" class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200 dark:bg-indigo-500/15 dark:text-indigo-300 dark:border-indigo-500/30">
                {deals.length} Verified
              </span>
            </h2>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
              Filtered and hand-tested partner network vouchers
            </p>
          </div>

          <!-- Faceted Filter & Sort Controls for Category -->
          <div class="flex flex-wrap items-center gap-2">
            <!-- Type Tabs -->
            <div class="inline-flex p-1 bg-slate-100 dark:bg-slate-800 rounded-xl border border-slate-200/80 dark:border-slate-700/80 text-xs font-bold" role="tablist">
              <button
                type="button"
                class="cat-facet-tab active px-3 py-1 rounded-lg bg-white dark:bg-slate-900 text-slate-900 dark:text-white shadow-xs transition cursor-pointer"
                data-filter="all"
              >
                All ({deals.length})
              </button>
              <button
                type="button"
                class="cat-facet-tab px-3 py-1 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition cursor-pointer"
                data-filter="code"
              >
                Codes ({codesCount})
              </button>
              <button
                type="button"
                class="cat-facet-tab px-3 py-1 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition cursor-pointer"
                data-filter="deal"
              >
                Deals ({directDealsCount})
              </button>
            </div>

            <!-- Store Selector within Category -->
            <div class="relative">
              <select
                id="catStoreSelect"
                aria-label="Filter by Store"
                class="appearance-none bg-slate-100 hover:bg-slate-200/60 dark:bg-slate-800 dark:hover:bg-slate-700/80 text-slate-800 dark:text-slate-200 text-xs font-bold pl-3 pr-7 py-1.5 rounded-xl border border-slate-200/80 dark:border-slate-700/80 cursor-pointer outline-none focus:ring-2 focus:ring-indigo-500/20"
              >
                <option value="all">All Brands ({stores.length})</option>
                {stores.map(s => (
                  <option value={s.slug}>{s.name}</option>
                ))}
              </select>
              <svg class="w-3.5 h-3.5 text-slate-400 absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </div>

            <!-- Sort Dropdown Selector -->
            <div class="relative">
              <select
                id="catSortSelect"
                aria-label="Sort Deals"
                class="appearance-none bg-slate-100 hover:bg-slate-200/60 dark:bg-slate-800 dark:hover:bg-slate-700/80 text-slate-800 dark:text-slate-200 text-xs font-bold pl-3 pr-7 py-1.5 rounded-xl border border-slate-200/80 dark:border-slate-700/80 cursor-pointer outline-none focus:ring-2 focus:ring-indigo-500/20"
              >
                <option value="recommended">Sort: Best Match</option>
                <option value="discount">Sort: Highest Discount</option>
                <option value="expiry">Sort: Ending Soon</option>
              </select>
              <svg class="w-3.5 h-3.5 text-slate-400 absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </div>
          </div>
        </div>

        <div id="catCouponsGrid" class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {deals.map((deal, idx) => {
            const isCode = deal.code && deal.code.trim().length > 0;
            const isTopDeal = idx === 0;
            const expiryBadge = getExpiryBadge(deal.expiryDate);
            const discountNum = parseDiscountValue(deal.discountBadge || deal.badge);
            const expiryTs = deal.expiryDate ? new Date(deal.expiryDate).getTime() : 4102444800000;

            return (
              <article
                class={`cat-deal-card bg-white dark:bg-slate-900/90 rounded-2xl border border-slate-200/90 dark:border-slate-800 p-5 card-hover shadow-sm flex flex-col justify-between dark:shadow-[inset_0_1px_0_0_rgba(255,255,255,0.06)] ${isTopDeal ? 'ring-1 ring-amber-400/30' : ''}`}
                data-deal-type={isCode ? 'code' : 'deal'}
                data-store-slug={deal.storeSlug}
                data-discount-val={discountNum}
                data-expiry-ts={expiryTs}
                data-default-order={idx}
              >
                <div>
                  <div class="flex items-start justify-between gap-3 mb-3">
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class="text-xs font-extrabold px-2.5 py-1 rounded-xl bg-rose-50 text-rose-600 border border-rose-200/80 dark:bg-rose-500/15 dark:text-rose-300 dark:border-rose-500/30">
                        {deal.discountBadge || deal.badge}
                      </span>
                      <a
                        href={`${base}/stores/${deal.storeSlug}/`}
                        class="text-xs font-bold text-slate-800 dark:text-slate-200 hover:text-indigo-600 dark:hover:text-indigo-400 transition"
                      >
                        {deal.storeName}
                      </a>
                      {isTopDeal && (
                        <span class="inline-flex items-center gap-1 text-[10px] font-extrabold px-2 py-0.5 rounded-md bg-amber-50 text-amber-800 border border-amber-200/80 dark:bg-amber-500/15 dark:text-amber-300 dark:border-amber-500/30 shrink-0">
                          <span class="text-amber-500">★</span> Editor's Pick
                        </span>
                      )}
                    </div>
                    <div class="flex items-center gap-1.5 shrink-0">
                      <span class={`text-[10px] px-2 py-0.5 rounded-md border shrink-0 ${expiryBadge.class}`}>
                        {expiryBadge.text}
                      </span>
                      <button
                        type="button"
                        class="deal-share-btn w-7 h-7 rounded-lg border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 dark:hover:bg-indigo-950/40 dark:hover:text-indigo-400 transition cursor-pointer"
                        data-share-title={deal.title}
                        data-share-desc={deal.description}
                        data-share-url={`https://promoradar.store/stores/${deal.storeSlug}/`}
                        title="Share Discount"
                        aria-label="Share Discount"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
                        </svg>
                      </button>
                    </div>
                  </div>

                  <h3 class="text-base font-extrabold text-slate-900 dark:text-white mb-1.5 leading-snug">
                    {deal.title}
                  </h3>
                  <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
                    {deal.description}
                  </p>
                </div>

                <div class="space-y-2.5 pt-3.5 border-t border-slate-100 dark:border-slate-800/80">
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs text-slate-500 dark:text-slate-400">
                      <span class="inline-flex items-center gap-1 text-emerald-600 dark:text-emerald-400 font-semibold">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                        Verified Live
                      </span>
                      <span>•</span>
                      <span>Success: <strong class="text-slate-800 dark:text-slate-200">{deal.successRate || '99%'}</strong></span>
                      {deal.terms && (
                        <>
                          <span>•</span>
                          <button type="button" class="deal-terms-toggle text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 underline underline-offset-2 font-medium cursor-pointer">
                            Terms ▾
                          </button>
                        </>
                      )}
                    </div>

                    {isCode ? (
                      <button
                        type="button"
                        class="code-peel text-white rounded-xl px-4 py-2.5 text-xs font-bold flex items-center justify-center gap-2 shrink-0 shadow-sm cursor-pointer"
                        data-reveal-deal={JSON.stringify({
                          id: deal.id,
                          title: deal.title,
                          desc: deal.description,
                          code: deal.code,
                          storeName: deal.storeName,
                          storeSlug: deal.storeSlug,
                          badge: deal.discountBadge || deal.badge,
                          affiliateUrl: deal.affiliateUrl,
                          successRate: deal.successRate || '99%'
                        })}
                      >
                        <span>Get Code</span>
                        <span class="font-mono text-[11px] bg-black/25 px-2 py-0.5 rounded border border-white/20">
                          •••{deal.code.slice(-3)}
                        </span>
                      </button>
                    ) : (
                      <button
                        type="button"
                        class="px-4 py-2 rounded-xl bg-slate-900 hover:bg-indigo-600 dark:bg-indigo-600 dark:hover:bg-indigo-500 text-white font-bold text-xs flex items-center justify-center gap-1.5 transition shadow-sm cursor-pointer"
                        data-reveal-deal={JSON.stringify({
                          id: deal.id,
                          title: deal.title,
                          desc: deal.description,
                          code: deal.code || '',
                          storeName: deal.storeName,
                          storeSlug: deal.storeSlug,
                          badge: deal.discountBadge || deal.badge,
                          affiliateUrl: deal.affiliateUrl,
                          successRate: deal.successRate || '99%'
                        })}
                      >
                        <span>Reveal &amp; Activate ↗</span>
                      </button>
                    )}
                  </div>

                  {/* Expandable Terms Drawer */}
                  {deal.terms && (
                    <div class="deal-terms-drawer hidden text-[11px] text-slate-600 dark:text-slate-300 bg-slate-50 dark:bg-slate-800/60 p-3 rounded-xl border border-slate-200/70 dark:border-slate-700/60 space-y-1">
                      <div class="font-bold text-slate-800 dark:text-slate-200 flex items-center justify-between">
                        <span>Terms &amp; Restrictions:</span>
                        <span class="text-[10px] text-slate-400 font-mono">Expires {deal.expiryDate}</span>
                      </div>
                      <p class="leading-relaxed">{deal.terms}</p>
                    </div>
                  )}
                </div>
              </article>
            );
          })}

          <!-- Empty State for Category Filters -->
          <div id="catFiltersEmptyState" class="hidden col-span-full p-8 text-center bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 space-y-3">
            <div class="text-3xl">🔍</div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">No vouchers match the selected filter</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 max-w-sm mx-auto">
              Try switching back to all offers or select another brand in this category.
            </p>
            <button
              type="button"
              id="resetCatFilterBtn"
              class="px-4 py-2 rounded-xl bg-indigo-600 text-white font-bold text-xs hover:bg-indigo-500 transition cursor-pointer"
            >
              Reset Filters
            </button>
          </div>
        </div>
      </div>

    </div>
  </main>

  <script is:inline>
    // Terms Drawers Toggle
    document.querySelectorAll('.deal-terms-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const card = btn.closest('article');
        const drawer = card?.querySelector('.deal-terms-drawer');
        drawer?.classList.toggle('hidden');
      });
    });

    // Faceted Filtering & Sorting Engine for Category Deals
    let currentCatFilter = 'all';
    let currentCatStore = 'all';
    let currentCatSort = 'recommended';
    const catCards = Array.from(document.querySelectorAll('.cat-deal-card'));
    const catGrid = document.getElementById('catCouponsGrid');
    const catCountEl = document.getElementById('catFilteredCount');
    const catEmptyEl = document.getElementById('catFiltersEmptyState');

    function applyCatFilters() {
      let visibleCount = 0;

      catCards.forEach(card => {
        const dealType = card.getAttribute('data-deal-type') || 'deal';
        const storeSlug = card.getAttribute('data-store-slug') || '';
        const matchType = currentCatFilter === 'all' || dealType === currentCatFilter;
        const matchStore = currentCatStore === 'all' || storeSlug === currentCatStore;

        if (matchType && matchStore) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      // Sort cards
      if (catGrid && visibleCount > 0) {
        const sorted = [...catCards].sort((a, b) => {
          if (currentCatSort === 'discount') {
            const valA = parseFloat(a.getAttribute('data-discount-val') || '0');
            const valB = parseFloat(b.getAttribute('data-discount-val') || '0');
            return valB - valA;
          } else if (currentCatSort === 'expiry') {
            const expA = parseFloat(a.getAttribute('data-expiry-ts') || '0');
            const expB = parseFloat(b.getAttribute('data-expiry-ts') || '0');
            return expA - expB;
          } else {
            const orderA = parseInt(a.getAttribute('data-default-order') || '0', 10);
            const orderB = parseInt(b.getAttribute('data-default-order') || '0', 10);
            return orderA - orderB;
          }
        });
        sorted.forEach(card => catGrid.appendChild(card));
        if (catEmptyEl) catGrid.appendChild(catEmptyEl);
      }

      if (catCountEl) catCountEl.textContent = `${visibleCount} Verified`;
      if (catEmptyEl) {
        if (visibleCount === 0) catEmptyEl.classList.remove('hidden');
        else catEmptyEl.classList.add('hidden');
      }
    }

    document.querySelectorAll('.cat-facet-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        currentCatFilter = tab.getAttribute('data-filter') || 'all';
        document.querySelectorAll('.cat-facet-tab').forEach(t => {
          const isActive = t === tab;
          t.classList.toggle('active', isActive);
          t.classList.toggle('bg-white', isActive);
          t.classList.toggle('dark:bg-slate-900', isActive);
          t.classList.toggle('text-slate-900', isActive);
          t.classList.toggle('dark:text-white', isActive);
          t.classList.toggle('shadow-xs', isActive);
          t.classList.toggle('text-slate-600', !isActive);
          t.classList.toggle('dark:text-slate-400', !isActive);
        });
        applyCatFilters();
      });
    });

    document.getElementById('catStoreSelect')?.addEventListener('change', (e) => {
      currentCatStore = e.target.value;
      applyCatFilters();
    });

    document.getElementById('catSortSelect')?.addEventListener('change', (e) => {
      currentCatSort = e.target.value;
      applyCatFilters();
    });

    document.getElementById('resetCatFilterBtn')?.addEventListener('click', () => {
      const allTab = document.querySelector('.cat-facet-tab[data-filter="all"]');
      if (allTab) allTab.click();
      const storeSelect = document.getElementById('catStoreSelect');
      if (storeSelect) {
        storeSelect.value = 'all';
        currentCatStore = 'all';
      }
      applyCatFilters();
    });
  </script>

  <Footer />
</BaseLayout>
