---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { COUPONS_DATA, STORES_DATA } from '../../data/couponsData';

export const prerender = true;

export async function getStaticPaths() {
  const CATEGORIES_DEF = [
    {
      slug: 'privacy-security',
      name: 'Privacy, VPN & Cybersecurity',
      categoryName: 'Privacy & Security',
      icon: '🛡',
      desc: 'Military-grade VPNs, encrypted zero-knowledge password vaults, family screen time parental controls, and virtual phone numbers for instant SMS activation.',
      maxDiscount: 'Up to 81% OFF'
    },
    {
      slug: 'dating-lifestyle',
      name: 'Dating & Lifestyle Services',
      categoryName: 'Dating & Lifestyle',
      icon: '💬',
      desc: 'Camera-verified dating platforms with priority compatibility scoring, anonymous stealth matching passes, and zero bot guarantees.',
      maxDiscount: '100% Free VIP'
    },
    {
      slug: 'fashion-apparel',
      name: 'Fashion & Apparel',
      categoryName: 'Fashion & Apparel',
      icon: '👗',
      desc: 'Worldwide on-trend women\'s fashion, seasonal dresses, swimwear, and footwear with stackable voucher discounts.',
      maxDiscount: '12% OFF Code'
    },
    {
      slug: 'eyewear-health',
      name: 'Eyewear & Optical Health',
      categoryName: 'Eyewear & Health',
      icon: '👓',
      desc: 'Factory-direct prescription optical frames, anti-blue-light lenses, bifocals, and polarized sunglasses without retail markup.',
      maxDiscount: '$8 OFF Voucher'
    },
    {
      slug: 'travel-tours',
      name: 'Travel, Desert Safaris & Tours',
      categoryName: 'Travel & Tours',
      icon: '✈️',
      desc: 'UAE desert safaris, Dubai Marina luxury dhow dinner cruises, Burj Khalifa observation deck admissions, and global sightseeing excursions.',
      maxDiscount: '20% OFF Booking'
    },
    {
      slug: 'ecommerce-wholesale',
      name: 'E-Commerce & Department Stores',
      categoryName: 'E-Commerce & Wholesale',
      icon: '📦',
      desc: 'Global B2B wholesale platforms, luxury department stores, and Trade Assurance factory-direct sourcing with voucher discounts.',
      maxDiscount: 'Up to 75% OFF'
    },
    {
      slug: 'electronics-gadgets',
      name: 'Electronics, Solar & Hardware',
      categoryName: 'Electronics & Gadgets',
      icon: '⚡',
      desc: 'Portable power stations, solar panels, and smart gadgets with verified merchant coupons.',
      maxDiscount: 'Up to $800 OFF'
    },
    {
      slug: 'education-learning',
      name: 'Online Education & Coding',
      categoryName: 'Education & Learning',
      icon: '🎓',
      desc: 'Interactive coding academies, English lessons, and digital skills courses for kids and adults.',
      maxDiscount: 'Up to 30% OFF'
    },
    {
      slug: 'beauty-fragrances',
      name: 'Beauty, Fragrances & Oud',
      categoryName: 'Beauty & Fragrances',
      icon: '✨',
      desc: 'Authentic French and oriental perfumes, niche fragrances, oud oils, and luxury cosmetics.',
      maxDiscount: 'Free Express Shipping'
    }
  ];

  return CATEGORIES_DEF.map(cat => {
    const deals = COUPONS_DATA.filter(d => d.storeCategory === cat.categoryName);
    const stores = STORES_DATA.filter(s => s.category === cat.categoryName);
    return {
      params: { category: cat.slug },
      props: { cat, deals, stores }
    };
  });
}

const { cat, deals, stores } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const breadcrumbs = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://promoradar.store/" },
      { "@type": "ListItem", "position": 2, "name": "Categories", "item": "https://promoradar.store/categories/" },
      { "@type": "ListItem", "position": 3, "name": cat.name, "item": `https://promoradar.store/categories/${cat.slug}/` }
    ]
  }
];
---

<BaseLayout
  title={`${cat.name} Promo Codes & Vouchers (October 2026) — PromoRadar`}
  description={`Active and verified ${cat.name} promo codes, discount coupons, and checkout vouchers. Save ${cat.maxDiscount} with direct merchant partner feeds.`}
  activePath={`/categories/${cat.slug}/`}
  schemas={breadcrumbs}
>
  <Header activePath="/categories" />

  <main class="flex-1">
    <!-- Header -->
    <div class="bg-gradient-to-b from-indigo-950 via-slate-900 to-slate-900 text-white py-12 px-4 sm:px-6 lg:px-8 border-b border-slate-800">
      <div class="max-w-5xl mx-auto text-center space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/20 border border-indigo-400/30 text-indigo-300 text-xs font-semibold">
          <span class="text-base">{cat.icon}</span>
          <span>Verified Category Collection</span>
          <span>•</span>
          <span class="text-emerald-400">{deals.length} Active Deals</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">
          {cat.name} Promo Codes
        </h1>
        <p class="text-slate-300 text-xs sm:text-sm max-w-2xl mx-auto leading-relaxed">
          {cat.desc}
        </p>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 space-y-10">
      
      <!-- Participating Stores Row -->
      {stores.length > 0 && (
        <div class="bg-white rounded-2xl p-6 border border-slate-200/90 shadow-sm space-y-3">
          <div class="text-xs font-bold uppercase tracking-wider text-slate-500">
            Featured Brands in this Category
          </div>
          <div class="flex flex-wrap gap-2">
            {stores.map(store => (
              <a
                href={`${base}/stores/${store.slug}/`}
                class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-800 font-bold text-xs transition border border-transparent hover:border-indigo-200"
              >
                <span>{store.name}</span>
                <span class="text-[10px] text-slate-400 font-normal">→</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Deals List Grid -->
      <div class="space-y-4">
        <h2 class="text-xl font-extrabold text-slate-900 flex items-center justify-between">
          <span>Active Coupons &amp; Verified Offers</span>
          <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-indigo-50 text-indigo-700">
            {deals.length} Verified
          </span>
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {deals.map(deal => (
            <article class="bg-white rounded-2xl border border-slate-200/90 p-5 card-hover shadow-sm flex flex-col justify-between">
              <div>
                <div class="flex items-start justify-between gap-3 mb-3">
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-extrabold px-2.5 py-1 rounded-xl bg-rose-50 text-rose-600 border border-rose-200/80">
                      {deal.discountBadge || deal.badge}
                    </span>
                    <a
                      href={`${base}/stores/${deal.storeSlug}/`}
                      class="text-xs font-bold text-slate-800 hover:text-indigo-600 transition"
                    >
                      {deal.storeName}
                    </a>
                  </div>
                  <span class="text-[11px] text-slate-400 font-medium">
                    Expires: {deal.expiryDate}
                  </span>
                </div>

                <h3 class="text-base font-extrabold text-slate-900 mb-1.5 leading-snug">
                  {deal.title}
                </h3>
                <p class="text-xs text-slate-600 leading-relaxed mb-4">
                  {deal.description}
                </p>
              </div>

              <div class="pt-3.5 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex items-center gap-2 text-xs text-slate-500">
                  <span class="inline-flex items-center gap-1 text-emerald-600 font-semibold">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    Verified Live
                  </span>
                  <span>•</span>
                  <span>Success: <strong class="text-slate-800">{deal.successRate || '99%'}</strong></span>
                </div>

                <a
                  href={deal.affiliateUrl}
                  target="_blank"
                  rel="nofollow sponsored"
                  class="px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs flex items-center justify-center gap-1.5 transition shadow-sm"
                >
                  <span>Reveal &amp; Activate ↗</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer />
</BaseLayout>
