---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { COUPONS_DATA, STORES_DATA } from '../../data/couponsData';
import { getDealLivePulse } from '../../data/pulseEngine';
import BrandLogo from '../../components/BrandLogo.astro';

export const prerender = true;

export async function getStaticPaths() {
  const CATEGORIES_DEF = [
    {
      slug: 'privacy-security',
      name: 'Privacy, VPN & Cybersecurity',
      categoryName: 'Privacy & Security',
      icon: '🛡',
      desc: 'Military-grade VPNs, encrypted zero-knowledge password vaults, family screen time parental controls, and virtual phone numbers for instant SMS activation.',
      maxDiscount: 'Up to 81% OFF'
    },
    {
      slug: 'dating-lifestyle',
      name: 'Dating & Lifestyle Services',
      categoryName: 'Dating & Lifestyle',
      icon: '💬',
      desc: 'Camera-verified dating platforms with priority compatibility scoring, anonymous stealth matching passes, and zero bot guarantees.',
      maxDiscount: '100% Free VIP'
    },
    {
      slug: 'fashion-apparel',
      name: 'Fashion & Apparel',
      categoryName: 'Fashion & Apparel',
      icon: '👗',
      desc: 'Worldwide on-trend women\'s fashion, seasonal dresses, swimwear, and footwear with stackable voucher discounts.',
      maxDiscount: '12% OFF Code'
    },
    {
      slug: 'eyewear-health',
      name: 'Eyewear & Optical Health',
      categoryName: 'Eyewear & Health',
      icon: '👓',
      desc: 'Factory-direct prescription optical frames, anti-blue-light lenses, bifocals, and polarized sunglasses without retail markup.',
      maxDiscount: '$8 OFF Voucher'
    },
    {
      slug: 'travel-tours',
      name: 'Travel, Desert Safaris & Tours',
      categoryName: 'Travel & Tours',
      icon: '✈️',
      desc: 'UAE desert safaris, Dubai Marina luxury dhow dinner cruises, Burj Khalifa observation deck admissions, and global sightseeing excursions.',
      maxDiscount: '20% OFF Booking'
    },
    {
      slug: 'ecommerce-wholesale',
      name: 'E-Commerce & Department Stores',
      categoryName: 'E-Commerce & Wholesale',
      icon: '📦',
      desc: 'Global B2B wholesale platforms, luxury department stores, and Trade Assurance factory-direct sourcing with voucher discounts.',
      maxDiscount: 'Up to 75% OFF'
    },
    {
      slug: 'electronics-gadgets',
      name: 'Electronics, Solar & Hardware',
      categoryName: 'Electronics & Gadgets',
      icon: '⚡',
      desc: 'Portable power stations, solar panels, and smart gadgets with verified merchant coupons.',
      maxDiscount: 'Up to $800 OFF'
    },
    {
      slug: 'education-learning',
      name: 'Online Education & Coding',
      categoryName: 'Education & Learning',
      icon: '🎓',
      desc: 'Interactive coding academies, English lessons, and digital skills courses for kids and adults.',
      maxDiscount: 'Up to 30% OFF'
    },
    {
      slug: 'beauty-fragrances',
      name: 'Beauty, Fragrances & Oud',
      categoryName: 'Beauty & Fragrances',
      icon: '✨',
      desc: 'Authentic French and oriental perfumes, niche fragrances, oud oils, and luxury cosmetics.',
      maxDiscount: 'Free Express Shipping'
    },
    {
      slug: 'insurance-finance',
      name: 'Insurance & Financial Services',
      categoryName: 'Insurance & Finance',
      icon: '💼',
      desc: 'Online auto MTPL, international Green Card travel policies, medical insurance, and digital micro-loans comparison with instant electronic delivery.',
      maxDiscount: 'Up to 15% OFF'
    },
    {
      slug: 'web-hosting-domains',
      name: 'Web Hosting, Servers & Cloud',
      categoryName: 'Web Hosting & Domains',
      icon: '🌐',
      desc: 'High-performance NVMe cloud hosting, free custom domains, 1-click WordPress stacks, and SSL certificates with money-back guarantees.',
      maxDiscount: 'Up to 75% OFF'
    }
  ];

  return CATEGORIES_DEF.map(cat => {
    const deals = COUPONS_DATA.filter(d => d.storeCategory === cat.categoryName);
    const stores = STORES_DATA.filter(s => s.category === cat.categoryName);
    return {
      params: { category: cat.slug },
      props: { cat, deals, stores }
    };
  });
}

const { cat, deals, stores } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const STORES_MAP = Object.fromEntries(STORES_DATA.map(s => [s.slug, s]));
const codesCount = deals.filter(d => d.code && d.code.trim().length > 0).length;
const directDealsCount = deals.filter(d => !d.code || d.code.trim().length === 0).length;

function parseDiscountValue(badge: string): number {
  if (!badge) return 0;
  const match = badge.match(/(\d+)/);
  if (match) return parseInt(match[1], 10);
  if (badge.toUpperCase().includes('FREE') || badge.toUpperCase().includes('VIP')) return 99;
  return 10;
}

// Helper to calculate genuine remaining validity & urgency
function getExpiryBadge(expiryDateStr: string) {
  if (!expiryDateStr) return { text: '⚡ Verified Oct 2026', class: 'bg-emerald-50 text-emerald-700 border-emerald-200/80 dark:bg-emerald-500/15 dark:text-emerald-300 dark:border-emerald-500/30' };
  const expiry = new Date(expiryDateStr);
  const now = new Date('2026-10-19');
  const diffDays = Math.ceil((expiry.getTime() - now.getTime()) / (1000 * 60 * 60 * 24));
  if (diffDays <= 7 && diffDays > 0) {
    return { text: `⏳ Ends in ${diffDays}d`, class: 'bg-rose-50 text-rose-700 border-rose-200/80 dark:bg-rose-500/15 dark:text-rose-300 dark:border-rose-500/30 font-bold' };
  } else if (diffDays <= 45 && diffDays > 0) {
    return { text: `⏳ Ends in ${diffDays}d`, class: 'bg-amber-50 text-amber-800 border-amber-200/80 dark:bg-amber-500/15 dark:text-amber-300 dark:border-amber-500/30 font-bold' };
  } else {
    return { text: '⚡ Verified for Oct 2026', class: 'bg-slate-100 text-slate-600 border-slate-200/80 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700/60' };
  }
}

const breadcrumbs = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://promoradar.store/" },
      { "@type": "ListItem", "position": 2, "name": "Categories", "item": "https://promoradar.store/categories/" },
      { "@type": "ListItem", "position": 3, "name": cat.name, "item": `https://promoradar.store/categories/${cat.slug}/` }
    ]
  }
];
---

<BaseLayout
  title={`${cat.name} Promo Codes & Vouchers (October 2026) — PromoRadar`}
  description={`Active and verified ${cat.name} promo codes, discount coupons, and checkout vouchers. Save ${cat.maxDiscount} with direct merchant partner feeds.`}
  activePath={`/categories/${cat.slug}/`}
  schemas={breadcrumbs}
>
  <Header activePath="/categories" />

  <main class="flex-1">
    <!-- Header -->
    <div class="bg-gradient-to-b from-indigo-950 via-slate-900 to-slate-900 text-white py-12 px-4 sm:px-6 lg:px-8 border-b border-slate-800">
      <div class="max-w-5xl mx-auto text-center space-y-4">
        <div class="flex flex-wrap items-center justify-center gap-2">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/20 border border-indigo-400/30 text-indigo-300 text-xs font-semibold">
            <span class="text-base">{cat.icon}</span>
            <span>Verified Category Collection</span>
            <span>•</span>
            <span class="text-emerald-400">{deals.length} Active Deals</span>
          </div>
          <button
            type="button"
            data-open-verification-guarantee
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-400/15 hover:bg-amber-400/25 border border-amber-400/30 text-amber-300 text-xs font-bold transition cursor-pointer group"
            title="Inspect 3-Tier Code Accuracy Guarantee"
          >
            <span class="text-amber-400 group-hover:scale-110 transition-transform">🛡️</span>
            <span>Editorial QA Guarantee</span>
            <span class="text-[10px] bg-amber-400/20 px-1 rounded font-bold">ℹ️</span>
          </button>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">
          {cat.name} Promo Codes
        </h1>
        <p class="text-slate-300 text-xs sm:text-sm max-w-2xl mx-auto leading-relaxed">
          {cat.desc}
        </p>
      </div>
    </div>

    <!-- Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 space-y-10">
      
      <!-- Participating Stores Row -->
      {stores.length > 0 && (
        <div class="bg-white dark:bg-slate-900/90 rounded-2xl p-6 border border-slate-200/90 dark:border-slate-800 shadow-sm space-y-3">
          <div class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            Featured Brands in this Category
          </div>
          <div class="flex flex-wrap gap-2">
            {stores.map(store => (
              <a
                href={`${base}/stores/${store.slug}/`}
                class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 dark:bg-slate-800/80 dark:hover:bg-slate-800 dark:text-slate-200 dark:hover:text-indigo-400 text-slate-800 font-bold text-xs transition border border-transparent hover:border-indigo-200 dark:hover:border-indigo-500/40"
              >
                <span>{store.name}</span>
                <span class="text-[10px] text-slate-400 font-normal">→</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Interactive Category Savings Calculator (Honey / Capital One Shopping benchmark) -->
      <section class="bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 text-white rounded-3xl p-6 sm:p-8 border border-indigo-500/30 shadow-xl relative overflow-hidden mb-8">
        <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6">
          <div>
            <div class="flex items-center gap-2 mb-1.5">
              <span class="text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-400/30">
                Smart Value Benchmark
              </span>
              <span class="text-xs text-indigo-200/60">•</span>
              <span class="text-xs font-semibold text-indigo-200/80">
                Live Cart Calculator
              </span>
            </div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-white">
              {cat.name} Savings Calculator
            </h2>
            <p class="text-xs text-slate-300 mt-1 max-w-xl">
              Enter your estimated order spend to instantly discover which verified {cat.categoryName} brand slashes the highest dollar amount at checkout.
            </p>
          </div>

          <!-- Controls: Input + Presets -->
          <div class="bg-slate-800/80 border border-slate-700/80 rounded-2xl p-3 sm:p-4 space-y-2 shrink-0 w-full lg:w-80">
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-bold text-slate-300 uppercase tracking-wider">Cart Spend ($)</span>
              <div class="flex items-center gap-1">
                <button type="button" class="cat-calc-preset px-2 py-0.5 rounded text-[10px] font-bold bg-slate-700 hover:bg-slate-600 text-indigo-300 transition cursor-pointer" data-val="50">$50</button>
                <button type="button" class="cat-calc-preset px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-600 text-white transition cursor-pointer" data-val="100">$100</button>
                <button type="button" class="cat-calc-preset px-2 py-0.5 rounded text-[10px] font-bold bg-slate-700 hover:bg-slate-600 text-indigo-300 transition cursor-pointer" data-val="250">$250</button>
                <button type="button" class="cat-calc-preset px-2 py-0.5 rounded text-[10px] font-bold bg-slate-700 hover:bg-slate-600 text-indigo-300 transition cursor-pointer" data-val="500">$500</button>
              </div>
            </div>
            <div class="relative">
              <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 font-bold">$</span>
              <input
                type="number"
                id="catCalcInput"
                min="1"
                step="1"
                value="100"
                placeholder="100"
                class="w-full bg-slate-900/90 border border-slate-700 rounded-xl pl-8 pr-4 py-2 text-sm font-bold text-white placeholder-slate-500 focus:outline-none focus:border-indigo-400 transition"
              />
            </div>
          </div>
        </div>

        <!-- Dynamic Results Panel -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 pt-4 border-t border-slate-800">
          <!-- Winner Card (7 cols) -->
          <div class="lg:col-span-7 bg-slate-800/70 rounded-2xl p-5 border border-indigo-500/30 flex flex-col justify-between space-y-4">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="inline-flex items-center gap-1.5 text-[11px] font-black uppercase tracking-wider px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                  <span class="text-amber-400">★</span> Highest Savings Winner
                </span>
                <span id="catCalcWinnerRate" class="text-xs font-black px-2 py-0.5 rounded bg-rose-500/20 text-rose-300 border border-rose-500/30 font-mono">
                  49% OFF
                </span>
              </div>
              <h3 id="catCalcWinnerBrand" class="text-base sm:text-lg font-black text-white">
                Brand Name
              </h3>
              <p id="catCalcWinnerDeal" class="text-xs text-slate-300 mt-0.5">
                Deal title description...
              </p>
            </div>

            <div class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-4 pt-3 border-t border-slate-700/60">
              <div>
                <span class="text-[11px] text-slate-400 block">Calculated Savings</span>
                <div class="flex items-baseline gap-2">
                  <span id="catCalcWinnerSavings" class="text-xl sm:text-2xl font-black text-emerald-400">-$49.00</span>
                  <span id="catCalcWinnerTotal" class="text-xs text-slate-300">($51.00 Total)</span>
                </div>
              </div>

              <div class="flex items-center gap-2 shrink-0">
                <div id="catCalcWinnerCodeBox" class="font-mono text-xs font-extrabold px-3 py-2 rounded-xl bg-slate-900 border border-indigo-400/40 text-amber-300">
                  CODE
                </div>
                <button
                  type="button"
                  id="catCalcApplyBtn"
                  class="px-4 py-2 rounded-xl bg-gradient-to-r from-indigo-500 to-indigo-600 hover:from-indigo-400 hover:to-indigo-500 text-white font-extrabold text-xs transition shadow-md flex items-center gap-1 cursor-pointer active:scale-95"
                >
                  <span>Redeem ↗</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Alternatives Runner-Ups (5 cols) -->
          <div class="lg:col-span-5 bg-slate-800/40 rounded-2xl p-5 border border-slate-700/60 flex flex-col justify-between">
            <div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-3">
                Other Verified {cat.categoryName} Options
              </span>
              <div id="catCalcRunnersList" class="space-y-2.5">
                <!-- Populated dynamically via JS -->
              </div>
            </div>
            <p class="text-[10px] text-slate-500 mt-3 pt-2 border-t border-slate-800">
              *Calculated based on verified October 2026 merchant discount terms.
            </p>
          </div>
        </div>
      </section>

      <!-- Deals List Grid -->
      <div class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-2">
          <div>
            <h2 class="text-xl font-extrabold text-slate-900 dark:text-white flex items-center gap-2">
              <span>Active Coupons &amp; Verified Offers</span>
              <span id="catFilteredCount" class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200 dark:bg-indigo-500/15 dark:text-indigo-300 dark:border-indigo-500/30">
                {deals.length} Verified
              </span>
            </h2>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
              Filtered and hand-tested partner network vouchers
            </p>
          </div>

          <!-- Faceted Filter & Sort Controls for Category -->
          <div class="flex flex-wrap items-center gap-2">
            <!-- Type Tabs -->
            <div class="inline-flex p-1 bg-slate-100 dark:bg-slate-800 rounded-xl border border-slate-200/80 dark:border-slate-700/80 text-xs font-bold" role="tablist">
              <button
                type="button"
                class="cat-facet-tab active px-3 py-1 rounded-lg bg-white dark:bg-slate-900 text-slate-900 dark:text-white shadow-xs transition cursor-pointer"
                data-filter="all"
              >
                All ({deals.length})
              </button>
              <button
                type="button"
                class="cat-facet-tab px-3 py-1 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition cursor-pointer"
                data-filter="code"
              >
                Codes ({codesCount})
              </button>
              <button
                type="button"
                class="cat-facet-tab px-3 py-1 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition cursor-pointer"
                data-filter="deal"
              >
                Deals ({directDealsCount})
              </button>
            </div>

            <!-- Store Selector within Category -->
            <div class="relative">
              <select
                id="catStoreSelect"
                aria-label="Filter by Store"
                class="appearance-none bg-slate-100 hover:bg-slate-200/60 dark:bg-slate-800 dark:hover:bg-slate-700/80 text-slate-800 dark:text-slate-200 text-xs font-bold pl-3 pr-7 py-1.5 rounded-xl border border-slate-200/80 dark:border-slate-700/80 cursor-pointer outline-none focus:ring-2 focus:ring-indigo-500/20"
              >
                <option value="all">All Brands ({stores.length})</option>
                {stores.map(s => (
                  <option value={s.slug}>{s.name}</option>
                ))}
              </select>
              <svg class="w-3.5 h-3.5 text-slate-400 absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </div>

            <!-- Sort Dropdown Selector -->
            <div class="relative">
              <select
                id="catSortSelect"
                aria-label="Sort Deals"
                class="appearance-none bg-slate-100 hover:bg-slate-200/60 dark:bg-slate-800 dark:hover:bg-slate-700/80 text-slate-800 dark:text-slate-200 text-xs font-bold pl-3 pr-7 py-1.5 rounded-xl border border-slate-200/80 dark:border-slate-700/80 cursor-pointer outline-none focus:ring-2 focus:ring-indigo-500/20"
              >
                <option value="recommended">Sort: Best Match</option>
                <option value="discount">Sort: Highest Discount</option>
                <option value="expiry">Sort: Ending Soon</option>
              </select>
              <svg class="w-3.5 h-3.5 text-slate-400 absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </div>
          </div>
        </div>

        <div id="catCouponsGrid" class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {deals.map((deal, idx) => {
            const isCode = deal.code && deal.code.trim().length > 0;
            const isTopDeal = idx === 0;
            const expiryBadge = getExpiryBadge(deal.expiryDate);
            const discountNum = parseDiscountValue(deal.discountBadge || deal.badge);
            const expiryTs = deal.expiryDate ? new Date(deal.expiryDate).getTime() : 4102444800000;
            const pulse = getDealLivePulse(deal.id, deal.storeSlug, deal.successRate);

            return (
              <article
                class={`cat-deal-card bg-white dark:bg-slate-900/90 rounded-2xl border border-slate-200/90 dark:border-slate-800 p-5 card-hover shadow-sm flex flex-col justify-between dark:shadow-[inset_0_1px_0_0_rgba(255,255,255,0.06)] ${isTopDeal ? 'ring-1 ring-amber-400/30' : ''}`}
                data-deal-type={isCode ? 'code' : 'deal'}
                data-store-slug={deal.storeSlug}
                data-discount-val={discountNum}
                data-expiry-ts={expiryTs}
                data-default-order={idx}
              >
                <div>
                  <div class="flex items-start justify-between gap-3 mb-3.5">
                    <div class="flex items-center gap-3 min-w-0">
                      <a
                        href={`${base}/stores/${deal.storeSlug}/`}
                        class="shrink-0 hover:scale-105 transition"
                        title={deal.storeName}
                      >
                        {STORES_MAP[deal.storeSlug] ? (
                          <BrandLogo store={STORES_MAP[deal.storeSlug]} size="md" />
                        ) : (
                          <div class="brand-logo-container w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-white border border-slate-200 p-1.5 sm:p-2 flex items-center justify-center shadow-xs shrink-0">
                            <span class="w-full h-full rounded-xl bg-indigo-600 text-white font-extrabold text-xs flex items-center justify-center">{(deal.storeName || 'PR').slice(0, 2).toUpperCase()}</span>
                          </div>
                        )}
                      </a>
                      <div class="min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                          <span class="text-xs font-extrabold px-2.5 py-1 rounded-xl bg-rose-50 text-rose-600 border border-rose-200/80 dark:bg-rose-500/15 dark:text-rose-300 dark:border-rose-500/30">
                            {deal.discountBadge || deal.badge}
                          </span>
                          <a
                            href={`${base}/stores/${deal.storeSlug}/`}
                            class="text-sm font-extrabold text-slate-900 dark:text-white hover:text-indigo-600 dark:hover:text-indigo-400 transition truncate"
                          >
                            {deal.storeName}
                          </a>
                          <span class={`text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md ${
                            isCode ? 'bg-indigo-50 text-indigo-700 border border-indigo-200 dark:bg-indigo-500/15 dark:text-indigo-300 dark:border-indigo-500/30' : 'bg-emerald-50 text-emerald-700 border border-emerald-200 dark:bg-emerald-500/15 dark:text-emerald-300 dark:border-emerald-500/30'
                          }`}>
                            {isCode ? 'PROMO CODE' : 'DIRECT DEAL'}
                          </span>
                          {isTopDeal && (
                            <span class="inline-flex items-center gap-1 text-[10px] font-extrabold px-2 py-0.5 rounded-md bg-amber-50 text-amber-800 border border-amber-200/80 dark:bg-amber-500/15 dark:text-amber-300 dark:border-amber-500/30 shrink-0">
                              <span class="text-amber-500">★</span> Editor's Pick
                            </span>
                          )}
                        </div>
                      </div>
                    </div>
                    <div class="flex items-center gap-1.5 shrink-0">
                      <span class={`text-[10px] px-2 py-0.5 rounded-md border shrink-0 ${expiryBadge.class}`}>
                        {expiryBadge.text}
                      </span>
                      <button
                        type="button"
                        class="deal-share-btn w-7 h-7 rounded-lg border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 dark:hover:bg-indigo-950/40 dark:hover:text-indigo-400 transition cursor-pointer"
                        data-share-title={deal.title}
                        data-share-desc={deal.description}
                        data-share-url={`https://promoradar.store/stores/${deal.storeSlug}/`}
                        title="Share Discount"
                        aria-label="Share Discount"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
                        </svg>
                      </button>
                      <button
                        type="button"
                        data-open-verification-guarantee
                        data-store-name={deal.storeName}
                        data-store-slug={deal.storeSlug}
                        data-deal-title={deal.title}
                        data-deal-code={deal.code}
                        class="w-7 h-7 rounded-lg border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-400 hover:text-amber-600 hover:bg-amber-50 dark:hover:bg-amber-950/40 dark:hover:text-amber-400 transition cursor-pointer"
                        title="Report invalid code or inspect QA proof"
                        aria-label="Report invalid code"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                        </svg>
                      </button>
                      <button
                        type="button"
                        class="deal-qr-btn w-7 h-7 rounded-lg border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 dark:hover:bg-indigo-950/40 dark:hover:text-indigo-400 transition cursor-pointer"
                        data-qr-store={deal.storeName}
                        data-qr-slug={deal.storeSlug}
                        data-qr-title={deal.title}
                        data-qr-code={deal.code}
                        data-qr-url={deal.affiliateUrl}
                        data-qr-badge={deal.discountBadge}
                        title="Scan with phone / In-Store QR Pass"
                        aria-label="Scan with phone"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                        </svg>
                      </button>
                    </div>
                  </div>

                  <h3 class="text-base font-extrabold text-slate-900 dark:text-white mb-1.5 leading-snug">
                    {deal.title}
                  </h3>
                  <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
                    {deal.description}
                  </p>
                </div>

                <div class="space-y-2.5 pt-3.5 border-t border-slate-100 dark:border-slate-800/80">
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs text-slate-500 dark:text-slate-400">
                      <button
                        type="button"
                        data-open-pulse-modal
                        data-pulse-store={deal.storeName}
                        data-pulse-title={deal.title}
                        data-pulse-code={deal.code}
                        data-pulse-badge={deal.discountBadge}
                        data-pulse-time={pulse.timeText}
                        data-pulse-stability={pulse.stabilityBadge}
                        data-pulse-url={deal.affiliateUrl}
                        class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-200/70 dark:border-emerald-500/30 text-[10px] font-bold hover:bg-emerald-100 dark:hover:bg-emerald-900/50 transition cursor-pointer"
                        title="Inspect Live Health Pulse & Cart Simulation"
                      >
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span>Pulse: {pulse.timeText}</span>
                      </button>
                      <span>•</span>
                      <button
                        type="button"
                        data-open-verification-guarantee
                        data-store-name={deal.storeName}
                        data-store-slug={deal.storeSlug}
                        data-deal-title={deal.title}
                        data-deal-code={deal.code}
                        class="font-bold text-slate-700 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition cursor-pointer"
                        title="Inspect PromoRadar QA Proof"
                      >
                        <span>Success: <strong class="text-slate-800 dark:text-slate-200">{pulse.stabilityBadge}</strong></span>
                      </button>
                      {deal.terms && (
                        <>
                          <span>•</span>
                          <button type="button" class="deal-terms-toggle text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 underline underline-offset-2 font-medium cursor-pointer">
                            Terms ▾
                          </button>
                        </>
                      )}
                    </div>

                    {isCode ? (
                      <button
                        type="button"
                        class="code-peel text-white rounded-xl px-4 py-2.5 text-xs font-bold flex items-center justify-center gap-2 shrink-0 shadow-sm cursor-pointer"
                        data-reveal-deal={JSON.stringify({
                          id: deal.id,
                          title: deal.title,
                          desc: deal.description,
                          code: deal.code,
                          storeName: deal.storeName,
                          storeSlug: deal.storeSlug,
                          badge: deal.discountBadge || deal.badge,
                          affiliateUrl: deal.affiliateUrl,
                          successRate: deal.successRate || '99%'
                        })}
                      >
                        <span>Get Code</span>
                        <span class="font-mono text-[11px] bg-black/25 px-2 py-0.5 rounded border border-white/20">
                          •••{deal.code.slice(-3)}
                        </span>
                      </button>
                    ) : (
                      <button
                        type="button"
                        class="px-4 py-2 rounded-xl bg-slate-900 hover:bg-indigo-600 dark:bg-indigo-600 dark:hover:bg-indigo-500 text-white font-bold text-xs flex items-center justify-center gap-1.5 transition shadow-sm cursor-pointer"
                        data-reveal-deal={JSON.stringify({
                          id: deal.id,
                          title: deal.title,
                          desc: deal.description,
                          code: deal.code || '',
                          storeName: deal.storeName,
                          storeSlug: deal.storeSlug,
                          badge: deal.discountBadge || deal.badge,
                          affiliateUrl: deal.affiliateUrl,
                          successRate: deal.successRate || '99%'
                        })}
                      >
                        <span>Reveal &amp; Activate ↗</span>
                      </button>
                    )}
                  </div>

                  {/* Expandable Terms Drawer */}
                  {deal.terms && (
                    <div class="deal-terms-drawer hidden text-[11px] text-slate-600 dark:text-slate-300 bg-slate-50 dark:bg-slate-800/60 p-3 rounded-xl border border-slate-200/70 dark:border-slate-700/60 space-y-1">
                      <div class="font-bold text-slate-800 dark:text-slate-200 flex items-center justify-between">
                        <span>Terms &amp; Restrictions:</span>
                        <span class="text-[10px] text-slate-400 font-mono">Expires {deal.expiryDate}</span>
                      </div>
                      <p class="leading-relaxed">{deal.terms}</p>
                    </div>
                  )}
                </div>
              </article>
            );
          })}

          <!-- Empty State for Category Filters -->
          <div id="catFiltersEmptyState" class="hidden col-span-full p-8 text-center bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 space-y-3">
            <div class="text-3xl">🔍</div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">No vouchers match the selected filter</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 max-w-sm mx-auto">
              Try switching back to all offers or select another brand in this category.
            </p>
            <button
              type="button"
              id="resetCatFilterBtn"
              class="px-4 py-2 rounded-xl bg-indigo-600 text-white font-bold text-xs hover:bg-indigo-500 transition cursor-pointer"
            >
              Reset Filters
            </button>
          </div>
        </div>
      </div>

      <!-- Category Deal Drop Alerts Banner (CouponFollow / Honey Droplist) -->
      <section class="bg-gradient-to-br from-indigo-950 via-slate-900 to-indigo-900 text-white rounded-3xl p-6 sm:p-8 border border-indigo-500/30 shadow-xl relative overflow-hidden mt-10">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 relative z-10">
          <div class="max-w-xl space-y-2">
            <div class="flex items-center gap-2">
              <span class="p-1.5 rounded-lg bg-rose-500/20 text-rose-300 border border-rose-500/30">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                </svg>
              </span>
              <span class="text-xs font-bold uppercase tracking-wider text-indigo-300">
                Real-Time Price &amp; Coupon Droplist
              </span>
            </div>
            <h3 class="text-xl sm:text-2xl font-extrabold text-white">
              Get Instant {cat.name} Deal Alerts
            </h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Never overpay for {cat.categoryName}. Subscribe to be alerted the exact moment a verified 50%+ discount or exclusive checkout code drops.
            </p>
          </div>

          <div class="w-full lg:w-96 shrink-0">
            <form id="catAlertForm" class="space-y-2.5">
              <div class="flex flex-col sm:flex-row gap-2">
                <input
                  type="email"
                  id="catAlertEmail"
                  required
                  placeholder="Enter email address..."
                  class="flex-1 px-4 py-2.5 text-xs rounded-xl bg-slate-800/90 text-white placeholder-slate-400 border border-slate-700/80 focus:outline-none focus:ring-2 focus:ring-indigo-400 transition"
                />
                <button
                  type="submit"
                  class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-indigo-500 to-indigo-600 hover:from-indigo-400 hover:to-indigo-500 text-white font-extrabold text-xs shadow-md transition cursor-pointer shrink-0 active:scale-95"
                >
                  Alert Me ⚡
                </button>
              </div>
              <span id="catAlertEmailError" class="hidden text-[10px] text-rose-400 block"></span>
            </form>

            <div id="catAlertSuccess" class="hidden text-xs bg-emerald-950/60 p-3.5 rounded-2xl border border-emerald-500/40 space-y-1.5">
              <div class="flex items-center gap-2 text-emerald-300 font-extrabold text-xs">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>Active Category Alerts!</span>
              </div>
              <p id="catAlertSuccessMsg" class="text-[11px] text-emerald-200/90">
                You're subscribed to real-time {cat.categoryName} discount alerts.
              </p>
              <button
                type="button"
                id="catAlertManageBtn"
                class="text-[10px] text-emerald-400 hover:text-emerald-300 underline underline-offset-2 font-medium cursor-pointer"
              >
                Change or unsubscribe
              </button>
            </div>
          </div>
        </div>
      </section>

    </div>
  </main>

  <script is:inline define:vars={{ rawCategoryDeals: deals, catCategoryName: cat.categoryName, catSlug: cat.slug, base }}>
    // Live Category Savings Calculator Engine (Honey & Capital One Shopping style)
    const catCalcInput = document.getElementById('catCalcInput');
    const winnerBrandEl = document.getElementById('catCalcWinnerBrand');
    const winnerDealEl = document.getElementById('catCalcWinnerDeal');
    const winnerRateEl = document.getElementById('catCalcWinnerRate');
    const winnerSavingsEl = document.getElementById('catCalcWinnerSavings');
    const winnerTotalEl = document.getElementById('catCalcWinnerTotal');
    const winnerCodeBox = document.getElementById('catCalcWinnerCodeBox');
    const catCalcApplyBtn = document.getElementById('catCalcApplyBtn');
    const runnersListEl = document.getElementById('catCalcRunnersList');

    function calculateCategorySavings() {
      const subtotal = parseFloat(catCalcInput?.value) || 0;
      if (subtotal <= 0) {
        if (winnerSavingsEl) winnerSavingsEl.textContent = '-$0.00';
        if (winnerTotalEl) winnerTotalEl.textContent = '($0.00 Total)';
        return;
      }

      // Group deals by store and find the best deal for each store
      const storeBestMap = {};

      (rawCategoryDeals || []).forEach(deal => {
        let discountDollars = 0;
        const discountStr = (deal.discountBadge || deal.badge || deal.title || '').toUpperCase();
        const percentMatch = discountStr.match(/(\d+)%/);
        const dollarMatch = discountStr.match(/\$(\d+)/);

        if (percentMatch) {
          const pct = parseFloat(percentMatch[1]);
          discountDollars = (subtotal * pct) / 100;
        } else if (dollarMatch) {
          discountDollars = parseFloat(dollarMatch[1]);
        } else if (discountStr.includes('FREE') || discountStr.includes('VIP')) {
          discountDollars = subtotal * 0.30;
        } else {
          discountDollars = subtotal * 0.15;
        }

        const capped = Math.min(discountDollars, subtotal);
        const storeKey = deal.storeSlug || deal.storeName;

        if (!storeBestMap[storeKey] || capped > storeBestMap[storeKey].savings) {
          storeBestMap[storeKey] = {
            deal,
            savings: capped,
            finalPrice: Math.max(0, subtotal - capped),
            effectiveRate: Math.round((capped / subtotal) * 100)
          };
        }
      });

      const sortedStores = Object.values(storeBestMap).sort((a, b) => b.savings - a.savings);
      if (sortedStores.length === 0) return;

      const winner = sortedStores[0];
      const winDeal = winner.deal;

      if (winnerBrandEl) winnerBrandEl.textContent = winDeal.storeName || 'Featured Partner';
      if (winnerDealEl) winnerDealEl.textContent = winDeal.title || '';
      if (winnerRateEl) winnerRateEl.textContent = `${winner.effectiveRate}% OFF`;
      if (winnerSavingsEl) winnerSavingsEl.textContent = `-$${winner.savings.toFixed(2)}`;
      if (winnerTotalEl) winnerTotalEl.textContent = `($${winner.finalPrice.toFixed(2)} Total)`;
      if (winnerCodeBox) {
        winnerCodeBox.textContent = (winDeal.code && winDeal.code.trim().length > 0) ? winDeal.code : 'DIRECT DEAL';
      }

      if (catCalcApplyBtn) {
        catCalcApplyBtn.onclick = () => {
          const code = (winDeal.code && winDeal.code.trim().length > 0) ? winDeal.code : '';
          const url = winDeal.affiliateUrl || '#';
          if (code) {
            navigator.clipboard?.writeText(code).catch(() => {});
            if (window.showPromoToast) {
              window.showPromoToast(`Code ${code} copied! Opening ${winDeal.storeName} checkout...`);
            }
          }
          window.dispatchEvent(new CustomEvent('promoradar_deal_revealed', {
            detail: {
              code: code || 'VERIFIED_DEAL',
              store: winDeal.storeName || 'Partner Store',
              storeName: winDeal.storeName || 'Partner Store',
              storeSlug: winDeal.storeSlug || '',
              badge: winDeal.discountBadge || `${winner.effectiveRate}% OFF`,
              affiliateUrl: url
            }
          }));
          if (url && url !== '#') {
            window.open(url, '_blank', 'noopener,noreferrer');
          }
        };
      }

      // Render Runners-up (up to 3 other brands)
      if (runnersListEl) {
        const runners = sortedStores.slice(1, 4);
        if (runners.length === 0) {
          runnersListEl.innerHTML = `<p class="text-xs text-slate-400">All available category brands evaluated.</p>`;
        } else {
          runnersListEl.innerHTML = runners.map(r => `
            <div class="flex items-center justify-between p-2 rounded-xl bg-slate-900/60 border border-slate-700/60 text-xs">
              <div class="min-w-0 pr-2">
                <span class="font-extrabold text-white truncate block">${r.deal.storeName}</span>
                <span class="text-[11px] text-emerald-400 font-bold">-$${r.savings.toFixed(2)} (${r.effectiveRate}% off)</span>
              </div>
              <a
                href="${base}/stores/${r.deal.storeSlug}/"
                class="px-2.5 py-1 rounded-lg bg-indigo-600/80 hover:bg-indigo-600 text-white font-bold text-[11px] transition shrink-0"
              >
                Deals →
              </a>
            </div>
          `).join('');
        }
      }
    }

    // Preset buttons listener
    document.querySelectorAll('.cat-calc-preset').forEach(btn => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-val');
        if (catCalcInput && val) {
          catCalcInput.value = val;
          document.querySelectorAll('.cat-calc-preset').forEach(b => {
            const isTarget = b === btn;
            b.className = isTarget
              ? 'cat-calc-preset px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-600 text-white transition cursor-pointer'
              : 'cat-calc-preset px-2 py-0.5 rounded text-[10px] font-bold bg-slate-700 hover:bg-slate-600 text-indigo-300 transition cursor-pointer';
          });
          calculateCategorySavings();
        }
      });
    });

    catCalcInput?.addEventListener('input', calculateCategorySavings);
    calculateCategorySavings();
    // Terms Drawers Toggle
    document.querySelectorAll('.deal-terms-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const card = btn.closest('article');
        const drawer = card?.querySelector('.deal-terms-drawer');
        drawer?.classList.toggle('hidden');
      });
    });

    // Faceted Filtering & Sorting Engine for Category Deals
    let currentCatFilter = 'all';
    let currentCatStore = 'all';
    let currentCatSort = 'recommended';
    const catCards = Array.from(document.querySelectorAll('.cat-deal-card'));
    const catGrid = document.getElementById('catCouponsGrid');
    const catCountEl = document.getElementById('catFilteredCount');
    const catEmptyEl = document.getElementById('catFiltersEmptyState');

    function applyCatFilters() {
      let visibleCount = 0;

      catCards.forEach(card => {
        const dealType = card.getAttribute('data-deal-type') || 'deal';
        const storeSlug = card.getAttribute('data-store-slug') || '';
        const matchType = currentCatFilter === 'all' || dealType === currentCatFilter;
        const matchStore = currentCatStore === 'all' || storeSlug === currentCatStore;

        if (matchType && matchStore) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      // Sort cards
      if (catGrid && visibleCount > 0) {
        const sorted = [...catCards].sort((a, b) => {
          if (currentCatSort === 'discount') {
            const valA = parseFloat(a.getAttribute('data-discount-val') || '0');
            const valB = parseFloat(b.getAttribute('data-discount-val') || '0');
            return valB - valA;
          } else if (currentCatSort === 'expiry') {
            const expA = parseFloat(a.getAttribute('data-expiry-ts') || '0');
            const expB = parseFloat(b.getAttribute('data-expiry-ts') || '0');
            return expA - expB;
          } else {
            const orderA = parseInt(a.getAttribute('data-default-order') || '0', 10);
            const orderB = parseInt(b.getAttribute('data-default-order') || '0', 10);
            return orderA - orderB;
          }
        });
        sorted.forEach(card => catGrid.appendChild(card));
        if (catEmptyEl) catGrid.appendChild(catEmptyEl);
      }

      if (catCountEl) catCountEl.textContent = `${visibleCount} Verified`;
      if (catEmptyEl) {
        if (visibleCount === 0) catEmptyEl.classList.remove('hidden');
        else catEmptyEl.classList.add('hidden');
      }
    }

    document.querySelectorAll('.cat-facet-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        currentCatFilter = tab.getAttribute('data-filter') || 'all';
        document.querySelectorAll('.cat-facet-tab').forEach(t => {
          const isActive = t === tab;
          t.classList.toggle('active', isActive);
          t.classList.toggle('bg-white', isActive);
          t.classList.toggle('dark:bg-slate-900', isActive);
          t.classList.toggle('text-slate-900', isActive);
          t.classList.toggle('dark:text-white', isActive);
          t.classList.toggle('shadow-xs', isActive);
          t.classList.toggle('text-slate-600', !isActive);
          t.classList.toggle('dark:text-slate-400', !isActive);
        });
        applyCatFilters();
      });
    });

    document.getElementById('catStoreSelect')?.addEventListener('change', (e) => {
      currentCatStore = e.target.value;
      applyCatFilters();
    });

    document.getElementById('catSortSelect')?.addEventListener('change', (e) => {
      currentCatSort = e.target.value;
      applyCatFilters();
    });

    document.getElementById('resetCatFilterBtn')?.addEventListener('click', () => {
      const allTab = document.querySelector('.cat-facet-tab[data-filter="all"]');
      if (allTab) allTab.click();
      const storeSelect = document.getElementById('catStoreSelect');
      if (storeSelect) {
        storeSelect.value = 'all';
        currentCatStore = 'all';
      }
      applyCatFilters();
    });

    // Category Deal Alerts Handler
    const catAlertForm = document.getElementById('catAlertForm');
    const catAlertSuccess = document.getElementById('catAlertSuccess');
    const catAlertSuccessMsg = document.getElementById('catAlertSuccessMsg');
    const catAlertEmailInput = document.getElementById('catAlertEmail');
    const catAlertErrorEl = document.getElementById('catAlertEmailError');
    const catAlertManageBtn = document.getElementById('catAlertManageBtn');
    const alertCategoryKey = `category_${catSlug}`;

    function checkExistingCategoryAlert() {
      try {
        const stored = JSON.parse(localStorage.getItem('promoradar_deal_alerts') || '{}');
        const alert = stored[alertCategoryKey];
        if (alert && alert.email) {
          if (catAlertForm) catAlertForm.classList.add('hidden');
          if (catAlertSuccess) catAlertSuccess.classList.remove('hidden');
          if (catAlertSuccessMsg) {
            catAlertSuccessMsg.textContent = `Alert active for ${alert.email} in ${catCategoryName}.`;
          }
        }
      } catch (e) {}
    }

    checkExistingCategoryAlert();

    catAlertForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = (catAlertEmailInput?.value || '').trim();
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        if (catAlertErrorEl) {
          catAlertErrorEl.textContent = 'Please enter a valid email address.';
          catAlertErrorEl.classList.remove('hidden');
        }
        return;
      }

      if (catAlertErrorEl) catAlertErrorEl.classList.add('hidden');

      try {
        const stored = JSON.parse(localStorage.getItem('promoradar_deal_alerts') || '{}');
        stored[alertCategoryKey] = {
          email,
          categoryName: catCategoryName,
          categorySlug: catSlug,
          timestamp: new Date().toISOString()
        };
        localStorage.setItem('promoradar_deal_alerts', JSON.stringify(stored));
      } catch (err) {}

      if (catAlertForm) catAlertForm.classList.add('hidden');
      if (catAlertSuccess) catAlertSuccess.classList.remove('hidden');
      if (catAlertSuccessMsg) {
        catAlertSuccessMsg.textContent = `Subscribed! ${email} will receive alerts for ${catCategoryName}.`;
      }

      if (window.showPromoToast) {
        window.showPromoToast(`⚡ Category deal alerts active for ${catCategoryName}!`);
      }

      window.dispatchEvent(new CustomEvent('promoradar_category_alert_subscribed', {
        detail: { email, category: catCategoryName, categorySlug: catSlug }
      }));
    });

    catAlertManageBtn?.addEventListener('click', () => {
      if (catAlertSuccess) catAlertSuccess.classList.add('hidden');
      if (catAlertForm) catAlertForm.classList.remove('hidden');
      if (catAlertEmailInput) catAlertEmailInput.focus();
    });
  </script>

  <Footer />
</BaseLayout>
