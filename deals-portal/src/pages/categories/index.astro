---

<BaseLayout
  title="Deal Categories & Curated Collections — PromoRadar"
  description="Explore tested promo codes and checkout vouchers across 16 specialized verticals: Privacy, Gaming, Home, Fashion, Travel, Auto, Food, and more."
  activePath="/categories"
>
  <Header activePath="/categories" />

  <main class="flex-1">
    <!-- Category Hero Header -->
    <div class="border-b border-slate-200/80 dark:border-slate-800/80 bg-white dark:bg-slate-900/60 transition-colors">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">Explore 16 Curated Verticals</span>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-1">Deal Categories &amp; Curated Collections</h1>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-1.5 max-w-2xl leading-relaxed">
          Browse hand-verified merchant partner offers across 16 specialized verticals—from high-speed VPNs and gaming keys to luxury home goods, travel bookings, and tech gear.
        </p>
      </div>
    </div>

    <!-- Categories Bento Grid -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-10">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {CATEGORIES.map(cat => {
          const dealCount = COUPONS_DATA.filter(d => {
            if (isJunkTestOffer(d.storeName, d.title)) return false;
            const clean = cleanBrandName(d.storeName, d.title);
            return resolveSmartCategory(d.storeCategory, clean, d.title) === cat.categoryName;
          }).length;
          const { visible, remainingCount } = getSanitizedStores(cat.categoryName);
          return (
            <div class="bg-white dark:bg-slate-900/90 rounded-2xl p-5 border border-slate-200/90 dark:border-slate-800/90 flex flex-col justify-between card-hover shadow-sm transition-all hover:border-indigo-500/30">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="w-11 h-11 rounded-2xl bg-indigo-50 dark:bg-indigo-950/50 text-xl flex items-center justify-center border border-indigo-100 dark:border-indigo-800/50 shadow-sm">
                    {cat.icon}
                  </span>
                  <span class="text-[11px] font-extrabold px-2.5 py-0.5 rounded-full bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 border border-rose-200/80 dark:border-rose-800/40 whitespace-nowrap">
                    {cat.maxDiscount}
                  </span>
                </div>
                <h3 class="text-base font-extrabold text-slate-900 dark:text-white mb-1.5 leading-snug">
                  {cat.name}
                </h3>
                <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mb-4 line-clamp-3">
                  {cat.desc}
                </p>
                <div class="flex flex-wrap gap-1.5 mb-5">
                  {visible.map(store => (
                    <a
                      href={`${base}/stores/${store.slug}/`}
                      class="text-[11px] font-semibold px-2 py-0.5 rounded-lg bg-slate-100 dark:bg-slate-800/70 hover:bg-indigo-50 dark:hover:bg-indigo-900/40 hover:text-indigo-700 dark:hover:text-indigo-300 text-slate-700 dark:text-slate-300 transition"
                    >
                      {store.name}
                    </a>
                  ))}
                  {remainingCount > 0 && (
                    <a
                      href={`${base}/categories/${cat.slug}/`}
                      class="text-[11px] font-bold px-2 py-0.5 rounded-lg bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 hover:bg-indigo-100 dark:hover:bg-indigo-900/60 transition"
                    >
                      +{remainingCount} more
                    </a>
                  )}
                </div>
              </div>

              <a
                href={`${base}/categories/${cat.slug}/`}
                class="w-full py-2 rounded-xl bg-slate-900 dark:bg-indigo-600 hover:bg-indigo-600 dark:hover:bg-indigo-500 text-white text-xs font-bold text-center transition shadow-sm"
              >
                Browse Deals ({dealCount}) →
              </a>
            </div>
          );
        })}
      </div>

      <!-- Curated Seasonal Banner -->
      <div class="bg-gradient-to-r from-indigo-950 via-slate-900 to-indigo-900 rounded-3xl p-6 sm:p-10 text-white shadow-xl flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6 relative overflow-hidden border border-indigo-500/20">
        <div class="space-y-2.5 max-w-2xl relative z-10">
          <span class="inline-block text-[11px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-amber-400 text-slate-950 font-mono">
            Featured Collection
          </span>
          <h2 class="text-xl sm:text-2xl font-extrabold tracking-tight">
            Cybersecurity, VPN &amp; Family Digital Safety — Up to 81% Off
          </h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Compare verified deals from ExpressVPN, PureVPN, Keeper Security, Qustodio, OnlineSim, and Spokeo in one place. Hand-verified via direct partner network feeds.
          </p>
        </div>
        <a
          href={`${base}/?cat=${encodeURIComponent('Privacy & Security')}`}
          class="px-6 py-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm transition shrink-0 shadow-lg shadow-indigo-600/30 relative z-10"
        >
          Explore Security Deals →
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
