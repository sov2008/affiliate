---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { COUPONS_DATA, STORES_DATA } from '../../data/couponsData';
import { cleanBrandName, isJunkTestOffer, resolveSmartCategory, getCanonicalStoreSlug, getUniqueCleanStores } from '../../utils/dealNormalizer';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Helper to get sanitized, case-insensitively deduplicated store pills for each category
function getSanitizedStores(categoryName: string) {
  const allCleanStores = getUniqueCleanStores(STORES_DATA);
  const matchingStores = allCleanStores.filter(s => s.category === categoryName);

  return {
    visible: matchingStores.slice(0, 8),
    totalCount: matchingStores.length,
    remainingCount: Math.max(0, matchingStores.length - 8)
  };
}

