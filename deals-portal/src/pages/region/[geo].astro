---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { COUPONS_DATA, STORES_DATA } from '../../data/couponsData';
import { getDealLivePulse } from '../../data/pulseEngine';
import BrandLogo from '../../components/BrandLogo.astro';
import {
  resolveMerchantIdentity,
  isJunkTestOffer,
  resolveSmartCategory,
  extractSmartDiscountBadge,
  getUniqueCleanStores,
  getCanonicalStoreSlug,
  normalizeExpiryDate
} from '../../utils/dealNormalizer';

export const prerender = true;

export async function getStaticPaths() {
  const REGIONS_DATA = [
    {
      geo: 'us',
      code: 'US',
      name: 'United States',
      flag: '🇺🇸',
      titleGeo: 'US & North America',
      heading: 'United States Verified Promo Codes & Exclusive Coupons',
      desc: 'Tested and verified promo codes, checkout discounts, and exclusive vouchers for US shoppers. Updated daily with 99.4% API stability.'
    },
    {
      geo: 'worldwide',
      code: 'GLOBAL',
      name: 'Worldwide',
      flag: '🌐',
      titleGeo: 'Worldwide & International',
      heading: 'Worldwide Verified Promo Codes & Global Online Deals',
      desc: 'International discount codes, global checkout vouchers, and cross-border deals with direct tracking and verified merchant savings.'
    },
    {
      geo: 'eu',
      code: 'EU',
      name: 'Europe',
      flag: '🇪🇺',
      titleGeo: 'Europe & UK',
      heading: 'Europe & EU Verified Promo Codes & Vouchers',
      desc: 'Tested vouchers and coupon discounts for shoppers across Europe and the UK with fast delivery and VAT-compliant pricing.'
    },
    {
      geo: 'uae',
      code: 'GCC',
      name: 'UAE & GCC',
      flag: '🇦🇪',
      titleGeo: 'UAE & Middle East',
      heading: 'UAE & GCC Verified Promo Codes & Dubai Deals',
      desc: 'Exclusive promo codes and clearance vouchers for Dubai, Abu Dhabi, Saudi Arabia, and Gulf region shoppers.'
    },
    {
      geo: 'ua',
      code: 'UA',
      name: 'Ukraine',
      flag: '🇺🇦',
      titleGeo: 'Ukraine & Eastern Europe',
      heading: 'Ukraine Verified Promo Codes & Local Partner Discounts',
      desc: 'Tested discount codes, electronics vouchers, and verified merchant deals active for users in Ukraine.'
    }
  ];

  return REGIONS_DATA.map(item => ({
    params: { geo: item.geo },
    props: {
      regionInfo: item,
      allRegions: REGIONS_DATA
    }
  }));
}

const { geo } = Astro.params;
const { regionInfo, allRegions } = Astro.props;
const REGIONS_DEF = allRegions;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Target Region mappings for stores
const STORE_REGIONS: Record<string, string[]> = {
  'chicme': ['GLOBAL', 'EU', 'US'],
  'glasseslit': ['GLOBAL', 'US', 'EU'],
  'raynatours': ['GCC', 'GLOBAL'],
  'purevpn': ['GLOBAL', 'EU', 'US', 'GCC'],
  'expressvpn': ['GLOBAL', 'EU', 'US', 'GCC', 'UA'],
  'alibaba': ['GLOBAL', 'EU', 'GCC', 'US'],
  'thedealoutlet': ['GCC'],
  'vogacloset': ['GCC', 'GLOBAL'],
  'kodland': ['GLOBAL', 'EU', 'UA'],
  'airalo': ['GLOBAL', 'EU', 'GCC', 'US', 'UA'],
  'keepersecurity': ['GLOBAL', 'EU', 'US'],
  'qustodio': ['GLOBAL', 'EU', 'US'],
  'allpowers': ['UA', 'GLOBAL', 'EU'],
  'huawei': ['GCC', 'GLOBAL', 'EU'],
  'nazih': ['GCC'],
  'touch': ['UA'],
  'onlinesim': ['GLOBAL', 'EU', 'UA'],
  'jashanmal': ['GCC'],
  'dabdoob': ['GCC'],
  'vperfumes': ['GCC'],
  'aovica': ['GLOBAL', 'EU', 'US'],
  'markformelle': ['GLOBAL', 'EU'],
  'elitedate': ['EU'],
  'verified-match': ['US', 'GLOBAL'],
  'discreet-local': ['US', 'GLOBAL'],
  'spokeo': ['US'],
  'hostinger': ['GLOBAL', 'US', 'EU', 'UA', 'GCC'],
  'abelssoft': ['GLOBAL', 'EU', 'US'],
  '945industries': ['US', 'GLOBAL', 'EU']
};

const cleanStores = getUniqueCleanStores(STORES_DATA, COUPONS_DATA);

// Filter valid coupons matching region code or fallback to GLOBAL
const validCoupons = COUPONS_DATA.filter(d => !isJunkTestOffer(d.storeName, d.title));

const regionDeals = validCoupons.filter(deal => {
  const identity = resolveMerchantIdentity(deal);
  const slug = getCanonicalStoreSlug(identity.brand);
  const allowedGeos = STORE_REGIONS[slug] || STORE_REGIONS[deal.storeSlug] || ['GLOBAL'];
  
  if (regionInfo.code === 'GLOBAL') {
    return true; // Worldwide includes all
  }
  return allowedGeos.includes(regionInfo.code) || allowedGeos.includes('GLOBAL');
}).map(d => {
  const identity = resolveMerchantIdentity(d);
  return {
    ...d,
    cleanBrand: identity.brand,
    canonicalSlug: getCanonicalStoreSlug(identity.brand),
    resolvedDomain: identity.domain,
    discountBadge: extractSmartDiscountBadge(d.discountBadge || d.badge, d.title),
    normalizedExpiry: normalizeExpiryDate(d.expiryDate)
  };
}).sort((a, b) => {
  const aHasCode = a.code && a.code.trim().length > 0 ? 1 : 0;
  const bHasCode = b.code && b.code.trim().length > 0 ? 1 : 0;
  return bHasCode - aHasCode;
});

const now = new Date();
const currentMonth = now.toLocaleString('en-US', { month: 'long' });
const currentYear = now.getFullYear();

// Structured Data
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://promoradar.store/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Regions",
      "item": "https://promoradar.store/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": regionInfo.name,
      "item": `https://promoradar.store/region/${regionInfo.geo}/`
    }
  ]
};

const offersListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `${regionInfo.name} Verified Promo Codes`,
  "itemListElement": regionDeals.slice(0, 30).map((deal, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "item": {
      "@type": "Offer",
      "name": deal.title,
      "description": deal.description,
      "priceSpecification": {
        "@type": "PriceSpecification",
        "description": deal.discountBadge
      }
    }
  }))
};

const pageSchemas = [breadcrumbSchema, offersListSchema];
---

<BaseLayout
  title={`${regionInfo.name} Promo Codes & Coupons (${currentMonth} ${currentYear}) — PromoRadar`}
  description={regionInfo.desc}
  canonicalUrl={`https://promoradar.store/region/${regionInfo.geo}/`}
  activePath={`/region/${regionInfo.geo}/`}
  schemas={pageSchemas}
>
  <Header activePath={`/region/${regionInfo.geo}/`} />

  <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6" aria-label="Breadcrumb">
      <a href={`${base}/`} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Home</a>
      <span>/</span>
      <span class="text-slate-500">Regions</span>
      <span>/</span>
      <span class="text-slate-900 dark:text-white font-bold">{regionInfo.name} {regionInfo.flag}</span>
    </nav>

    <!-- Region Hero Banner -->
    <section class="bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 text-white rounded-3xl p-6 sm:p-10 mb-8 border border-slate-800 shadow-xl relative overflow-hidden">
      <div class="relative z-10 max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-400/30 mb-4">
          <span class="text-base">{regionInfo.flag}</span>
          <span>Regional Savings Hub • Verified for {currentMonth} {currentYear}</span>
        </div>
        <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight mb-3 text-white">
          {regionInfo.heading}
        </h1>
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed mb-6">
          {regionInfo.desc}
        </p>

        <!-- Quick Region Selector Switcher -->
        <div class="flex items-center gap-2 flex-wrap text-xs pt-2">
          <span class="text-slate-400 font-semibold mr-1">Other Regions:</span>
          {REGIONS_DEF.map(r => (
            <a
              href={`${base}/region/${r.geo}/`}
              class={`px-3 py-1.5 rounded-xl font-bold transition flex items-center gap-1.5 ${
                r.geo === regionInfo.geo
                  ? 'bg-indigo-600 text-white shadow-xs'
                  : 'bg-white/10 hover:bg-white/20 text-slate-300'
              }`}
            >
              <span>{r.flag}</span>
              <span>{r.name}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Deals Counter & Status Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-200 dark:border-slate-800">
      <div>
        <h2 class="text-lg font-extrabold text-slate-900 dark:text-white flex items-center gap-2">
          <span>Active Deals for {regionInfo.name}</span>
          <span class="text-xs px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300 font-bold border border-emerald-200 dark:border-emerald-500/30">
            {regionDeals.length} Verified
          </span>
        </h2>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
          Tested with merchant checkout carts for direct regional applicability
        </p>
      </div>

      <a href={`${base}/stores/`} class="text-xs font-bold text-indigo-600 dark:text-indigo-400 hover:underline">
        Browse All Stores Catalog →
      </a>
    </div>

    <!-- Deals Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {regionDeals.map((deal) => {
        const isCode = deal.code && deal.code.trim().length > 0;
        return (
          <article class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-5 flex flex-col justify-between shadow-xs hover:shadow-md transition">
            <div>
              <div class="flex items-start justify-between gap-3 mb-3">
                <div class="flex items-center gap-2.5">
                  <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center p-1 font-bold text-xs">
                    {deal.cleanBrand.slice(0, 2).toUpperCase()}
                  </div>
                  <div>
                    <a href={`${base}/stores/${deal.canonicalSlug}/`} class="text-sm font-extrabold text-slate-900 dark:text-white hover:text-indigo-600 dark:hover:text-indigo-400 transition">
                      {deal.cleanBrand}
                    </a>
                    <span class="block text-[10px] text-slate-400">{deal.resolvedDomain}</span>
                  </div>
                </div>
                <span class="text-xs font-black px-2 py-1 rounded-lg bg-rose-50 text-rose-600 dark:bg-rose-500/15 dark:text-rose-300 border border-rose-200 dark:border-rose-500/30">
                  {deal.discountBadge}
                </span>
              </div>

              <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-2 line-clamp-2">
                <a href={`${base}/stores/${deal.canonicalSlug}/`} class="hover:text-indigo-600 dark:hover:text-indigo-400">
                  {deal.title}
                </a>
              </h3>

              <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2 mb-4 leading-relaxed">
                {deal.description}
              </p>
            </div>

            <div class="pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between gap-2">
              <span class="text-[10px] font-mono text-slate-400">
                Expires {deal.normalizedExpiry}
              </span>

              <a
                href={deal.affiliateUrl}
                target="_blank"
                rel="nofollow sponsored"
                class="px-3.5 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs transition inline-flex items-center gap-1.5 shadow-xs"
              >
                <span>{isCode ? `Code: ${deal.code}` : 'Claim Deal'}</span>
                <span>↗</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </main>

  <Footer />
</BaseLayout>
