---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BrandLogo from '../../components/BrandLogo.astro';
import { STORES_DATA, COUPONS_DATA } from '../../data/couponsData';

export const prerender = true;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Head-to-Head Showdown definitions matching Screen 3 design
const SHOWDOWNS = [
  {
    id: 'expressvpn-vs-purevpn',
    category: 'PRIVACY & SECURITY',
    netSave: 'Save 81% Net',
    storeA: STORES_DATA.find(s => s.slug === 'expressvpn')!,
    storeB: STORES_DATA.find(s => s.slug === 'purevpn')!,
    taglineA: 'Lightway Protocol',
    taglineB: 'WireGuard Multi-Year',
    versusTitle: 'Lightway vs WireGuard',
    title: 'ExpressVPN vs PureVPN: Privacy Shield & Speed',
    desc: 'Side-by-side audit of proprietary Lightway speed protocols, RAM-only server wipe guarantees, independent zero-logging audits, and active checkout voucher codes.',
    metrics: [
      { label: 'Best Discount', valA: '81% OFF + 4 Mo.', valB: '20% OFF' },
      { label: 'Refund Period', valA: '30 Days (Instant)', valB: '31 Days' },
      { label: 'Live Code Stability', valA: '99.7%', valB: '99.6%', isMono: true }
    ],
    code: 'EXPRESS81',
    codeSlot: '••• d20',
    btnLabel: 'Claim 81% Voucher',
    disclaimer: 'Handshake link applies maximum savings automatically at cart'
  },
  {
    id: 'chicme-vs-vogacloset',
    category: 'FASHION & APPAREL',
    netSave: 'Save 80% Net',
    storeA: STORES_DATA.find(s => s.slug === 'chicme')!,
    storeB: STORES_DATA.find(s => s.slug === 'vogacloset')!,
    taglineA: 'Global Fast-Fashion',
    taglineB: 'UK & GCC Designer',
    versusTitle: 'Global vs Runway',
    title: 'ChicMe vs VogaCloset: Trending Looks & Delivery',
    desc: 'Compare international door-to-door delivery schedules (US/EU/UAE), doorstep return friction, seasonal coupon stacking, and clearance checkout codes.',
    metrics: [
      { label: 'Top Voucher Rate', valA: '15% Extra (PUMPKIN)', valB: '80% OFF (SALE)' },
      { label: 'Average Delivery', valA: '6-10 Business Days', valB: '3-5 Days (Express)' },
      { label: 'Returns Window', valA: '30 Days', valB: '14 Days Free Return' }
    ],
    code: 'SALE',
    codeSlot: '••• ALE',
    btnLabel: 'Claim 80% VogaCloset',
    disclaimer: 'Code SALE verified live • 99.8% cart acceptance'
  },
  {
    id: 'raynatours-vs-airalo',
    category: 'TRAVEL & ROAMING',
    netSave: 'Dubai vs Global Data',
    storeA: STORES_DATA.find(s => s.slug === 'raynatours')!,
    storeB: STORES_DATA.find(s => s.slug === 'airalo')!,
    taglineA: 'UAE Safaris & Passes',
    taglineB: '200+ Lands eSIM',
    versusTitle: 'Experiences vs SIM',
    title: 'RaynaTours vs Airalo eSIM: Travel Logistics',
    desc: 'Dubai desert tours, SeaWorld tickets & theme park passes vs instant 200+ country international eSIM packages. Plan trips with zero physical airport queues.',
    metrics: [
      { label: 'Deal Mechanism', valA: '15% Direct Markdown', valB: '10% Off Code (ADM)' },
      { label: 'Activation Latency', valA: 'Instant E-Ticket Pass', valB: 'Instant eSIM QR Profile' },
      { label: 'Best Region', valA: 'UAE & GCC Exclusives', valB: 'Worldwide 200+' }
    ],
    code: 'ADM',
    codeSlot: '••• ADM',
    btnLabel: 'Claim 10% Airalo',
    disclaimer: 'Code ADM verified live • 100% data pass discount'
  },
  {
    id: 'keepersecurity-vs-qustodio',
    category: 'SECURITY & FAMILY',
    netSave: 'Save 50% Net',
    storeA: STORES_DATA.find(s => s.slug === 'keepersecurity')!,
    storeB: STORES_DATA.find(s => s.slug === 'qustodio')!,
    taglineA: 'Zero-Knowledge Vault',
    taglineB: 'Parental Digital Shield',
    versusTitle: 'Password vs Safety',
    title: 'Keeper Security vs Qustodio: Digital Fortress',
    desc: 'Compare enterprise-grade credential encryption and dark web credential monitoring against complete parental device activity monitoring and screen management.',
    metrics: [
      { label: 'Top Discount', valA: '50% OFF Annual', valB: '15% OFF (OCT15)' },
      { label: 'Cross-Device Sync', valA: 'Unlimited Devices', valB: 'Up to 15 Devices' },
      { label: 'Security Standard', valA: 'SOC 2 & ISO 27001', valB: 'COPPA Compliant' }
    ],
    code: 'KEEPER50',
    codeSlot: '••• R50',
    btnLabel: 'Claim 50% Keeper',
    disclaimer: 'Zero-knowledge encryption audited by third-party cyber analysts'
  },
  {
    id: 'alibaba-vs-thedealoutlet',
    category: 'COMMERCE & LUXURY',
    netSave: 'Save $20 - 75%',
    storeA: STORES_DATA.find(s => s.slug === 'alibaba')!,
    storeB: STORES_DATA.find(s => s.slug === 'thedealoutlet')!,
    taglineA: 'Factory Direct Sourcing',
    taglineB: 'Luxury Designer Outlet',
    versusTitle: 'Wholesale vs Outlet',
    title: 'Alibaba vs The Deal Outlet: Sourcing & Luxury',
    desc: 'Sourcing factory-direct consumer goods at verified bulk discounts versus authentic European luxury designer apparel with Middle East regional fulfillment.',
    metrics: [
      { label: 'Peak Savings', valA: '$20 OFF (HH12)', valB: '75% OFF Clearance' },
      { label: 'Authenticity Guarantee', valA: 'Trade Assurance Escrow', valB: '100% Verified Brand New' },
      { label: 'Dispatch Window', valA: '3-12 Days Sea/Air', valB: '24-48h UAE Delivery' }
    ],
    code: 'HH12',
    codeSlot: '••• H12',
    btnLabel: 'Claim $20 Alibaba',
    disclaimer: 'Trade Assurance covers all purchases until delivery confirmation'
  },
  {
    id: 'vperfumes-vs-jashanmal',
    category: 'BEAUTY & LIFESTYLE',
    netSave: 'Save 10% - 20%',
    storeA: STORES_DATA.find(s => s.slug === 'vperfumes')!,
    storeB: STORES_DATA.find(s => s.slug === 'jashanmal')!,
    taglineA: 'Oriental Oud & French Scents',
    taglineB: 'Department Store Icon',
    versusTitle: 'Perfumery vs Department',
    title: 'Vperfumes vs Jashanmal: Fragrance & Lifestyle',
    desc: 'Compare authentic niche oriental oud, amber, and French eau de parfum collections against iconic Middle Eastern department store homeware and lifestyle goods.',
    metrics: [
      { label: 'Top Voucher', valA: '10% Extra (VP10)', valB: '15% Off Home (JASH15)' },
      { label: 'Product Range', valA: '5,000+ Fragrance Lines', valB: 'Apparel, Kitchen & Travel' },
      { label: 'Regional Hub', valA: 'Dubai & UAE Direct', valB: 'GCC Network Storefronts' }
    ],
    code: 'VP10',
    codeSlot: '••• P10',
    btnLabel: 'Claim 10% Vperfumes',
    disclaimer: 'Authentic sealed perfumes shipped directly from temperature-controlled hubs'
  }
];

// High-Density Benchmark Table Data from actual stores
const BENCHMARK_ROWS = [
  {
    store: STORES_DATA.find(s => s.slug === 'expressvpn')!,
    category: 'Privacy & Security',
    discount: '81% OFF + 4 MO',
    stability: '99.7%',
    refund: '30-Day Money-Back',
    rating: '4.9',
    code: 'EXPRESS81',
    codeSlot: '••• d20'
  },
  {
    store: STORES_DATA.find(s => s.slug === 'purevpn')!,
    category: 'Privacy & Security',
    discount: '20% OFF',
    stability: '99.6%',
    refund: '31-Day Guarantee',
    rating: '4.9',
    code: 'admitad20',
    codeSlot: '••• d20'
  },
  {
    store: STORES_DATA.find(s => s.slug === 'vogacloset')!,
    category: 'Fashion & Apparel',
    discount: '80% OFF',
    stability: '99.8%',
    refund: '14-Day Free Returns',
    rating: '4.9',
    code: 'SALE',
    codeSlot: '••• ALE'
  },
  {
    store: STORES_DATA.find(s => s.slug === 'chicme')!,
    category: 'Fashion & Apparel',
    discount: '15% EXTRA',
    stability: '99.5%',
    refund: '30-Day Returns',
    rating: '4.8',
    code: 'PUMPKIN',
    codeSlot: '••• KIN'
  },
  {
    store: STORES_DATA.find(s => s.slug === 'airalo')!,
    category: 'Travel & Tours',
    discount: '10% OFF',
    stability: '99.9%',
    refund: 'Instant Wallet Refund',
    rating: '4.9',
    code: 'ADM',
    codeSlot: '••• ADM'
  },
  {
    store: STORES_DATA.find(s => s.slug === 'raynatours')!,
    category: 'Travel & Tours',
    discount: '15% OFF',
    stability: '99.7%',
    refund: 'Flexible 24h Cancellation',
    rating: '4.9',
    code: 'RAYNA15',
    codeSlot: '••• A15'
  },
  {
    store: STORES_DATA.find(s => s.slug === 'keepersecurity')!,
    category: 'Privacy & Security',
    discount: '50% OFF',
    stability: '99.8%',
    refund: '30-Day Evaluation',
    rating: '4.9',
    code: 'KEEPER50',
    codeSlot: '••• R50'
  },
  {
    store: STORES_DATA.find(s => s.slug === 'alibaba')!,
    category: 'E-Commerce & Wholesale',
    discount: '$20 OFF',
    stability: '99.4%',
    refund: 'Trade Assurance Escrow',
    rating: '4.8',
    code: 'HH12',
    codeSlot: '••• H12'
  },
  {
    store: STORES_DATA.find(s => s.slug === 'allpowers')!,
    category: 'Electronics & Gadgets',
    discount: '11% OFF',
    stability: '99.5%',
    refund: '5-Year Warranty Support',
    rating: '4.9',
    code: 'BULKRATE',
    codeSlot: '••• ATE'
  },
  {
    store: STORES_DATA.find(s => s.slug === 'abelssoft')!,
    category: 'Privacy & Security',
    discount: '50% OFF',
    stability: '99.5%',
    refund: '30-Day Guarantee',
    rating: '4.9',
    code: 'ABELSSOFT50',
    codeSlot: '••• T50'
  }
];
---

<BaseLayout
  title="Stop Guessing Checkout Codes. Compare Savings & Terms Side-by-Side — PromoRadar"
  description="Can't decide between top merchants? Compare real checkout savings, live code stability, delivery speeds, warranties, and refund policies before you apply your voucher."
  activePath="/compare"
>
  <Header activePath="/compare" />

  <main class="w-full bg-surface min-h-[calc(100vh-18rem)]">
    <!-- Top Telemetry & Hero Banner -->
    <section class="w-full bg-canvas-dark text-white py-12 lg:py-16 relative overflow-hidden">
      <div class="absolute -right-20 -top-24 w-96 h-96 rounded-full bg-primary/20 blur-3xl pointer-events-none"></div>
      <div class="absolute left-1/3 -bottom-20 w-80 h-80 rounded-full bg-tertiary-container/20 blur-3xl pointer-events-none"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <!-- Live Audit Monospace Strip -->
        <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 border border-white/10 text-tertiary-fixed-dim font-mono text-xs">
            <span class="flex h-2 w-2 rounded-full bg-tertiary-fixed-dim animate-pulse"></span>
            <span>DIRECT AFFILIATE VERIFICATION RADAR • OCTOBER 2026</span>
          </div>
          <div class="flex items-center gap-4 font-mono text-xs text-slate-400">
            <span class="flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[16px] text-tertiary-fixed-dim">verified_user</span>
              Real-Cart Basket Simulated
            </span>
            <span class="text-slate-600">•</span>
            <span class="flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[16px] text-brand-accent-blue">sync_alt</span>
              15-Minute Heartbeat Pings
            </span>
          </div>
        </div>

        <!-- Headline & Live Audit Benchmark Box -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-end">
          <div class="lg:col-span-8 flex flex-col gap-3">
            <span class="font-mono text-xs text-tertiary-fixed tracking-wider uppercase font-bold">
              Head-to-Head Merchant &amp; Voucher Comparisons
            </span>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
              Stop Guessing Checkout Codes. Compare Savings &amp; Terms Side-by-Side.
            </h1>
            <p class="text-sm sm:text-base text-slate-300 max-w-2xl mt-1 leading-relaxed">
              Can't decide between top merchants? Compare real checkout savings, live code stability, delivery speeds, warranties, and refund policies before you apply your voucher.
            </p>
          </div>

          <!-- Benchmark Stats Box -->
          <div class="lg:col-span-4 bg-slate-900/90 border border-white/10 p-5 rounded-2xl shadow-xl flex flex-col gap-3">
            <div class="flex items-center justify-between font-mono text-xs text-tertiary-fixed-dim">
              <span class="font-bold">LIVE AUDIT BENCHMARK</span>
              <span class="bg-tertiary-container text-tertiary-fixed-dim px-2 py-0.5 rounded text-[11px] font-bold">OCTOBER 2026</span>
            </div>
            <div class="grid grid-cols-2 gap-3 text-center">
              <div class="bg-slate-950 p-3 rounded-xl border border-white/5">
                <div class="text-2xl font-black text-white">99.4%</div>
                <div class="font-mono text-[11px] text-slate-400 mt-0.5">Cart Match Rate</div>
              </div>
              <div class="bg-slate-950 p-3 rounded-xl border border-white/5">
                <div class="text-2xl font-black text-discount-rose">-81%</div>
                <div class="font-mono text-[11px] text-slate-400 mt-0.5">Peak Net Spread</div>
              </div>
            </div>
            <p class="text-[11px] text-slate-400 leading-relaxed">
              Telemetry derived from automated browser headless checkout tests across US, UAE, and Global store gateways.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Curated Head-to-Head Showdowns Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16 w-full">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
        <div>
          <span class="font-mono text-xs text-primary font-bold uppercase tracking-wider mb-1 block">High-Impact Matchups</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-on-surface">Curated Head-to-Head Showdowns</h2>
        </div>
        <div class="flex items-center gap-1.5 text-xs text-on-surface-variant font-medium">
          <span class="material-symbols-outlined text-[18px] text-badge-verified-text">check_circle</span>
          <span>Independent Editorial QA Verified • No Scraped Deals</span>
        </div>
      </div>

      <!-- Bento Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {SHOWDOWNS.map((item, idx) => (
          <div class="bg-surface-container-lowest rounded-2xl shadow-sm hover:shadow-xl border border-border-subtle p-6 flex flex-col justify-between transition-all group">
            <div>
              <!-- Top Card Badge -->
              <div class="flex items-center justify-between pb-4 border-b border-border-subtle">
                <span class="font-mono text-[11px] font-bold px-2.5 py-0.5 rounded-lg bg-secondary-container text-on-secondary-fixed">
                  {item.category}
                </span>
                <span class="font-mono text-[11px] font-bold px-2.5 py-0.5 rounded-lg bg-badge-verified-fill text-badge-verified-text border border-emerald-200">
                  {item.netSave}
                </span>
              </div>

              <!-- Brand vs Brand Duel Banner -->
              <div class="flex items-center justify-between my-5 bg-surface-container-low p-3.5 rounded-xl border border-border-subtle">
                <!-- Merchant A -->
                <div class="flex flex-col items-center gap-1.5 flex-1 text-center">
                  <div class="w-12 h-12 rounded-xl bg-white shadow-sm flex items-center justify-center p-1.5">
                    <BrandLogo store={item.storeA} size="md" />
                  </div>
                  <span class="font-bold text-xs text-on-surface leading-tight">{item.storeA.name}</span>
                  <span class="font-mono text-[10px] text-badge-verified-text font-bold">4.9 ★ Top</span>
                </div>

                <!-- Versus Pill -->
                <div class="flex flex-col items-center px-2">
                  <span class="font-mono text-xs font-black text-on-surface-variant bg-surface-container px-2.5 py-1 rounded-full border border-border-subtle">VS</span>
                  <span class="font-mono text-[10px] text-on-surface-variant mt-1 whitespace-nowrap">{item.versusTitle}</span>
                </div>

                <!-- Merchant B -->
                <div class="flex flex-col items-center gap-1.5 flex-1 text-center">
                  <div class="w-12 h-12 rounded-xl bg-white shadow-sm flex items-center justify-center p-1.5">
                    <BrandLogo store={item.storeB} size="md" />
                  </div>
                  <span class="font-bold text-xs text-on-surface leading-tight">{item.storeB.name}</span>
                  <span class="font-mono text-[10px] text-badge-verified-text font-bold">4.9 ★ Partner</span>
                </div>
              </div>

              <!-- Title & Description -->
              <h3 class="text-base font-extrabold text-on-surface mb-2 leading-snug group-hover:text-primary transition-colors">
                {item.title}
              </h3>
              <p class="text-xs text-on-surface-variant leading-relaxed mb-5">
                {item.desc}
              </p>

              <!-- Metric Comparison Snippets -->
              <div class="space-y-2 text-xs mb-6 bg-surface p-3 rounded-xl border border-border-subtle">
                {item.metrics.map(m => (
                  <div class="flex justify-between items-center py-0.5 border-b border-border-subtle/50 last:border-none">
                    <span class="text-on-surface-variant">{m.label}</span>
                    <div class="flex items-center gap-2 font-mono text-[11px]">
                      <span class="text-primary font-bold">{m.valA}</span>
                      <span class="text-slate-400">vs</span>
                      <span class="text-on-surface font-semibold">{m.valB}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Two-Segment Reveal Trigger Button -->
            <div class="flex flex-col gap-2 pt-2">
              <div
                class="flex items-stretch rounded-xl overflow-hidden shadow-sm group/btn cursor-pointer"
                onclick={`handleCopyCompareCode(this, '${item.code}', '${item.storeA.name}')`}
              >
                <button
                  type="button"
                  class="flex-1 bg-primary group-hover/btn:bg-primary-container text-white py-3 px-3.5 text-xs font-bold flex items-center justify-center gap-2 transition-colors cursor-pointer"
                >
                  <span class="material-symbols-outlined text-[16px]">verified</span>
                  <span class="btn-label">{item.btnLabel}</span>
                </button>
                <div class="bg-canvas-dark text-white font-mono text-xs px-3.5 py-3 flex items-center tracking-wider font-bold shrink-0">
                  {item.codeSlot}
                </div>
              </div>
              <span class="text-[11px] text-center text-on-surface-variant">
                {item.disclaimer}
              </span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Interactive Visual Matrix: Specification Table -->
    <section class="w-full bg-surface-container-low py-12 lg:py-16 border-t border-border-subtle">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
          <div>
            <span class="font-mono text-xs text-primary uppercase font-bold tracking-wider">Granular Feature Matrix</span>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-on-surface mt-1">Checkout &amp; Reliability Benchmark Audit</h3>
            <p class="text-xs sm:text-sm text-on-surface-variant mt-1">Direct parameters logged from PromoRadar's verified affiliate API handshakes.</p>
          </div>
          <div class="flex items-center gap-2 text-xs">
            <span class="font-mono text-on-surface-variant">Filter Focus:</span>
            <button type="button" class="px-3 py-1.5 rounded-lg bg-primary text-white font-bold shadow-sm">All Categories</button>
          </div>
        </div>

        <!-- High-Density Specification Table -->
        <div class="w-full overflow-x-auto rounded-2xl shadow-sm bg-surface-container-lowest border border-border-subtle">
          <table class="w-full text-left text-xs">
            <thead>
              <tr class="bg-surface-container text-on-surface font-bold border-b border-border-subtle">
                <th class="py-3.5 px-4 font-mono uppercase text-[11px]">Merchant Partner</th>
                <th class="py-3.5 px-3 font-mono uppercase text-[11px]">Category</th>
                <th class="py-3.5 px-3 font-mono uppercase text-[11px]">Top Verified Discount</th>
                <th class="py-3.5 px-3 font-mono uppercase text-[11px]">Stability</th>
                <th class="py-3.5 px-3 font-mono uppercase text-[11px]">Refund Policy</th>
                <th class="py-3.5 px-3 font-mono uppercase text-[11px]">Trust Score</th>
                <th class="py-3.5 px-4 text-right font-mono uppercase text-[11px]">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border-subtle/70 text-on-surface">
              {BENCHMARK_ROWS.map((row, idx) => (
                <tr class="hover:bg-surface transition-colors">
                  <td class="py-3.5 px-4">
                    <div class="flex items-center gap-3">
                      <div class="w-8 h-8 rounded-lg overflow-hidden shrink-0 shadow-sm">
                        <BrandLogo store={row.store} size="sm" />
                      </div>
                      <div>
                        <div class="font-bold text-sm text-on-surface">{row.store.name}</div>
                        <div class="font-mono text-[10px] text-badge-verified-text">Official Direct Feed</div>
                      </div>
                    </div>
                  </td>
                  <td class="py-3.5 px-3 text-on-surface-variant font-medium">{row.category}</td>
                  <td class="py-3.5 px-3">
                    <span class="inline-block px-2.5 py-0.5 rounded-md font-mono text-[11px] bg-badge-verified-fill text-badge-verified-text font-bold border border-emerald-200">
                      {row.discount}
                    </span>
                  </td>
                  <td class="py-3.5 px-3 font-mono font-bold text-badge-verified-text">
                    <div class="flex items-center gap-1.5">
                      <span class="h-2 w-2 rounded-full bg-badge-verified-text animate-pulse"></span>
                      <span>{row.stability}</span>
                    </div>
                  </td>
                  <td class="py-3.5 px-3 text-on-surface-variant">{row.refund}</td>
                  <td class="py-3.5 px-3 font-mono font-bold">
                    <div class="flex items-center gap-1 text-on-surface">
                      <span class="material-symbols-outlined text-[15px] text-urgency-amber">star</span>
                      <span>{row.rating} / 5.0</span>
                    </div>
                  </td>
                  <td class="py-3.5 px-4 text-right">
                    <button
                      type="button"
                      class="px-3.5 py-1.5 rounded-lg bg-primary hover:bg-primary-container text-white font-mono text-xs font-bold transition-all shadow-sm cursor-pointer"
                      onclick={`handleCopyCompareCode(this, '${row.code}', '${row.store.name}')`}
                    >
                      Get Code {row.codeSlot}
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script is:inline>
    function handleCopyCompareCode(btn, code, storeName) {
      if (!code) return;
      navigator.clipboard.writeText(code).then(() => {
        // Dispatch global event for sticky bar & toast
        window.dispatchEvent(new CustomEvent('promoradar:coupon-copied', {
          detail: { code: code, storeName: storeName }
        }));

        const label = btn.querySelector('.btn-label') || btn;
        const originalText = label.innerText;
        label.innerText = 'COPIED!';
        btn.classList.add('bg-emerald-600');
        setTimeout(() => {
          label.innerText = originalText;
          btn.classList.remove('bg-emerald-600');
        }, 2000);
      }).catch(err => {
        console.error('Failed to copy', err);
      });
    }
  </script>
</BaseLayout>
