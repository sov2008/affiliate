---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BrandLogo from '../../components/BrandLogo.astro';
import { STORES_DATA, COUPONS_DATA } from '../../data/couponsData';

export const prerender = true;

const comparisons = [
  {
    slug: 'expressvpn-vs-purevpn',
    storeA: STORES_DATA.find(s => s.slug === 'expressvpn'),
    storeB: STORES_DATA.find(s => s.slug === 'purevpn'),
    tagline: 'High-speed encrypted servers vs multi-year value plans and streaming unblocks.',
    category: 'Privacy & Security',
    winner: 'ExpressVPN',
    winnerVerdict: 'Best for raw speeds and unblocking streaming catalogs worldwide.'
  },
  {
    slug: 'airalo-vs-allpowers',
    storeA: STORES_DATA.find(s => s.slug === 'airalo'),
    storeB: STORES_DATA.find(s => s.slug === 'allpowers'),
    tagline: 'Global eSIM connectivity in 200+ countries vs off-grid solar generator stations.',
    category: 'Travel & Tours',
    winner: 'Airalo eSIM',
    winnerVerdict: 'Unbeatable convenience for digital nomads travelling internationally without roaming fees.'
  },
  {
    slug: 'keepersecurity-vs-qustodio',
    storeA: STORES_DATA.find(s => s.slug === 'keepersecurity'),
    storeB: STORES_DATA.find(s => s.slug === 'qustodio'),
    tagline: 'Zero-knowledge password & secrets vault vs comprehensive parental device controls.',
    category: 'Privacy & Security',
    winner: 'Keeper Security',
    winnerVerdict: 'Premier enterprise-grade vault security for personal and family credentials.'
  },
  {
    slug: 'chicme-vs-vogacloset',
    storeA: STORES_DATA.find(s => s.slug === 'chicme'),
    storeB: STORES_DATA.find(s => s.slug === 'vogacloset'),
    tagline: 'Everyday budget women’s fast fashion vs European designer collections in GCC.',
    category: 'Fashion & Apparel',
    winner: 'VogaCloset',
    winnerVerdict: 'Higher quality fabrics and direct regional Middle East delivery with 80% markdowns.'
  },
  {
    slug: 'alibaba-vs-thedealoutlet',
    storeA: STORES_DATA.find(s => s.slug === 'alibaba'),
    storeB: STORES_DATA.find(s => s.slug === 'thedealoutlet'),
    tagline: 'Global B2B factory wholesale pricing vs verified luxury designer department outlet.',
    category: 'E-Commerce & Wholesale',
    winner: 'The Deal Outlet',
    winnerVerdict: 'Authentic European luxury goods ready to ship with up to 75% outlet savings.'
  },
  {
    slug: 'vperfumes-vs-jashanmal',
    storeA: STORES_DATA.find(s => s.slug === 'vperfumes'),
    storeB: STORES_DATA.find(s => s.slug === 'jashanmal'),
    tagline: 'Niche oriental oud & luxury perfumes vs premium department home & fashion goods.',
    category: 'Beauty & Fragrances',
    winner: 'Vperfumes',
    winnerVerdict: 'The go-to destination for authentic Arabian oud, french perfumery and fragrance vouchers.'
  }
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Brand Comparisons & Head-to-Head Discount Vouchers — PromoRadar"
  description="Compare top verified partner brands side by side. Discover which service offers the best discount, feature set, and promo codes for October 2026."
  activePath="/compare"
>
  <Header activePath="/compare" />

  <main class="flex-1">
    <!-- Header -->
    <div class="bg-gradient-to-b from-indigo-950 via-slate-900 to-slate-900 text-white py-12 px-4 sm:px-6 lg:px-8 border-b border-slate-800">
      <div class="max-w-4xl mx-auto text-center space-y-3.5">
        <span class="text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-400/30">
          Smart Shopper Comparisons
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">
          Brand Comparisons &amp; Deal Showdowns
        </h1>
        <p class="text-slate-300 text-xs sm:text-sm max-w-2xl mx-auto leading-relaxed">
          Deciding between top services? Compare checkout pricing, exclusive vouchers, and real customer ratings to find the right deal.
        </p>
      </div>
    </div>

    <!-- Comparisons Grid -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {comparisons.map(item => {
          const dealsA = COUPONS_DATA.filter(d => d.storeSlug === item.storeA?.slug);
          const dealsB = COUPONS_DATA.filter(d => d.storeSlug === item.storeB?.slug);
          return (
            <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 border border-slate-200/90 dark:border-slate-800 shadow-sm flex flex-col justify-between hover:shadow-lg transition space-y-6 group">
              <div class="space-y-4">
                <div class="flex items-center justify-between">
                  <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200 dark:bg-indigo-500/15 dark:text-indigo-300 dark:border dark:border-indigo-500/30">
                    {item.category}
                  </span>
                  <span class="text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full dark:bg-emerald-500/15 dark:text-emerald-300 dark:border dark:border-emerald-500/30">
                    Verified Oct 2026
                  </span>
                </div>

                <!-- Side by side Logos -->
                <div class="flex items-center justify-center gap-3 py-2 bg-slate-50 dark:bg-slate-800/60 rounded-2xl border border-slate-100 dark:border-slate-700/60">
                  {item.storeA && <BrandLogo store={item.storeA} size="md" />}
                  <span class="font-extrabold text-sm text-slate-400">VS</span>
                  {item.storeB && <BrandLogo store={item.storeB} size="md" />}
                </div>

                <h2 class="text-lg font-extrabold text-slate-900 dark:text-white leading-snug group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition">
                  {item.storeA?.name} <span class="text-indigo-600 dark:text-indigo-400">vs</span> {item.storeB?.name}
                </h2>

                <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                  {item.tagline}
                </p>

                <!-- Editorial Verdict Snippet -->
                <div class="p-3 rounded-xl bg-indigo-50/70 border border-indigo-100 dark:bg-indigo-950/30 dark:border-indigo-500/30 text-[11px] text-slate-700 dark:text-slate-300">
                  <span class="font-bold text-indigo-900 dark:text-indigo-300">Verdict:</span> {item.winnerVerdict}
                </div>
              </div>

              <div class="pt-2 border-t border-slate-100 dark:border-slate-800">
                <a
                  href={`${base}/compare/${item.slug}/`}
                  class="w-full py-2.5 px-4 rounded-xl bg-slate-900 hover:bg-indigo-600 text-white font-bold text-xs text-center block transition shadow-sm dark:bg-slate-800/90 dark:hover:bg-indigo-600 dark:text-slate-100 dark:border dark:border-slate-700/80 cursor-pointer"
                >
                  Read Full Comparison &amp; Codes →
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
