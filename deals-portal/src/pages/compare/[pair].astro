---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BrandLogo from '../../components/BrandLogo.astro';
import { STORES_DATA, COUPONS_DATA } from '../../data/couponsData';

export const prerender = true;

export async function getStaticPaths() {
  const pairs = [
    {
      slug: 'expressvpn-vs-purevpn',
      storeA: 'expressvpn',
      storeB: 'purevpn',
      title: 'ExpressVPN vs PureVPN — 2026 Promo Codes & Direct Speed/Price Comparison',
      desc: 'Compare ExpressVPN and PureVPN discount deals, promo vouchers, server speeds, and checkout pricing for October 2026.',
      maxDiscountA: '81% OFF + 4 Mo. Free',
      maxDiscountB: '85% OFF + 3 Mo. Free',
      startingPriceA: '$6.67/mo',
      startingPriceB: '$2.14/mo',
      guaranteeA: '30-Day Money-Back',
      guaranteeB: '31-Day Money-Back',
      regionsA: 'Global (105 countries)',
      regionsB: 'Global (65+ countries)',
      bestForA: 'High-speed 4K streaming, Lightway protocol, and strict privacy',
      bestForB: 'Budget-conscious multi-year subscriptions with port forwarding',
      scoreA: '9.8 / 10',
      scoreB: '9.3 / 10',
      verdictTitle: 'ExpressVPN Wins for Performance, PureVPN for Pure Price',
      verdictBody: 'If your priority is zero buffering, instant streaming unblocks for Netflix/BBC iPlayer, and ultra-reliable connection stability, ExpressVPN is the gold standard. For users looking to spend the least amount of cash over a 5-year horizon, PureVPN represents unbeatable raw savings.'
    },
    {
      slug: 'airalo-vs-allpowers',
      storeA: 'airalo',
      storeB: 'allpowers',
      title: 'Airalo eSIM vs ALLPOWERS Solar — Digital Travel Tech Coupons Compared',
      desc: 'Direct comparison of travel connectivity and remote power deals. Save up to $800 with verified promo codes.',
      maxDiscountA: '10% OFF',
      maxDiscountB: '15% OFF (Up to $800)',
      startingPriceA: '$4.50 (1GB data)',
      startingPriceB: '$199 (Power Station)',
      guaranteeA: 'Instant digital delivery & 24/7 support',
      guaranteeB: '5-Year Manufacturer Warranty',
      regionsA: '200+ Countries worldwide',
      regionsB: 'US, EU, Ukraine, Global',
      bestForA: 'Instant international mobile data without physical SIM cards',
      bestForB: 'Off-grid camping, blackouts, and heavy solar power resilience',
      scoreA: '9.7 / 10',
      scoreB: '9.5 / 10',
      verdictTitle: 'Complementary Travel Powerhouses',
      verdictBody: 'Airalo solves the communication hurdle for international globe-trotters instantly via software eSIM. ALLPOWERS provides the physical electricity to keep laptops, drones, and medical equipment running anywhere.'
    },
    {
      slug: 'keepersecurity-vs-qustodio',
      storeA: 'keepersecurity',
      storeB: 'qustodio',
      title: 'Keeper Security vs Qustodio — Cybersecurity & Family Safety Discounts',
      desc: 'Compare password encryption and parental monitoring promo codes. Verified October 2026 offers.',
      maxDiscountA: '50% OFF',
      maxDiscountB: '15% OFF',
      startingPriceA: '$2.92/mo',
      startingPriceB: '$4.58/mo',
      guaranteeA: '30-Day Money-Back Guarantee',
      guaranteeB: '30-Day Free Trial Available',
      regionsA: 'Worldwide (Global)',
      regionsB: 'Worldwide (Global)',
      bestForA: 'Zero-knowledge password vaults, Dark Web monitoring, and 2FA',
      bestForB: 'Screen time limits, location tracking, and child cyber-safety',
      scoreA: '9.6 / 10',
      scoreB: '9.4 / 10',
      verdictTitle: 'Keeper for Identity Armor, Qustodio for Family Care',
      verdictBody: 'Both platforms protect your digital life, but Keeper shields your credentials from breaches while Qustodio ensures your children navigate the internet safely.'
    },
    {
      slug: 'chicme-vs-vogacloset',
      storeA: 'chicme',
      storeB: 'vogacloset',
      title: 'ChicMe vs VogaCloset — Fast Fashion & European Boutique Promo Codes',
      desc: 'Compare ChicMe and VogaCloset discount codes, shipping fees, seasonal sales, and clothing collection prices.',
      maxDiscountA: '60% OFF',
      maxDiscountB: '80% OFF',
      startingPriceA: '$8 per item',
      startingPriceB: '$15 per item',
      guaranteeA: 'Easy 30-Day Returns',
      guaranteeB: 'Free Returns & GCC Cash on Delivery',
      regionsA: 'Global, US, Europe',
      regionsB: 'GCC (UAE, KSA) & Global',
      bestForA: 'Affordable trendy fast-fashion and seasonal women’s beachwear',
      bestForB: 'High-end European streetwear, cosmetics, and luxury apparel',
      scoreA: '9.1 / 10',
      scoreB: '9.6 / 10',
      verdictTitle: 'VogaCloset for Premium Quality, ChicMe for Ultra-Budget',
      verdictBody: 'VogaCloset offers premium fabrics and unbeatable regional shipping speeds in the Gulf, while ChicMe delivers trendy styles for shoppers maximizing unit count per dollar.'
    },
    {
      slug: 'alibaba-vs-thedealoutlet',
      storeA: 'alibaba',
      storeB: 'thedealoutlet',
      title: 'Alibaba vs The Deal Outlet — Wholesale Sourcing vs Luxury Outlet Discounts',
      desc: 'Compare B2B factory wholesale pricing and designer luxury department store markdowns up to 75% off.',
      maxDiscountA: '$50 OFF First Order',
      maxDiscountB: '75% OFF + Extra 20%',
      startingPriceA: 'Factory wholesale pricing',
      startingPriceB: '$35 outlet markdowns',
      guaranteeA: 'Trade Assurance Escrow Protection',
      guaranteeB: '100% Authenticity Guarantee',
      regionsA: 'Worldwide international trade',
      regionsB: 'Middle East & Global Delivery',
      bestForA: 'Commercial importers, drop-shippers, and custom product runs',
      bestForB: 'Direct luxury fashion shoppers buying verified designer brands',
      scoreA: '9.4 / 10',
      scoreB: '9.5 / 10',
      verdictTitle: 'B2B Wholesale vs Luxury Consumer Outlet',
      verdictBody: 'Alibaba is built for entrepreneurs sourcing goods in volume directly from manufacturing plants. The Deal Outlet is curated for fashion lovers seeking authentic luxury designer labels at clearance discounts.'
    },
    {
      slug: 'vperfumes-vs-jashanmal',
      storeA: 'vperfumes',
      storeB: 'jashanmal',
      title: 'Vperfumes vs Jashanmal — Luxury Perfumes & GCC Home Goods Coupons',
      desc: 'Compare authentic oriental fragrances and luxury department store checkout promo codes with free delivery.',
      maxDiscountA: '70% OFF',
      maxDiscountB: '25% OFF',
      startingPriceA: '$20 perfumes',
      startingPriceB: '$40 home & travel',
      guaranteeA: '100% Genuine Perfume Guarantee',
      guaranteeB: 'Authorized GCC Retailer Warranty',
      regionsA: 'UAE & Gulf Region',
      regionsB: 'GCC (UAE, Kuwait, Bahrain, Oman)',
      bestForA: 'Niche Arabian perfumes, French designer colognes, and gift sets',
      bestForB: 'Luxury luggage, premium kitchenware, appliances, and fashion',
      scoreA: '9.5 / 10',
      scoreB: '9.4 / 10',
      verdictTitle: 'Vperfumes for Scents, Jashanmal for Premium Living',
      verdictBody: 'For fragrances, Vperfumes has an unmatched catalog of authentic oriental oils and luxury perfumes. Jashanmal covers your entire upscale home, travel luggage, and kitchen needs.'
    }
  ];

  return pairs.map(p => {
    const dataA = STORES_DATA.find(s => s.slug === p.storeA);
    const dataB = STORES_DATA.find(s => s.slug === p.storeB);
    const dealsA = COUPONS_DATA.filter(d => d.storeSlug === p.storeA);
    const dealsB = COUPONS_DATA.filter(d => d.storeSlug === p.storeB);

    return {
      params: { pair: p.slug },
      props: {
        comparison: p,
        storeA: dataA,
        storeB: dataB,
        dealsA,
        dealsB
      }
    };
  });
}

const { comparison, storeA, storeB, dealsA, dealsB } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const breadcrumbs = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://promoradar.store/" },
      { "@type": "ListItem", "position": 2, "name": "Compare", "item": "https://promoradar.store/compare/" },
      { "@type": "ListItem", "position": 3, "name": `${storeA?.name} vs ${storeB?.name}`, "item": `https://promoradar.store/compare/${comparison.slug}/` }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": comparison.title,
    "description": comparison.desc,
    "url": `https://promoradar.store/compare/${comparison.slug}/`
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": `${storeA?.name} Promo Offers`,
    "description": comparison.bestForA,
    "brand": { "@type": "Brand", "name": storeA?.name },
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": "USD",
      "lowPrice": "2.00",
      "highPrice": "199.00",
      "offerCount": dealsA.length || 1,
      "priceSpecification": {
        "@type": "PriceSpecification",
        "description": comparison.maxDiscountA
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": `${storeB?.name} Promo Offers`,
    "description": comparison.bestForB,
    "brand": { "@type": "Brand", "name": storeB?.name },
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": "USD",
      "lowPrice": "2.00",
      "highPrice": "199.00",
      "offerCount": dealsB.length || 1,
      "priceSpecification": {
        "@type": "PriceSpecification",
        "description": comparison.maxDiscountB
      }
    }
  }
];
---

<BaseLayout
  title={`${comparison.title} — PromoRadar`}
  description={comparison.desc}
  activePath={`/compare/${comparison.slug}/`}
  schemas={breadcrumbs}
>
  <Header activePath="/compare" />

  <main class="flex-1">
    <!-- Breadcrumb Nav -->
    <div class="border-b border-slate-200 bg-white py-3">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex items-center gap-2 text-xs text-slate-500" aria-label="Breadcrumb">
          <a href={`${base}/`} class="hover:text-indigo-600 transition-colors">Home</a>
          <span>/</span>
          <a href={`${base}/compare/`} class="hover:text-indigo-600 transition-colors">Compare</a>
          <span>/</span>
          <span class="text-slate-900 font-bold">{storeA?.name} vs {storeB?.name}</span>
        </nav>
      </div>
    </div>

    <!-- Header Section with Side-by-Side Brand Logos -->
    <div class="bg-gradient-to-b from-indigo-950 via-slate-900 to-slate-900 text-white py-12 px-4 sm:px-6 lg:px-8 border-b border-slate-800">
      <div class="max-w-5xl mx-auto text-center space-y-5">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/20 border border-indigo-400/30 text-indigo-300 text-xs font-semibold">
          <span>⚔️ Head-to-Head Showdown</span>
          <span>•</span>
          <span>Verified Checkout Rates</span>
        </div>

        <!-- Brand Logos Side-by-Side Pill -->
        <div class="inline-flex items-center gap-5 bg-white/10 backdrop-blur-md p-3 px-6 rounded-3xl border border-white/15 shadow-xl">
          <div class="flex items-center gap-2.5">
            {storeA && <BrandLogo store={storeA} size="md" />}
            <div class="text-left">
              <div class="text-sm font-extrabold text-white">{storeA?.name}</div>
              <div class="text-[10px] text-amber-300 font-bold">{comparison.maxDiscountA}</div>
            </div>
          </div>

          <span class="font-black text-sm text-rose-400 px-2 py-0.5 rounded-full bg-black/40 border border-white/10">VS</span>

          <div class="flex items-center gap-2.5">
            {storeB && <BrandLogo store={storeB} size="md" />}
            <div class="text-left">
              <div class="text-sm font-extrabold text-white">{storeB?.name}</div>
              <div class="text-[10px] text-amber-300 font-bold">{comparison.maxDiscountB}</div>
            </div>
          </div>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">
          {storeA?.name} <span class="text-indigo-400">vs</span> {storeB?.name}
        </h1>
        <p class="text-slate-300 text-xs sm:text-sm max-w-2xl mx-auto leading-relaxed">
          {comparison.desc}
        </p>
      </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 space-y-12">
      
      <!-- 6-Point Comparison Matrix Table -->
      <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-sm space-y-5">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4">
          <div>
            <h3 class="text-lg font-extrabold text-slate-900">Head-to-Head Comparison Matrix</h3>
            <p class="text-xs text-slate-500">Comparing 6 essential criteria verified on live checkouts.</p>
          </div>
          <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
            ✓ 100% Tested Data
          </span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-xs text-left text-slate-700 border-collapse">
            <thead>
              <tr class="border-b border-slate-200 dark:border-slate-800 font-extrabold text-sm text-slate-900 dark:text-white bg-slate-50/80 dark:bg-slate-800/80">
                <th class="py-3.5 px-4 rounded-l-xl">Comparison Factor</th>
                <th class="py-3.5 px-4">{storeA?.name}</th>
                <th class="py-3.5 px-4 rounded-r-xl">{storeB?.name}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 font-medium">
              <tr>
                <td class="py-3.5 px-4 font-bold text-slate-900">1. Maximum Active Discount</td>
                <td class="py-3.5 px-4 font-bold text-rose-600">{comparison.maxDiscountA}</td>
                <td class="py-3.5 px-4 font-bold text-rose-600">{comparison.maxDiscountB}</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-bold text-slate-900">2. Starting Plan / Product Price</td>
                <td class="py-3.5 px-4">{comparison.startingPriceA}</td>
                <td class="py-3.5 px-4">{comparison.startingPriceB}</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-bold text-slate-900">3. Guarantee / Trial Policy</td>
                <td class="py-3.5 px-4">{comparison.guaranteeA}</td>
                <td class="py-3.5 px-4">{comparison.guaranteeB}</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-bold text-slate-900">4. Supported Delivery &amp; Regions</td>
                <td class="py-3.5 px-4">{comparison.regionsA}</td>
                <td class="py-3.5 px-4">{comparison.regionsB}</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-bold text-slate-900">5. Best Use Case</td>
                <td class="py-3.5 px-4 text-slate-600">{comparison.bestForA}</td>
                <td class="py-3.5 px-4 text-slate-600">{comparison.bestForB}</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-bold text-slate-900">6. Verification QA Score</td>
                <td class="py-3.5 px-4 font-black text-indigo-600 text-sm">{comparison.scoreA}</td>
                <td class="py-3.5 px-4 font-black text-indigo-600 text-sm">{comparison.scoreB}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Editorial Verdict Box -->
      <div class="bg-gradient-to-br from-indigo-50 via-purple-50/60 to-rose-50/60 rounded-3xl p-6 sm:p-8 border border-indigo-200/80 shadow-md space-y-3">
        <div class="flex items-center gap-2.5">
          <span class="w-8 h-8 rounded-xl bg-indigo-600 text-white font-black text-xs flex items-center justify-center">★</span>
          <div>
            <span class="text-[10px] font-bold uppercase tracking-wider text-indigo-600">Editorial Verdict</span>
            <h3 class="text-base sm:text-lg font-extrabold text-slate-900">{comparison.verdictTitle}</h3>
          </div>
        </div>
        <p class="text-xs sm:text-sm text-slate-700 leading-relaxed font-normal">
          {comparison.verdictBody}
        </p>
      </div>

      <!-- Direct Active Coupon Cards for Both Brands -->
      <div class="space-y-6">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-extrabold text-slate-900">Active Coupons for Both Brands</h3>
          <span class="text-xs text-slate-500">Tested live today</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Store A Deals -->
          <div class="space-y-4">
            <div class="flex items-center justify-between pb-2 border-b border-slate-200">
              <div class="flex items-center gap-2">
                {storeA && <BrandLogo store={storeA} size="sm" />}
                <span class="text-sm font-extrabold text-slate-900">{storeA?.name}</span>
              </div>
              <a href={`${base}/stores/${storeA?.slug}/`} class="text-xs font-bold text-indigo-600 hover:text-indigo-700">View all ({dealsA.length}) →</a>
            </div>

            <div class="space-y-3">
              {dealsA.slice(0, 3).map(deal => (
                <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm flex flex-col justify-between space-y-3">
                  <div class="flex items-start justify-between gap-2">
                    <div>
                      <span class="text-[10px] font-black text-rose-600 bg-rose-50 px-2 py-0.5 rounded border border-rose-200">{deal.discountBadge}</span>
                      <h4 class="text-xs font-bold text-slate-900 mt-1 line-clamp-1">{deal.title}</h4>
                      <p class="text-[11px] text-slate-500 line-clamp-1 mt-0.5">{deal.description}</p>
                    </div>
                  </div>
                  <div class="flex items-center justify-between pt-2 border-t border-slate-100">
                    <span class="font-mono text-xs font-bold bg-slate-100 text-slate-900 px-2.5 py-1 rounded border border-slate-200">{deal.code || 'ACTIVATED'}</span>
                    <a href={deal.affiliateUrl || storeA?.primaryAffiliateUrl} target="_blank" rel="nofollow sponsored" class="px-3.5 py-1.5 rounded-xl bg-slate-900 hover:bg-indigo-600 text-white text-xs font-bold transition">Get Code ↗</a>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Store B Deals -->
          <div class="space-y-4">
            <div class="flex items-center justify-between pb-2 border-b border-slate-200">
              <div class="flex items-center gap-2">
                {storeB && <BrandLogo store={storeB} size="sm" />}
                <span class="text-sm font-extrabold text-slate-900">{storeB?.name}</span>
              </div>
              <a href={`${base}/stores/${storeB?.slug}/`} class="text-xs font-bold text-indigo-600 hover:text-indigo-700">View all ({dealsB.length}) →</a>
            </div>

            <div class="space-y-3">
              {dealsB.slice(0, 3).map(deal => (
                <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm flex flex-col justify-between space-y-3">
                  <div class="flex items-start justify-between gap-2">
                    <div>
                      <span class="text-[10px] font-black text-rose-600 bg-rose-50 px-2 py-0.5 rounded border border-rose-200">{deal.discountBadge}</span>
                      <h4 class="text-xs font-bold text-slate-900 mt-1 line-clamp-1">{deal.title}</h4>
                      <p class="text-[11px] text-slate-500 line-clamp-1 mt-0.5">{deal.description}</p>
                    </div>
                  </div>
                  <div class="flex items-center justify-between pt-2 border-t border-slate-100">
                    <span class="font-mono text-xs font-bold bg-slate-100 text-slate-900 px-2.5 py-1 rounded border border-slate-200">{deal.code || 'ACTIVATED'}</span>
                    <a href={deal.affiliateUrl || storeB?.primaryAffiliateUrl} target="_blank" rel="nofollow sponsored" class="px-3.5 py-1.5 rounded-xl bg-slate-900 hover:bg-indigo-600 text-white text-xs font-bold transition">Get Code ↗</a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</BaseLayout>
