---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BrandLogo from '../../components/BrandLogo.astro';
import { STORES_DATA, COUPONS_DATA } from '../../data/couponsData';
import { getUniqueCleanStores } from '../../utils/dealNormalizer';
import { 
  generateComparisonPairs, 
  calculateStoreMetrics, 
  generateComparisonFaqSchema,
  type ComparisonPair,
  type StoreComparisonMetrics
} from '../../utils/comparisonMatrix';

export const prerender = true;

export async function getStaticPaths() {
  const cleanStores = getUniqueCleanStores(STORES_DATA, COUPONS_DATA);
  const pairs = generateComparisonPairs(cleanStores, COUPONS_DATA);

  return pairs.map(p => {
    const dataA = cleanStores.find(s => s.slug === p.storeA || s.originalSlug === p.storeA) || STORES_DATA.find(s => s.slug === p.storeA);
    const dataB = cleanStores.find(s => s.slug === p.storeB || s.originalSlug === p.storeB) || STORES_DATA.find(s => s.slug === p.storeB);
    const dealsA = COUPONS_DATA.filter(d => d.storeSlug === p.storeA || d.storeSlug === dataA?.originalSlug || d.storeSlug === dataA?.slug);
    const dealsB = COUPONS_DATA.filter(d => d.storeSlug === p.storeB || d.storeSlug === dataB?.originalSlug || d.storeSlug === dataB?.slug);

    const metricsA = calculateStoreMetrics(dealsA, dataA);
    const metricsB = calculateStoreMetrics(dealsB, dataB);

    return {
      params: { pair: p.slug },
      props: {
        comparison: p,
        storeA: dataA,
        storeB: dataB,
        dealsA,
        dealsB,
        metricsA,
        metricsB
      }
    };
  });
}

interface Props {
  comparison: ComparisonPair;
  storeA: any;
  storeB: any;
  dealsA: any[];
  dealsB: any[];
  metricsA: StoreComparisonMetrics;
  metricsB: StoreComparisonMetrics;
}

const { comparison, storeA, storeB, dealsA, dealsB, metricsA, metricsB } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Generate Dynamic Schema.org structured data including Breadcrumbs, Products and FAQPage
const faqSchema = generateComparisonFaqSchema(comparison, storeA, storeB, metricsA, metricsB);

const breadcrumbs = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://promoradar.store/" },
      { "@type": "ListItem", "position": 2, "name": "Compare", "item": "https://promoradar.store/compare/" },
      { "@type": "ListItem", "position": 3, "name": `${storeA?.name} vs ${storeB?.name}`, "item": `https://promoradar.store/compare/${comparison.slug}/` }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": comparison.title,
    "description": comparison.desc,
    "url": `https://promoradar.store/compare/${comparison.slug}/`
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": `${storeA?.name} Promo Offers`,
    "description": comparison.bestForA,
    "brand": { "@type": "Brand", "name": storeA?.name },
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": "USD",
      "lowPrice": "2.00",
      "highPrice": "199.00",
      "offerCount": dealsA.length || 1,
      "priceSpecification": {
        "@type": "PriceSpecification",
        "description": metricsA.maxDiscount
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": `${storeB?.name} Promo Offers`,
    "description": comparison.bestForB,
    "brand": { "@type": "Brand", "name": storeB?.name },
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": "USD",
      "lowPrice": "2.00",
      "highPrice": "199.00",
      "offerCount": dealsB.length || 1,
      "priceSpecification": {
        "@type": "PriceSpecification",
        "description": metricsB.maxDiscount
      }
    }
  },
  faqSchema
];

// OpenGraph Card lookup
import fs from 'node:fs';
import path from 'node:path';

const candidateCardName = `compare_${comparison.slug.replace(/-/g, '_')}_landscape.webp`;
const publicCardPath = path.resolve(process.cwd(), process.cwd().endsWith('deals-portal') ? `public/images/social-cards/${candidateCardName}` : `deals-portal/public/images/social-cards/${candidateCardName}`);
const ogImageUrl = fs.existsSync(publicCardPath) ? `/images/social-cards/${candidateCardName}` : undefined;

// Serialise only the 2 compared stores deals into modal cross-sell map
const pairDealsMap: Record<string, Array<{ id: string; title: string; code: string; badge: string; affiliateUrl: string }>> = {};
if (storeA?.slug) {
  pairDealsMap[storeA.slug] = dealsA.slice(0, 4).map(d => ({
    id: d.id,
    title: d.title,
    code: d.code,
    badge: d.discountBadge,
    affiliateUrl: d.affiliateUrl
  }));
}
if (storeB?.slug) {
  pairDealsMap[storeB.slug] = dealsB.slice(0, 4).map(d => ({
    id: d.id,
    title: d.title,
    code: d.code,
    badge: d.discountBadge,
    affiliateUrl: d.affiliateUrl
  }));
}
---

<BaseLayout
  title={`${comparison.title} — PromoRadar`}
  description={comparison.desc}
  activePath={`/compare/${comparison.slug}/`}
  schemas={breadcrumbs}
  ogImage={ogImageUrl}
  storeDealsMap={pairDealsMap}
>
  <Header activePath="/compare" />

  <main class="flex-1">
    <!-- Breadcrumb Nav -->
    <div class="border-b border-slate-200 dark:border-white/10 bg-white dark:bg-slate-900 py-3">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400" aria-label="Breadcrumb">
          <a href={`${base}/`} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Home</a>
          <span>/</span>
          <a href={`${base}/compare/`} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Compare</a>
          <span>/</span>
          <span class="text-slate-900 dark:text-white font-bold">{storeA?.name} vs {storeB?.name}</span>
        </nav>
      </div>
    </div>

    <!-- Header Section with Side-by-Side Brand Logos -->
    <div class="bg-gradient-to-b from-indigo-950 via-slate-900 to-slate-900 text-white py-12 px-4 sm:px-6 lg:px-8 border-b border-slate-800">
      <div class="max-w-5xl mx-auto text-center space-y-5">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/20 border border-indigo-400/30 text-indigo-300 text-xs font-semibold">
          <span>⚔️ Head-to-Head Showdown</span>
          <span>•</span>
          <span>{comparison.category}</span>
          <span>•</span>
          <span>Verified Checkout Rates</span>
        </div>

        <!-- Brand Logos Side-by-Side Pill -->
        <div class="inline-flex items-center gap-5 bg-white/10 backdrop-blur-md p-3 px-6 rounded-3xl border border-white/15 shadow-xl">
          <div class="flex items-center gap-2.5">
            {storeA && <BrandLogo store={storeA} size="md" />}
            <div class="text-left">
              <div class="text-sm font-extrabold text-white">{storeA?.name}</div>
              <div class="text-[10px] text-amber-300 font-bold">{metricsA.maxDiscount}</div>
            </div>
          </div>

          <span class="font-black text-sm text-rose-400 px-2 py-0.5 rounded-full bg-black/40 border border-white/10">VS</span>

          <div class="flex items-center gap-2.5">
            {storeB && <BrandLogo store={storeB} size="md" />}
            <div class="text-left">
              <div class="text-sm font-extrabold text-white">{storeB?.name}</div>
              <div class="text-[10px] text-amber-300 font-bold">{metricsB.maxDiscount}</div>
            </div>
          </div>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">
          {storeA?.name} <span class="text-indigo-400">vs</span> {storeB?.name}
        </h1>
        <p class="text-slate-300 text-xs sm:text-sm max-w-2xl mx-auto leading-relaxed">
          {comparison.desc}
        </p>
      </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 space-y-12">
      
      <!-- 1. Dynamic Promo & Savings Overview Matrix Table -->
      <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 border border-slate-200/90 dark:border-white/10 shadow-sm space-y-5">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 dark:border-slate-800 pb-4">
          <div>
            <h2 class="text-lg font-extrabold text-slate-900 dark:text-white flex items-center gap-2">
              <span>📊 Real-Time Promo Code & Savings Matrix</span>
            </h2>
            <p class="text-xs text-slate-500 dark:text-slate-400">Live discount comparison computed directly from verified partner feeds.</p>
          </div>
          <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 px-3 py-1 rounded-full border border-emerald-200 dark:border-emerald-800/40 w-fit">
            ✓ Live Verified Metrics
          </span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-xs text-left text-slate-700 dark:text-slate-300 border-collapse">
            <thead>
              <tr class="border-b border-slate-200 dark:border-slate-800 font-extrabold text-sm text-slate-900 dark:text-white bg-slate-50/80 dark:bg-slate-800/80">
                <th class="py-3.5 px-4 rounded-l-xl">Promotional Metric</th>
                <th class="py-3.5 px-4">{storeA?.name}</th>
                <th class="py-3.5 px-4 rounded-r-xl">{storeB?.name}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 font-medium">
              <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
                <td class="py-3.5 px-4 font-bold text-slate-900 dark:text-white">🔥 Maximum Active Discount</td>
                <td class="py-3.5 px-4 font-black text-rose-600 dark:text-rose-400 text-sm">{metricsA.maxDiscount}</td>
                <td class="py-3.5 px-4 font-black text-rose-600 dark:text-rose-400 text-sm">{metricsB.maxDiscount}</td>
              </tr>
              <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
                <td class="py-3.5 px-4 font-bold text-slate-900 dark:text-white">🎟️ Active Coupon Codes</td>
                <td class="py-3.5 px-4 font-mono font-bold text-indigo-600 dark:text-indigo-400">{metricsA.activeCodesCount} Direct Codes ({metricsA.totalDeals} Deals)</td>
                <td class="py-3.5 px-4 font-mono font-bold text-indigo-600 dark:text-indigo-400">{metricsB.activeCodesCount} Direct Codes ({metricsB.totalDeals} Deals)</td>
              </tr>
              <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
                <td class="py-3.5 px-4 font-bold text-slate-900 dark:text-white">💰 Average Estimated Savings (EST. SAVINGS)</td>
                <td class="py-3.5 px-4 font-bold text-emerald-600 dark:text-emerald-400">{metricsA.estSavings}</td>
                <td class="py-3.5 px-4 font-bold text-emerald-600 dark:text-emerald-400">{metricsB.estSavings}</td>
              </tr>
              <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
                <td class="py-3.5 px-4 font-bold text-slate-900 dark:text-white">🛡️ Checkout Success Rate</td>
                <td class="py-3.5 px-4 font-mono font-bold text-emerald-600 dark:text-emerald-400">{metricsA.verifiedRate}</td>
                <td class="py-3.5 px-4 font-mono font-bold text-emerald-600 dark:text-emerald-400">{metricsB.verifiedRate}</td>
              </tr>
              <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
                <td class="py-3.5 px-4 font-bold text-slate-900 dark:text-white">🌐 Official Store Domain</td>
                <td class="py-3.5 px-4 text-slate-500 dark:text-slate-400 font-mono">{storeA?.cleanDomain || storeA?.websiteUrl}</td>
                <td class="py-3.5 px-4 text-slate-500 dark:text-slate-400 font-mono">{storeB?.cleanDomain || storeB?.websiteUrl}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- 2. Detailed 6-Point Comparison Matrix Table -->
      <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 border border-slate-200/90 dark:border-white/10 shadow-sm space-y-5">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
          <div>
            <h3 class="text-lg font-extrabold text-slate-900 dark:text-white">Head-to-Head Feature Matrix</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">Comparing essential terms verified on live merchant checkouts.</p>
          </div>
          <span class="text-xs font-bold text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/40 px-3 py-1 rounded-full border border-indigo-200 dark:border-indigo-800/40">
            ✓ 100% Tested
          </span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-xs text-left text-slate-700 dark:text-slate-300 border-collapse">
            <thead>
              <tr class="border-b border-slate-200 dark:border-slate-800 font-extrabold text-sm text-slate-900 dark:text-white bg-slate-50/80 dark:bg-slate-800/80">
                <th class="py-3.5 px-4 rounded-l-xl">Factor</th>
                <th class="py-3.5 px-4">{storeA?.name}</th>
                <th class="py-3.5 px-4 rounded-r-xl">{storeB?.name}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 font-medium">
              <tr>
                <td class="py-3.5 px-4 font-bold text-slate-900 dark:text-white">1. Starting Product / Service Price</td>
                <td class="py-3.5 px-4">{comparison.startingPriceA}</td>
                <td class="py-3.5 px-4">{comparison.startingPriceB}</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-bold text-slate-900 dark:text-white">2. Guarantee / Return Policy</td>
                <td class="py-3.5 px-4">{comparison.guaranteeA}</td>
                <td class="py-3.5 px-4">{comparison.guaranteeB}</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-bold text-slate-900 dark:text-white">3. Supported Delivery &amp; Regions</td>
                <td class="py-3.5 px-4">{comparison.regionsA}</td>
                <td class="py-3.5 px-4">{comparison.regionsB}</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-bold text-slate-900 dark:text-white">4. Best Use Case</td>
                <td class="py-3.5 px-4 text-slate-600 dark:text-slate-400">{comparison.bestForA}</td>
                <td class="py-3.5 px-4 text-slate-600 dark:text-slate-400">{comparison.bestForB}</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-bold text-slate-900 dark:text-white">5. Verification QA Score</td>
                <td class="py-3.5 px-4 font-black text-indigo-600 dark:text-indigo-400 text-sm">{comparison.scoreA}</td>
                <td class="py-3.5 px-4 font-black text-indigo-600 dark:text-indigo-400 text-sm">{comparison.scoreB}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- 3. Editorial Verdict Box -->
      <div class="bg-gradient-to-br from-indigo-50 via-purple-50/60 to-rose-50/60 dark:from-slate-800 dark:via-indigo-950/40 dark:to-slate-800 rounded-3xl p-6 sm:p-8 border border-indigo-200/80 dark:border-indigo-500/20 shadow-md space-y-3">
        <div class="flex items-center gap-2.5">
          <span class="w-8 h-8 rounded-xl bg-indigo-600 text-white font-black text-xs flex items-center justify-center">★</span>
          <div>
            <span class="text-[10px] font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">Editorial Verdict</span>
            <h3 class="text-base sm:text-lg font-extrabold text-slate-900 dark:text-white">{comparison.verdictTitle}</h3>
          </div>
        </div>
        <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed font-normal">
          {comparison.verdictBody}
        </p>
      </div>

      <!-- 4. Direct Active Coupon Cards for Both Brands -->
      <div class="space-y-6">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-extrabold text-slate-900 dark:text-white">Active Coupons for Both Brands</h3>
          <span class="text-xs text-slate-500 dark:text-slate-400">Tested live today</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Store A Deals -->
          <div class="space-y-4">
            <div class="flex items-center justify-between pb-2 border-b border-slate-200 dark:border-slate-800">
              <div class="flex items-center gap-2">
                {storeA && <BrandLogo store={storeA} size="sm" />}
                <span class="text-sm font-extrabold text-slate-900 dark:text-white">{storeA?.name}</span>
              </div>
              <a href={`${base}/stores/${storeA?.slug}/`} class="text-xs font-bold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700">View all ({dealsA.length}) →</a>
            </div>

            <div class="space-y-3">
              {dealsA.slice(0, 4).map(deal => (
                <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 border border-slate-200 dark:border-white/10 shadow-sm flex flex-col justify-between space-y-3">
                  <div class="flex items-start justify-between gap-2">
                    <div>
                      <span class="text-[10px] font-black text-rose-600 bg-rose-50 dark:bg-rose-950/40 dark:text-rose-400 px-2 py-0.5 rounded border border-rose-200 dark:border-rose-900/40">{deal.discountBadge}</span>
                      <h4 class="text-xs font-bold text-slate-900 dark:text-white mt-1 line-clamp-1">{deal.title}</h4>
                      <p class="text-[11px] text-slate-500 dark:text-slate-400 line-clamp-1 mt-0.5">{deal.description}</p>
                    </div>
                  </div>
                  <div class="flex items-center justify-between pt-2 border-t border-slate-100 dark:border-slate-800">
                    <span class="font-mono text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white px-2.5 py-1 rounded border border-slate-200 dark:border-slate-700">{deal.code || 'ACTIVATED'}</span>
                    <a href={deal.affiliateUrl || storeA?.primaryAffiliateUrl} target="_blank" rel="nofollow sponsored" class="px-3.5 py-1.5 rounded-xl bg-slate-900 hover:bg-indigo-600 text-white text-xs font-bold transition">Get Code ↗</a>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Store B Deals -->
          <div class="space-y-4">
            <div class="flex items-center justify-between pb-2 border-b border-slate-200 dark:border-slate-800">
              <div class="flex items-center gap-2">
                {storeB && <BrandLogo store={storeB} size="sm" />}
                <span class="text-sm font-extrabold text-slate-900 dark:text-white">{storeB?.name}</span>
              </div>
              <a href={`${base}/stores/${storeB?.slug}/`} class="text-xs font-bold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700">View all ({dealsB.length}) →</a>
            </div>

            <div class="space-y-3">
              {dealsB.slice(0, 4).map(deal => (
                <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 border border-slate-200 dark:border-white/10 shadow-sm flex flex-col justify-between space-y-3">
                  <div class="flex items-start justify-between gap-2">
                    <div>
                      <span class="text-[10px] font-black text-rose-600 bg-rose-50 dark:bg-rose-950/40 dark:text-rose-400 px-2 py-0.5 rounded border border-rose-200 dark:border-rose-900/40">{deal.discountBadge}</span>
                      <h4 class="text-xs font-bold text-slate-900 dark:text-white mt-1 line-clamp-1">{deal.title}</h4>
                      <p class="text-[11px] text-slate-500 dark:text-slate-400 line-clamp-1 mt-0.5">{deal.description}</p>
                    </div>
                  </div>
                  <div class="flex items-center justify-between pt-2 border-t border-slate-100 dark:border-slate-800">
                    <span class="font-mono text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white px-2.5 py-1 rounded border border-slate-200 dark:border-slate-700">{deal.code || 'ACTIVATED'}</span>
                    <a href={deal.affiliateUrl || storeB?.primaryAffiliateUrl} target="_blank" rel="nofollow sponsored" class="px-3.5 py-1.5 rounded-xl bg-slate-900 hover:bg-indigo-600 text-white text-xs font-bold transition">Get Code ↗</a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- 5. SEO FAQ Section with Schema.org FAQPage -->
      <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 border border-slate-200/90 dark:border-white/10 shadow-sm space-y-6">
        <div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">Frequently Asked Questions</span>
          <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white mt-1">
            {storeA?.name} vs {storeB?.name} Promo Codes FAQ
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
            Expert answers on coupon validity, stackability, and checkout discount differences between {storeA?.name} and {storeB?.name}.
          </p>
        </div>

        <div class="space-y-4">
          {faqSchema.mainEntity.map(faq => (
            <div class="p-4 sm:p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-white/5 space-y-2">
              <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <span class="text-indigo-600 dark:text-indigo-400">Q:</span> {faq.name}
              </h3>
              <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed pl-5">
                {faq.acceptedAnswer.text}
              </p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer />
</BaseLayout>
