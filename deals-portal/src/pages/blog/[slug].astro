---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { BLOG_ARTICLES, type BlogArticle } from '../../data/blogArticles';
import { Calendar, Clock, ArrowLeft, Tag, ShieldCheck, ChevronRight, HelpCircle } from 'lucide-astro';

export const prerender = true;

export function getStaticPaths() {
  return BLOG_ARTICLES.map(article => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

interface Props {
  article: BlogArticle;
}

const { article } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Article + FAQPage Schema
const articleSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": article.title,
      "description": article.description,
      "image": `https://promoradar.store${article.featuredImage}`,
      "datePublished": `${article.publishedAt}T08:00:00+00:00`,
      "dateModified": `${article.updatedAt}T08:00:00+00:00`,
      "author": {
        "@type": "Organization",
        "name": article.author.name
      },
      "publisher": {
        "@type": "Organization",
        "name": "PromoRadar",
        "url": "https://promoradar.store",
        "logo": "https://promoradar.store/icons/icon-512x512.png"
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": `https://promoradar.store/blog/${article.slug}/`
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": article.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://promoradar.store/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Blog",
          "item": "https://promoradar.store/blog/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": article.title,
          "item": `https://promoradar.store/blog/${article.slug}/`
        }
      ]
    }
  ]
};
---

<BaseLayout
  title={article.seoTitle || `${article.title} | PromoRadar`}
  description={article.description}
  activePath="/blog"
>
  <Header activePath="/blog" />

  <main class="flex-1 bg-slate-50 dark:bg-slate-950 transition-colors duration-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-10">
      
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
        <a href={`${base}/`} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition">Home</a>
        <ChevronRight class="w-3.5 h-3.5" />
        <a href={`${base}/blog/`} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition">Blog</a>
        <ChevronRight class="w-3.5 h-3.5" />
        <span class="text-slate-900 dark:text-slate-200 font-semibold truncate max-w-[240px] sm:max-w-none">
          {article.title}
        </span>
      </nav>

      <!-- Article Header -->
      <header class="space-y-4">
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="text-xs font-extrabold uppercase tracking-wider px-3 py-1 rounded-full bg-indigo-50 dark:bg-indigo-900/50 text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800">
            {article.category}
          </span>
          <div class="flex items-center gap-4 text-xs text-slate-500 dark:text-slate-400">
            <span class="flex items-center gap-1.5">
              <Calendar class="w-3.5 h-3.5" />
              {article.publishedAt}
            </span>
            <span class="flex items-center gap-1.5">
              <Clock class="w-3.5 h-3.5" />
              {article.readingTime}
            </span>
          </div>
        </div>

        <h1 class="text-2xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
          {article.title}
        </h1>

        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
          {article.description}
        </p>

        <!-- Author / Editorial Trust Badge -->
        <div class="flex items-center justify-between pt-4 border-t border-slate-200/80 dark:border-slate-800 text-xs">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold text-xs">
              PR
            </div>
            <div>
              <div class="font-bold text-slate-900 dark:text-white">{article.author.name}</div>
              <div class="text-[11px] text-slate-500 dark:text-slate-400">{article.author.role}</div>
            </div>
          </div>
          <div class="hidden sm:flex items-center gap-1.5 text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 px-2.5 py-1 rounded-md border border-emerald-200 dark:border-emerald-800">
            <ShieldCheck class="w-3.5 h-3.5" />
            <span>100% Fact-Checked Pricing</span>
          </div>
        </div>
      </header>

      <!-- Linked Merchant Highlights Card -->
      {article.relatedStores && article.relatedStores.length > 0 && (
        <section class="bg-gradient-to-r from-indigo-50/80 to-slate-50 dark:from-indigo-950/30 dark:to-slate-900/40 rounded-2xl p-5 border border-indigo-100 dark:border-indigo-900/60 shadow-xs space-y-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2 text-xs font-bold text-indigo-950 dark:text-indigo-200 uppercase tracking-wide">
              <Tag class="w-4 h-4 text-indigo-600 dark:text-indigo-400" />
              <span>Verified Retailers &amp; Deals Mentioned in this Guide</span>
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {article.relatedStores.map(store => (
              <a
                href={`${base}/stores/${store.slug}/`}
                class="flex items-center justify-between p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 hover:border-indigo-300 dark:hover:border-indigo-700 transition shadow-xs group"
              >
                <div>
                  <div class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition">
                    {store.name}
                  </div>
                  {store.note && (
                    <div class="text-[11px] text-slate-500 dark:text-slate-400">
                      {store.note}
                    </div>
                  )}
                </div>
                {store.discountBadge && (
                  <span class="text-xs font-extrabold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 px-2.5 py-1 rounded-md border border-emerald-100 dark:border-emerald-800 shrink-0 ml-2">
                    {store.discountBadge}
                  </span>
                )}
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Article Body Markdown / Rendered HTML Content -->
      <article class="bg-white dark:bg-slate-900 rounded-2xl p-6 sm:p-10 border border-slate-200/90 dark:border-slate-800 shadow-sm prose prose-slate dark:prose-invert max-w-none text-slate-800 dark:text-slate-200 leading-relaxed text-sm sm:text-base">
        <div class="space-y-6" set:html={article.content.replace(/\n\n/g, '<br/><br/>').replace(/### (.*?)\n/g, '<h3 class="text-xl font-bold text-slate-900 dark:text-white mt-6 mb-3">$1</h3>').replace(/#### (.*?)\n/g, '<h4 class="text-lg font-bold text-slate-800 dark:text-slate-200 mt-4 mb-2">$1</h4>').replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')} />
      </article>

      <!-- FAQ Section -->
      {article.faqs && article.faqs.length > 0 && (
        <section class="bg-white dark:bg-slate-900 rounded-2xl p-6 sm:p-8 border border-slate-200/90 dark:border-slate-800 shadow-sm space-y-5">
          <div class="flex items-center gap-2 text-base font-bold text-slate-900 dark:text-white">
            <HelpCircle class="w-5 h-5 text-indigo-600 dark:text-indigo-400" />
            <span>Frequently Asked Questions</span>
          </div>
          <div class="divide-y divide-slate-100 dark:divide-slate-800 space-y-4 pt-1">
            {article.faqs.map(faq => (
              <div class="pt-4 space-y-1.5">
                <h4 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white">
                  {faq.question}
                </h4>
                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                  {faq.answer}
                </p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Back to Blog Navigation -->
      <div class="pt-4 flex items-center justify-between">
        <a
          href={`${base}/blog/`}
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs sm:text-sm font-bold text-slate-700 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition shadow-xs"
        >
          <ArrowLeft class="w-4 h-4" />
          <span>Back to All Articles</span>
        </a>
        <a
          href={`${base}/stores/`}
          class="text-xs sm:text-sm font-bold text-indigo-600 dark:text-indigo-400 hover:underline"
        >
          Browse All Stores ↗
        </a>
      </div>

    </div>
  </main>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</BaseLayout>

