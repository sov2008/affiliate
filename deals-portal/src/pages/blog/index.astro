---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { BLOG_ARTICLES } from '../../data/blogArticles';
import { BookOpen, Calendar, Clock, ArrowRight, ShieldCheck, Tag, Sparkles } from 'lucide-astro';

export const prerender = true;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// CollectionPage Schema
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "PromoRadar Shopping Intelligence & Savings Blog",
  "description": "Expert shopping guides, verified discount analysis, Black Friday timing tactics, and consumer savings strategies.",
  "url": "https://promoradar.store/blog/",
  "publisher": {
    "@type": "Organization",
    "name": "PromoRadar",
    "url": "https://promoradar.store",
    "logo": "https://promoradar.store/icons/icon-512x512.png"
  },
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": BLOG_ARTICLES.map((article, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": `https://promoradar.store/blog/${article.slug}/`,
      "name": article.title
    }))
  }
};
---

<BaseLayout
  title="PromoRadar Blog | Shopping Intelligence, Deal Breakdowns & Savings Guides"
  description="Master smart online shopping with empirical discount analysis, holiday sale schedules, verified promo code roundups, and tech comparisons."
  activePath="/blog"
>
  <Header activePath="/blog" />

  <main class="flex-1 bg-slate-50 dark:bg-slate-950 transition-colors duration-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 space-y-12">
      
      <!-- Hero Banner -->
      <section class="text-center max-w-3xl mx-auto space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-50 dark:bg-indigo-950/60 border border-indigo-200/80 dark:border-indigo-800 text-indigo-700 dark:text-indigo-300 text-xs font-bold tracking-wide uppercase shadow-xs">
          <Sparkles class="w-3.5 h-3.5 text-indigo-500 animate-pulse" />
          <span>Shopping Intelligence &amp; Verified Trends</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
          Smarter Buying. Zero AI Fluff.
        </h1>
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 leading-relaxed max-w-2xl mx-auto">
          In-depth retail investigations, verified promotional schedules, and empirical tests to help you capture genuine savings across global brands.
        </p>
      </section>

      <!-- Featured Grid -->
      <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {BLOG_ARTICLES.map((article, idx) => (
          <article class="flex flex-col bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/90 dark:border-slate-800 shadow-sm hover:shadow-md transition duration-200 overflow-hidden group">
            
            <!-- Category & Badge Header -->
            <div class="p-6 pb-4 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class="text-[11px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded-md bg-indigo-50 dark:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300 border border-indigo-100 dark:border-indigo-800">
                    {article.category}
                  </span>
                  <div class="flex items-center gap-1.5 text-[11px] text-slate-500 dark:text-slate-400">
                    <Clock class="w-3 h-3" />
                    <span>{article.readingTime}</span>
                  </div>
                </div>

                <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition leading-snug mb-2.5">
                  <a href={`${base}/blog/${article.slug}/`}>
                    {article.title}
                  </a>
                </h2>

                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed line-clamp-3 mb-4">
                  {article.description}
                </p>
              </div>

              <!-- Store Cross-Linking Chips -->
              {article.relatedStores && article.relatedStores.length > 0 && (
                <div class="pt-3 border-t border-slate-100 dark:border-slate-800 mb-4">
                  <div class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2 flex items-center gap-1">
                    <Tag class="w-3 h-3" />
                    <span>Verified Brand Perks</span>
                  </div>
                  <div class="flex flex-wrap gap-1.5">
                    {article.relatedStores.slice(0, 3).map(store => (
                      <a
                        href={`${base}/stores/${store.slug}/`}
                        class="text-[11px] font-semibold px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 hover:bg-indigo-50 dark:hover:bg-indigo-950 text-slate-700 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition border border-slate-200/60 dark:border-slate-700"
                        title={`Browse verified coupons for ${store.name}`}
                      >
                        {store.name}
                        {store.discountBadge && <span class="text-emerald-600 dark:text-emerald-400 ml-1 font-bold">({store.discountBadge})</span>}
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>

            <!-- Footer Card Action -->
            <div class="px-6 py-3.5 bg-slate-50/80 dark:bg-slate-900/60 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs">
              <span class="text-slate-500 dark:text-slate-400 flex items-center gap-1.5 text-[11px]">
                <Calendar class="w-3 h-3" />
                <span>{article.publishedAt}</span>
              </span>
              <a
                href={`${base}/blog/${article.slug}/`}
                class="inline-flex items-center gap-1 font-bold text-indigo-600 dark:text-indigo-400 hover:gap-1.5 transition-all text-xs"
              >
                <span>Read Full Guide</span>
                <ArrowRight class="w-3.5 h-3.5" />
              </a>
            </div>
          </article>
        ))}
      </section>

      <!-- Trust Bar / Quality Guarantee -->
      <section class="bg-indigo-900 text-white rounded-2xl p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-md">
        <div class="space-y-1.5 text-center sm:text-left">
          <div class="inline-flex items-center gap-1.5 text-indigo-200 text-xs font-extrabold uppercase tracking-wide">
            <ShieldCheck class="w-4 h-4 text-emerald-400" />
            <span>Zero Affiliate Hype Standard</span>
          </div>
          <h3 class="text-xl sm:text-2xl font-bold">Real Benchmarks, Direct Feeds</h3>
          <p class="text-xs sm:text-sm text-indigo-200/90 max-w-xl">
            Every price point, coupon validity timeframe, and voucher code referenced in our guides is checked against live merchant affiliate APIs.
          </p>
        </div>
        <a
          href={`${base}/stores/`}
          class="shrink-0 px-5 py-2.5 rounded-xl bg-white text-indigo-950 font-bold text-xs sm:text-sm hover:bg-indigo-50 transition shadow-sm"
        >
          Explore All 800+ Stores ↗
        </a>
      </section>

    </div>
  </main>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
</BaseLayout>

