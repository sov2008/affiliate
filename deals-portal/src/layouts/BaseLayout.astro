---
import '../styles/global.css';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import CouponRevealModal from '../components/CouponRevealModal.astro';
import VerificationGuaranteeModal from '../components/VerificationGuaranteeModal.astro';
import MobileQRModal from '../components/MobileQRModal.astro';
import CouponPulseModal from '../components/CouponPulseModal.astro';
import BookmarkletModal from '../components/BookmarkletModal.astro';
import SmartRecoveryOffer from '../components/SmartRecoveryOffer.astro';
import PagePreloader from '../components/PagePreloader.astro';
import SavedDealsModal from '../components/SavedDealsModal.astro';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  activePath?: string;
  schemas?: any[];
  ogImage?: string;
  ogType?: string;
  storeDealsMap?: Record<string, Array<{ id: string; title: string; code: string; badge: string; affiliateUrl: string }>>;
}

const {
  title,
  description,
  canonicalUrl,
  activePath = '/',
  schemas = [],
  ogImage,
  ogType = 'website',
  storeDealsMap
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://promoradar.store';
const fullCanonical = canonicalUrl || `${siteUrl}${Astro.url.pathname}`;
const defaultOgImage = `${siteUrl}/images/promoradar-og.png`;
const resolvedOgImage = ogImage ? (ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`) : defaultOgImage;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth bg-slate-50 text-slate-900 antialiased selection:bg-indigo-600 selection:text-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="p:domain_verify" content="9809e84106b1c9cf5dcdcb45246046e5" />
    <link rel="canonical" href={fullCanonical} />
    <!-- International SEO Hreflang Tags (affiliate-seo-pro & localization-pro) -->
    <link rel="alternate" hreflang="x-default" href={fullCanonical} />
    <link rel="alternate" hreflang="en" href={fullCanonical} />
    <link rel="alternate" hreflang="ar" href={fullCanonical} />
    <link rel="alternate" hreflang="es" href={fullCanonical} />
    <link rel="alternate" hreflang="pt" href={fullCanonical} />
    <link rel="alternate" hreflang="de" href={fullCanonical} />
    <link rel="alternate" hreflang="uk-UA" href={fullCanonical} />
    <link rel="alternate" hreflang="pl" href={fullCanonical} />
    <link rel="alternate" hreflang="cs" href={fullCanonical} />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <meta name="theme-color" content="#4f46e5" />
    <meta name="mitgo-verification" content="dcaf1a95-f2a7-42c8-b67f-4a463294ee43" />
    <meta name="admitad-verification" content="fa9e3fd878" />
    <meta name="mitgo-verification" content="fa9e3fd878" />
    <meta name="google-site-verification" content="EoZOJUjFA2-uy89WOLVK-1Ze_Ub5mzaLpKVlh9ZYCVk" />

    <!-- Google Fonts: Inter & JetBrains Mono (Zero External Icon Font Payload) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet" />
    </noscript>

    <!-- OpenGraph Metadata -->
    <meta property="og:site_name" content="PromoRadar — Verified Promo Codes & Deals" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter Cards Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Google Analytics 4 (GA4) -->
    <GoogleAnalytics measurementId="G-ZKTJYVZEPT" />

    <!-- Theme & Instant Language Initialization Script -->
    <script is:inline>
      (function() {
        try {
          const storedLang = localStorage.getItem('promoradar_lang');
          if (storedLang) {
            document.documentElement.lang = storedLang;
            if (storedLang === 'ar') {
              document.documentElement.dir = 'rtl';
            }
          }
        } catch (e) {}
      })();
    </script>
    <!-- Theme Initialization Script (Instant, Zero-FOUC, Defaults to OS preference) -->
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('promoradar_theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Structured Data -->
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 overflow-x-clip w-full font-sans">
    <PagePreloader />
    <slot />
    <CouponRevealModal storeDealsMap={storeDealsMap} />
    <VerificationGuaranteeModal />
    <MobileQRModal />
    <CouponPulseModal />
    <BookmarkletModal />
    <SmartRecoveryOffer />
    <SavedDealsModal />

    <!-- Global Sleek Toast Notification -->
    <div
      id="globalToast"
      class="fixed bottom-6 right-6 z-50 hidden items-center gap-2.5 bg-slate-900/95 dark:bg-slate-800/95 text-white text-xs font-semibold px-4 py-3 rounded-2xl shadow-2xl border border-slate-700/80 backdrop-blur-md transition-all"
      role="status"
    >
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span id="globalToastMessage">Notification message</span>
    </div>

    <script defer src="/scripts/smooth-images.js"></script>
    <script>
      import { initClientI18n } from '../i18n/client';
      import { initRecommendationListeners } from '../utils/recommendationEngine';
      initClientI18n();
      initRecommendationListeners();
    </script>
  </body>
</html>
