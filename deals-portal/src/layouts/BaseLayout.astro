---
import '../styles/global.css';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import CouponRevealModal from '../components/CouponRevealModal.astro';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  activePath?: string;
  schemas?: any[];
}

const {
  title,
  description,
  canonicalUrl,
  activePath = '/',
  schemas = []
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://promoradar.store';
const fullCanonical = canonicalUrl || `${siteUrl}${Astro.url.pathname}`;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth bg-slate-50 text-slate-900 antialiased selection:bg-indigo-600 selection:text-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonical} />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <meta name="theme-color" content="#4f46e5" />
    <meta name="mitgo-verification" content="dcaf1a95-f2a7-42c8-b67f-4a463294ee43" />
    <meta name="admitad-verification" content="fa9e3fd878" />
    <meta name="mitgo-verification" content="fa9e3fd878" />
    <meta name="google-site-verification" content="EoZOJUjFA2-uy89WOLVK-1Ze_Ub5mzaLpKVlh9ZYCVk" />

    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet" />

    <!-- OpenGraph Metadata -->
    <meta property="og:site_name" content="PromoRadar — Verified Promo Codes & Deals" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullCanonical} />

    <!-- Google Analytics 4 (GA4) -->
    <GoogleAnalytics measurementId="G-ZKTJYVZEPT" />

    <!-- Theme Initialization Script (Instant, Zero-FOUC, Defaults to OS preference) -->
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('promoradar_theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Structured Data -->
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 overflow-x-hidden w-full font-sans">
    <slot />
    <CouponRevealModal />

    <!-- Global Sleek Toast Notification -->
    <div
      id="globalToast"
      class="fixed bottom-6 right-6 z-50 hidden items-center gap-2.5 bg-slate-900/95 dark:bg-slate-800/95 text-white text-xs font-semibold px-4 py-3 rounded-2xl shadow-2xl border border-slate-700/80 backdrop-blur-md transition-all"
      role="status"
    >
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span id="globalToastMessage">Notification message</span>
    </div>

    <script is:inline>
      window.showPromoToast = function(msg) {
        const toast = document.getElementById('globalToast');
        const text = document.getElementById('globalToastMessage');
        if (!toast || !text) return;
        text.textContent = msg;
        toast.classList.remove('hidden');
        toast.classList.add('flex');
        clearTimeout(window.__toastTimer);
        window.__toastTimer = setTimeout(() => {
          toast.classList.add('hidden');
          toast.classList.remove('flex');
        }, 2800);
      };

      // Global Delegated Click Listener for .deal-share-btn
      document.addEventListener('click', (e) => {
        const shareBtn = e.target.closest('.deal-share-btn');
        if (shareBtn) {
          e.preventDefault();
          e.stopPropagation();
          const title = shareBtn.getAttribute('data-share-title') || 'PromoRadar Discount Voucher';
          const desc = shareBtn.getAttribute('data-share-desc') || '';
          const url = shareBtn.getAttribute('data-share-url') || window.location.href;

          const sharePayload = {
            title: `${title} | PromoRadar`,
            text: `${desc ? desc + ' — ' : ''}Verified discount on PromoRadar:`,
            url: url
          };

          if (navigator.share) {
            navigator.share(sharePayload).catch(() => {
              // Fallback to clipboard if cancelled or rejected
              navigator.clipboard?.writeText(url).then(() => {
                window.showPromoToast('Deal link copied to clipboard! Share it with friends ✨');
              });
            });
          } else {
            navigator.clipboard?.writeText(url).then(() => {
              window.showPromoToast('Deal link copied to clipboard! Share it with friends ✨');
            }).catch(() => {
              window.showPromoToast('Unable to copy link');
            });
          }
        }
      });
    </script>
  </body>
</html>
