---
import { getStoreDomain } from '../data/storeDomains';
import { BRAND_VECTOR_SVGS } from '../data/brandVectorIcons';

interface Props {
  store: {
    slug: string;
    name: string;
    cleanDomain?: string;
    websiteUrl?: string;
    logoText?: string;
  };
  size?: 'sm' | 'md' | 'lg' | 'xl';
  unstyled?: boolean;
  class?: string;
}

const { store, size = 'md', unstyled = false, class: className = '' } = Astro.props;

// Check for direct pure vector SVG mark first
const vectorSvg = BRAND_VECTOR_SVGS[store.slug] || BRAND_VECTOR_SVGS[store.name.toLowerCase().replace(/\s+/g, '')] || '';

// Domain resolution for logos using registry first, then cleanDomain, then websiteUrl
let domain = getStoreDomain(store.name) || getStoreDomain(store.slug) || store.cleanDomain || '';
if (!domain && store.websiteUrl) {
  try {
    domain = new URL(store.websiteUrl).hostname.replace(/^www\./, '');
  } catch (e) {
    domain = '';
  }
}

// Fallback letter monogram
const initials = store.name ? store.name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase() : 'PR';

// Sizing classes - ergonomically enlarged for crisp brand recognition without breaking layout
const sizeClasses = {
  sm: 'w-9 h-9 sm:w-10 sm:h-10 rounded-xl text-xs',
  md: 'w-11 h-11 rounded-xl text-xs font-extrabold',
  lg: 'w-16 h-16 sm:w-20 sm:h-20 rounded-2xl text-lg sm:text-xl font-black',
  xl: 'w-20 h-20 sm:w-24 sm:h-24 md:w-28 md:h-28 rounded-3xl text-2xl sm:text-3xl font-black'
};

const paddingClasses = {
  sm: 'p-1 sm:p-1.5',
  md: 'p-1',
  lg: 'p-2 sm:p-2.5',
  xl: 'p-3 sm:p-3.5'
};

const containerSize = sizeClasses[size] || sizeClasses.md;
const pad = unstyled ? 'p-0' : (paddingClasses[size] || paddingClasses.md);
const styleClasses = unstyled
  ? 'bg-transparent border-0 shadow-none rounded-none'
  : 'bg-white border border-slate-200/90 shadow-xs';

// Multi-Tier Logo sources:
// Tier 1: Clearbit Logo API
const clearbitUrl = domain ? `https://logo.clearbit.com/${domain}` : '';
// Tier 2: Google HD Favicon
const googleFaviconUrl = domain ? `https://www.google.com/s2/favicons?domain=${domain}&sz=128` : '';
---

<div class={`brand-logo-container brand-logo-box relative ${containerSize} ${pad} ${styleClasses} flex items-center justify-center shrink-0 overflow-hidden group ${className}`}>
  {vectorSvg ? (
    <div class="w-full h-full flex items-center justify-center" set:html={vectorSvg} />
  ) : domain ? (
    <img
      src={clearbitUrl}
      alt={`${store.name} logo`}
      class="w-full h-full object-contain filter group-hover:scale-105 transition-transform duration-200"
      loading="lazy"
      data-fallback-google={googleFaviconUrl}
      onerror={`
        if (this.src !== this.getAttribute('data-fallback-google')) {
          this.src = this.getAttribute('data-fallback-google');
        } else {
          this.style.display = 'none';
          if (this.nextElementSibling) this.nextElementSibling.style.display = 'flex';
        }
      `}
    />
  ) : null}

  <!-- Tier 3: Styled gradient monogram badge fallback (only when no vector & no domain) -->
  {!vectorSvg && (
    <div
      class={`brand-logo-monogram w-full h-full rounded-xl bg-gradient-to-br from-indigo-600 via-indigo-700 to-rose-600 text-white font-black items-center justify-center shadow-inner ${domain ? 'hidden' : 'flex'}`}
    >
      {initials}
    </div>
  )}
</div>
