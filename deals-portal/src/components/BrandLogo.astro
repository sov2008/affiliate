---
import { getStoreDomain } from '../data/storeDomains';

interface Props {
  store: {
    slug: string;
    name: string;
    cleanDomain?: string;
    websiteUrl?: string;
    logoText?: string;
  };
  size?: 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
}

const { store, size = 'md', class: className = '' } = Astro.props;

// Multi-Tier Domain resolution using authoritative store registry, cleanDomain, or websiteUrl
let domain = getStoreDomain(store.name) || getStoreDomain(store.slug) || '';
if (!domain && store.cleanDomain && !/terms|program|locking|affiliate|^[a-z]{5}\.com$/i.test(store.cleanDomain)) {
  domain = store.cleanDomain;
}
if (!domain && store.websiteUrl && !/terms|program|locking|affiliate|flirtcheck/i.test(store.websiteUrl)) {
  try {
    domain = new URL(store.websiteUrl).hostname.replace(/^www\./, '');
  } catch (e) {
    domain = '';
  }
}
if (!domain || /^[a-z]{5}\.com$/i.test(domain)) {
  const fallbackSlug = (store.slug || store.name || '').toLowerCase().replace(/[^a-z0-9]/g, '');
  if (fallbackSlug.length >= 3) domain = `${fallbackSlug}.com`;
}

// Fallback letter monogram
const initials = store.name ? store.name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase() : 'PR';

// Sizing classes - ergonomically enlarged for crisp brand recognition without breaking layout
const sizeClasses = {
  sm: 'w-10 h-10 sm:w-11 sm:h-11 rounded-xl text-xs',
  md: 'w-12 h-12 rounded-xl text-xs font-extrabold',
  lg: 'w-16 h-16 sm:w-20 sm:h-20 rounded-2xl text-lg sm:text-xl font-black',
  xl: 'w-20 h-20 sm:w-24 sm:h-24 md:w-28 md:h-28 rounded-3xl text-2xl sm:text-3xl font-black'
};

const paddingClasses = {
  sm: 'p-0.5',
  md: 'p-0.5',
  lg: 'p-1.5 sm:p-2',
  xl: 'p-2 sm:p-2.5'
};

const containerSize = sizeClasses[size] || sizeClasses.md;
const pad = paddingClasses[size] || paddingClasses.md;

const pixelDimensions = {
  sm: { w: 44, h: 44 },
  md: { w: 48, h: 48 },
  lg: { w: 80, h: 80 },
  xl: { w: 112, h: 112 }
};
const dims = pixelDimensions[size] || pixelDimensions.md;

// Multi-Tier Logo sources:
// Priority local logo for verified merchants with brand-compliant transparent logo assets
const localLogoUrl = store.slug ? `/logos/${store.slug}.png` : '';
// Fallbacks for stores without local assets
const googleFaviconUrl = domain ? `https://www.google.com/s2/favicons?domain=${domain}&sz=128` : '';
const duckFaviconUrl = domain ? `https://icons.duckduckgo.com/ip3/${domain}.ico` : '';

// Dresscode standard: Always prefer verified local transparent logo first
const primaryLogo = localLogoUrl || googleFaviconUrl;
const secondaryFallback = googleFaviconUrl || duckFaviconUrl;
---

<div class={`brand-logo-container brand-logo-box relative ${containerSize} ${pad} bg-transparent border-0 flex items-center justify-center shrink-0 overflow-hidden group ${className}`}>
  {primaryLogo ? (
    <img
      src={primaryLogo}
      alt={`${store.name} logo`}
      width={dims.w}
      height={dims.h}
      class="w-full h-full object-contain filter group-hover:scale-105 transition-transform duration-200"
      loading="lazy"
      decoding="async"
      data-fallback-google={googleFaviconUrl}
      data-fallback-duck={secondaryFallback}
      data-fallback-local={localLogoUrl}
      onerror={`
        if (this.getAttribute('data-fallback-google') && this.src !== this.getAttribute('data-fallback-google')) {
          this.src = this.getAttribute('data-fallback-google');
        } else if (this.getAttribute('data-fallback-duck') && this.src !== this.getAttribute('data-fallback-duck')) {
          this.src = this.getAttribute('data-fallback-duck');
        } else {
          this.style.display = 'none';
          if (this.nextElementSibling) this.nextElementSibling.style.display = 'flex';
        }
      `}
    />
  ) : null}

  <!-- Tier 4: Styled gradient monogram badge fallback -->
  <div
    class={`brand-logo-monogram w-full h-full rounded-xl bg-gradient-to-br from-indigo-600 via-indigo-700 to-rose-600 text-white font-black items-center justify-center shadow-inner ${domain ? 'hidden' : 'flex'}`}
  >
    {initials}
  </div>
</div>
