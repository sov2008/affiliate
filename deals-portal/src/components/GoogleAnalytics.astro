---
// Google Analytics 4 (GA4) Tag & Comprehensive Telemetry Engine for PromoRadar
interface Props {
  measurementId?: string;
}

const { measurementId = 'G-ZKTJYVZEPT' } = Astro.props;
---

<!-- Google tag (gtag.js) -->
<script async src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`}></script>
<script is:inline define:vars={{ measurementId }}>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', measurementId, {
    send_page_view: true,
    cookie_flags: 'SameSite=None;Secure'
  });

  function setupPromoradarTelemetry() {
    if (window._promoradar_telemetry_attached) return;
    window._promoradar_telemetry_attached = true;

    // 1. Coupon Code Reveal & Copy Tracking (Core Conversion Event)
    document.addEventListener('click', function(e) {
      var target = e.target;
      if (!target) return;

      // Track Promo Code Reveal Button
      var revealBtn = target.closest ? target.closest('[data-reveal-deal]') : null;
      if (revealBtn && typeof window.gtag === 'function') {
        try {
          var dealData = JSON.parse(revealBtn.getAttribute('data-reveal-deal') || '{}');
          window.gtag('event', 'coupon_reveal', {
            event_category: 'Conversion',
            event_label: dealData.storeName || 'unknown_store',
            deal_id: dealData.id,
            store_name: dealData.storeName,
            promo_code: dealData.code,
            discount_badge: dealData.badge,
            page_path: window.location.pathname
          });
        } catch (err) {}
      }

      // Track Manual Copy Code in Modal
      var copyBtn = target.closest ? target.closest('#copyCodeBtn, #copyStoreCodeBtn') : null;
      if (copyBtn && typeof window.gtag === 'function') {
        window.gtag('event', 'coupon_copy', {
          event_category: 'Conversion',
          event_label: 'clipboard_copy',
          page_path: window.location.pathname
        });
      }

      // Track Outbound Affiliate Links
      var link = target.closest ? target.closest('a') : null;
      if (!link || !link.href) return;
      var href = link.href;

      var isAffiliate = (link.rel && link.rel.indexOf('sponsored') !== -1) ||
                        href.indexOf('admitad.com') !== -1 ||
                        href.indexOf('/g/') !== -1 ||
                        href.indexOf('rzekl.com') !== -1 ||
                        href.indexOf('track') !== -1;

      if (isAffiliate && typeof window.gtag === 'function') {
        window.gtag('event', 'affiliate_click', {
          event_category: 'Monetization',
          event_label: href,
          target_url: href,
          page_path: window.location.pathname,
          transport_type: 'beacon'
        });
      }

      // Track Category & Region Filter Clicks
      var catBtn = target.closest ? target.closest('.main-cat-btn, .region-filter-btn, .type-filter-btn') : null;
      if (catBtn && typeof window.gtag === 'function') {
        var filterType = catBtn.getAttribute('data-cat') ? 'category' : (catBtn.getAttribute('data-region') ? 'region' : 'type');
        var filterVal = catBtn.getAttribute('data-cat') || catBtn.getAttribute('data-region') || catBtn.getAttribute('data-type');
        window.gtag('event', 'filter_change', {
          event_category: 'Engagement',
          filter_type: filterType,
          filter_value: filterVal,
          page_path: window.location.pathname
        });
      }
    }, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPromoradarTelemetry);
  } else {
    setupPromoradarTelemetry();
  }
  document.addEventListener('astro:page-load', function() {
    window._promoradar_telemetry_attached = false;
    setupPromoradarTelemetry();
  });
</script>
