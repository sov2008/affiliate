---
import { STORES_DATA } from '../data/couponsData';
import { getUniqueCleanStores } from '../utils/dealNormalizer';
import { LOCALES, DEFAULT_LOCALE, getTranslation } from '../i18n/ui';
import { Flame, Store, Shapes, ArrowLeftRight, HelpCircle, ChevronDown, Sun, Moon, Heart, Globe, Sparkles, Shield, Zap, Home, Shirt, Plane, Gamepad2, Coffee, Car, ShoppingBag, ArrowRight, Compass, Percent, Layers, HeartHandshake, Glasses, Menu, X, Tag, BookOpen } from 'lucide-astro';

interface Props {
  activePath?: string;
  locale?: string;
}

const { activePath = '/', locale = DEFAULT_LOCALE } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const uniqueStores = getUniqueCleanStores(STORES_DATA);
const storesCount = STORES_DATA.length; // 248 verified affiliate programs
const t = getTranslation(locale);
const currentLocaleConfig = LOCALES[locale] || LOCALES[DEFAULT_LOCALE];

// Prepare categorized stores for RetailMeNot-style Mega Menu
const megaCategories = [
  { name: 'Popular', key: 'popular', icon: Sparkles },
  { name: 'Privacy & Security', key: 'privacy', icon: Shield },
  { name: 'Electronics & Gadgets', key: 'electronics', icon: Zap },
  { name: 'Home & Living', key: 'home', icon: Home },
  { name: 'Fashion & Apparel', key: 'fashion', icon: Shirt },
  { name: 'Travel & Tours', key: 'travel', icon: Plane },
  { name: 'Gaming & Software', key: 'software', icon: Gamepad2 },
  { name: 'Food & Nutrition', key: 'food', icon: Coffee },
  { name: 'Auto & Mobility', key: 'auto', icon: Car },
  { name: 'E-Commerce & Wholesale', key: 'ecommerce', icon: ShoppingBag }
];

// Popular priority stores (like Amazon, Best Buy, etc. on RetailMeNot)
const popularStores = uniqueStores.filter(s => 
  ['expressvpn', 'nordvpn', 'surfshark', 'target', 'walmart', 'best-buy', 'aliexpress', 'dhgate', 'temu', 'hostinger', 'namecheap', 'shein', 'wayfair', 'viator', 'qvc', 'macys'].some(slug => (s.slug || '').toLowerCase().includes(slug)) ||
  (s.rating && s.rating >= 4.8)
).slice(0, 14);


// Smart Categories Data with verified deals counters, max discount & top stores
const smartCategories = [
  {
    slug: 'privacy-security',
    name: 'Privacy, VPN & Security',
    key: 'privacy',
    icon: Shield,
    desc: 'Military-grade VPNs, encrypted zero-knowledge password vaults & proxies.',
    discountBadge: 'Up to 82% OFF',
    featuredStores: ['ExpressVPN', 'NordVPN', 'Surfshark', 'Private Internet Access']
  },
  {
    slug: 'electronics-gadgets',
    name: 'Electronics & Portable Power',
    key: 'electronics',
    icon: Zap,
    desc: 'Power stations, solar generators, audio devices & smart accessories.',
    discountBadge: 'Up to 45% OFF',
    featuredStores: ['EcoFlow', 'Jackery', 'Bluetti', 'Baseus']
  },
  {
    slug: 'fashion-apparel',
    name: 'Fashion & Designer Apparel',
    key: 'fashion',
    icon: Shirt,
    desc: 'Worldwide on-trend designer fashion, footwear, denim & luxury jewelry.',
    discountBadge: 'Up to 60% OFF',
    featuredStores: ['SHEIN', 'ChicMe', 'Zaful', 'ASOS']
  },
  {
    slug: 'travel-tours',
    name: 'Travel, Flights & Desert Safaris',
    key: 'travel',
    icon: Plane,
    desc: 'Boutique hotel bookings, desert tours, Burj Khalifa tickets & flights.',
    discountBadge: 'Up to 25% OFF',
    featuredStores: ['Viator', 'Trip.com', 'Agoda', 'Klook']
  },
  {
    slug: 'gaming-software',
    name: 'Gaming & Digital Software',
    key: 'software',
    icon: Gamepad2,
    desc: 'Software licenses, PC gaming keys, streaming media & AI tools.',
    discountBadge: 'Up to 70% OFF',
    featuredStores: ['G2A', 'Kinguin', 'Eneba', 'Hostinger']
  },
  {
    slug: 'home-living',
    name: 'Home, Furniture & 3D Print',
    key: 'home',
    icon: Home,
    desc: 'Smart furniture, 3D printing equipment, modern organizers & decor.',
    discountBadge: 'Up to 40% OFF',
    featuredStores: ['Anycubic', 'Elegoo', 'Wayfair', 'Costway']
  },
  {
    slug: 'ecommerce-wholesale',
    name: 'E-Commerce & Wholesale Hubs',
    key: 'ecommerce',
    icon: ShoppingBag,
    desc: 'Global B2B wholesale platforms, factory-direct sourcing & department stores.',
    discountBadge: 'Up to $30 OFF',
    featuredStores: ['AliExpress', 'DHgate', 'Temu', 'Target']
  },
  {
    slug: 'auto-mobility',
    name: 'Auto & 4K Dashcams',
    key: 'auto',
    icon: Car,
    desc: 'Wireless CarPlay adapters, 4K night-vision dashcams & accessories.',
    discountBadge: 'Up to 35% OFF',
    featuredStores: ['VIOFO', 'Carlinkit', '70mai', 'Rexing']
  }
];
const storesByCategory: Record<string, typeof uniqueStores> = {
  popular: popularStores.length > 0 ? popularStores : uniqueStores.slice(0, 12),
  privacy: uniqueStores.filter(s => (s.category || '').toLowerCase().includes('privacy') || (s.category || '').toLowerCase().includes('security')).slice(0, 14),
  electronics: uniqueStores.filter(s => (s.category || '').toLowerCase().includes('electronic') || (s.category || '').toLowerCase().includes('gadget')).slice(0, 14),
  home: uniqueStores.filter(s => (s.category || '').toLowerCase().includes('home') || (s.category || '').toLowerCase().includes('living')).slice(0, 14),
  fashion: uniqueStores.filter(s => (s.category || '').toLowerCase().includes('fashion') || (s.category || '').toLowerCase().includes('apparel')).slice(0, 14),
  travel: uniqueStores.filter(s => (s.category || '').toLowerCase().includes('travel') || (s.category || '').toLowerCase().includes('tour')).slice(0, 14),
  software: uniqueStores.filter(s => (s.category || '').toLowerCase().includes('software') || (s.category || '').toLowerCase().includes('gaming')).slice(0, 14),
  food: uniqueStores.filter(s => (s.category || '').toLowerCase().includes('food') || (s.category || '').toLowerCase().includes('nutrition') || (s.category || '').toLowerCase().includes('beverage')).slice(0, 14),
  auto: uniqueStores.filter(s => (s.category || '').toLowerCase().includes('auto') || (s.category || '').toLowerCase().includes('mobility')).slice(0, 14),
  ecommerce: uniqueStores.filter(s => (s.category || '').toLowerCase().includes('commerce') || (s.category || '').toLowerCase().includes('wholesale') || (s.category || '').toLowerCase().includes('department')).slice(0, 14)
};
---

<!-- Sticky Main Glass Header (h-[68px]) -->
<header class="sticky top-0 z-40 h-[68px] bg-[#0B0F19] text-white border-b border-white/10 shadow-md transition-colors">
  <div class="max-w-7xl mx-auto h-full px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-4">
    
        <!-- Balanced PromoRadar Brand Lockup -->
    <a href={`${base}/`} class="pr-logo-root inline-flex items-center gap-1 sm:gap-1.5 group focus:outline-none select-none shrink-0" aria-label="PromoRadar Home">
      <!-- 1. Squircle Radar Icon (With One-Time Intro Animation) -->
      <div id="header-radar-badge" class="pr-logo-badge relative w-10 h-10 sm:w-11 sm:h-11 rounded-[13px] bg-gradient-to-b from-[#635BFF] via-[#4F46E5] to-[#312E81] p-[2px] shadow-md shadow-indigo-500/25 shrink-0 opacity-0 scale-90">
        <div class="w-full h-full rounded-[11px] bg-[#1E1B4B] flex items-center justify-center overflow-hidden relative">
          <svg class="w-9 h-9 sm:w-10 sm:h-10" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="stitch-sweep" x1="20" y1="20" x2="32" y2="8" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#10B981" stop-opacity="0.65" />
                <stop offset="100%" stop-color="#10B981" stop-opacity="0.0" />
              </linearGradient>
              <filter id="emerald-glow" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="1.5" result="blur" />
                <feMerge>
                  <feMergeNode in="blur" />
                  <feMergeNode in="SourceGraphic" />
                </feMerge>
              </filter>
            </defs>

            <circle cx="20" cy="20" r="15" stroke="#818CF8" stroke-opacity="0.45" stroke-width="1.2" />
            <circle cx="20" cy="20" r="10.5" stroke="#818CF8" stroke-opacity="0.35" stroke-width="1" />
            <circle cx="20" cy="20" r="6" stroke="#818CF8" stroke-opacity="0.35" stroke-width="1" />
            <line x1="20" y1="4" x2="20" y2="36" stroke="#818CF8" stroke-opacity="0.25" stroke-width="1" />
            <line x1="4" y1="20" x2="36" y2="20" stroke="#818CF8" stroke-opacity="0.25" stroke-width="1" />

            <g class="header-radar-sweep-group" id="header-radar-sweep-group">
              <path d="M20 20 L20 5 A15 15 0 0 1 31.5 10.4 Z" fill="url(#stitch-sweep)" />
              <line x1="20" y1="20" x2="30.6" y2="9.4" stroke="#34D399" stroke-width="1.8" stroke-linecap="round" />
            </g>

            <circle cx="28" cy="12" r="2.3" fill="#34D399" filter="url(#emerald-glow)" class="header-radar-blip-1" id="header-radar-blip-1" />
            <circle cx="25.5" cy="26.5" r="2" fill="#10B981" filter="url(#emerald-glow)" class="header-radar-blip-2" id="header-radar-blip-2" />

            <circle cx="20" cy="20" r="3" fill="#10B981" filter="url(#emerald-glow)" />
            <circle cx="20" cy="20" r="1.5" fill="#A7F3D0" />
          </svg>
        </div>
      </div>

      <!-- 2. Balanced Typography Lockup (Emerges from behind radar, slogan glides down from above) -->
      <div id="header-brand-block" class="flex flex-col justify-center overflow-hidden">
        <div id="header-brand-title" class="tracking-tight leading-none overflow-hidden flex items-baseline">
          <span class="pr-logo-title font-extrabold text-[20px] sm:text-[22px] text-white tracking-tight leading-none inline-flex items-baseline">
            Promo<span class="text-indigo-400">Radar</span>
          </span>
          <!-- .store rolls out smoothly from left to right as the finale -->
          <span id="header-brand-store-tag" class="text-[9.5px] sm:text-[10.5px] font-bold text-indigo-300/80 tracking-normal -ml-[1px] self-end">.store</span>
        </div>
        <div id="header-brand-sub" class="pr-logo-subtitle mt-0.5 overflow-hidden">
          <span class="text-[8.5px] uppercase tracking-[0.06em] font-bold text-slate-400 leading-none block whitespace-nowrap">
            Verified Promo Codes &amp; Deals
          </span>
        </div>
      </div>
    </a>

    <!-- Desktop Navigation Menu Tabs (Clean, Frameless, Pure Typography & Lucide Icons) -->
    <nav id="headerNavMenu" class="header-nav-menu hidden xl:flex items-center gap-1 text-xs font-bold" aria-label="Main Navigation">
      <a
        href={`${base}/`}
        class={`header-stagger-item flex items-center gap-1.5 px-3 py-2 rounded-xl border transition-all duration-200 whitespace-nowrap ${
          activePath === '/' 
            ? 'bg-indigo-500/15 border-indigo-500/35 text-indigo-400 font-extrabold shadow-sm shadow-indigo-500/20' 
            : 'border-transparent text-slate-300 hover:text-white hover:bg-white/5 hover:border-white/15'
        }`}
      >
        <Flame class="w-4 h-4" />
        <span data-i18n="allDeals">All Deals</span>
      </a>
      <a
        href={`${base}/events/black-friday/`}
        class={`header-stagger-item flex items-center gap-1.5 px-3 py-2 rounded-xl border transition-all duration-200 whitespace-nowrap ${
          activePath.startsWith('/events/black-friday') 
            ? 'bg-indigo-500/15 border-indigo-500/35 text-indigo-400 font-extrabold shadow-sm shadow-indigo-500/20' 
            : 'border-transparent text-slate-300 hover:text-white hover:bg-white/5 hover:border-white/15'
        }`}
      >
        <Tag class="w-4 h-4" />
        <span>Black Friday</span>
      </a>
      <!-- RetailMeNot Style Stores Mega Menu Dropdown -->
      <div class="relative group/stores header-stagger-item">
        <a
          href={`${base}/stores/`}
          id="headerStoresNavBtn"
          class={`flex items-center gap-1.5 px-3 py-2 rounded-xl border transition-all duration-200 whitespace-nowrap ${
            activePath.startsWith('/stores')
              ? 'bg-indigo-500/15 border-indigo-500/35 text-indigo-400 font-extrabold shadow-sm shadow-indigo-500/20' 
              : 'border-transparent text-slate-300 hover:text-white hover:bg-white/5 hover:border-white/15 group-hover/stores:bg-white/5 group-hover/stores:border-white/15 group-hover/stores:text-white'
          }`}
          aria-haspopup="true"
          aria-expanded="false"
        >
          <Store class="w-4 h-4" />
          <span data-i18n="stores">Stores</span>
          <span class="font-normal text-slate-400 text-[11px]">({storesCount})</span>
          <ChevronDown class="w-3.5 h-3.5 text-slate-400 group-hover/stores:rotate-180 transition-transform duration-200" />
        </a>

        <!-- 2-Column Split Dropdown (RetailMeNot Reverse-Engineered Architecture) -->
        <div
          id="storesMegaDropdown"
          class="hidden group-hover/stores:flex absolute top-full left-0 mt-1 w-[490px] bg-[#0E131F] border border-white/10 rounded-2xl shadow-2xl z-50 overflow-hidden backdrop-blur-xl animate-in fade-in slide-in-from-top-2 duration-200"
        >
          <!-- Left Column: Categories List (Width: 175px) -->
          <div class="w-[205px] bg-[#080B14] py-3 px-2 border-r border-white/10 shrink-0 space-y-0.5">
            {megaCategories.map((cat, idx) => {
              const IconComp = cat.icon;
              return (
                <button
                  type="button"
                  data-mega-cat={cat.key}
                  class={`mega-cat-btn w-full text-left px-2.5 py-2 rounded-xl text-xs font-semibold transition-all duration-150 flex items-center justify-between gap-1.5 cursor-pointer ${
                    idx === 0 
                      ? 'bg-indigo-600/20 text-indigo-400 font-bold border border-indigo-500/30' 
                      : 'text-slate-400 hover:text-white hover:bg-white/5 border border-transparent'
                  }`}
                >
                  <span class="flex items-center gap-2 truncate">
                    <IconComp class="w-3.5 h-3.5 shrink-0 opacity-80" />
                    <span class="truncate">{cat.name}</span>
                  </span>
                  <span class="text-[10px] text-slate-500 font-mono shrink-0">{(storesByCategory[cat.key] || []).length}</span>
                </button>
              );
            })}
          </div>

          <!-- Right Column: Stores List for the Selected Category (Width: 280px) -->
          <div class="flex-1 p-3.5 flex flex-col justify-between bg-[#0E131F]">
            <div>
              <div class="flex items-center justify-between pb-2 mb-2 border-b border-white/10">
                <span id="megaCurrentCatTitle" class="text-[11px] font-extrabold uppercase tracking-wider text-slate-400">Popular Stores</span>
                <a href={`${base}/stores/`} class="text-[11px] text-indigo-400 hover:text-indigo-300 font-bold transition flex items-center gap-1">
                  View All &rarr;
                </a>
              </div>

              <!-- Store Items Container -->
              {megaCategories.map((cat, idx) => (
                <div
                  id={`mega-store-list-${cat.key}`}
                  class={`mega-store-panel ${idx === 0 ? 'grid' : 'hidden'} grid-cols-2 gap-x-2 gap-y-1.5`}
                >
                  {(storesByCategory[cat.key] || []).map((store) => (
                    <a
                      href={`${base}/stores/${store.slug}/`}
                      class="flex items-center gap-2 p-1.5 rounded-lg hover:bg-white/10 text-slate-300 hover:text-white transition group/store truncate"
                      title={store.name}
                    >
                      <div class="w-5 h-5 rounded-md bg-white/5 border border-white/10 flex items-center justify-center text-[10px] font-bold text-indigo-400 shrink-0 uppercase">
                        {(store.name || 'S').charAt(0)}
                      </div>
                      <span class="text-xs font-medium truncate group-hover/store:text-white">{store.name}</span>
                    </a>
                  ))}
                  {(storesByCategory[cat.key] || []).length === 0 && (
                    <div class="col-span-2 py-4 text-center text-xs text-slate-500">
                      Explore all partner stores in the directory.
                    </div>
                  )}
                </div>
              ))}
            </div>

            <!-- Bottom Promo Bar in Dropdown -->
            <div class="pt-3 mt-3 border-t border-white/10 flex items-center justify-between text-[11px]">
              <span class="text-slate-400">All codes verified today</span>
              <a href={`${base}/stores/`} class="text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-500 px-3 py-1 rounded-lg transition shadow-sm">
                Browse Directory
              </a>
            </div>
          </div>
        </div>
      </div>
      <!-- Smart Categories Mega Menu Dropdown (RetailMeNot Split Architecture) -->
      <div class="relative group/categories header-stagger-item">
        <a
          href={`${base}/categories/`}
          id="headerCategoriesNavBtn"
          class={`flex items-center gap-1.5 px-3 py-2 rounded-xl border transition-all duration-200 whitespace-nowrap ${
            activePath.startsWith('/categories') 
              ? 'bg-indigo-500/15 border-indigo-500/35 text-indigo-400 font-extrabold shadow-sm shadow-indigo-500/20' 
              : 'border-transparent text-slate-300 hover:text-white hover:bg-white/5 hover:border-white/15 group-hover/categories:bg-white/5 group-hover/categories:border-white/15 group-hover/categories:text-white'
          }`}
          aria-haspopup="true"
          aria-expanded="false"
        >
          <Shapes class="w-4 h-4" />
          <span data-i18n="categories">Categories</span>
          <ChevronDown class="w-3.5 h-3.5 text-slate-400 group-hover/categories:rotate-180 transition-transform duration-200" />
        </a>

        <!-- 2-Column Split Dropdown for Smart Categories -->
        <div
          id="categoriesMegaDropdown"
          class="hidden group-hover/categories:flex absolute top-full left-0 mt-1 w-[530px] bg-[#0E131F] border border-white/10 rounded-2xl shadow-2xl z-50 overflow-hidden backdrop-blur-xl animate-in fade-in slide-in-from-top-2 duration-200"
        >
          <!-- Left Column: Category Selector List (Width: 220px) -->
          <div class="w-[220px] bg-[#080B14] py-3 px-2 border-r border-white/10 shrink-0 space-y-0.5">
            {smartCategories.map((cat, idx) => {
              const IconComponent = cat.icon;
              return (
                <button
                  type="button"
                  data-smart-cat={cat.key}
                  class={`smart-cat-btn w-full text-left px-2.5 py-2 rounded-xl text-xs font-semibold transition-all duration-150 flex items-center justify-between gap-1.5 cursor-pointer ${
                    idx === 0 
                      ? 'bg-indigo-600/20 text-indigo-400 font-bold border border-indigo-500/30' 
                      : 'text-slate-400 hover:text-white hover:bg-white/5 border border-transparent'
                  }`}
                >
                  <span class="flex items-center gap-2 truncate">
                    <IconComponent class="w-3.5 h-3.5 shrink-0 opacity-80" />
                    <span class="truncate">{cat.name.split('&')[0]}</span>
                  </span>
                  <span class="text-[9px] font-bold px-1.5 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/25 shrink-0">
                    {cat.discountBadge.replace('Up to ', '')}
                  </span>
                </button>
              );
            })}
          </div>

          <!-- Right Column: Smart Category Highlights, Stores & Quick Actions -->
          <div class="flex-1 p-4 flex flex-col justify-between bg-[#0E131F]">
            <div>
              {smartCategories.map((cat, idx) => {
                const CatIcon = cat.icon;
                return (
                  <div
                    id={`smart-cat-panel-${cat.key}`}
                    class={`smart-cat-panel ${idx === 0 ? 'block' : 'hidden'} space-y-3.5`}
                  >
                    <!-- Header with Icon & Verified Badge -->
                    <div class="flex items-start justify-between gap-2 border-b border-white/10 pb-2.5">
                      <div class="flex items-center gap-2">
                        <div class="w-7 h-7 rounded-lg bg-indigo-500/15 border border-indigo-500/30 flex items-center justify-center text-indigo-400 shrink-0">
                          <CatIcon class="w-4 h-4" />
                        </div>
                        <div>
                          <h4 class="text-xs font-extrabold text-white leading-tight">{cat.name}</h4>
                          <span class="text-[10px] text-emerald-400 font-semibold">{cat.discountBadge} verified savings</span>
                        </div>
                      </div>
                      <a
                        href={`${base}/categories/#${cat.slug}`}
                        class="text-[11px] font-bold text-indigo-400 hover:text-indigo-300 transition flex items-center gap-0.5 shrink-0"
                      >
                        Explore &rarr;
                      </a>
                    </div>

                    <!-- Description -->
                    <p class="text-[11px] text-slate-400 leading-relaxed">
                      {cat.desc}
                    </p>

                    <!-- Featured Stores in Category -->
                    <div>
                      <div class="text-[10px] uppercase font-bold tracking-wider text-slate-500 mb-1.5">Top Partner Stores</div>
                      <div class="flex flex-wrap gap-1.5">
                        {cat.featuredStores.map((storeName) => (
                          <a
                            href={`${base}/stores/${storeName.toLowerCase().replace(/[^a-z0-9]/g, '-')}/`}
                            class="text-xs px-2.5 py-1 rounded-lg bg-white/5 hover:bg-indigo-600/20 text-slate-300 hover:text-white border border-white/10 hover:border-indigo-500/30 transition flex items-center gap-1.5 font-medium"
                          >
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                            <span>{storeName}</span>
                          </a>
                        ))}
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>

            <!-- Bottom Action Footer -->
            <div class="pt-3 mt-3 border-t border-white/10 flex items-center justify-between text-[11px]">
              <span class="text-slate-400 flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>Active coupon feeds</span>
              </span>
              <a
                href={`${base}/categories/`}
                class="text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-500 px-3.5 py-1.5 rounded-lg transition shadow-md shadow-indigo-600/20 flex items-center gap-1"
              >
                <span>All Categories</span>
                <span>&rarr;</span>
              </a>
            </div>
          </div>
        </div>
      </div>
      <a
        href={`${base}/compare/`}
        class={`header-stagger-item flex items-center gap-1.5 px-3 py-2 rounded-xl border transition-all duration-200 whitespace-nowrap ${
          activePath.startsWith('/compare') 
            ? 'bg-indigo-500/15 border-indigo-500/35 text-indigo-400 font-extrabold shadow-sm shadow-indigo-500/20' 
            : 'border-transparent text-slate-300 hover:text-white hover:bg-white/5 hover:border-white/15'
        }`}
      >
        <ArrowLeftRight class="w-4 h-4" />
        <span data-i18n="compare">Compare</span>
      </a>
      <a
        href={`${base}/blog/`}
        class={`header-stagger-item flex items-center gap-1.5 px-3 py-2 rounded-xl border transition-all duration-200 whitespace-nowrap ${
          activePath.startsWith('/blog') 
            ? 'bg-indigo-500/15 border-indigo-500/35 text-indigo-400 font-extrabold shadow-sm shadow-indigo-500/20' 
            : 'border-transparent text-slate-300 hover:text-white hover:bg-white/5 hover:border-white/15'
        }`}
      >
        <BookOpen class="w-4 h-4" />
        <span>Blog</span>
      </a>
      <a
        href={`${base}/about/`}
