---
import { STORES_DATA } from '../data/couponsData';

interface Props {
  activePath?: string;
}

const { activePath = '/' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const storesCount = STORES_DATA.length;
---

<!-- Top Status Bar (Partner Network Feed & Live Telemetry) -->
<div class="bg-canvas-dark text-slate-200 text-xs border-b border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-1.5 flex flex-wrap items-center justify-between gap-2 text-[11px]">
    <div class="flex items-center gap-2 truncate">
      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span id="topBarFeedBadge">Feed: LIVE</span>
      </span>
      <span id="topBarFeedText" class="text-slate-300 truncate">⚡ Hand-tested promo codes &amp; direct affiliate deals • Updated: October 2026 • US Coupons 🇺🇸</span>
    </div>
    <div class="hidden sm:flex items-center gap-3 ml-auto font-mono text-[11px]">
      <span class="text-emerald-400 font-semibold flex items-center gap-1">
        <span class="material-symbols-outlined text-[13px]">verified</span>
        99.4% API Verification Rate
      </span>
      <span class="text-slate-500">•</span>
      <div id="topBarRegionSelector" class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-white/10 hover:bg-white/15 text-slate-200 border border-white/15 cursor-pointer transition" title="Active Target Region">
        <span>⚡</span>
        <span id="topBarSelectedRegionText">US Coupons 🇺🇸</span>
      </div>
      <span class="text-slate-500">•</span>
      <span class="text-slate-400">Automated sync active</span>
    </div>
  </div>
</div>

<!-- Sticky Glass Header -->
<header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-200/80 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-3">
      <!-- PromoRadar Brand Logo -->
      <a href={`${base}/`} class="flex items-center gap-2.5 text-left group shrink-0">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-600 via-indigo-700 to-rose-600 flex items-center justify-center text-white font-extrabold text-lg shadow-md shadow-indigo-500/20 group-hover:scale-105 transition">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9" stroke-width="2" class="opacity-40"></circle>
            <circle cx="12" cy="12" r="5" stroke-width="2" class="opacity-75"></circle>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 12l6-6"></path>
            <circle cx="12" cy="12" r="2" fill="currentColor"></circle>
          </svg>
        </div>
        <div>
          <span class="font-extrabold text-lg tracking-tight text-slate-900">PromoRadar</span>
          <p id="headerSubtitle" class="text-[11px] text-slate-500 leading-none mt-0.5">Verified Promo Codes &amp; Deals</p>
        </div>
      </a>

      <!-- Desktop Nav Tabs -->
      <nav class="hidden lg:flex items-center gap-1 bg-slate-100/80 p-1 rounded-xl border border-slate-200/70 shrink-0" aria-label="Main Navigation">
        <a
          href={`${base}/`}
          class={`nav-tab-link whitespace-nowrap shrink-0 flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-semibold transition ${
            activePath === '/' ? 'bg-white text-indigo-600 shadow-sm' : 'text-slate-600 hover:text-slate-900'
          }`}
        >
          <svg class="w-4 h-4 text-rose-500 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2c-1.5 2.5-3 5-3 8 0 3.3 2.7 6 6 6s6-2.7 6-6c0-3-1.5-5.5-3-8-.3.8-.7 1.5-1.2 2.1C15.8 7 15 5.5 15 4c-1 1.5-1.8 3.2-1.8 5 0 .6.2 1.2.5 1.7-.8-.4-1.7-.7-2.7-.7z"/>
          </svg>
          <span id="navDealsText">All Deals</span>
        </a>
        <a
          href={`${base}/stores/`}
          class={`nav-tab-link whitespace-nowrap shrink-0 flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-semibold transition ${
            activePath.startsWith('/stores') && !activePath.includes('/stores/') ? 'bg-white text-indigo-600 shadow-sm' : 'text-slate-600 hover:text-slate-900'
          }`}
        >
          <svg class="w-4 h-4 text-indigo-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
          </svg>
          <span id="navStoresText">Stores ({storesCount})</span>
        </a>
        <a
          href={`${base}/categories/`}
          class={`nav-tab-link whitespace-nowrap shrink-0 flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-semibold transition ${
            activePath.startsWith('/categories') ? 'bg-white text-indigo-600 shadow-sm' : 'text-slate-600 hover:text-slate-900'
          }`}
        >
          <svg class="w-4 h-4 text-indigo-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
          </svg>
          <span id="navCategoriesText">Categories</span>
        </a>
        <a
          href={`${base}/compare/`}
          class={`nav-tab-link whitespace-nowrap shrink-0 flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-semibold transition ${
            activePath.startsWith('/compare') ? 'bg-white text-indigo-600 shadow-sm' : 'text-slate-600 hover:text-slate-900'
          }`}
        >
          <svg class="w-4 h-4 text-rose-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
          </svg>
          <span id="navCompareText">Compare</span>
        </a>
        <a
          href={`${base}/about/`}
          class={`nav-tab-link whitespace-nowrap shrink-0 flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-semibold transition ${
            activePath.startsWith('/about') ? 'bg-white text-indigo-600 shadow-sm' : 'text-slate-600 hover:text-slate-900'
          }`}
        >
          <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span id="navAboutText">FAQ</span>
        </a>
      </nav>

      <!-- Right Header Actions with Spotlight Search Container -->
      <div class="flex items-center gap-2 shrink-0 relative">
        <div class="relative hidden sm:block w-44 xl:w-60 shrink-0" id="headerSearchWrapper">
          <input
            id="headerQuickSearch"
            type="text"
            placeholder="Search store or promo..."
            autocomplete="off"
            class="w-full pl-9 pr-3 py-2 text-sm bg-slate-100 hover:bg-slate-200/60 focus:bg-white rounded-xl border border-transparent focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 outline-none transition"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>

          <!-- Search Spotlight Floating Dropdown -->
          <div id="headerSearchSpotlight" class="hidden absolute top-full right-0 mt-2 w-80 sm:w-96 bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-slate-200/90 dark:border-slate-800 z-50 overflow-hidden animate-fadeIn">
            <div class="p-3 bg-slate-50 dark:bg-slate-800/60 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
              <span class="font-bold uppercase tracking-wider text-[10px] text-slate-400 dark:text-slate-400">Search Results</span>
              <span class="text-[10px] bg-slate-200/80 dark:bg-slate-700 px-1.5 py-0.5 rounded font-mono text-slate-600 dark:text-slate-300">ESC to close</span>
            </div>
            <div id="spotlightCategoriesList" class="p-2 space-y-1 max-h-36 overflow-y-auto border-b border-slate-100 dark:border-slate-800 hidden"></div>
            <div id="spotlightStoresList" class="p-2 space-y-1 max-h-48 overflow-y-auto border-b border-slate-100 dark:border-slate-800"></div>
            <div id="spotlightDealsList" class="p-2 space-y-1 max-h-60 overflow-y-auto"></div>
          </div>
        </div>


        <!-- Saved Deals Button (Triggers Drawer) -->
        <button id="headerSavedBtn" type="button" class="header-action-btn relative inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-sm font-semibold transition shrink-0 cursor-pointer" title="Saved Vouchers">
          <svg class="w-4 h-4 text-rose-500 fill-current" viewBox="0 0 24 24">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
          <span id="savedCountBadge" class="text-xs font-bold px-1.5 py-0.2 rounded-full bg-rose-100 text-rose-700 dark:bg-rose-500/20 dark:text-rose-300 shrink-0">0</span>
        </button>

        <!-- Light / Dark Theme Switcher Button -->
        <button
          id="themeToggleBtn"
          type="button"
          class="header-action-btn relative inline-flex items-center justify-center w-9 h-9 rounded-xl transition shrink-0 cursor-pointer"
          title="Toggle Light / Dark Theme"
          aria-label="Toggle theme"
        >
          <!-- Sun Icon (shown in dark mode) -->
          <svg id="themeIconSun" class="w-4 h-4 text-amber-400 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <!-- Moon Icon (shown in light mode) -->
          <svg id="themeIconMoon" class="w-4 h-4 text-slate-600 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>


      </div>
    </div>

    <!-- Mobile Scrollable Sub-nav -->
    <div class="flex lg:hidden items-center gap-1.5 overflow-x-auto no-scrollbar py-2 border-t border-slate-100">
      <a href={`${base}/`} class={`whitespace-nowrap shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold ${activePath === '/' ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-700'}`}>🔥 All Deals</a>
      <a href={`${base}/stores/`} class={`whitespace-nowrap shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold ${activePath.startsWith('/stores') && !activePath.includes('/stores/') ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-700'}`}>🏪 Stores ({storesCount})</a>
      <a href={`${base}/categories/`} class={`whitespace-nowrap shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold ${activePath.startsWith('/categories') ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-700'}`}>🗂 Categories</a>
      <a href={`${base}/compare/`} class={`whitespace-nowrap shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold ${activePath.startsWith('/compare') ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-700'}`}>⚖️ Compare</a>
      <a href={`${base}/about/`} class={`whitespace-nowrap shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold ${activePath.startsWith('/about') ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-700'}`}>❓ FAQ</a>
    </div>
  </div>
</header>

<!-- Saved Vouchers Slide-over Drawer -->
<div id="savedVouchersDrawerOverlay" class="fixed inset-0 z-50 hidden bg-slate-950/60 backdrop-blur-sm transition-opacity">
  <div class="fixed inset-y-0 right-0 max-w-full flex pl-10">
    <div class="w-screen max-w-md bg-white shadow-2xl flex flex-col border-l border-slate-200 animate-slideInRight">
      <!-- Drawer Header -->
      <div class="p-5 border-b border-slate-200 flex items-center justify-between bg-slate-50">
        <div class="flex items-center gap-2">
          <span class="w-8 h-8 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center font-bold">♥</span>
          <div>
            <h3 id="drawerSavedTitle" class="font-extrabold text-slate-900 text-base">Saved Vouchers</h3>
            <p id="drawerSavedSubtitle" class="text-xs text-slate-500">Saved in browser • No signup required</p>
          </div>
        </div>
        <button id="closeSavedDrawerBtn" type="button" class="w-8 h-8 rounded-full bg-slate-200/80 hover:bg-slate-300 text-slate-600 flex items-center justify-center text-sm font-bold cursor-pointer transition">✕</button>
      </div>

      <!-- Drawer Content -->
      <div id="savedDrawerDealsContainer" class="flex-1 overflow-y-auto p-5 space-y-3">
        <!-- Rendered dynamically -->
      </div>

      <!-- Drawer Footer -->
      <div class="p-4 border-t border-slate-200 bg-slate-50 flex items-center justify-between text-xs text-slate-500">
        <span id="savedDrawerCountLabel">0 vouchers saved</span>
        <button id="clearAllSavedBtn" type="button" class="text-rose-600 hover:text-rose-700 font-semibold cursor-pointer">Clear all</button>
      </div>
    </div>
  </div>
</div>



<!-- Floating Sticky Copied Voucher Bar -->
<div id="stickyCopiedBar" class="fixed bottom-4 left-1/2 -translate-x-1/2 z-40 hidden max-w-xl w-[92%] sm:w-auto bg-slate-900 text-white px-4 py-3 rounded-2xl shadow-2xl border border-slate-700 items-center justify-between gap-3 animate-fadeIn">
  <div class="flex items-center gap-2.5 min-w-0">
    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse shrink-0"></span>
    <span class="text-xs text-slate-300 truncate">
      <span id="stickyCopiedPrefix">Code copied:</span>
      <strong id="stickyCopiedCode" class="text-amber-300 font-mono font-bold">CODE</strong>
      <span id="stickyCopiedStore">for Store</span>
      <span id="stickyCopiedSuffix" class="hidden sm:inline text-slate-400">— Paste at checkout</span>
    </span>
  </div>
  <div class="flex items-center gap-2 shrink-0">
    <a id="stickyOutboundBtn" href="#" target="_blank" rel="nofollow sponsored" class="px-3 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold transition">Open Store ↗</a>
    <button id="closeStickyBarBtn" type="button" class="w-7 h-7 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white flex items-center justify-center text-xs font-bold transition cursor-pointer">✕</button>
  </div>
</div>

<script>
  import { STORES_DATA, COUPONS_DATA } from '../data/couponsData';
  import { STORE_DOMAINS_MAP } from '../data/storeDomains';


  // 2. Saved Vouchers Drawer & Real-Time Sync
  const savedDrawerOverlay = document.getElementById('savedVouchersDrawerOverlay');
  const closeSavedDrawerBtn = document.getElementById('closeSavedDrawerBtn');
  const headerSavedBtn = document.getElementById('headerSavedBtn');
  const clearAllSavedBtn = document.getElementById('clearAllSavedBtn');

  function getSavedDealIds(): string[] {
    try {
      return JSON.parse(localStorage.getItem('promoradar_saved_deals') || '[]');
    } catch {
      return [];
    }
  }

  function updateSavedBadge() {
    const ids = getSavedDealIds();
    const badge = document.getElementById('savedCountBadge');
    if (badge) badge.textContent = String(ids.length);
    const countLabel = document.getElementById('savedDrawerCountLabel');
    if (countLabel) countLabel.textContent = `${ids.length} vouchers saved`;
  }

  function renderSavedDrawer() {
    const ids = getSavedDealIds();
    const container = document.getElementById('savedDrawerDealsContainer');
    if (!container) return;

    if (ids.length === 0) {
      container.innerHTML = `
        <div class="text-center py-12 px-4 space-y-3">
          <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto text-xl">♥</div>
          <p class="text-xs text-slate-500 leading-relaxed">No saved vouchers yet. Tap the heart icon on any deal card to save it for quick access.</p>
        </div>
      `;
      return;
    }

    const savedDeals = COUPONS_DATA.filter(d => ids.includes(d.id));
    container.innerHTML = savedDeals.map(deal => `
      <div class="bg-slate-50 rounded-2xl p-3.5 border border-slate-200/90 relative group hover:bg-white transition shadow-sm">
        <button type="button" data-remove-saved="${deal.id}" class="absolute right-3 top-3 text-slate-400 hover:text-rose-600 text-xs transition" title="Remove">✕</button>
        <div class="flex items-center gap-2 mb-1.5">
          <span class="text-xs font-bold text-slate-900">${deal.storeName}</span>
          <span class="text-[10px] font-bold px-2 py-0.2 rounded bg-rose-50 text-rose-700 border border-rose-200">${deal.discountBadge}</span>
        </div>
        <p class="text-xs text-slate-700 font-semibold mb-2 line-clamp-1">${deal.title}</p>
        <div class="flex items-center justify-between gap-2 pt-2 border-t border-slate-200/60">
          <span class="font-mono text-xs font-black text-indigo-950 bg-white px-2 py-1 rounded border border-slate-200">${deal.code || 'NO CODE'}</span>
          <a href="${deal.affiliateUrl || '#'}" target="_blank" rel="nofollow sponsored" class="px-3 py-1 rounded-lg bg-slate-900 text-white text-[11px] font-bold hover:bg-indigo-600 transition">Claim ↗</a>
        </div>
      </div>
    `).join('');

    container.querySelectorAll('[data-remove-saved]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-remove-saved');
        if (!id) return;
        const current = getSavedDealIds().filter(x => x !== id);
        localStorage.setItem('promoradar_saved_deals', JSON.stringify(current));
        updateSavedBadge();
        renderSavedDrawer();
        window.dispatchEvent(new CustomEvent('promoradar_saved_updated', { detail: { id, saved: false } }));
      });
    });
  }

  headerSavedBtn?.addEventListener('click', () => {
    renderSavedDrawer();
    savedDrawerOverlay?.classList.remove('hidden');
  });

  closeSavedDrawerBtn?.addEventListener('click', () => {
    savedDrawerOverlay?.classList.add('hidden');
  });

  savedDrawerOverlay?.addEventListener('click', (e) => {
    if (e.target === savedDrawerOverlay) {
      savedDrawerOverlay.classList.add('hidden');
    }
  });

  clearAllSavedBtn?.addEventListener('click', () => {
    localStorage.setItem('promoradar_saved_deals', JSON.stringify([]));
    updateSavedBadge();
    renderSavedDrawer();
    window.dispatchEvent(new CustomEvent('promoradar_saved_updated', { detail: { cleared: true } }));
  });



  // 4. Spotlight Search Dropdown Engine
  const headerQuickSearch = document.getElementById('headerQuickSearch') as HTMLInputElement;
  const headerSearchSpotlight = document.getElementById('headerSearchSpotlight');
  const spotlightStoresList = document.getElementById('spotlightStoresList');
  const spotlightDealsList = document.getElementById('spotlightDealsList');
  const spotlightCategoriesList = document.getElementById('spotlightCategoriesList');

  const HEADER_CATEGORIES = [
    { slug: 'privacy-security', name: 'Privacy, VPN & Cybersecurity', icon: '🛡' },
    { slug: 'dating-lifestyle', name: 'Dating & Lifestyle Services', icon: '💬' },
    { slug: 'fashion-apparel', name: 'Fashion & Apparel', icon: '👗' },
    { slug: 'eyewear-health', name: 'Eyewear & Optical Health', icon: '👓' },
    { slug: 'travel-tours', name: 'Travel, Desert Safaris & Tours', icon: '✈️' },
    { slug: 'ecommerce-wholesale', name: 'E-Commerce & Wholesale', icon: '📦' },
    { slug: 'electronics-gadgets', name: 'Electronics & Portable Power', icon: '⚡' },
    { slug: 'education-learning', name: 'Education & Learning', icon: '🎓' },
    { slug: 'beauty-fragrances', name: 'Beauty & Fragrances', icon: '✨' },
    { slug: 'insurance-finance', name: 'Insurance & Finance', icon: '💰' },
    { slug: 'web-hosting-domains', name: 'Web Hosting & Domains', icon: '🌐' }
  ];

  function renderSpotlightResults(query: string) {
    if (!query || query.trim().length < 2) {
      headerSearchSpotlight?.classList.add('hidden');
      return;
    }

    const q = query.trim().toLowerCase();
    const base = import.meta.env.BASE_URL.replace(/\/$/, '');

    const matchedStores = STORES_DATA.filter(s =>
      s.name.toLowerCase().includes(q) || s.category.toLowerCase().includes(q) || s.slug.includes(q)
    ).slice(0, 4);

    const matchedDeals = COUPONS_DATA.filter(d =>
      d.title.toLowerCase().includes(q) || d.storeName.toLowerCase().includes(q) || d.code.toLowerCase().includes(q)
    ).slice(0, 4);

    const matchedCategories = HEADER_CATEGORIES.filter(c =>
      c.name.toLowerCase().includes(q) || c.slug.includes(q)
    ).slice(0, 2);

    if (matchedStores.length === 0 && matchedDeals.length === 0 && matchedCategories.length === 0) {
      if (spotlightStoresList) spotlightStoresList.innerHTML = `<div class="p-3 text-xs text-slate-500 text-center">No stores or coupons match "${query}"</div>`;
      if (spotlightDealsList) spotlightDealsList.innerHTML = '';
      if (spotlightCategoriesList) spotlightCategoriesList.classList.add('hidden');
      headerSearchSpotlight?.classList.remove('hidden');
      return;
    }

    if (spotlightCategoriesList) {
      if (matchedCategories.length > 0) {
        spotlightCategoriesList.innerHTML = matchedCategories.map(c => `
          <a href="${base}/categories/${c.slug}/" class="flex items-center justify-between p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition group">
            <div class="flex items-center gap-2">
              <span class="text-sm">${c.icon}</span>
              <span class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 transition">${c.name}</span>
            </div>
            <span class="text-[10px] font-bold text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/60 px-2 py-0.5 rounded-full">Category →</span>
          </a>
        `).join('');
        spotlightCategoriesList.classList.remove('hidden');
      } else {
        spotlightCategoriesList.classList.add('hidden');
        spotlightCategoriesList.innerHTML = '';
      }
    }

    if (spotlightStoresList) {
      spotlightStoresList.innerHTML = matchedStores.map(s => {
        const base = import.meta.env.BASE_URL.replace(/\/$/, '');
        const domain = (STORE_DOMAINS_MAP as Record<string, string>)[s.slug] || (STORE_DOMAINS_MAP as Record<string, string>)[s.name] || '';
        const storeCount = COUPONS_DATA.filter(d => d.storeSlug === s.slug).length;
        const logoUrl = domain ? `https://logo.clearbit.com/${domain}` : '';
        const fallbackUrl = domain ? `https://www.google.com/s2/favicons?domain=${domain}&sz=64` : '';
        
        return `
          <a href="${base}/stores/${s.slug}/" class="flex items-center justify-between p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition group">
            <div class="flex items-center gap-2.5">
              <div class="w-9 h-9 rounded-xl bg-white border border-slate-200 p-1 flex items-center justify-center shrink-0 overflow-hidden shadow-xs">
                ${domain ? `<img src="${logoUrl}" onerror="this.onerror=null;this.src='${fallbackUrl}';" alt="${s.name}" class="w-full h-full object-contain" />` : `<span class="text-indigo-700 font-extrabold text-[10px]">${s.name.slice(0, 2).toUpperCase()}</span>`}
              </div>
              <div>
                <div class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 transition">${s.name}</div>
                <div class="text-[10px] text-emerald-600 dark:text-emerald-400 font-medium">${storeCount} active offers · ${s.category}</div>
              </div>
            </div>
            <span class="text-[10px] font-bold text-indigo-600 bg-indigo-50 dark:bg-indigo-950/60 px-2 py-0.5 rounded-full">Store →</span>
          </a>
        `;
      }).join('');
    }

    if (spotlightDealsList) {
      spotlightDealsList.innerHTML = matchedDeals.map(d => {
        const dealJson = JSON.stringify({
          id: d.id,
          title: d.title,
          desc: d.description,
          code: d.code,
          storeName: d.storeName,
          storeSlug: d.storeSlug,
          domain: (STORE_DOMAINS_MAP as Record<string, string>)[d.storeSlug] || '',
          badge: d.discountBadge,
          affiliateUrl: d.affiliateUrl,
          successRate: d.successRate
        }).replace(/"/g, '&quot;');

        return `
          <button
            type="button"
            data-reveal-deal="${dealJson}"
            class="w-full text-left flex items-center justify-between p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition cursor-pointer group"
          >
            <div class="min-w-0 pr-2">
              <div class="flex items-center gap-1.5">
                <span class="text-xs font-bold text-slate-900 dark:text-white truncate">${d.storeName}</span>
                <span class="text-[9px] font-bold px-1.5 py-0.2 rounded bg-rose-50 text-rose-700 dark:bg-rose-500/20 dark:text-rose-300">${d.discountBadge}</span>
              </div>
              <p class="text-[11px] text-slate-600 dark:text-slate-400 truncate">${d.title}</p>
            </div>
            <span class="font-mono text-xs font-bold text-indigo-900 bg-indigo-50 dark:bg-indigo-950 dark:text-indigo-300 px-2 py-1 rounded border border-indigo-200 dark:border-indigo-800 shrink-0 group-hover:bg-indigo-600 group-hover:text-white transition">
              ${d.code ? '•••' + d.code.slice(-3) : 'Redeem →'}
            </span>
          </button>
        `;
      }).join('');
    }

    headerSearchSpotlight?.classList.remove('hidden');
  }

  headerQuickSearch?.addEventListener('input', (e) => {
    renderSpotlightResults((e.target as HTMLInputElement).value);
  });

  headerQuickSearch?.addEventListener('focus', () => {
    if (headerQuickSearch.value.trim().length >= 2) {
      renderSpotlightResults(headerQuickSearch.value);
    }
  });

  document.addEventListener('click', (e) => {
    const wrapper = document.getElementById('headerSearchWrapper');
    if (wrapper && !wrapper.contains(e.target as Node)) {
      headerSearchSpotlight?.classList.add('hidden');
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      headerSearchSpotlight?.classList.add('hidden');
      savedDrawerOverlay?.classList.add('hidden');
    }
  });

  // 5. Sticky Floating Copied Voucher Bar Logic
  function showStickyCopiedBar(deal: { code?: string; storeName?: string; affiliateUrl?: string }) {
    if (!deal || !deal.code) return;
    sessionStorage.setItem('promoradar_last_copied', JSON.stringify(deal));

    const bar = document.getElementById('stickyCopiedBar');
    const codeEl = document.getElementById('stickyCopiedCode');
    const storeEl = document.getElementById('stickyCopiedStore');
    const outboundBtn = document.getElementById('stickyOutboundBtn') as HTMLAnchorElement;

    if (codeEl) codeEl.textContent = deal.code;
    if (storeEl) storeEl.textContent = `for ${deal.storeName || 'Store'}`;
    if (outboundBtn) outboundBtn.href = deal.affiliateUrl || '#';

    bar?.classList.remove('hidden');
    bar?.classList.add('flex');
  }

  document.getElementById('closeStickyBarBtn')?.addEventListener('click', () => {
    const bar = document.getElementById('stickyCopiedBar');
    bar?.classList.add('hidden');
    bar?.classList.remove('flex');
    sessionStorage.removeItem('promoradar_last_copied');
  });

  // Restore on page load if recently copied
  const lastCopied = sessionStorage.getItem('promoradar_last_copied');
  if (lastCopied) {
    try {
      showStickyCopiedBar(JSON.parse(lastCopied));
    } catch {}
  }

  // Listen to custom deal reveal event across portal
  window.addEventListener('promoradar_deal_revealed', (e: any) => {
    showStickyCopiedBar(e.detail);
  });

  // Init badge
  updateSavedBadge();

  // 3. Theme Toggle Controller (Light / Dark with OS preference detection)
  function initTheme() {
    const sunIcon = document.getElementById('themeIconSun');
    const moonIcon = document.getElementById('themeIconMoon');
    const toggleBtn = document.getElementById('themeToggleBtn');

    function syncIcons(isDark: boolean) {
      if (isDark) {
        sunIcon?.classList.remove('hidden');
        sunIcon?.classList.add('block');
        moonIcon?.classList.remove('block');
        moonIcon?.classList.add('hidden');
      } else {
        sunIcon?.classList.remove('block');
        sunIcon?.classList.add('hidden');
        moonIcon?.classList.remove('hidden');
        moonIcon?.classList.add('block');
      }
    }

    const isCurrentDark = document.documentElement.classList.contains('dark');
    syncIcons(isCurrentDark);

    toggleBtn?.addEventListener('click', () => {
      document.documentElement.classList.add('theme-transition');
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('promoradar_theme', isDark ? 'dark' : 'light');
      syncIcons(isDark);
      setTimeout(() => {
        document.documentElement.classList.remove('theme-transition');
      }, 500);
    });

    // Listen to OS system color-scheme changes if user hasn't explicitly overridden
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
      if (!localStorage.getItem('promoradar_theme')) {
        document.documentElement.classList.add('theme-transition');
        if (e.matches) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
        syncIcons(e.matches);
        setTimeout(() => {
          document.documentElement.classList.remove('theme-transition');
        }, 500);
      }
    });
  }

  initTheme();
</script>

<style>
  @keyframes slideInRight {
    from {
      transform: translateX(100%);
    }
    to {
      transform: translateX(0);
    }
  }

  .animate-slideInRight {
    animation: slideInRight 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>
