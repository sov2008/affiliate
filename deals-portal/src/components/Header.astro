---
import { STORES_DATA } from '../data/couponsData';
import { getUniqueCleanStores } from '../utils/dealNormalizer';

interface Props {
  activePath?: string;
}

const { activePath = '/' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const uniqueStores = getUniqueCleanStores(STORES_DATA);
const storesCount = uniqueStores.length;
---

<!-- Sticky Main Glass Header (h-[68px]) -->
<header class="sticky top-0 z-40 h-[68px] bg-white/95 dark:bg-[#0B0F19]/95 backdrop-blur-xl border-b border-slate-200/80 dark:border-slate-800/80 shadow-xs transition-colors">
  <div class="max-w-7xl mx-auto h-full px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-4">
    
    <!-- Exact PromoRadar Logo & Brand Block from code.html -->
    <a href={`${base}/`} class="flex items-center gap-3 text-left group shrink-0">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-blue-500 flex items-center justify-center text-white shadow-md shadow-indigo-500/25 group-hover:scale-105 transition-transform">
        <span class="material-symbols-outlined text-[24px]">radar</span>
      </div>
      <div>
        <div class="font-extrabold text-[19px] tracking-tight leading-none text-slate-900 dark:text-white">PromoRadar</div>
        <div class="text-[9.5px] uppercase tracking-wider font-semibold text-indigo-600 dark:text-indigo-400 leading-none mt-1">GLOBAL Verified Deals</div>
      </div>
    </a>

    <!-- Clean Header Actions (Region + Saved + Theme Switcher) -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      
      <!-- Region Selector Pill -->
      <div class="relative">
        <button
          type="button"
          id="headerRegionDropdownBtn"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/80 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 text-xs font-bold transition shrink-0 cursor-pointer"
          title="Select Target Region"
        >
          <span id="headerSelectedRegionText">🌐 Worldwide</span>
          <span class="material-symbols-outlined text-[14px] text-slate-400">expand_more</span>
        </button>
        <div
          id="headerRegionMenu"
          class="hidden absolute top-full right-0 mt-2 w-48 bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-800 z-50 p-1.5 text-left text-xs"
        >
          <div class="px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-wider text-slate-400">Target Region</div>
          <button type="button" data-region-code="GLOBAL" class="header-region-item w-full text-left px-2.5 py-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 font-semibold flex items-center justify-between cursor-pointer">
            <span>🌐 Worldwide</span>
            <span class="region-check text-emerald-500 font-bold">✓</span>
          </button>
          <button type="button" data-region-code="US" class="header-region-item w-full text-left px-2.5 py-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 font-semibold flex items-center justify-between cursor-pointer">
            <span>🇺🇸 United States</span>
          </button>
          <button type="button" data-region-code="EU" class="header-region-item w-full text-left px-2.5 py-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 font-semibold flex items-center justify-between cursor-pointer">
            <span>🇪🇺 Europe</span>
          </button>
          <button type="button" data-region-code="GCC" class="header-region-item w-full text-left px-2.5 py-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 font-semibold flex items-center justify-between cursor-pointer">
            <span>🇦🇪 UAE &amp; GCC</span>
          </button>
          <button type="button" data-region-code="UA" class="header-region-item w-full text-left px-2.5 py-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 font-semibold flex items-center justify-between cursor-pointer">
            <span>🇺🇦 Ukraine</span>
          </button>
        </div>
      </div>

      <!-- Saved Deals Pill -->
      <button
        id="headerSavedBtn"
        type="button"
        class="relative inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/80 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 text-xs font-bold transition shrink-0 cursor-pointer"
        title="Saved Vouchers"
      >
        <span class="text-rose-500">❤️</span>
        <span>Saved</span>
        <span id="savedCountBadge" class="text-xs font-bold px-1.5 py-0.2 rounded-full bg-rose-100 text-rose-700 dark:bg-rose-500/20 dark:text-rose-300">0</span>
      </button>

      <!-- 3-State Light / Auto / Dark Theme Pill Toggle (`#theme-control-wrapper`) -->
      <div id="theme-control-wrapper" class="flex items-center p-1 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-200/90 dark:border-slate-700/80 text-xs">
        <button
          type="button"
          data-theme-val="light"
          class="theme-toggle-option px-2 py-1 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition flex items-center justify-center cursor-pointer"
          title="Light Theme"
          aria-label="Light mode"
        >
          <span class="material-symbols-outlined text-[15px]">light_mode</span>
        </button>
        <button
          type="button"
          data-theme-val="auto"
          class="theme-toggle-option px-2 py-1 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition flex items-center justify-center cursor-pointer"
          title="Auto / System Preference"
          aria-label="Auto mode"
        >
          <span class="material-symbols-outlined text-[15px]">brightness_auto</span>
        </button>
        <button
          type="button"
          data-theme-val="dark"
          class="theme-toggle-option px-2 py-1 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition flex items-center justify-center cursor-pointer"
          title="Dark Theme"
          aria-label="Dark mode"
        >
          <span class="material-symbols-outlined text-[15px]">dark_mode</span>
        </button>
      </div>

    </div>
  </div>
</header>

<script is:inline>
  // 3-State Light / Auto / Dark Theme Controller
  (function initThreeStateTheme() {
    const wrapper = document.getElementById('theme-control-wrapper');
    if (!wrapper) return;

    function applyTheme(mode) {
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (mode === 'dark' || (mode === 'auto' && prefersDark)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }

      // Update active toggle button style
      wrapper.querySelectorAll('.theme-toggle-option').forEach(btn => {
        const val = btn.getAttribute('data-theme-val');
        if (val === mode) {
          btn.classList.add('bg-white', 'dark:bg-slate-900', 'text-indigo-600', 'dark:text-indigo-400', 'shadow-xs', 'font-bold');
          btn.classList.remove('text-slate-600', 'dark:text-slate-400');
        } else {
          btn.classList.remove('bg-white', 'dark:bg-slate-900', 'text-indigo-600', 'dark:text-indigo-400', 'shadow-xs', 'font-bold');
          btn.classList.add('text-slate-600', 'dark:text-slate-400');
        }
      });

      try {
        localStorage.setItem('promoradar_theme_mode', mode);
        localStorage.setItem('promoradar_theme', mode === 'auto' ? (prefersDark ? 'dark' : 'light') : mode);
      } catch (e) {}
    }

    const currentMode = localStorage.getItem('promoradar_theme_mode') || 'auto';
    applyTheme(currentMode);

    wrapper.querySelectorAll('.theme-toggle-option').forEach(btn => {
      btn.addEventListener('click', () => {
        const selected = btn.getAttribute('data-theme-val') || 'auto';
        applyTheme(selected);
      });
    });

    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      if ((localStorage.getItem('promoradar_theme_mode') || 'auto') === 'auto') {
        applyTheme('auto');
      }
    });
  })();

  // Header Region Dropdown
  (function initHeaderRegionDropdown() {
    const btn = document.getElementById('headerRegionDropdownBtn');
    const menu = document.getElementById('headerRegionMenu');
    const label = document.getElementById('headerSelectedRegionText');

    btn?.addEventListener('click', (e) => {
      e.stopPropagation();
      menu?.classList.toggle('hidden');
    });

    document.addEventListener('click', () => {
      menu?.classList.add('hidden');
    });

    menu?.querySelectorAll('.header-region-item').forEach(item => {
      item.addEventListener('click', () => {
        const code = item.getAttribute('data-region-code') || 'GLOBAL';
        const text = item.querySelector('span')?.textContent || '🌐 Worldwide';
        if (label) label.textContent = text;
        menu.classList.add('hidden');

        // Checkmark sync
        menu.querySelectorAll('.region-check').forEach(c => c.remove());
        item.insertAdjacentHTML('beforeend', '<span class="region-check text-emerald-500 font-bold">✓</span>');

        // Dispatch global region change event
        window.dispatchEvent(new CustomEvent('promoradar_region_changed', { detail: { region: code } }));
      });
    });
  })();

  // Saved Deals Count Sync
  (function initSavedCounter() {
    function updateBadge() {
      try {
        const saved = JSON.parse(localStorage.getItem('promoradar_saved_deals') || '[]');
        const badge = document.getElementById('savedCountBadge');
        if (badge) badge.textContent = String(saved.length || 0);
      } catch (e) {}
    }
    updateBadge();
    window.addEventListener('storage', updateBadge);
    window.addEventListener('promoradar_saved_updated', updateBadge);

    document.getElementById('headerSavedBtn')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('promoradar_filter_saved'));
    });
  })();
</script>
