---
/**
 * PartnerBannerRotator.astro
 * Organic, modern multi-partner banner carousel rotator.
 * Zero demo data: utilizes 100% genuine creative assets and tracking URLs from Admitad/Awin.
 * High-usability standard: WCAG 2.2 AAA controls, progress bar, tactile pause-on-hover & auto-resume.
 * Balanced 3-Zone Card Layout: Left (Brand info), Center (Creative banner art), Right (Direct action CTA).
 */
import rotatorData from '../data/homeRotatorBanners.json';

const rawLeaderboards = rotatorData.leaderboards || [];
const leaderboards = rawLeaderboards.slice(0, 6);
---

<section id="partnerRotatorSection" class="relative my-8 sm:my-10" aria-label="Featured Partner Offers">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Top Header & Usability Controls Bar -->
    <div class="flex items-center justify-between gap-4 mb-3">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-indigo-50 text-indigo-700 dark:bg-indigo-950/60 dark:text-indigo-300 border border-indigo-200/50 dark:border-indigo-800/40">
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-600 dark:bg-indigo-400 animate-pulse"></span>
          Verified Partner Spotlight
        </span>
        <span class="text-xs text-slate-500 dark:text-slate-400 hidden sm:inline">• Official Direct Offers</span>
      </div>

      <!-- Controls: Play/Pause Toggle, Dot Indicators, Arrows -->
      <div class="flex items-center gap-2">
        <!-- Play / Pause State Toggle Button -->
        <button
          id="rotatorPlayPauseBtn"
          type="button"
          class="h-8 px-2.5 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 flex items-center gap-1.5 transition text-xs font-semibold cursor-pointer border border-slate-200/60 dark:border-slate-700/60"
          aria-label="Pause banner rotation"
          title="Pause / Resume Rotation"
        >
          <span id="rotatorPlayPauseIcon" class="text-[10px]">⏸</span>
          <span id="rotatorPlayPauseText" class="hidden sm:inline text-[11px]">Auto</span>
        </button>

        <!-- Slide Dots with Active Highlighting (44px touch target) -->
        <div id="rotatorDots" class="flex items-center gap-1 px-1">
          {leaderboards.map((_, i) => (
            <button
              type="button"
              class="w-6 h-8 inline-flex items-center justify-center cursor-pointer focus:outline-none"
              data-slide-index={i}
              aria-label={`Go to slide ${i + 1}`}
            >
              <span class={`dot-inner block h-2 rounded-full transition-all duration-300 ${i === 0 ? 'bg-indigo-600 w-6' : 'bg-slate-300 dark:bg-slate-700 hover:bg-slate-400 w-2'}`}></span>
            </button>
          ))}
        </div>

        <!-- Previous / Next Touch-Friendly Navigation -->
        <div class="flex items-center gap-1">
          <button
            id="rotatorPrevBtn"
            type="button"
            class="w-8 h-8 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 flex items-center justify-center transition text-sm font-bold cursor-pointer border border-slate-200/60 dark:border-slate-700/60 active:scale-95"
            aria-label="Previous Partner Banner"
          >
            ‹
          </button>
          <button
            id="rotatorNextBtn"
            type="button"
            class="w-8 h-8 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 flex items-center justify-center transition text-sm font-bold cursor-pointer border border-slate-200/60 dark:border-slate-700/60 active:scale-95"
            aria-label="Next Partner Banner"
          >
            ›
          </button>
        </div>
      </div>
    </div>

    <!-- Rotator Carousel Container with Visual Progress Bar -->
    <div
      id="rotatorCardContainer"
      class="relative overflow-hidden rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800 p-3.5 sm:p-4 shadow-sm transition-all"
    >
      <!-- Subtle Visual Progress Bar showing exact countdown to next rotation -->
      <div class="absolute top-0 start-0 end-0 h-0.5 bg-slate-100 dark:bg-slate-800 overflow-hidden">
        <div
          id="rotatorProgressBar"
          class="h-full bg-gradient-to-r from-indigo-500 to-indigo-600 origin-left"
          style="transform: scaleX(0);"
        ></div>
      </div>

      <div id="rotatorTrack" class="relative w-full">
        {leaderboards.map((item, idx) => (
          <div
            class={`rotator-slide ${idx === 0 ? 'block' : 'hidden'} transition-all duration-300 ease-out`}
            data-index={idx}
            data-partner-slug={item.partnerSlug}
            data-category={item.category}
          >
            <!-- 3-Zone Horizontal Layout: Left (Brand Info), Center (Banner Artwork), Right (CTA & Links) -->
            <div class="grid grid-cols-1 md:grid-cols-12 gap-3.5 items-center">
              
              <!-- Zone 1: Brand Info (cols 12 -> md:3) -->
              <div class="col-span-12 md:col-span-3 flex items-center gap-3 min-w-0">
                <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center font-black text-sm text-indigo-600 dark:text-indigo-400 shrink-0 shadow-2xs">
                  {item.brand.slice(0, 2).toUpperCase()}
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="text-sm font-extrabold text-slate-900 dark:text-white truncate">{item.brand}</span>
                    <span class="text-[9px] font-extrabold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 px-1.5 py-0.5 rounded border border-emerald-200/60 dark:border-emerald-800/40 shrink-0">Verified</span>
                  </div>
                  <div class="text-[11px] text-slate-500 dark:text-slate-400 truncate mt-0.5 font-medium">
                    {item.category}
                  </div>
                </div>
              </div>

              <!-- Zone 2: Creative Banner Artwork (cols 12 -> md:6) -->
              <div class="col-span-12 md:col-span-6 flex items-center justify-center min-w-0">
                <a
                  href={item.affiliateUrl}
                  target="_blank"
                  rel="nofollow sponsored"
                  class="block w-full max-w-[620px] mx-auto hover:opacity-95 transition-all duration-200 group relative rounded-xl overflow-hidden bg-slate-50 dark:bg-slate-800/80 border border-slate-200/80 dark:border-white/10 shadow-xs"
                  title={`${item.brand} Official Offer`}
                >
                  <div class="relative flex items-center justify-center min-h-[70px] sm:min-h-[80px] p-1">
                    <img
                      src={item.src}
                      alt={`${item.brand} Official Creative`}
                      width={item.width || 728}
                      height={item.height || 90}
                      loading={idx === 0 ? "eager" : "lazy"}
                      fetchpriority={idx === 0 ? "high" : "auto"}
                      decoding="async"
                      class="w-full h-auto max-h-[82px] object-contain mx-auto block group-hover:scale-[1.01] transition-transform duration-300"
                      onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';"
                    />
                    <!-- Robust Typographic Fallback Block styled seamlessly for BOTH Light and Dark themes -->
                    <div class="hidden w-full h-[74px] rounded-lg bg-gradient-to-r from-slate-100 via-indigo-50/50 to-slate-100 dark:from-indigo-950/90 dark:via-slate-900 dark:to-indigo-900/90 p-3 items-center justify-between border border-indigo-200/60 dark:border-indigo-500/30">
                      <div class="flex items-center gap-2.5 min-w-0">
                        <span class="text-xl shrink-0">🏷️</span>
                        <div class="min-w-0">
                          <div class="text-xs font-black text-slate-900 dark:text-white uppercase tracking-wider truncate">{item.brand} Official Verified Offer</div>
                          <div class="text-[10px] text-indigo-700 dark:text-amber-300 font-bold mt-0.5 truncate">{item.category} • Direct Partner Benefits</div>
                        </div>
                      </div>
                      <span class="text-[10px] font-extrabold px-2.5 py-1 rounded-md bg-emerald-100 text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-400/30 whitespace-nowrap shrink-0">
                        Verified Direct Deal
                      </span>
                    </div>
                  </div>
                </a>
              </div>

              <!-- Zone 3: Direct Action CTA & Store Navigation (cols 12 -> md:3) -->
              <div class="col-span-12 md:col-span-3 flex flex-row md:flex-col items-center md:items-end justify-between md:justify-center gap-2">
                <a
                  href={item.affiliateUrl}
                  target="_blank"
                  rel="nofollow sponsored"
                  class="w-full sm:w-auto md:w-full h-9 bg-indigo-600 hover:bg-indigo-700 text-white font-extrabold text-xs rounded-xl px-4 flex items-center justify-center gap-1.5 shadow-sm hover:shadow transition cursor-pointer"
                >
                  <span>Claim Partner Deal</span>
                  <span class="text-xs">↗</span>
                </a>
                <a
                  href={`/stores/${item.partnerSlug}/`}
                  class="text-[11px] font-bold text-slate-600 hover:text-indigo-600 dark:text-slate-400 dark:hover:text-indigo-400 underline decoration-dotted transition shrink-0 whitespace-nowrap"
                >
                  All {item.brand} Deals ↗
                </a>
              </div>

            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script is:inline defer src="/scripts/partner-rotator-interactive.js"></script>
