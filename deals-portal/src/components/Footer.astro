---
import { STORES_DATA } from '../data/couponsData';
import { getUniqueCleanStores } from '../utils/dealNormalizer';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Deduplicate stores by cleaned brand name & canonical slug
const cleanStoresList = getUniqueCleanStores(STORES_DATA);
---

<footer class="bg-slate-900 text-slate-600 dark:text-slate-300 border-t border-slate-800 mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 pb-10 border-b border-slate-800">
      
      <!-- Brand & Mission Column -->
      <div class="md:col-span-5 space-y-3.5">
        <div class="flex items-center gap-3">
          <div class="relative w-9 h-9 rounded-[11px] bg-gradient-to-b from-[#635BFF] via-[#4F46E5] to-[#312E81] p-[1.5px] shadow-md shadow-indigo-500/25 shrink-0">
            <div class="w-full h-full rounded-[9.5px] bg-[#1E1B4B] flex items-center justify-center overflow-hidden relative">
              <svg class="w-8 h-8" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <linearGradient id="stitch-sweep-footer" x1="20" y1="20" x2="32" y2="8" gradientUnits="userSpaceOnUse">
                    <stop offset="0%" stop-color="#10B981" stop-opacity="0.65" />
                    <stop offset="100%" stop-color="#10B981" stop-opacity="0.0" />
                  </linearGradient>
                  <filter id="emerald-glow-footer" x="-50%" y="-50%" width="200%" height="200%">
                    <feGaussianBlur stdDeviation="1.5" result="blur" />
                    <feMerge>
                      <feMergeNode in="blur" />
                      <feMergeNode in="SourceGraphic" />
                    </feMerge>
                  </filter>
                </defs>
                <circle cx="20" cy="20" r="15" stroke="#818CF8" stroke-opacity="0.45" stroke-width="1.2" />
                <circle cx="20" cy="20" r="10.5" stroke="#818CF8" stroke-opacity="0.35" stroke-width="1" />
                <circle cx="20" cy="20" r="6" stroke="#818CF8" stroke-opacity="0.35" stroke-width="1" />
                <line x1="20" y1="4" x2="20" y2="36" stroke="#818CF8" stroke-opacity="0.25" stroke-width="1" />
                <line x1="4" y1="20" x2="36" y2="20" stroke="#818CF8" stroke-opacity="0.25" stroke-width="1" />
                <!-- Static target blips & hub (No animations in footer) -->
                <circle cx="28" cy="12" r="2.3" fill="#34D399" filter="url(#emerald-glow-footer)" />
                <circle cx="25.5" cy="26.5" r="2" fill="#10B981" filter="url(#emerald-glow-footer)" opacity="0.85" />
                <circle cx="20" cy="20" r="3" fill="#10B981" filter="url(#emerald-glow-footer)" />
                <circle cx="20" cy="20" r="1.5" fill="#A7F3D0" />
              </svg>
            </div>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="text-white font-extrabold text-lg tracking-tight">Promo<span class="text-indigo-400">Radar</span></span>
            <span class="px-1.5 py-0.5 rounded-full bg-blue-600 text-white font-bold text-[10px] leading-none tracking-wide shadow-sm">.store</span>
          </div>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed max-w-sm">
          Independent coupon and checkout voucher radar. Hand-tested discount codes across global fashion, prescription eyewear, international travel, privacy software, and B2B wholesale marketplaces powered by verified partner networks.
        </p>
        <div class="flex items-center gap-2 text-[11px] text-slate-500">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Updated: October 2026 • Zero dead-link policy • Verified partner network feeds</span>
        </div>
      </div>

      <!-- Quick Store Directory Links -->
      <div class="md:col-span-4 space-y-2">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-200 mb-3">Popular Partner Stores</div>
        <div class="grid grid-cols-2 gap-2 text-xs">
          {cleanStoresList.slice(0, 8).map(store => (
            <a href={`${base}/stores/${store.slug}/`} class="text-slate-600 dark:text-slate-300 hover:text-white transition-colors truncate">
              {store.name}
            </a>
          ))}
        </div>
      </div>

      <!-- Affiliate Transparency -->
      <div class="md:col-span-3 space-y-2.5">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-200 mb-2">Affiliate Transparency</div>
        <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
          PromoRadar earns partner referral commissions through accredited affiliate networks when you redeem coupons or purchase via our outbound links, at zero extra cost to you.
        </p>
        <div class="pt-2 flex flex-col gap-1.5">
          <a href={`${base}/about/`} class="text-xs font-semibold text-indigo-400 hover:text-indigo-300">
            Learn more about our verification QA →
          </a>
          <button
            type="button"
            data-open-bookmarklet-modal
            class="text-left text-xs font-semibold text-emerald-400 hover:text-emerald-300 cursor-pointer flex items-center gap-1"
          >
            <span>⚡ One-Click Browser Bookmarklet</span>
          </button>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
      <span>© 2026 PromoRadar. All rights reserved.</span>
      <div class="flex items-center gap-5">
        <a href={`${base}/`} class="hover:text-slate-300 transition-colors">Home</a>
        <a href={`${base}/stores/`} class="hover:text-slate-300 transition-colors">Partner Stores</a>
        <a href={`${base}/categories/`} class="hover:text-slate-300 transition-colors">Categories</a>
        <a href={`${base}/compare/`} class="hover:text-slate-300 transition-colors">Compare Deals</a>
        <a href={`${base}/about/`} class="hover:text-slate-300 transition-colors">How It Works & FAQ</a>
      </div>
    </div>
  </div>
</footer>
