---
// deals-portal/src/components/CookieBanner.astro
// Lightweight, zero-dependency GDPR & Google Consent Mode v2 Banner
// Strictly English (Strict English Rule), Accessible WCAG 2.2 AAA
---

<div
  id="promoradarCookieBanner"
  class="fixed bottom-4 left-4 right-4 sm:left-auto sm:right-6 sm:max-w-md z-50 bg-slate-900/95 dark:bg-slate-950/95 text-white backdrop-blur-md rounded-2xl p-5 border border-slate-700/80 shadow-2xl transition-all duration-300 transform translate-y-32 opacity-0 pointer-events-none"
  role="dialog"
  aria-live="polite"
  aria-label="Privacy and Cookie Consent"
>
  <div class="flex items-start gap-3.5">
    <div class="w-9 h-9 rounded-xl bg-indigo-500/20 text-indigo-400 border border-indigo-500/30 flex items-center justify-center shrink-0 text-base">
      🍪
    </div>
    <div class="space-y-1.5 flex-1 min-w-0">
      <h3 class="text-sm font-extrabold text-white">We value your privacy</h3>
      <p class="text-xs text-slate-300 leading-relaxed">
        We use cookies and telemetry to analyze traffic, remember saved deals, and verify merchant discounts. By clicking "Accept All", you consent to our use of cookies according to Google Consent Mode v2.
      </p>
    </div>
  </div>

  <div class="mt-4 pt-3 border-t border-slate-800 flex items-center justify-end gap-2.5">
    <button
      type="button"
      id="cookieDeclineBtn"
      class="px-3 py-1.5 rounded-xl text-xs font-bold text-slate-400 hover:text-white hover:bg-slate-800 transition cursor-pointer"
    >
      Necessary Only
    </button>
    <button
      type="button"
      id="cookieAcceptBtn"
      class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-black text-xs shadow-md shadow-indigo-600/30 transition cursor-pointer active:scale-95"
    >
      Accept All
    </button>
  </div>
</div>

<script is:inline>
  (() => {
    const banner = document.getElementById('promoradarCookieBanner');
    const acceptBtn = document.getElementById('cookieAcceptBtn');
    const declineBtn = document.getElementById('cookieDeclineBtn');
    if (!banner) return;

    let consent = null;
    try {
      consent = localStorage.getItem('promoradar_cookie_consent');
    } catch (e) {}

    // Show banner only if user has not yet decided
    if (!consent) {
      setTimeout(() => {
        banner.classList.remove('translate-y-32', 'opacity-0', 'pointer-events-none');
        banner.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
      }, 1000);
    }

    function handleConsent(status) {
      try {
        localStorage.setItem('promoradar_cookie_consent', status);
      } catch (e) {}

      // Update Google Consent Mode v2
      if (typeof window.gtag === 'function') {
        if (status === 'granted') {
          window.gtag('consent', 'update', {
            'ad_storage': 'granted',
            'analytics_storage': 'granted',
            'ad_user_data': 'granted',
            'ad_personalization': 'granted'
          });
        } else {
          window.gtag('consent', 'update', {
            'ad_storage': 'denied',
            'analytics_storage': 'denied',
            'ad_user_data': 'denied',
            'ad_personalization': 'denied'
          });
        }
      }

      // Hide banner
      banner.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
      banner.classList.add('translate-y-32', 'opacity-0', 'pointer-events-none');
    }

    acceptBtn?.addEventListener('click', () => handleConsent('granted'));
    declineBtn?.addEventListener('click', () => handleConsent('denied'));
  })();
</script>

