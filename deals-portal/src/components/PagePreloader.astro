---
// PagePreloader.astro - Sleek brand preloader with animated radar icon
---

<div
  id="promoradar-preloader"
  class="fixed inset-0 z-50 flex flex-col items-center justify-center bg-[#0B0F19] transition-opacity duration-500 ease-out pointer-events-auto"
  aria-label="Loading PromoRadar..."
>
  <div class="flex flex-col items-center">
    <!-- Animated Squircle Radar Icon (64x64px) -->
    <div class="relative w-16 h-16 rounded-[20px] bg-gradient-to-b from-[#635BFF] via-[#4F46E5] to-[#312E81] p-[2.5px] shadow-2xl shadow-indigo-500/30">
      <div class="w-full h-full rounded-[17.5px] bg-[#1E1B4B] flex items-center justify-center overflow-hidden relative">
        <svg class="w-14 h-14" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="preloader-sweep" x1="20" y1="20" x2="32" y2="8" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#10B981" stop-opacity="0.8" />
              <stop offset="100%" stop-color="#10B981" stop-opacity="0.0" />
            </linearGradient>
            <filter id="preloader-glow" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation="1.5" result="blur" />
              <feMerge>
                <feMergeNode in="blur" />
                <feMergeNode in="SourceGraphic" />
              </feMerge>
            </filter>
          </defs>

          <!-- Concentric Radar Rings -->
          <circle cx="20" cy="20" r="15" stroke="#818CF8" stroke-opacity="0.4" stroke-width="1.2" />
          <circle cx="20" cy="20" r="10.5" stroke="#818CF8" stroke-opacity="0.3" stroke-width="1" />
          <circle cx="20" cy="20" r="6" stroke="#818CF8" stroke-opacity="0.3" stroke-width="1" />

          <!-- Crosshairs -->
          <line x1="20" y1="4" x2="20" y2="36" stroke="#818CF8" stroke-opacity="0.25" stroke-width="1" />
          <line x1="4" y1="20" x2="36" y2="20" stroke="#818CF8" stroke-opacity="0.25" stroke-width="1" />

          <!-- Continuous Rotating Radar Beam (Ultra-Smooth CSS GPU Transform, No Jitter) -->
          <g class="radar-beam-continuous">
            <path d="M20 20 L20 5 A15 15 0 0 1 31.5 10.4 Z" fill="url(#preloader-sweep)" />
            <line x1="20" y1="20" x2="30.6" y2="9.4" stroke="#34D399" stroke-width="2" stroke-linecap="round" />
          </g>

          <!-- Pulsing Target Blips (Silky Infinite Breathe) -->
          <circle cx="28" cy="12" r="2.3" fill="#34D399" filter="url(#preloader-glow)" class="radar-blip-pulse-1" />
          <circle cx="25.5" cy="26.5" r="2" fill="#10B981" filter="url(#preloader-glow)" class="radar-blip-pulse-2" />

          <!-- Core Hub -->
          <circle cx="20" cy="20" r="3" fill="#10B981" filter="url(#preloader-glow)" />
          <circle cx="20" cy="20" r="1.5" fill="#A7F3D0" />
        </svg>
      </div>
    </div>

    <!-- Brand Typography Lockup -->
    <div class="mt-4 flex items-baseline">
      <span class="font-extrabold text-2xl tracking-tight leading-none text-white inline-flex items-baseline">
        Promo<span class="text-indigo-400">Radar</span>
      </span>
      <span class="text-[11px] font-bold text-indigo-300/80 tracking-normal -ml-[1px] self-end">
        .store
      </span>
    </div>

    <!-- Scanning status message -->
    <div class="mt-2.5 flex items-center gap-2 text-xs text-slate-400 font-medium">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
      <span class="tracking-wide">Scanning verified deals...</span>
    </div>
  </div>
</div>

<script is:inline>
  (function initPreloader() {
    const preloader = document.getElementById('promoradar-preloader');
    if (!preloader) return;

    function hidePreloader() {
      if (preloader.dataset.hidden === 'true') return;
      preloader.dataset.hidden = 'true';
      preloader.style.opacity = '0';
      preloader.style.pointerEvents = 'none';
      
      // Dispatch event as soon as preloader begins dissolving
      window.dispatchEvent(new CustomEvent('promoradar_preloader_done'));

      setTimeout(() => {
        preloader.remove();
      }, 550);
    }

    // Minimum visible display duration to let the scanning radar animation breathe
    const minDisplayMs = 850;
    const startTime = Date.now();

    function scheduleDismiss() {
      const elapsed = Date.now() - startTime;
      const remaining = Math.max(0, minDisplayMs - elapsed);
      setTimeout(hidePreloader, remaining);
    }

    if (document.readyState === 'complete') {
      scheduleDismiss();
    } else {
      window.addEventListener('load', scheduleDismiss);
      // Fallback timeout in case of slow resources
      setTimeout(hidePreloader, 3000);
    }
  })();
</script>

<style>
  /* Silky smooth 60fps GPU-accelerated rotation */
  .radar-beam-continuous {
    transform-origin: 20px 20px;
    animation: radarSweepContinuous 2.4s linear infinite;
    will-change: transform;
  }

  @keyframes radarSweepContinuous {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  .radar-blip-pulse-1 {
    transform-origin: 28px 12px;
    animation: radarBlipBreath1 2.4s ease-in-out infinite;
    will-change: opacity, transform;
  }

  @keyframes radarBlipBreath1 {
    0%, 100% {
      opacity: 0.35;
      transform: scale(0.9);
    }
    50% {
      opacity: 1;
      transform: scale(1.2);
    }
  }

  .radar-blip-pulse-2 {
    transform-origin: 25.5px 26.5px;
    animation: radarBlipBreath2 2.4s ease-in-out infinite;
    will-change: opacity, transform;
  }

  @keyframes radarBlipBreath2 {
    0%, 100% {
      opacity: 0.9;
      transform: scale(1.15);
    }
    50% {
      opacity: 0.25;
      transform: scale(0.85);
    }
  }
</style>

