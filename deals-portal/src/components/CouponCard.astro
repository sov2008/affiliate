---
import type { CouponDeal } from '../data/couponsData';
import { Tag, Check, ExternalLink, Clock } from 'lucide-astro';

interface Props {
  deal: CouponDeal;
}

const { deal } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div
  class="coupon-card group bg-white border-2 border-slate-900 p-5 sm:p-6 shadow-[3px_3px_0px_0px_#0f172a] transition-all hover:-translate-y-0.5 hover:shadow-[5px_5px_0px_0px_#0f172a] flex flex-col justify-between"
  data-store={deal.storeSlug}
  data-category={deal.storeCategory}
  data-code={deal.code}
  data-affiliate-url={deal.affiliateUrl}
>
  <div>
    <!-- Top Meta Row -->
    <div class="flex items-start justify-between gap-3 mb-3">
      <!-- Store Badge & Category -->
      <div class="flex items-center gap-2 flex-wrap">
        <a
          href={`${base}/stores/${deal.storeSlug}/`}
          class="font-mono text-[10px] font-bold uppercase tracking-wider bg-slate-100 hover:bg-slate-200 text-slate-800 px-2.5 py-1 border border-slate-300 transition-colors"
        >
          {deal.storeName}
        </a>
        <span class="font-mono text-[9px] text-slate-500 uppercase tracking-widest hidden sm:inline">
          {deal.storeCategory}
        </span>
      </div>

      <!-- Discount Value Badge -->
      <div class="bg-rose-700 text-white font-mono font-black text-xs sm:text-sm px-3 py-1 uppercase tracking-wider border border-slate-900 shadow-[1px_1px_0px_0px_#0f172a] shrink-0">
        {deal.discountBadge}
      </div>
    </div>

    <!-- Title -->
    <h3 class="font-serif font-black text-lg sm:text-xl text-slate-900 leading-snug mb-2 group-hover:text-rose-700 transition-colors">
      <a href={`${base}/stores/${deal.storeSlug}/`}>
        {deal.title}
      </a>
    </h3>

    <!-- Description -->
    <p class="font-sans text-xs text-slate-600 leading-relaxed mb-4">
      {deal.description}
    </p>
  </div>

  <!-- Bottom Action Block -->
  <div class="pt-4 border-t border-slate-200/80 mt-auto">
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
      <!-- Trust Signals -->
      <div class="flex items-center gap-3 text-[10px] font-mono text-slate-500">
        <span class="inline-flex items-center gap-1 text-emerald-700 font-bold">
          <Check class="w-3.5 h-3.5" />
          Verified Today
        </span>
        <span>·</span>
        <span class="flex items-center gap-1">
          <Clock class="w-3 h-3 text-slate-400" />
          {deal.expiryDate}
        </span>
      </div>

      <!-- Reveal Code Action Button -->
      <div class="relative shrink-0">
        <button
          type="button"
          class="reveal-code-btn w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-slate-900 hover:bg-rose-700 active:bg-rose-800 text-white font-mono font-bold text-xs uppercase tracking-wider transition-all border border-slate-900 shadow-[2px_2px_0px_0px_#0f172a] hover:shadow-none active:translate-x-0.5 active:translate-y-0.5 cursor-pointer"
          data-deal-id={deal.id}
          data-code={deal.code}
          data-affiliate-url={deal.affiliateUrl}
          data-reveal-deal={JSON.stringify({
            id: deal.id,
            title: deal.title,
            desc: deal.description,
            code: deal.code,
            storeName: deal.storeName,
            storeSlug: deal.storeSlug,
            badge: deal.discountBadge,
            affiliateUrl: deal.affiliateUrl,
            successRate: deal.successRate
          })}
        >
          <Tag class="w-3.5 h-3.5 shrink-0" />
          <span class="btn-text">GET CODE &amp; OPEN STORE</span>
          <ExternalLink class="w-3 h-3 shrink-0" />
        </button>
      </div>
    </div>
  </div>
</div>
