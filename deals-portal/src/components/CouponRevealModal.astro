---

interface Props {
  storeDealsMap?: Record<string, Array<{ id: string; title: string; code: string; badge: string; affiliateUrl: string }>>;
}

const { storeDealsMap = {} } = Astro.props;
---

<!-- Global Click-to-Reveal Coupon Modal (Dual-Tab & Cross-Sell Engine) -->
<div
  id="universalCouponModal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-3 sm:p-4 bg-slate-950/80 backdrop-blur-md overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modalDealTitle"
>
  <div class="bg-white dark:bg-slate-900 rounded-3xl max-w-lg w-full p-5 sm:p-7 shadow-2xl border border-slate-200/90 dark:border-slate-800 relative my-auto animate-fadeIn transform transition-all">
    <!-- Close Button -->
    <button
      id="closeUniversalModalBtn"
      type="button"
      class="absolute right-4 top-4 w-9 h-9 rounded-full bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white flex items-center justify-center font-bold text-sm cursor-pointer transition shadow-sm z-10"
      aria-label="Close modal"
    >
      ✕
    </button>

    <!-- Modal Header with Verified Store Logo -->
    <div class="flex items-center gap-3.5 mb-4 pr-8">
      <div id="modalLogoContainer" class="brand-logo-container w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-white p-2 border border-slate-200 flex items-center justify-center shrink-0 shadow-md relative overflow-hidden">
        <img
          id="modalLogoImg"
          src=""
          alt="Store Logo"
          width="64"
          height="64"
          class="w-full h-full object-contain filter hover:scale-105 transition-transform duration-200"
          loading="lazy"
        />
        <span id="modalLogoFallback" class="hidden w-full h-full rounded-xl bg-gradient-to-br from-indigo-600 via-indigo-700 to-rose-600 text-white font-extrabold text-sm sm:text-base items-center justify-center">
          PR
        </span>
      </div>
      <div>
        <div class="flex items-center gap-2 flex-wrap">
          <span id="modalStoreName" class="font-extrabold text-slate-900 dark:text-white text-base">Store</span>
          <span id="modalDiscountBadge" class="text-xs font-extrabold px-2.5 py-0.5 rounded-lg bg-rose-100 text-rose-700 dark:bg-rose-500/20 dark:text-rose-300 border border-rose-200 dark:border-rose-500/30">Verified</span>
        </div>
        <div class="flex items-center gap-2 mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">
          <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-200/70 dark:border-emerald-500/30 font-bold text-[10px]">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span id="modalPulseStatusText">Pulse: Tested 14m ago</span>
          </span>
          <span>•</span>
          <span id="modalReliabilityScore" class="font-bold text-slate-700 dark:text-slate-300">99.2% Stability</span>
        </div>
      </div>
    </div>

    <!-- Title & Description -->
    <h3 id="modalDealTitle" class="text-base sm:text-lg font-extrabold text-slate-900 dark:text-white mb-1.5 leading-snug"></h3>
    <p id="modalDealDesc" class="text-xs text-slate-600 dark:text-slate-300 mb-4 leading-relaxed"></p>

    <!-- Primary Voucher Code Box (Styled Honey / RetailMeNot Voucher) -->
    <div id="modalCodeBox" class="bg-indigo-50/90 dark:bg-indigo-950/45 border-2 border-dashed border-indigo-300 dark:border-indigo-500/40 rounded-2xl p-4 mb-4 relative overflow-hidden">
      <div class="flex items-center justify-between text-[11px] font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-300 mb-2 px-1">
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
          </svg>
          EXCLUSIVE PROMO CODE
        </span>
        <span id="modalCodeStatusTag" class="text-emerald-600 dark:text-emerald-400 font-bold text-[10px] bg-emerald-100/70 dark:bg-emerald-950/80 px-2 py-0.5 rounded-md">
          ACTIVE &amp; VERIFIED
        </span>
      </div>

      <div class="flex items-center justify-between gap-2 bg-white dark:bg-slate-950/90 rounded-xl p-2 pl-4 border border-indigo-200 dark:border-indigo-500/30 shadow-inner">
        <span id="modalCodeText" class="font-mono font-extrabold text-lg sm:text-xl tracking-widest text-slate-900 dark:text-white select-all"></span>
        <button
          id="copyModalCodeBtn"
          type="button"
          class="code-peel px-4 py-2.5 rounded-xl text-white font-bold text-xs transition shrink-0 cursor-pointer shadow-sm flex items-center gap-1.5 active:scale-95"
        >
          <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
          </svg>
          <span id="copyModalBtnLabel">Copy Code</span>
        </button>
      </div>

      <!-- 3-Step Instant Instructions Micro-Guide -->
      <div class="mt-3.5 pt-3 border-t border-indigo-200/60 dark:border-indigo-500/20 grid grid-cols-3 gap-2 text-center">
        <div class="space-y-0.5">
          <span class="w-4 h-4 rounded-full bg-emerald-600 text-white font-mono text-[9px] font-bold inline-flex items-center justify-center">✓</span>
          <p class="text-[10px] font-bold text-emerald-600 dark:text-emerald-400">1. Copied ✓</p>
          <p class="text-[9px] text-slate-500 dark:text-slate-400">Ready to use</p>
        </div>
        <div class="space-y-0.5">
          <span class="w-4 h-4 rounded-full bg-indigo-600 text-white font-mono text-[9px] font-bold inline-flex items-center justify-center">2</span>
          <p class="text-[10px] font-semibold text-slate-700 dark:text-slate-300">2. Go to Store</p>
          <p class="text-[9px] text-slate-500 dark:text-slate-400">Add items to cart</p>
        </div>
        <div class="space-y-0.5">
          <span class="w-4 h-4 rounded-full bg-indigo-600 text-white font-mono text-[9px] font-bold inline-flex items-center justify-center">3</span>
          <p class="text-[10px] font-semibold text-slate-700 dark:text-slate-300">3. Paste Code</p>
          <p class="text-[9px] text-slate-500 dark:text-slate-400">Save at checkout!</p>
        </div>
      </div>
    </div>

    <!-- Outbound Affiliate Link Button -->
    <a
      id="modalOutboundLink"
      href="#"
      target="_blank"
      rel="nofollow sponsored"
      class="w-full py-3.5 px-5 rounded-xl bg-slate-900 hover:bg-slate-800 dark:bg-gradient-to-r dark:from-emerald-600 dark:to-teal-600 dark:hover:from-emerald-500 dark:hover:to-teal-500 text-white font-bold text-sm flex items-center justify-center gap-2 shadow-lg dark:shadow-emerald-950/50 border border-transparent dark:border-emerald-400/30 transition mb-3 group"
    >
      <span id="modalOutboundBtnLabel">Go to Official Store ↗</span>
    </a>

    <!-- Desktop-to-Mobile QR Code Trigger -->
    <div class="mb-3">
      <button
        type="button"
        id="modalOpenQRBtn"
        class="w-full py-2 px-3 rounded-xl bg-slate-50 hover:bg-slate-100 dark:bg-slate-800/60 dark:hover:bg-slate-800 border border-slate-200/80 dark:border-slate-700/60 text-slate-700 dark:text-slate-300 font-bold text-xs flex items-center justify-between transition cursor-pointer"
        title="Open QR code to scan with your phone"
      >
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
          </svg>
          <span>📱 Scan on Phone (Mobile Checkout / In-Store QR)</span>
        </span>
        <span class="text-[10px] text-slate-400">View QR →</span>
      </button>
    </div>

    <!-- Quick Share Deal Bar -->
    <div class="mb-4 p-3 rounded-2xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/80 dark:border-slate-700/60">
      <div class="flex items-center justify-between mb-2 px-1">
        <span class="text-[11px] font-extrabold uppercase tracking-wider text-slate-600 dark:text-slate-300 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
          </svg>
          Share this deal
        </span>
        <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">Invite friends to save</span>
      </div>
      <div class="grid grid-cols-4 gap-2">
        <!-- Native / Quick Share -->
        <button
          id="modalShareNativeBtn"
          type="button"
          class="flex items-center justify-center gap-1 py-2 px-1 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 hover:border-indigo-400 dark:hover:border-indigo-500 text-slate-700 dark:text-slate-200 font-bold text-xs transition cursor-pointer shadow-xs hover:shadow-sm"
          title="Share via device"
        >
          <svg class="w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
          </svg>
          <span class="text-[11px]">Share</span>
        </button>
        <!-- Telegram Share -->
        <a
          id="modalShareTelegramBtn"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-1 py-2 px-1 rounded-xl bg-[#229ED9]/10 hover:bg-[#229ED9]/20 text-[#229ED9] border border-[#229ED9]/30 font-bold text-xs transition shadow-xs"
          title="Share on Telegram"
        >
          <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
          </svg>
          <span class="text-[11px]">Telegram</span>
        </a>
        <!-- WhatsApp Share -->
        <a
          id="modalShareWhatsappBtn"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-1 py-2 px-1 rounded-xl bg-[#25D366]/10 hover:bg-[#25D366]/20 text-[#25D366] border border-[#25D366]/30 font-bold text-xs transition shadow-xs"
          title="Share on WhatsApp"
        >
          <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M9.53 7.03C9.36 7.03 9.08 7.09 8.84 7.35C8.6 7.61 7.92 8.25 7.92 9.55C7.92 10.85 8.87 12.11 9 12.28C9.13 12.45 10.84 15.09 13.47 16.22C14.1 16.49 14.58 16.65 14.97 16.77C15.6 16.97 16.17 16.94 16.62 16.88C17.12 16.8 18.17 16.24 18.39 15.62C18.61 15 18.61 14.47 14.54 14.38C14.47 14.34 14.23 14.22 13.88 14.05C13.53 13.88 12.07 13.16 11.83 13.07C11.6 12.98 11.43 12.94 11.26 13.2C11.09 13.46 10.6 14.05 10.45 14.22C10.3 14.39 10.15 14.41 9.92 14.3C9.69 14.19 8.94 13.94 8.05 13.15C7.36 12.53 6.89 11.77 6.76 11.55C6.63 11.32 6.75 11.2 6.86 11.09C6.96 10.99 7.09 10.82 7.21 10.68C7.33 10.54 7.37 10.43 7.45 10.27C7.53 10.11 7.49 9.97 7.43 9.85C7.37 9.73 6.89 8.55 6.69 8.07C6.5 7.6 6.3 7.66 6.15 7.65C6.01 7.65 5.84 7.65 5.67 7.65C5.5 7.65 5.22 7.71 4.98 7.97"/>
          </svg>
          <span class="text-[11px]">WhatsApp</span>
        </a>
        <!-- Copy Link Button -->
        <button
          id="modalCopyLinkBtn"
          type="button"
          class="flex items-center justify-center gap-1 py-2 px-1 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 hover:border-indigo-400 dark:hover:border-indigo-500 text-slate-700 dark:text-slate-200 font-bold text-xs transition cursor-pointer shadow-xs hover:shadow-sm"
          title="Copy link to clipboard"
        >
          <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
          </svg>
          <span id="modalCopyLinkText" class="text-[11px]">Copy</span>
        </button>
      </div>
    </div>

    <!-- Cross-Sell Section: "More Active Deals for this Store" -->
    <div id="modalCrossSellSection" class="hidden mb-4 p-3 bg-slate-50 dark:bg-slate-800/50 rounded-2xl border border-slate-200/80 dark:border-slate-700/60">
      <div class="flex items-center justify-between mb-2 px-1">
        <span class="text-[11px] font-extrabold uppercase tracking-wider text-slate-700 dark:text-slate-300">More Active Offers</span>
        <span class="text-[10px] font-bold text-indigo-600 dark:text-indigo-400" id="modalCrossSellCount"></span>
      </div>
      <div id="modalCrossSellContainer" class="space-y-1.5">
        <!-- Rendered dynamically -->
      </div>
    </div>

    <!-- Crowdsourced Community Voting Footer (Wethrift & SimplyCodes Pattern) -->
    <div class="pt-3.5 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
      <span class="font-medium">Did this coupon work?</span>
      <div class="flex items-center gap-1.5">
        <button
          type="button"
          data-vote="up"
          class="modal-vote-btn px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-emerald-50 hover:text-emerald-700 dark:bg-slate-800 dark:hover:bg-emerald-950/40 dark:text-slate-300 dark:hover:text-emerald-300 font-bold transition flex items-center gap-1 cursor-pointer"
        >
          <span>👍</span>
          <span class="text-[11px]">Works</span>
        </button>
        <button
          type="button"
          data-vote="down"
          class="modal-vote-btn px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-rose-50 hover:text-rose-700 dark:bg-slate-800 dark:hover:bg-rose-950/40 dark:text-slate-300 dark:hover:text-rose-300 font-bold transition flex items-center gap-1 cursor-pointer"
        >
          <span>👎</span>
          <span class="text-[11px]">Didn't work</span>
        </button>
      </div>
    </div>
    <div id="modalVoteFeedback" class="hidden mt-2 text-center text-xs font-semibold text-emerald-600 dark:text-emerald-400">
      ✓ Thank you! Your feedback has been verified and recorded.
    </div>
  </div>
</div>

<script defer src="/scripts/coupon-modal.js"></script>