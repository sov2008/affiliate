---
// deals-portal/src/components/SavingsWalletModal.astro
// Gamified Shopper Savings Tracker & Loyalty Pass
// Benchmarked against Honey Gold / Rakuten / RetailMeNot Wallet
---

<div
  id="savingsWalletModal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-3 sm:p-4 bg-slate-950/80 backdrop-blur-md overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-labelledby="walletModalTitle"
>
  <div class="bg-white dark:bg-slate-900 rounded-3xl max-w-lg w-full p-6 sm:p-7 shadow-2xl border border-slate-200/90 dark:border-slate-800 relative my-auto animate-fadeIn transform transition-all">
    <!-- Close Button -->
    <button
      id="closeWalletModalBtn"
      type="button"
      class="absolute right-4 top-4 w-9 h-9 rounded-full bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white flex items-center justify-center font-bold text-sm cursor-pointer transition shadow-sm z-10"
      aria-label="Close modal"
    >
      ✕
    </button>

    <!-- Header Badge -->
    <div class="flex items-center gap-2 mb-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-500/15 border border-emerald-200/80 dark:border-emerald-500/30 text-emerald-700 dark:text-emerald-300 text-[11px] font-extrabold shadow-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>MY SAVINGS WALLET &amp; LOYALTY PASS</span>
      </span>
      <span id="walletStreakBadge" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-amber-50 dark:bg-amber-500/15 border border-amber-200/80 dark:border-amber-500/30 text-amber-700 dark:text-amber-300 text-[11px] font-extrabold shadow-xs">
        🔥 <span id="walletStreakDaysText">1 Day Active</span>
      </span>
    </div>

    <!-- Hero Savings Card -->
    <div class="p-5 rounded-2xl bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 text-white shadow-xl relative overflow-hidden mb-5 border border-indigo-500/20">
      <!-- Glow ambient background -->
      <div class="absolute -top-10 -right-10 w-36 h-36 bg-emerald-500/20 rounded-full blur-2xl pointer-events-none"></div>
      <div class="absolute -bottom-10 -left-10 w-36 h-36 bg-indigo-500/20 rounded-full blur-2xl pointer-events-none"></div>

      <div class="relative z-10 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block mb-1">Estimated Total Saved</span>
          <div class="flex items-baseline gap-2">
            <span id="walletHeroTotalAmount" class="text-3xl sm:text-4xl font-black text-white tracking-tight">$0.00</span>
            <span class="text-xs text-emerald-400 font-bold">USD</span>
          </div>
          <p class="text-[11px] text-slate-400 mt-1">Calculated across verified coupons &amp; activated deals</p>
        </div>

        <div class="text-right sm:border-l sm:border-slate-800/80 sm:pl-4">
          <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-1">Current Tier</span>
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-white/10 border border-white/20 text-xs font-black text-amber-300 backdrop-blur-xs">
            <span id="walletTierIcon">🥉</span>
            <span id="walletHeroTierName">Bronze Saver</span>
          </div>
          <span id="walletHeroRedeemedCount" class="block text-[10px] text-slate-400 mt-1.5">0 Deals Activated</span>
        </div>
      </div>

      <!-- Gamification Progress Bar -->
      <div class="relative z-10 mt-4 pt-3.5 border-t border-white/10">
        <div class="flex items-center justify-between text-[11px] font-bold text-slate-300 mb-1.5">
          <span id="walletProgressLabel">Progress to Silver Shopper</span>
          <span id="walletProgressPercent">0%</span>
        </div>
        <div class="w-full h-2 rounded-full bg-slate-800 overflow-hidden p-0.5">
          <div id="walletProgressBar" class="h-full rounded-full bg-gradient-to-r from-emerald-400 via-teal-400 to-indigo-400 transition-all duration-500" style="width: 0%"></div>
        </div>
        <div class="flex items-center justify-between text-[10px] text-slate-400 mt-1">
          <span id="walletCurrentSavingsMini">$0.00</span>
          <span id="walletNextTierTarget">$50.00</span>
        </div>
      </div>
    </div>

    <!-- 4 Gamified Loyalty Tiers Matrix -->
    <div class="mb-5">
      <div class="flex items-center justify-between mb-2">
        <h4 class="text-xs font-black text-slate-900 dark:text-white uppercase tracking-wider">Loyalty Tiers &amp; Perks</h4>
        <span class="text-[10px] text-slate-500 dark:text-slate-400">Unlock via coupon usage</span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center text-xs">
        <!-- Tier 1 -->
        <div id="tierBoxBronze" class="p-2.5 rounded-xl border transition border-emerald-500 bg-emerald-50/50 dark:bg-emerald-950/20 text-slate-800 dark:text-slate-200">
          <span class="text-base block mb-0.5">🥉</span>
          <span class="font-bold text-[11px] block text-slate-900 dark:text-white">Bronze</span>
          <span class="text-[10px] text-slate-500 dark:text-slate-400 block">$0+</span>
          <span class="text-[9px] text-emerald-600 dark:text-emerald-400 font-semibold block mt-1">Verified Deals</span>
        </div>

        <!-- Tier 2 -->
        <div id="tierBoxSilver" class="p-2.5 rounded-xl border transition border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/40 text-slate-800 dark:text-slate-200">
          <span class="text-base block mb-0.5">🥈</span>
          <span class="font-bold text-[11px] block text-slate-900 dark:text-white">Silver</span>
          <span class="text-[10px] text-slate-500 dark:text-slate-400 block">$50+</span>
          <span class="text-[9px] text-slate-500 dark:text-slate-400 font-semibold block mt-1">Priority Alerts</span>
        </div>

        <!-- Tier 3 -->
        <div id="tierBoxGold" class="p-2.5 rounded-xl border transition border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/40 text-slate-800 dark:text-slate-200">
          <span class="text-base block mb-0.5">🥇</span>
          <span class="font-bold text-[11px] block text-slate-900 dark:text-white">Gold</span>
          <span class="text-[10px] text-slate-500 dark:text-slate-400 block">$150+</span>
          <span class="text-[9px] text-slate-500 dark:text-slate-400 font-semibold block mt-1">Insider Codes</span>
        </div>

        <!-- Tier 4 -->
        <div id="tierBoxDiamond" class="p-2.5 rounded-xl border transition border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/40 text-slate-800 dark:text-slate-200">
          <span class="text-base block mb-0.5">💎</span>
          <span class="font-bold text-[11px] block text-slate-900 dark:text-white">Diamond</span>
          <span class="text-[10px] text-slate-500 dark:text-slate-400 block">$300+</span>
          <span class="text-[9px] text-slate-500 dark:text-slate-400 font-semibold block mt-1">VIP Radar Status</span>
        </div>
      </div>
    </div>

    <!-- Recent Activations List -->
    <div class="mb-5">
      <div class="flex items-center justify-between mb-2">
        <h4 class="text-xs font-black text-slate-900 dark:text-white uppercase tracking-wider">Recent Voucher Activations</h4>
        <span id="walletHistoryCount" class="text-[10px] text-slate-500 dark:text-slate-400">0 items</span>
      </div>

      <div id="walletEmptyState" class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/80 dark:border-slate-800 text-center">
        <div class="w-10 h-10 rounded-2xl bg-indigo-50 dark:bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 flex items-center justify-center mx-auto mb-2 text-lg">
          🏷️
        </div>
        <p class="text-xs font-bold text-slate-800 dark:text-slate-200 mb-0.5">No deals activated yet</p>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 max-w-xs mx-auto">Click "Copy Code" or "Scan QR" on any store voucher to start accumulating your personal savings!</p>
      </div>

      <div id="walletHistoryList" class="hidden space-y-2 max-h-48 overflow-y-auto pr-1">
        <!-- Rendered dynamically via JS -->
      </div>
    </div>

    <!-- Bottom Actions -->
    <div class="flex items-center gap-2 pt-3 border-t border-slate-100 dark:border-slate-800">
      <button
        type="button"
        id="shareMySavingsBtn"
        class="flex-1 py-2.5 px-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs shadow-md shadow-indigo-600/20 transition cursor-pointer flex items-center justify-center gap-1.5"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
        </svg>
        <span>Share My Savings</span>
      </button>

      <button
        type="button"
        id="resetWalletBtn"
        class="py-2.5 px-3 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 font-bold text-xs transition cursor-pointer"
        title="Reset savings history"
      >
        Reset
      </button>
    </div>
  </div>
</div>

<script>
  interface SavingsRecord {
    id: string;
    storeName: string;
    storeSlug?: string;
    title: string;
    code?: string;
    badge: string;
    savingsAmount: number;
    timestamp: number;
  }

  interface SavingsWalletState {
    totalSaved: number;
    redeemedCount: number;
    streakDays: number;
    lastActiveDate: string;
    history: SavingsRecord[];
  }

  const STORAGE_KEY = 'promoradar_savings_wallet';

  function getDefaultWalletState(): SavingsWalletState {
    return {
      totalSaved: 0,
      redeemedCount: 0,
      streakDays: 1,
      lastActiveDate: new Date().toISOString().split('T')[0],
      history: []
    };
  }

  function getWalletState(): SavingsWalletState {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return getDefaultWalletState();
      return JSON.parse(raw);
    } catch (e) {
      return getDefaultWalletState();
    }
  }

  function saveWalletState(state: SavingsWalletState) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      window.dispatchEvent(new CustomEvent('promoradar_savings_updated', { detail: state }));
    } catch (e) {
      console.error('[PromoRadar] Error saving wallet state:', e);
    }
  }

  // Calculate savings deterministically based on genuine discount badge
  function calculateSavingsFromBadge(badge: string): number {
    if (!badge) return 10.0;
    const percentMatch = badge.match(/(\d+)%/);
    if (percentMatch) {
      const pct = parseInt(percentMatch[1], 10);
      // Assume a realistic average basket of $50
      return Math.round((50 * (pct / 100)) * 10) / 10;
    }
    const dollarMatch = badge.match(/\$(\d+)/);
    if (dollarMatch) {
      return parseFloat(dollarMatch[1]);
    }
    if (badge.toUpperCase().includes('FREE') || badge.toUpperCase().includes('BOGO')) {
      return 15.0;
    }
    return 10.0;
  }

  function getTierDetails(amount: number) {
    if (amount >= 300) {
      return {
        name: 'VIP Radar Diamond',
        icon: '💎',
        nextTarget: 300,
        nextName: 'Max Tier Unlocked',
        percent: 100,
        tierKey: 'diamond'
      };
    } else if (amount >= 150) {
      const nextTarget = 300;
      const progress = Math.min(100, Math.round(((amount - 150) / (300 - 150)) * 100));
      return {
        name: 'Gold Deal Hunter',
        icon: '🥇',
        nextTarget,
        nextName: 'VIP Radar Diamond',
        percent: progress,
        tierKey: 'gold'
      };
    } else if (amount >= 50) {
      const nextTarget = 150;
      const progress = Math.min(100, Math.round(((amount - 50) / (150 - 50)) * 100));
      return {
        name: 'Silver Shopper',
        icon: '🥈',
        nextTarget,
        nextName: 'Gold Deal Hunter',
        percent: progress,
        tierKey: 'silver'
      };
    } else {
      const nextTarget = 50;
      const progress = Math.min(100, Math.round((amount / 50) * 100));
      return {
        name: 'Bronze Saver',
        icon: '🥉',
        nextTarget,
        nextName: 'Silver Shopper',
        percent: progress,
        tierKey: 'bronze'
      };
    }
  }

  declare global {
    interface Window {
      recordSavingsRedemption: (deal: {
        storeName: string;
        storeSlug?: string;
        title: string;
        code?: string;
        badge: string;
      }) => void;
      openSavingsWalletModal: () => void;
      closeSavingsWalletModal: () => void;
      getSavingsWalletState: () => SavingsWalletState;
    }
  }

  // Record a redemption action into wallet
  window.recordSavingsRedemption = function(deal) {
    const state = getWalletState();
    const today = new Date().toISOString().split('T')[0];

    // Check if this exact deal title was redeemed in the last 10 minutes to avoid rapid double-clicks
    const now = Date.now();
    const isRecent = state.history.some(
      h => h.title === deal.title && (now - h.timestamp) < 10 * 60 * 1000
    );

    if (isRecent) return;

    const savings = calculateSavingsFromBadge(deal.badge);
    state.totalSaved = Math.round((state.totalSaved + savings) * 100) / 100;
    state.redeemedCount += 1;

    // Calculate streak
    if (state.lastActiveDate !== today) {
      const last = new Date(state.lastActiveDate).getTime();
      const diffDays = Math.round((new Date(today).getTime() - last) / (1000 * 60 * 60 * 24));
      if (diffDays === 1) {
        state.streakDays += 1;
      } else if (diffDays > 1) {
        state.streakDays = 1;
      }
      state.lastActiveDate = today;
    }

    const record: SavingsRecord = {
      id: `save_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`,
      storeName: deal.storeName,
      storeSlug: deal.storeSlug,
      title: deal.title,
      code: deal.code,
      badge: deal.badge,
      savingsAmount: savings,
      timestamp: now
    };

    // Prepend to history, max 30 items
    state.history.unshift(record);
    if (state.history.length > 30) state.history.pop();

    saveWalletState(state);
    updateUI(state);

    if ((window as any).showPromoToast) {
      (window as any).showPromoToast(`+$${savings.toFixed(2)} added to your Savings Wallet! 💰`);
    }
  };

  const modal = document.getElementById('savingsWalletModal');
  const closeBtn = document.getElementById('closeWalletModalBtn');
  const heroAmount = document.getElementById('walletHeroTotalAmount');
  const heroTierName = document.getElementById('walletHeroTierName');
  const heroRedeemedCount = document.getElementById('walletHeroRedeemedCount');
  const tierIcon = document.getElementById('walletTierIcon');
  const streakDaysText = document.getElementById('walletStreakDaysText');
  const progressLabel = document.getElementById('walletProgressLabel');
  const progressPercent = document.getElementById('walletProgressPercent');
  const progressBar = document.getElementById('walletProgressBar');
  const currentSavingsMini = document.getElementById('walletCurrentSavingsMini');
  const nextTierTarget = document.getElementById('walletNextTierTarget');
  const emptyState = document.getElementById('walletEmptyState');
  const historyList = document.getElementById('walletHistoryList');
  const historyCount = document.getElementById('walletHistoryCount');
  const shareBtn = document.getElementById('shareMySavingsBtn');
  const resetBtn = document.getElementById('resetWalletBtn');

  // Tier Boxes
  const tierBoxBronze = document.getElementById('tierBoxBronze');
  const tierBoxSilver = document.getElementById('tierBoxSilver');
  const tierBoxGold = document.getElementById('tierBoxGold');
  const tierBoxDiamond = document.getElementById('tierBoxDiamond');

  function updateTierHighlights(currentKey: string) {
    const boxes = [
      { key: 'bronze', el: tierBoxBronze },
      { key: 'silver', el: tierBoxSilver },
      { key: 'gold', el: tierBoxGold },
      { key: 'diamond', el: tierBoxDiamond }
    ];

    boxes.forEach(b => {
      if (!b.el) return;
      if (b.key === currentKey) {
        b.el.className = 'p-2.5 rounded-xl border-2 transition border-emerald-500 bg-emerald-50/70 dark:bg-emerald-950/30 text-slate-800 dark:text-slate-200 ring-2 ring-emerald-500/20';
      } else {
        b.el.className = 'p-2.5 rounded-xl border transition border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/40 text-slate-800 dark:text-slate-200 opacity-60';
      }
    });
  }

  function updateUI(state: SavingsWalletState) {
    const tier = getTierDetails(state.totalSaved);

    if (heroAmount) heroAmount.textContent = `$${state.totalSaved.toFixed(2)}`;
    if (heroTierName) heroTierName.textContent = tier.name;
    if (tierIcon) tierIcon.textContent = tier.icon;
    if (heroRedeemedCount) heroRedeemedCount.textContent = `${state.redeemedCount} Deals Activated`;
    if (streakDaysText) streakDaysText.textContent = `${state.streakDays} Day${state.streakDays > 1 ? 's' : ''} Active`;

    if (progressLabel) {
      progressLabel.textContent = tier.nextName === 'Max Tier Unlocked'
        ? 'VIP Diamond Master Tier'
        : `Progress to ${tier.nextName}`;
    }
    if (progressPercent) progressPercent.textContent = `${tier.percent}%`;
    if (progressBar) progressBar.style.width = `${tier.percent}%`;
    if (currentSavingsMini) currentSavingsMini.textContent = `$${state.totalSaved.toFixed(2)}`;
    if (nextTierTarget) nextTierTarget.textContent = `$${tier.nextTarget.toFixed(2)}`;

    updateTierHighlights(tier.tierKey);

    // Also update Header Widget Elements if present in DOM
    const headerSavedAmount = document.getElementById('headerSavedAmount');
    const headerTierName = document.getElementById('savingsTierName');
    if (headerSavedAmount) headerSavedAmount.textContent = `$${state.totalSaved.toFixed(2)}`;
    if (headerTierName) headerTierName.textContent = tier.name;

    // Render history
    if (historyCount) historyCount.textContent = `${state.history.length} items`;

    if (state.history.length === 0) {
      emptyState?.classList.remove('hidden');
      historyList?.classList.add('hidden');
    } else {
      emptyState?.classList.add('hidden');
      if (historyList) {
        historyList.classList.remove('hidden');
        historyList.innerHTML = state.history.map(item => {
          const dateStr = new Date(item.timestamp).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
          const storeUrl = item.storeSlug ? `/stores/${item.storeSlug}/` : '#';
          return `
            <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800 flex items-center justify-between gap-3 text-xs">
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-1.5 mb-0.5">
                  <span class="font-extrabold text-slate-900 dark:text-white truncate">${item.storeName}</span>
                  <span class="text-[10px] font-bold px-1.5 py-0.2 rounded bg-rose-50 text-rose-600 border border-rose-200/60 dark:bg-rose-500/10 dark:text-rose-300 dark:border-rose-500/20">${item.badge}</span>
                </div>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 truncate">${item.title}</p>
                <span class="text-[10px] text-slate-400">${dateStr}</span>
              </div>
              <div class="text-right shrink-0">
                <span class="text-xs font-black text-emerald-600 dark:text-emerald-400 block">+$\${item.savingsAmount.toFixed(2)}</span>
                <a href="${storeUrl}" class="text-[10px] text-indigo-600 dark:text-indigo-400 font-bold hover:underline">View Store ↗</a>
              </div>
            </div>
          `;
        }).join('');
      }
    }
  }

  window.openSavingsWalletModal = function() {
    if (!modal) return;
    const state = getWalletState();
    updateUI(state);
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.classList.add('overflow-hidden');
  };

  window.closeSavingsWalletModal = function() {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.classList.remove('overflow-hidden');
  };

  window.getSavingsWalletState = getWalletState;

  closeBtn?.addEventListener('click', window.closeSavingsWalletModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) window.closeSavingsWalletModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      window.closeSavingsWalletModal();
    }
  });

  // Share savings action
  shareBtn?.addEventListener('click', () => {
    const state = getWalletState();
    const tier = getTierDetails(state.totalSaved);
    const text = `I've saved $${state.totalSaved.toFixed(2)} using verified coupons on PromoRadar! I unlocked the ${tier.name} rank. Find promo codes at https://promoradar.store`;

    if (navigator.share) {
      navigator.share({
        title: 'My PromoRadar Savings',
        text: text,
        url: 'https://promoradar.store'
      }).catch(() => {});
    } else {
      navigator.clipboard?.writeText(text).then(() => {
        if ((window as any).showPromoToast) {
          (window as any).showPromoToast('Savings summary copied to clipboard! Share it with friends ✨');
        }
      });
    }
  });

  // Reset wallet action
  resetBtn?.addEventListener('click', () => {
    if (confirm('Are you sure you want to reset your savings wallet history?')) {
      const empty = getDefaultWalletState();
      saveWalletState(empty);
      updateUI(empty);
      if ((window as any).showPromoToast) {
        (window as any).showPromoToast('Savings wallet reset.');
      }
    }
  });

  // Global listener for open wallet triggers
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement)?.closest('#headerSavingsWalletBtn, [data-open-savings-wallet]');
    if (target) {
      e.preventDefault();
      window.openSavingsWalletModal();
    }
  });

  // Initial load
  document.addEventListener('DOMContentLoaded', () => {
    const state = getWalletState();
    updateUI(state);
  });

  // Immediate execution in case DOM is already ready
  const initialState = getWalletState();
  updateUI(initialState);
</script>
