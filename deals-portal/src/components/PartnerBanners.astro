---
interface BannerItem {
  name: string;
  width: number;
  height: number;
  sizeKey: string;
  src: string;
  cdnSrc: string;
  isBlackFriday: boolean;
  affiliateUrl: string;
}

interface Props {
  storeSlug: string;
  storeName: string;
  banners?: BannerItem[];
}

const { storeSlug, storeName, banners = [] } = Astro.props;

// Pick hero banner: 728x90, or 1200x628, or first banner
const heroBanner = banners.find(b => b.sizeKey === '728x90' && b.isBlackFriday) 
  || banners.find(b => b.sizeKey === '728x90')
  || banners.find(b => b.sizeKey === '1200x628')
  || (banners.length > 0 && banners[0].width >= 600 ? banners[0] : null);

// Pick grid items (300x250, 336x280, 800x500 or remainder)
const gridBanners = banners.filter(b => b !== heroBanner && (b.sizeKey === '300x250' || b.sizeKey === '336x280' || b.sizeKey === '800x500')).slice(0, 2);
---

{banners.length > 0 && (
  <div class="my-6 space-y-4">
    <!-- Clean Hero Banner (без рамок, плашек, скруглений и подписей) -->
    {heroBanner && (
      <div class="flex items-center justify-center">
        <a 
          href={heroBanner.affiliateUrl} 
          target="_blank" 
          rel="nofollow sponsored"
          class="block transition duration-200 hover:opacity-95"
        >
          <img 
            src={heroBanner.src} 
            alt={`${storeName} Promo Banner`} 
            width={heroBanner.width} 
            height={heroBanner.height}
            loading="lazy"
            class="max-w-full h-auto block"
          />
        </a>
      </div>
    )}

    <!-- Clean Grid Banners (без рамок, плашек, скруглений и подписей) -->
    {gridBanners.length > 0 && (
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 place-items-center">
        {gridBanners.map(banner => (
          <a 
            href={banner.affiliateUrl} 
            target="_blank" 
            rel="nofollow sponsored"
            class="block transition duration-200 hover:opacity-95"
          >
            <img 
              src={banner.src} 
              alt={`${storeName} ${banner.sizeKey} Banner`} 
              width={banner.width} 
              height={banner.height}
              loading="lazy"
              class="max-w-full h-auto block"
            />
          </a>
        ))}
      </div>
    )}
  </div>
)}
