---
export interface Props {
  platformName: string;
  discountBadge: string;
  dealTitle: string;
  dealDescription: string;
  couponCode: string;
  offerSlug?: 'vip-trial' | 'verified-match' | 'discreet-local' | 'deep-lookup';
  verifiedUsesToday?: number;
  successRate?: string;
  isExclusive?: boolean;
  className?: string;
}

const {
  platformName,
  discountBadge,
  dealTitle,
  dealDescription,
  couponCode,
  offerSlug = 'vip-trial',
  verifiedUsesToday,
  successRate = '99.1% Working',
  isExclusive = true,
  className = ''
} = Astro.props;

function getDailyUses(seed: string): number {
  const todayStr = new Date().toISOString().slice(0, 10);
  const combined = `${todayStr}-${seed}`;
  let hash = 0;
  for (let i = 0; i < combined.length; i++) {
    hash = (hash << 5) - hash + combined.charCodeAt(i);
    hash |= 0;
  }
  return 94 + (Math.abs(hash) % 145);
}

const usesCount = verifiedUsesToday ?? getDailyUses(dealTitle);
const maskedCode = couponCode.length > 4 
  ? `••••${couponCode.slice(-4)}`
  : '••••2026';

const platformSlug = platformName.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const outboundUrl = `https://flirtcheck.site/go/${offerSlug}?src=deals_portal&ctx=${encodeURIComponent(platformSlug)}&intent=coupon_unlock`;
const cardId = `deal-reveal-${Math.random().toString(36).slice(2, 9)}`;
---

<div
  id={cardId}
  class={`deal-card group bg-white border-2 border-slate-900 p-5 sm:p-6 shadow-[4px_4px_0px_0px_#0f172a] transition-all hover:-translate-y-0.5 hover:shadow-[6px_6px_0px_0px_#0f172a] flex flex-col justify-between not-prose relative overflow-hidden ${className}`}
  data-coupon-code={couponCode}
  data-outbound-url={outboundUrl}
  aria-label={`Deal Voucher: ${dealTitle}`}
>
  <!-- Top Badge Row -->
  <div>
    <div class="flex items-start justify-between gap-3 mb-3">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="font-mono text-[10px] font-bold uppercase tracking-wider bg-slate-100 text-slate-800 px-2.5 py-1 border border-slate-300">
          {platformName}
        </span>
        {isExclusive && (
          <span class="font-mono text-[9px] font-bold uppercase tracking-widest bg-amber-100 text-amber-900 px-2 py-0.5 border border-amber-300">
            ★ EXCLUSIVE PROMO
          </span>
        )}
      </div>

      <!-- Discount Badge -->
      <div class="bg-rose-700 text-white font-mono font-black text-xs sm:text-sm px-3 py-1 uppercase tracking-wider border border-slate-900 shadow-[1px_1px_0px_0px_#0f172a] shrink-0">
        {discountBadge}
      </div>
    </div>

    <!-- Title -->
    <h3 class="font-serif font-black text-lg sm:text-xl text-slate-900 leading-snug mb-2 group-hover:text-rose-700 transition-colors m-0">
      {dealTitle}
    </h3>

    <!-- Description -->
    <p class="font-sans text-xs sm:text-sm text-slate-600 leading-relaxed mb-4 m-0">
      {dealDescription}
    </p>
  </div>

  <!-- Dual-Tab Action Area -->
  <div class="pt-4 border-t border-slate-200/90 mt-4">
    <!-- Unrevealed State (Initial) -->
    <div class="unrevealed-box flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
      <!-- Trust Meta -->
      <div class="flex items-center gap-2.5 text-[11px] font-mono text-slate-600">
        <span class="inline-flex items-center gap-1 text-emerald-700 font-bold">
          <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          {successRate}
        </span>
        <span>·</span>
        <span class="text-slate-500 font-mono text-[10px]">
          {usesCount} used today
        </span>
      </div>

      <!-- Reveal Button -->
      <button
        type="button"
        class="reveal-trigger inline-flex items-center justify-center gap-2 px-5 py-3 bg-slate-900 hover:bg-rose-700 active:bg-rose-800 text-white font-mono font-bold text-xs uppercase tracking-wider transition-all border border-slate-900 shadow-[3px_3px_0px_0px_#0f172a] hover:shadow-none active:translate-x-0.5 active:translate-y-0.5 cursor-pointer shrink-0"
      >
        <span class="text-amber-300 font-mono tracking-widest">{maskedCode}</span>
        <span class="border-l border-slate-700 pl-2">REVEAL CODE &amp; ACTIVATE ↗</span>
      </button>
    </div>

    <!-- Revealed State (Active upon click) -->
    <div class="revealed-box hidden space-y-3 bg-emerald-50/70 border border-emerald-300 p-4">
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="font-mono text-[10px] font-bold text-emerald-800 uppercase tracking-widest flex items-center gap-1">
              <svg class="w-3.5 h-3.5 text-emerald-600" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              COPIED TO CLIPBOARD
            </span>
          </div>
          <p class="text-xs text-slate-700 m-0 font-sans">
            Code copied! Paste at registration or continue in the newly opened partner window.
          </p>
        </div>

        <!-- Unmasked Code Box -->
        <div class="flex items-center gap-2">
          <div class="px-4 py-2 bg-white border-2 border-dashed border-emerald-600 font-mono font-black text-sm text-slate-900 tracking-widest select-all">
            {couponCode}
          </div>
          <a
            href={outboundUrl}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-mono text-xs font-bold uppercase tracking-wider transition-colors inline-flex items-center gap-1 shrink-0"
          >
            <span>GO TO OFFER</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ cardId, couponCode, outboundUrl }}>
  (function() {
    const root = document.getElementById(cardId);
    if (!root) return;

    const triggerBtn = root.querySelector('.reveal-trigger');
    const unrevealedBox = root.querySelector('.unrevealed-box');
    const revealedBox = root.querySelector('.revealed-box');

    if (!triggerBtn || !unrevealedBox || !revealedBox) return;

    triggerBtn.addEventListener('click', function(e) {
      e.preventDefault();

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(couponCode).catch(function() {});
      }

      unrevealedBox.classList.add('hidden');
      revealedBox.classList.remove('hidden');

      try {
        window.open(outboundUrl, '_blank', 'noopener,noreferrer');
      } catch (err) {
        window.location.href = outboundUrl;
      }
    });
  })();
</script>
