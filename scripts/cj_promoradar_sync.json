"/**\n * CJ Affiliate Continuous Pipeline:\n * 1. Automatic Scouting: Filters top-converting advertisers by category and EPC\n * 2. Status Tracking: Detects auto-accepts and manual approvals\n * 3. Offer & Coupon Ingestion: Extracts tracking links and coupon codes\n * 4. Site Catalog Sync: Prepares store entries for PromoRadar\n */\n\nconst https = require('https');\nconst fs = require('fs');\nconst path = require('path');\n\nconst CONFIG = {\n  token: 'iTOZ5YSaULmdycZWAbA4ce0N1w',\n  cid: '8102806',\n  pollIntervalMs: 15 * 60 * 1000 // 15 mins\n};\n\nconst LOG_FILE = path.resolve(__dirname, '../artifacts_admitad/cj_sync.log');\nconst STATE_FILE = path.resolve(__dirname, '../artifacts_admitad/cj_active_offers.json');\nconst PIPELINE_FILE = path.resolve(__dirname, '../artifacts_admitad/cj_pipeline_manifest.json');\n\nfunction log(msg) {\n  const line = `[${new Date().toISOString()}] [CJ-AUTONOMOUS] ${msg}`;\n  console.log(line);\n  try {\n    fs.mkdirSync(path.dirname(LOG_FILE), { recursive: true });\n    fs.appendFileSync(LOG_FILE, line + '\\n');\n  } catch {}\n}\n\nfunction requestCJ(hostname, path) {\n  return new Promise((resolve, reject) => {\n    const options = {\n      hostname,\n      path,\n      method: 'GET',\n      headers: {\n        'Authorization': 'Bearer ' + CONFIG.token,\n        'User-Agent': 'PromoRadar-CJ-Autonomous/2.0'\n      }\n    };\n\n    const req = https.request(options, (res) => {\n      let data = '';\n      res.on('data', chunk => data += chunk);\n      res.on('end', () => {\n        if (res.statusCode >= 200 && res.statusCode < 300) {\n          resolve(data);\n        } else {\n          reject(new Error(`CJ API HTTP ${res.statusCode}: ${data}`));\n        }\n      });\n    });\n\n    req.on('error', reject);\n    req.end();\n  });\n}\n\n// 1. Scout High-Yield Targets\nasync function scoutOpportunities() {\n  log('Scanning CJ directory for highest-yield affiliate partners...');\n  const targets = [];\n  const queries = ['vpn', 'hosting', 'travel', 'insurance', 'software'];\n\n  for (const q of queries) {\n    try {\n      const xml = await requestCJ(\n        'advertiser-lookup.api.cj.com',\n        `/v2/advertiser-lookup?requestor-cid=${CONFIG.cid}&keywords=${q}&records-per-page=20`\n      );\n\n      const regex = /<advertiser>[\\s\\S]*?<advertiser-id>(\\d+)<\\/advertiser-id>[\\s\\S]*?<account-status>(.*?)<\\/account-status>[\\s\\S]*?<seven-day-epc>(.*?)<\\/seven-day-epc>[\\s\\S]*?<three-month-epc>(.*?)<\\/three-month-epc>[\\s\\S]*?<advertiser-name>(.*?)<\\/advertiser-name>[\\s\\S]*?<program-url>(.*?)<\\/program-url>[\\s\\S]*?<relationship-status>(.*?)<\\/relationship-status>[\\s\\S]*?<\\/advertiser>/g;\n      let m;\n      while ((m = regex.exec(xml)) !== null) {\n        const epc7 = parseFloat(m[3]) || 0;\n        const epc90 = parseFloat(m[4]) || 0;\n        if (m[2] === 'Active' && (epc7 >= 10.0 || epc90 >= 10.0)) {\n          targets.push({\n            id: m[1],\n            name: m[5],\n            url: m[6],\n            epc7d: epc7,\n            epc90d: epc90,\n            status: m[7],\n            score: (epc7 * 0.7) + (epc90 * 0.3)\n          });\n        }\n      }\n    } catch (e) {\n      log(`Error scouting query ${q}: ${e.message}`);\n    }\n  }\n\n  targets.sort((a,b) => b.score - a.score);\n  const unique = Array.from(new Map(targets.map(t => [t.id, t])).values());\n  log(`Scouting completed: identified ${unique.length} premium tier candidates.`);\n  return unique;\n}\n\n// 2. Track Joined Programs\nasync function checkJoinedAdvertisers() {\n  log('Checking joined advertisers for CID ' + CONFIG.cid + '...');\n  try {\n    const xml = await requestCJ(\n      'advertiser-lookup.api.cj.com',\n      `/v2/advertiser-lookup?requestor-cid=${CONFIG.cid}&advertiser-ids=joined`\n    );\n\n    const totalMatch = xml.match(/total-matched=\"(\\d+)\"/);\n    const count = totalMatch ? parseInt(totalMatch[1], 10) : 0;\n    log(`Found ${count} joined advertisers.`);\n\n    if (count > 0) {\n      const advertisers = [];\n      const regex = /<advertiser>[\\s\\S]*?<advertiser-id>(\\d+)<\\/advertiser-id>[\\s\\S]*?<advertiser-name>(.*?)<\\/advertiser-name>[\\s\\S]*?<seven-day-epc>(.*?)<\\/seven-day-epc>[\\s\\S]*?<\\/advertiser>/g;\n      let m;\n      while ((m = regex.exec(xml)) !== null) {\n        advertisers.push({ id: m[1], name: m[2], epc7d: m[3] });\n      }\n      return advertisers;\n    }\n    return [];\n  } catch (err) {\n    log(`Error checking joined: ${err.message}`);\n    return [];\n  }\n}\n\n// 3. Fetch Active Coupons\nasync function fetchCouponsForAdvertiser(advertiserId) {\n  log(`Ingesting active coupons for Advertiser ID ${advertiserId}...`);\n  try {\n    const xml = await requestCJ(\n      'link-search.api.cj.com',\n      `/v2/link-search?advertiser-ids=${advertiserId}&link-type=coupon&promotion-type=coupon&page-number=1&records-per-page=20`\n    );\n\n    const coupons = [];\n    const linkRegex = /<link>[\\s\\S]*?<link-id>(\\d+)<\\/link-id>[\\s\\S]*?<link-name>(.*?)<\\/link-name>[\\s\\S]*?<clickUrl>(.*?)<\\/clickUrl>[\\s\\S]*?<coupon-code>(.*?)<\\/coupon-code>[\\s\\S]*?<\\/link>/g;\n    let match;\n    while ((match = linkRegex.exec(xml)) !== null) {\n      coupons.push({\n        linkId: match[1],\n        title: match[2],\n        url: match[3],\n        code: match[4]\n      });\n    }\n    log(`Ingested ${coupons.length} valid coupons.`);\n    return coupons;\n  } catch (err) {\n    log(`Error fetching coupons: ${err.message}`);\n    return [];\n  }\n}\n\n// 4. Main Autonomous Loop\nasync function runAutonomousCycle() {\n  log('========================================================');\n  log('🚀 Running CJ Autonomous Selection & Sync Cycle');\n  log('========================================================');\n\n  // Step A: Scout & Rank candidates\n  const scouted = await scoutOpportunities();\n  \n  // Step B: Check active connections\n  const joined = await checkJoinedAdvertisers();\n\n  const manifest = {\n    updatedAt: new Date().toISOString(),\n    joinedCount: joined.length,\n    scoutedCount: scouted.length,\n    activePrograms: {},\n    topScoutedOpportunities: scouted.slice(0, 20)\n  };\n\n  if (joined.length > 0) {\n    for (const adv of joined) {\n      const coupons = await fetchCouponsForAdvertiser(adv.id);\n      manifest.activePrograms[adv.name] = {\n        id: adv.id,\n        epc: adv.epc7d,\n        coupons\n      };\n    }\n    fs.writeFileSync(STATE_FILE, JSON.stringify(manifest.activePrograms, null, 2));\n  }\n\n  fs.writeFileSync(PIPELINE_FILE, JSON.stringify(manifest, null, 2));\n  log(`Pipeline state updated. Next cycle in 15 minutes.`);\n}\n\nrunAutonomousCycle();\nsetInterval(runAutonomousCycle, CONFIG.pollIntervalMs);\n"