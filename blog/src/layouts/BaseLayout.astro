---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyRadar from '../components/StickyRadar.astro';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  imageUrl?: string;
  preloadImage?: string;
  activePath?: string;
}

const {
  title,
  description,
  canonicalUrl,
  ogImage,
  imageUrl,
  preloadImage,
  activePath = '/'
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://flirtcheck.site';
const fullCanonical = canonicalUrl || `${siteUrl}/`;
const rawImage = imageUrl || ogImage;
const fullImageUrl = rawImage
  ? (rawImage.startsWith('http') ? rawImage : new URL(rawImage, Astro.site || 'https://flirtcheck.site').href)
  : 'https://flirtcheck.site/images/default-og.webp';
---

<!DOCTYPE html>
<html lang="en" class="bg-[#FAF7F2] text-slate-900 antialiased scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="robots" content="noindex, nofollow, noarchive" />

    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" type="image/webp" />
    )}
    <slot name="head" />

    <!-- OpenGraph Metadata -->
    <meta property="og:site_name" content="FlirtCheck Independent Forensics" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:image:type" content="image/webp" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@flirtcheck" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />
  </head>

  <body class="min-h-screen flex flex-col bg-[#FBF8F1] text-slate-900">
    <Header activePath={activePath} />

    <main class="flex-1 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
      <slot />
    </main>

    <StickyRadar />

    <Footer />
  </body>
</html>
