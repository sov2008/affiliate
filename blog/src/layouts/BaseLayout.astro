---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyRadar from '../components/StickyRadar.astro';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  activePath?: string;
}

const {
  title,
  description,
  canonicalUrl,
  ogImage = '/images/posts/reverse-image-search-lens-scam.webp',
  activePath = '/'
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://flirtcheck.site';
const fullCanonical = canonicalUrl || `${siteUrl}/`;
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`;
---

<!DOCTYPE html>
<html lang="en" class="bg-[#FBF8F1] text-slate-900 antialiased scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex, nofollow, noarchive" />

    <!-- OpenGraph Metadata -->
    <meta property="og:site_name" content="FlirtCheck Safety Editorial" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:image:type" content="image/webp" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@flirtcheck" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />
  </head>

  <body class="min-h-screen flex flex-col bg-[#FBF8F1] text-slate-900">
    <Header activePath={activePath} />

    <main class="flex-1 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
      <slot />
    </main>

    <StickyRadar />

    <Footer />
  </body>
</html>
