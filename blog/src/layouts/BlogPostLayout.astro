---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ReadingProgressBar from '../components/ReadingProgressBar.astro';
import DossierContextBox from '../components/DossierContextBox.astro';
import MobileStickyCTA from '../components/MobileStickyCTA.astro';
import InlineQuiz from '../components/InlineQuiz.astro';
import ExitIntentModal from '../components/ExitIntentModal.astro';
import SocialShareBar from '../components/SocialShareBar.astro';
import { CATEGORIES_METADATA, CategoryEnum, type Category } from '../content.config';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  author: string;
  category?: Category;
  tags: string[];
  seoKeywords: string[];
  canonicalUrl?: string;
  coverImage?: string;
  image?: string;
  slug?: string;
  readingTime?: number;
  motto?: string;
  hook?: string;
  caseId?: string;
  classification?: string;
  telemetryRisk?: string;
}

const {
  title,
  description,
  pubDate,
  author,
  category,
  tags,
  seoKeywords,
  canonicalUrl = Astro.url.href,
  coverImage,
  image,
  slug,
  readingTime = 4,
  caseId: explicitCaseId
} = Astro.props;

const catId: Category = category && CATEGORIES_METADATA[category] ? category : 'safety-dossier';
const catMeta = CATEGORIES_METADATA[catId];
const caseId = explicitCaseId || ((slug || '2026').replace(/[^a-zA-Z0-9]/g, '').slice(-4).toUpperCase() || '2026');

const siteBaseUrl = 'https://flirtcheck.site';
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || siteBaseUrl;
const rawImg = coverImage || image;
const normalizedImg = rawImg ? rawImg.replace(/^\/blog/, '') : undefined;
const effectiveCoverImage = normalizedImg
  ? (normalizedImg.startsWith('/') ? normalizedImg : `/${normalizedImg}`)
  : undefined;
const normalizedCanonical = canonicalUrl ? canonicalUrl.replace(/https?:\/\/flirtcheck\.site\/blog\//, `${siteBaseUrl}/`) : '';
const canonicalAbsUrl = normalizedCanonical.startsWith('http')
  ? normalizedCanonical
  : `${siteBaseUrl}${normalizedCanonical.startsWith('/') ? '' : '/'}${normalizedCanonical}`;
const ogImageAbsUrl = effectiveCoverImage
  ? (effectiveCoverImage.startsWith('http') ? effectiveCoverImage : `${siteBaseUrl}${effectiveCoverImage.startsWith('/') ? '' : '/'}${effectiveCoverImage}`)
  : `${siteBaseUrl}/images/posts/${slug || 'dating-scam-verification-guide-2026'}.webp`;

const pubMonthYear = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  year: 'numeric'
}).format(pubDate);

// Generate 3 contextual key takeaway bullets for Executive Summary
const topicClean = title.replace(/^(the|how to|why|what to say when|what to)\s+/i, '');
const findingsList = [
  `Empirical analysis of ${topicClean.toLowerCase()}: identifying systematic algorithmic bias, behavioral funnels, and data telemetry.`,
  `Audit protocols: recognizing unverified profile signatures, bot farm syntax loops, and high-risk extraction patterns.`,
  `Technical defense checklist: operational guidelines for identity protection and mitigating digital manipulation.`
];

// Schema.org Article Structured Data
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": `${title} | FlirtCheck Investigation`,
  "description": description,
  "inLanguage": "en-US",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalAbsUrl
  },
  "author": {
    "@type": "Person",
    "name": "Senior Investigative Desk",
    "url": `${siteUrl}/author/editorial`
  },
  "publisher": {
    "@type": "Organization",
    "name": "FlirtCheck Independent Forensics",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/avatar.jpg`
    }
  },
  "datePublished": pubDate.toISOString(),
  "dateModified": pubDate.toISOString(),
  "keywords": seoKeywords.join(', ')
};

// Schema.org Breadcrumbs
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": `${siteUrl}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Archive",
      "item": `${siteUrl}/#feed`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": catMeta.shortTitle,
      "item": `${siteUrl}/category/${catMeta.id}`
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": title,
      "item": canonicalAbsUrl
    }
  ]
};

// Schema.org FAQPage Structured Data
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the fastest way to verify a dating profile?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The fastest zero-cost method is requesting a 15-second live video call or using our integrated safety lookup tool before exchanging personal social media or phone numbers."
      }
    },
    {
      "@type": "Question",
      "name": "Can AI detect whether a dating profile is genuine?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Automated security filters evaluate account creation velocity, IP fingerprint anomalies, syntactic repetition across chat logs, and visual GAN artifacts in uploaded gallery pictures."
      }
    },
    {
      "@type": "Question",
      "name": "What should I do if I discover a scammer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Immediately capture screenshots of the profile and chat log, report the account within the dating platform's safety center, block all communication channels, and never send funds under any circumstances."
      }
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en" class="bg-[#FAF7F2] text-slate-900 antialiased scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | FlirtCheck Investigation</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={seoKeywords.join(', ')} />
    <meta name="author" content={author} />
    <link rel="canonical" href={canonicalAbsUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="robots" content="noindex, nofollow, noarchive" />

    <!-- OpenGraph Metadata -->
    <meta property="og:site_name" content="FlirtCheck Independent Forensics" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={`${title} | FlirtCheck Investigation`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalAbsUrl} />
    <meta property="og:image" content={ogImageAbsUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/webp" />
    <meta property="article:published_time" content={pubDate.toISOString()} />
    <meta property="article:author" content="https://flirtcheck.site" />
    {tags.map(tag => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@flirtcheck" />
    <meta name="twitter:title" content={`${title} | FlirtCheck Investigation`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsUrl} />

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>

  <body class="min-h-screen flex flex-col bg-[#FAF7F2] text-slate-900">
    <!-- Top Reading Progress Indicator -->
    <ReadingProgressBar />

    <Header activePath="/" />

    <main class="flex-1 max-w-[68ch] mx-auto px-4 sm:px-6 py-8 w-full">
      <!-- Editorial Breadcrumbs Navigation -->
      <nav aria-label="Breadcrumbs" class="py-2 mb-4 text-xs font-sans text-slate-500">
        <div class="flex flex-wrap items-center gap-2">
          <a href="/" class="hover:text-slate-900 transition-colors">Home</a>
          <span class="text-slate-300">/</span>
          <a href="/#feed" class="hover:text-slate-900 transition-colors">Archive</a>
          <span class="text-slate-300">/</span>
          <a href={`/category/${catMeta.id}`} class="text-slate-700 hover:text-slate-900 transition-colors font-medium">
            {catMeta.shortTitle}
          </a>
        </div>
      </nav>

      <!-- Article Header -->
      <header class="my-6 pb-6 border-b border-slate-200">
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <a
            href={`/category/${catMeta.id}`}
            class="px-2.5 py-0.5 rounded text-xs font-sans font-medium uppercase tracking-wider bg-slate-100 text-slate-800 border border-slate-300 hover:bg-slate-200 transition-colors"
          >
            {catMeta.shortTitle}
          </a>
          {tags.slice(0, 3).map(tag => (
            <span class="px-2 py-0.5 rounded text-[11px] font-sans text-slate-600 bg-white border border-slate-200">
              #{tag}
            </span>
          ))}
          <span id="readingTimeBadge" class="text-xs font-sans text-slate-500 ml-auto">
            {readingTime} min read
          </span>
        </div>

        <!-- Headline -->
        <h1 class="font-bold text-2xl sm:text-3xl lg:text-4xl text-slate-900 tracking-tight leading-tight mb-4 font-sans">
          {title}
        </h1>

        <!-- Editorial Authority Byline -->
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1 pt-3 border-t border-slate-200 text-xs text-slate-600 font-sans">
          <span class="font-medium text-slate-900">By <a href="/desk" class="underline font-bold hover:text-rose-600">Arthur Vance</a></span>
          <span class="text-slate-300">·</span>
          <span>Cheltenham Bureau</span>
          <span class="text-slate-300">·</span>
          <span>Published {pubMonthYear}</span>
          <span class="text-slate-300">·</span>
          <span class="inline-flex items-center gap-1 text-emerald-700 font-medium bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200 text-[11px]">
            ✓ Verified Independent
          </span>
        </div>
      </header>

      <!-- Executive Summary / Key Findings Box (TL;DR) -->
      <div class="bg-slate-50 border-l-4 border-slate-900 p-4 sm:p-5 my-6 rounded-r-lg font-sans">
        <span class="font-mono text-xs font-bold uppercase tracking-wider text-slate-500 block mb-2">
          Investigation Abstract & Key Findings
        </span>
        <p class="text-sm sm:text-base text-slate-700 leading-relaxed font-sans mb-3">
          {description}
        </p>
        <ul class="space-y-1.5 text-xs sm:text-sm text-slate-800 list-disc list-outside pl-4 font-sans">
          {findingsList.map(item => (
            <li class="leading-relaxed">{item}</li>
          ))}
        </ul>
      </div>

      <!-- Social Share Bar (Top) -->
      <SocialShareBar title={title} url={canonicalAbsUrl} className="my-6" />

      <!-- 16:9 Full WebP Cover Frame -->
      <div class="mb-8 overflow-hidden rounded-lg border border-slate-200 shadow-sm bg-slate-100">
        <img
          src={effectiveCoverImage || `/images/posts/${slug || 'dating-scam-verification-guide-2026'}.webp`}
          alt={title}
          class="w-full aspect-[16/9] object-cover select-none pointer-events-none"
          loading="eager"
        />
      </div>

      <!-- Article Markdown Typography Content (Longform Readability) -->
      <article class="prose prose-slate max-w-[68ch] mx-auto
        [&>p:first-of-type::first-letter]:float-left 
        [&>p:first-of-type::first-letter]:text-5xl sm:[&>p:first-of-type::first-letter]:text-6xl 
        [&>p:first-of-type::first-letter]:font-serif 
        [&>p:first-of-type::first-letter]:font-bold 
        [&>p:first-of-type::first-letter]:mr-3 
        [&>p:first-of-type::first-letter]:mb-1 
        [&>p:first-of-type::first-letter]:leading-none 
        [&>p:first-of-type::first-letter]:text-slate-900
        [&_h1]:text-2xl sm:[&_h1]:text-3xl [&_h1]:font-bold [&_h1]:text-slate-900 [&_h1]:mt-8 [&_h1]:mb-4
        [&_h2]:font-serif [&_h2]:font-bold [&_h2]:text-2xl sm:[&_h2]:text-3xl [&_h2]:text-slate-900 [&_h2]:mt-10 [&_h2]:mb-4 [&_h2]:pt-6 [&_h2]:border-t [&_h2]:border-slate-200
        [&_h3]:font-serif [&_h3]:font-bold [&_h3]:text-xl sm:[&_h3]:text-2xl [&_h3]:text-slate-900 [&_h3]:mt-6 [&_h3]:mb-3
        [&_p]:font-sans [&_p]:text-[17px] sm:[&_p]:text-[18px] [&_p]:text-slate-800 [&_p]:leading-[1.75] [&_p]:tracking-[-0.01em] [&_p]:mb-5
        [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-5 [&_ul]:space-y-2 [&_ul]:text-slate-800 [&_ul]:text-[16px] sm:[&_ul]:text-[17px]
        [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:mb-5 [&_ol]:space-y-2 [&_ol]:text-slate-800 [&_ol]:text-[16px] sm:[&_ol]:text-[17px]
        [&_li]:text-slate-800 [&_li]:leading-relaxed
        [&_blockquote]:font-serif [&_blockquote]:italic [&_blockquote]:text-lg sm:[&_blockquote]:text-xl [&_blockquote]:text-slate-800 [&_blockquote]:border-l-2 [&_blockquote]:border-rose-600 [&_blockquote]:pl-4 [&_blockquote]:py-1 [&_blockquote]:my-6
        [&_hr]:border-slate-200 [&_hr]:my-8">
        <slot />
      </article>

      <!-- Contextual Editorial Note (Replaced DossierContextBox) -->
      <DossierContextBox />

      <!-- Social Share Bar (Bottom) -->
      <SocialShareBar title={title} url={canonicalAbsUrl} className="my-8" />

      <!-- Author Editorial Masthead & Confidential Desk Notice -->
      <div class="my-8 p-5 sm:p-6 rounded-lg bg-white border-2 border-slate-900 shadow-[4px_4px_0px_0px_#0f172a] flex flex-col sm:flex-row items-start gap-4">
        <img
          src="/images/author/arthur-vance-avatar.webp"
          alt="Arthur Vance"
          class="w-14 h-14 rounded-full border-2 border-slate-900 object-cover shrink-0 shadow-[2px_2px_0px_0px_#0f172a]"
          loading="lazy"
        />
        <div class="flex-1 min-w-0 font-sans">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5">
            <div>
              <h4 class="font-bold text-sm text-slate-900">
                <a href="/desk" class="hover:text-rose-600 hover:underline">Arthur Vance</a> // Lead Forensic Desk
              </h4>
              <span class="text-[11px] font-mono text-slate-500">Bureau Base: Cheltenham, UK · Station 04</span>
            </div>
            <a
              href="/desk"
              class="inline-flex items-center gap-1 text-[11px] font-mono font-bold text-rose-600 bg-rose-50 px-2.5 py-1 rounded border border-rose-300 hover:bg-rose-100 transition-colors"
            >
              Support Arthur's Independent Research →
            </a>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed mb-2.5">
            Arthur Vance investigates commercial matchmaking telemetry, hidden ELO ranking systems, and synthetic fraud funnels under confidential protocols. Read the <a href="/desk" class="text-slate-900 font-medium underline hover:text-rose-600">Investigative Manifesto</a>.
          </p>
          <div class="text-[11px] font-mono text-slate-500 flex items-center gap-1.5">
            <span class="text-slate-900 font-bold">Encrypted tips & leaks:</span>
            <a href="mailto:desk@dating-radar.com" class="text-slate-900 underline hover:text-rose-600">desk@dating-radar.com</a>
          </div>
        </div>
      </div>

      <!-- Mid-Article Sticky Inline Radar Quiz (Injected dynamically into article midpoint) -->
      <div id="mid-quiz-container" class="my-8 not-prose">
        <InlineQuiz
          slug={slug}
          quizId="mid-radar-quiz"
          title="⚡ Quick Scan: Is Your Dating Match Real?"
          subtitle="Instant cross-reference against verified anti-bot database and spoofing patterns."
        />
      </div>

      <!-- Conversion Hook: Full AI Match & Integrity Radar Quiz -->
      <section class="mt-10 mb-8">
        <InlineQuiz
          slug={slug}
          quizId="bottom-radar-quiz"
          title="AI Match & Integrity Radar: Complete Profile Verification"
          subtitle="Stop wasting time on catfish profiles and bot swarms. Verify safety clearance and access 100% verified singles."
        />
      </section>

      <!-- Editorial FAQ Section -->
      <section class="my-10 p-6 sm:p-8 rounded-xl bg-white border border-slate-200 shadow-sm">
        <div class="flex items-center gap-2 text-xs font-mono uppercase text-slate-500 font-bold mb-2">
          <span>● VERIFIED KNOWLEDGEBASE</span>
        </div>
        <h3 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight mb-5 font-sans">
          Frequently Asked Questions About Profile Safety
        </h3>
        <div class="space-y-3.5 font-sans">
          <div class="p-4 rounded-lg bg-slate-50 border border-slate-200">
            <h4 class="font-bold text-slate-900 text-sm sm:text-base mb-1.5">
              What is the fastest way to verify a dating profile?
            </h4>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              The fastest zero-cost method is requesting a 15-second live video call or using our integrated safety lookup tool before exchanging personal social media or phone numbers.
            </p>
          </div>

          <div class="p-4 rounded-lg bg-slate-50 border border-slate-200">
            <h4 class="font-bold text-slate-900 text-sm sm:text-base mb-1.5">
              Can AI detect whether a dating profile is genuine?
            </h4>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Yes. Automated security filters evaluate account creation velocity, IP fingerprint anomalies, syntactic repetition across chat logs, and visual GAN artifacts in uploaded gallery pictures.
            </p>
          </div>

          <div class="p-4 rounded-lg bg-slate-50 border border-slate-200">
            <h4 class="font-bold text-slate-900 text-sm sm:text-base mb-1.5">
              What should I do if I discover a scammer?
            </h4>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Immediately capture screenshots of the profile and chat log, report the account within the dating platform's safety center, block all communication channels, and never send funds under any circumstances.
            </p>
          </div>
        </div>
      </section>
    </main>

    <script>
      // Dynamically relocate mid-article quiz into article content midpoint
      function injectMidArticleQuiz() {
        const article = document.querySelector('article');
        const midQuiz = document.getElementById('mid-quiz-container');
        if (!article || !midQuiz) return;

        const h2Elements = article.querySelectorAll('h2');
        if (h2Elements.length >= 2) {
          const targetIndex = Math.floor(h2Elements.length / 2);
          h2Elements[targetIndex].before(midQuiz);
        } else {
          const paragraphs = article.querySelectorAll('p');
          if (paragraphs.length >= 3) {
            paragraphs[2].after(midQuiz);
          }
        }
      }

      document.addEventListener('DOMContentLoaded', injectMidArticleQuiz);
      injectMidArticleQuiz();

      // Ensure in-body article images are lazy-loaded and accompanied by forensic evidence caption
      function setupArticleEvidence() {
        document.querySelectorAll('article.prose img').forEach((img) => {
          img.setAttribute('loading', 'lazy');
          const parent = img.parentElement;
          if (parent && parent.tagName === 'P' && parent.children.length === 1) {
            if (!parent.nextElementSibling?.classList.contains('evidence-caption')) {
              const caption = document.createElement('div');
              caption.className = 'evidence-caption text-center font-mono text-[11px] font-bold text-slate-500 uppercase tracking-wider mt-1.5 mb-6';
              caption.textContent = 'FIG. // EVIDENCE SAMPLE · CHELTENHAM ARCHIVE';
              parent.after(caption);
            }
          }
        });
      }

      document.addEventListener('DOMContentLoaded', setupArticleEvidence);
      setupArticleEvidence();
    </script>

    <style is:global>
      /* Evidence Photography & Visual Samples */
      article.prose img {
        border: 1px solid #0F172A !important;
        border-radius: 4px;
        box-shadow: 2px 2px 0px 0px #0F172A;
        background-color: #F4EFE6;
        display: block;
        margin-left: auto;
        margin-right: auto;
      }

      /* Archival Evidence Table Styling */
      article.prose table {
        width: 100%;
        border-collapse: collapse;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 12px;
        margin-top: 1.5rem;
        margin-bottom: 1.5rem;
        border: 1px solid #0F172A;
        background-color: #FFFDF9;
        box-shadow: 3px 3px 0px 0px #0F172A;
      }
      article.prose table th {
        background-color: #0F172A;
        color: #FFFDF7;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.6rem 0.75rem;
        border: 1px solid #0F172A;
        text-align: left;
      }
      article.prose table td {
        padding: 0.5rem 0.75rem;
        border: 1px solid #E2D9CC;
        color: #334155;
      }
      article.prose table tr:nth-child(even) {
        background-color: #FAF7F2;
      }
      article.prose table tr:hover {
        background-color: #F2ECE1;
      }
    </style>

    <Footer />
    <MobileStickyCTA />
    <ExitIntentModal />
  </body>
</html>
