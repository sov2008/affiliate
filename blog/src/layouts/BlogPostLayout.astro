        color: #1E293B !important;
        padding: 0.1em 0.35em !important;
        border-radius: 2px !important;
        font-size: 0.875em !important;
        border: 1px solid #D1C9BC !important;
        box-shadow: none !important;
      }

      /* ─── Blockquote: editorial left-rule ────────────────────── */
      article.prose blockquote {
        border-left: 2px solid #0F172A !important;
        padding-left: 1rem !important;
        font-style: italic !important;
        color: #475569 !important;
        margin-top: 1.5rem !important;
        margin-bottom: 1.5rem !important;
        font-family: var(--font-serif, Georgia, serif) !important;
      }
      article.prose blockquote p {
        font-size: 1.0625rem !important;
        margin-bottom: 0 !important;
      }

      /* ─── Evidence Photography ───────────────────────────────── */
      article.prose img {
        border: 1px solid #CBD5E1 !important;
        border-radius: 0 !important;
        background-color: #F4EFE6;
        display: block;
        margin-left: auto;
        margin-right: auto;
      }

      /* ─── Archival Evidence Tables ───────────────────────────── */
      article.prose table {
        width: 100%;
        border-collapse: collapse;
        font-family: ui-monospace, 'JetBrains Mono', monospace;
        font-size: 12px;
        margin-top: 1.5rem;
        margin-bottom: 1.5rem;
        border: 1px solid #CBD5E1;
        background-color: #FFFDF9;
      }
      article.prose table th {
        background-color: #0F172A;
        color: #F8FAFC;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.55rem 0.75rem;
        border: 1px solid #0F172A;
        text-align: left;
      }
      article.prose table td {
        padding: 0.5rem 0.75rem;
        border: 1px solid #E2D9CC;
        color: #334155;
      }
      article.prose table tr:nth-child(even) { background-color: #FAF7F2; }
      article.prose table tr:hover { background-color: #F2ECE1; }

      /* ─── ScamRiskMatrix outer border override ───────────────── */
      /* Remove the component's own outer shadow when wrapped in our border */
      section .border.border-slate-300 > .bg-\[#FAF7F2\].border-2 {
        border: none !important;
        box-shadow: none !important;
        border-radius: 0 !important;
        margin: 0 !important;
      }
    </style>

    <Footer />
    <MobileStickyCTA />
    <ExitIntentModal />
  </body>
</html>
