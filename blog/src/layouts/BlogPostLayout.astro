    <!-- Global scripts -->
    <script>
      // ─── Table of Contents Generator ───────────────────────────
      function buildToc() {
        const article = document.getElementById('articleContent');
        const tocList = document.getElementById('tocList');
        if (!article || !tocList) return;

        const headings = Array.from(article.querySelectorAll('h2'));
        if (headings.length === 0) {
          const tocNav = document.getElementById('tocNav');
          if (tocNav) tocNav.closest('.bg-white')?.classList.add('hidden');
          return;
        }

        headings.forEach((h, i) => {
          if (!h.id) h.id = `section-${i}`;
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `#${h.id}`;
          a.textContent = h.textContent || '';
          a.className = 'toc-link block text-slate-500 hover:text-slate-900 transition-colors py-0.5 border-l-2 border-transparent pl-2 leading-snug';
          a.addEventListener('click', e => {
            e.preventDefault();
            h.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
          li.appendChild(a);
          tocList.appendChild(li);
        });

        // Active section highlight on scroll
        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            const id = entry.target.id;
            const link = tocList.querySelector(`[href="#${id}"]`);
            if (!link) return;
            if (entry.isIntersecting) {
              tocList.querySelectorAll('.toc-link').forEach(l => {
                l.classList.remove('text-slate-900', 'border-slate-900', 'font-bold');
                l.classList.add('text-slate-500', 'border-transparent');
              });
              link.classList.remove('text-slate-500', 'border-transparent');
              link.classList.add('text-slate-900', 'border-slate-900', 'font-bold');
            }
          });
        }, { rootMargin: '-10% 0px -70% 0px', threshold: 0 });

        headings.forEach(h => observer.observe(h));
      }

      // ─── Mid-article Quiz Injection ─────────────────────────────
      function injectMidArticleQuiz() {
        const article = document.getElementById('articleContent');
        const midQuiz = document.getElementById('mid-quiz-container');
        if (!article || !midQuiz) return;
        const h2Elements = article.querySelectorAll('h2');
        if (h2Elements.length >= 2) {
          const targetIndex = Math.floor(h2Elements.length / 2);
          h2Elements[targetIndex].before(midQuiz);
        } else {
          const paragraphs = article.querySelectorAll('p');
          if (paragraphs.length >= 3) paragraphs[2].after(midQuiz);
        }
      }

      // ─── Evidence image captions ────────────────────────────────
      function setupArticleEvidence() {
        document.querySelectorAll('article.prose img').forEach(img => {
          img.setAttribute('loading', 'lazy');
          const parent = img.parentElement;
          if (parent && parent.tagName === 'P' && parent.children.length === 1) {
            if (!parent.nextElementSibling?.classList.contains('evidence-caption')) {
              const caption = document.createElement('div');
              caption.className = 'evidence-caption text-center font-mono text-[10px] font-bold text-slate-500 uppercase tracking-wider mt-1.5 mb-6';
              caption.textContent = 'FIG. // EVIDENCE SAMPLE · CHELTENHAM ARCHIVE';
              parent.after(caption);
            }
          }
        });
      }

      // ─── Font Scale Controller (shared by sidebar + mobile btns) ─
      function initFontScale() {
        const article = document.getElementById('articleContent');
        const downBtns = [
          document.getElementById('fontScaleDownBtn'),
          document.getElementById('fontScaleDownBtnMobile')
        ].filter(Boolean);
        const upBtns = [
          document.getElementById('fontScaleUpBtn'),
          document.getElementById('fontScaleUpBtnMobile')
        ].filter(Boolean);
        if (!article) return;

        const scales = ['scale-sm', 'scale-md', 'scale-lg'];
        let currentScale = 'scale-md';
        try { currentScale = localStorage.getItem('flirtcheck_font_scale') || 'scale-md'; } catch {}

        function applyScale(scale) {
          scales.forEach(s => article.classList.remove(s));
          article.classList.add(scale);
          try { localStorage.setItem('flirtcheck_font_scale', scale); } catch {}
        }
        applyScale(currentScale);

        downBtns.forEach(btn => btn?.addEventListener('click', () => {
          const idx = scales.indexOf(currentScale);
          if (idx > 0) { currentScale = scales[idx - 1]; applyScale(currentScale); }
        }));
        upBtns.forEach(btn => btn?.addEventListener('click', () => {
          const idx = scales.indexOf(currentScale);
          if (idx < scales.length - 1) { currentScale = scales[idx + 1]; applyScale(currentScale); }
        }));
      }

      // ─── TOC Smartlink CID attribution ──────────────────────────
      function initTocCta() {
        const cta = document.getElementById('tocCtaLink');
        if (!cta) return;
        let cid = '';
        try {
          cid = sessionStorage.getItem('flirtcheck_cid') || '';
          if (!cid) {
            cid = 'fc_' + Math.random().toString(36).substring(2, 9) + '_' + Date.now().toString(36);
            sessionStorage.setItem('flirtcheck_cid', cid);
          }
        } catch { cid = 'fc_' + Date.now().toString(36); }
        const url = new URL(cta.href, window.location.origin);
        url.searchParams.set('cid', cid);
        cta.href = url.toString();
      }

      document.addEventListener('DOMContentLoaded', () => {
        buildToc();
        injectMidArticleQuiz();
        setupArticleEvidence();
        initFontScale();
        initTocCta();
      });
    </script>

    <style is:global>
      /* Reading Scale Adjustments */
      #articleContent.scale-sm p { font-size: 16px !important; line-height: 1.65 !important; }
      #articleContent.scale-md p { font-size: 18px !important; line-height: 1.75 !important; }
      #articleContent.scale-lg p { font-size: 20px !important; line-height: 1.85 !important; }

      /* ─── Parchment Code Blocks (no more acid black) ─────────── */
      article.prose pre,
      article.prose pre code {
        background-color: #F2ECE1 !important;
        color: #1E293B !important;
        border: 1px solid #CBD5E1 !important;
