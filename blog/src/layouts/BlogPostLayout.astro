---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ReadingProgressBar from '../components/ReadingProgressBar.astro';
import DossierContextBox from '../components/DossierContextBox.astro';
import MobileStickyCTA from '../components/MobileStickyCTA.astro';
import InlineQuiz from '../components/InlineQuiz.astro';
import ExitIntentModal from '../components/ExitIntentModal.astro';
import { CATEGORIES_METADATA, CategoryEnum, type Category } from '../content.config';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  author: string;
  category?: Category;
  tags: string[];
  seoKeywords: string[];
  canonicalUrl?: string;
  coverImage?: string;
  image?: string;
  slug?: string;
  readingTime?: number;
  motto?: string;
  hook?: string;
  caseId?: string;
  classification?: string;
  telemetryRisk?: string;
}

const {
  title,
  description,
  pubDate,
  author,
  category,
  tags,
  seoKeywords,
  canonicalUrl = Astro.url.href,
  coverImage,
  image,
  slug,
  readingTime = 4,
  motto,
  hook,
  caseId: explicitCaseId,
  classification,
  telemetryRisk
} = Astro.props;

const catId: Category = category && CATEGORIES_METADATA[category] ? category : 'safety-dossier';
const catMeta = CATEGORIES_METADATA[catId];
const caseId = explicitCaseId || ((slug || '2026').replace(/[^a-zA-Z0-9]/g, '').slice(-4).toUpperCase() || '2026');
const effectiveMotto = motto || hook || catMeta.motto || "Love is... knowing that in a world of endless swipes, real chemistry happens between two imperfect souls.";

const siteBaseUrl = 'https://flirtcheck.site';
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || siteBaseUrl;
const rawImg = coverImage || image;
const normalizedImg = rawImg ? rawImg.replace(/^\/blog/, '') : undefined;
const effectiveCoverImage = normalizedImg
  ? (normalizedImg.startsWith('/') ? normalizedImg : `/${normalizedImg}`)
  : undefined;
const normalizedCanonical = canonicalUrl ? canonicalUrl.replace(/https?:\/\/flirtcheck\.site\/blog\//, `${siteBaseUrl}/`) : '';
const canonicalAbsUrl = normalizedCanonical.startsWith('http')
  ? normalizedCanonical
  : `${siteBaseUrl}${normalizedCanonical.startsWith('/') ? '' : '/'}${normalizedCanonical}`;
const ogImageAbsUrl = effectiveCoverImage
  ? (effectiveCoverImage.startsWith('http') ? effectiveCoverImage : `${siteBaseUrl}${effectiveCoverImage.startsWith('/') ? '' : '/'}${effectiveCoverImage}`)
  : `${siteBaseUrl}/images/posts/${slug || 'dating-scam-verification-guide-2026'}.webp`;
const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(pubDate);

// Schema.org Article Structured Data
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "inLanguage": "en-US",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "author": {
    "@type": "Person",
    "name": author,
    "url": `${siteUrl}/author/editorial`
  },
  "publisher": {
    "@type": "Organization",
    "name": "FlirtCheck Safety Editorial",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/avatar.jpg`
    }
  },
  "datePublished": pubDate.toISOString(),
  "dateModified": pubDate.toISOString(),
  "keywords": seoKeywords.join(', ')
};

// Schema.org Breadcrumbs
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": `${siteUrl}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Archive",
      "item": `${siteUrl}/#feed`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": catMeta.shortTitle,
      "item": `${siteUrl}/category/${catMeta.id}`
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": `CASE #${caseId}`,
      "item": canonicalAbsUrl
    }
  ]
};

// Schema.org FAQPage Structured Data
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the fastest way to verify a dating profile?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The fastest zero-cost method is requesting a 15-second live video call or using an automated safety lookup tool before exchanging social media or phone numbers."
      }
    },
    {
      "@type": "Question",
      "name": "Can AI detect whether a dating profile is genuine?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Automated security filters evaluate account creation velocity, IP fingerprint anomalies, syntactic repetition across chat logs, and visual GAN artifacts in uploaded gallery pictures."
      }
    },
    {
      "@type": "Question",
      "name": "What should I do if I discover a scammer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Immediately capture screenshots of the profile and chat log, report the account within the dating platform's safety center, block all communication channels, and never send funds under any circumstances."
      }
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en" class="bg-slate-950 text-slate-100 antialiased scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | FlirtCheck Editorial</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={seoKeywords.join(', ')} />
    <meta name="author" content={author} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex, nofollow, noarchive" />

    <!-- OpenGraph Metadata -->
    <meta property="og:site_name" content="FlirtCheck Editorial" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalAbsUrl} />
    <meta property="og:image" content={ogImageAbsUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/webp" />
    <meta property="article:published_time" content={pubDate.toISOString()} />
    <meta property="article:author" content={author} />
    {tags.map(tag => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@flirtcheck" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsUrl} />

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>

  <body class="min-h-screen flex flex-col bg-[#FBF8F1] text-slate-900">
    <!-- Top Reading Progress Indicator -->
    <ReadingProgressBar />

    <Header activePath="/" />

    <main class="flex-1 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
      <!-- Editorial Breadcrumbs Navigation -->
      <nav aria-label="Breadcrumbs" class="py-2 mb-4 text-xs font-sans text-slate-500">
        <div class="flex flex-wrap items-center gap-2">
          <a href="/" class="hover:text-slate-900 transition-colors">Home</a>
          <span class="text-slate-300">/</span>
          <a href="/#feed" class="hover:text-slate-900 transition-colors">Archive</a>
          <span class="text-slate-300">/</span>
          <a href={`/category/${catMeta.id}`} class="text-slate-700 hover:text-slate-900 transition-colors font-medium">
            {catMeta.shortTitle}
          </a>
        </div>
      </nav>

      <!-- Article Header -->
      <header class="my-6 pb-6 border-b border-slate-200">
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <a
            href={`/category/${catMeta.id}`}
            class="px-2.5 py-0.5 rounded text-xs font-sans font-medium uppercase tracking-wider bg-slate-100 text-slate-800 border border-slate-300 hover:bg-slate-200 transition-colors"
          >
            {catMeta.shortTitle}
          </a>
          {tags.slice(0, 3).map(tag => (
            <span class="px-2 py-0.5 rounded text-[11px] font-sans text-slate-600 bg-white border border-slate-200">
              #{tag}
            </span>
          ))}
          <span id="readingTimeBadge" class="text-xs font-sans text-slate-500 ml-auto">
            {readingTime} min read
          </span>
        </div>

        <!-- Headline -->
        <h1 class="font-bold text-2xl sm:text-3xl lg:text-4xl text-slate-900 tracking-tight leading-tight mb-4 font-sans">
          {title}
        </h1>

        <!-- Description Summary -->
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-5 font-serif italic">
          {description}
        </p>

        <!-- Meta Dateline -->
        <div class="flex items-center justify-between gap-3 pt-4 border-t border-slate-200 text-xs text-slate-500 font-sans">
          <div class="flex items-center gap-2">
            <span class="font-medium text-slate-900">{author}</span>
            <span class="text-slate-300">·</span>
            <span>{formattedDate}</span>
          </div>
          <span class="text-xs font-mono text-slate-400">
            Cheltenham Desk
          </span>
        </div>
      </header>

      <!-- 16:9 Full WebP Cover Frame -->
      <div class="mb-8 overflow-hidden rounded-lg border border-slate-200 shadow-sm bg-slate-100">
        <img
          src={effectiveCoverImage || `/images/posts/${slug || 'dating-scam-verification-guide-2026'}.webp`}
          alt={title}
          class="w-full aspect-[16/9] object-cover select-none pointer-events-none"
          loading="eager"
        />
      </div>

      <!-- Article Markdown Typography Content (Classic Journalistic Drop Cap) -->
      <article class="prose prose-slate max-w-none 
        [&>p:first-of-type::first-letter]:float-left 
        [&>p:first-of-type::first-letter]:text-5xl sm:[&>p:first-of-type::first-letter]:text-6xl 
        [&>p:first-of-type::first-letter]:font-serif 
        [&>p:first-of-type::first-letter]:font-bold 
        [&>p:first-of-type::first-letter]:mr-3 
        [&>p:first-of-type::first-letter]:mb-1 
        [&>p:first-of-type::first-letter]:leading-none 
        [&>p:first-of-type::first-letter]:text-slate-900
        [&_h1]:text-2xl sm:[&_h1]:text-3xl [&_h1]:font-bold [&_h1]:text-slate-900 [&_h1]:mt-8 [&_h1]:mb-4
        [&_h2]:text-xl sm:[&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-slate-900 [&_h2]:mt-10 [&_h2]:mb-4 [&_h2]:pb-2 [&_h2]:border-b [&_h2]:border-slate-200
        [&_h3]:text-lg sm:[&_h3]:text-xl [&_h3]:font-semibold [&_h3]:text-slate-900 [&_h3]:mt-6 [&_h3]:mb-3
        [&_p]:text-slate-800 [&_p]:leading-relaxed [&_p]:mb-4 [&_p]:text-[15px] sm:[&_p]:text-base font-sans
        [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-4 [&_ul]:space-y-2 [&_ul]:text-slate-800
        [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:mb-4 [&_ol]:space-y-2 [&_ol]:text-slate-800
        [&_li]:text-slate-800
        [&_blockquote]:border-l-4 [&_blockquote]:border-slate-400 [&_blockquote]:pl-4 [&_blockquote]:py-2 [&_blockquote]:italic [&_blockquote]:text-slate-700 [&_blockquote]:my-6 [&_blockquote]:bg-slate-50 [&_blockquote]:rounded-r-lg
        [&_hr]:border-slate-200 [&_hr]:my-8">
        <slot />
      </article>

      <!-- Contextual Editorial Note (Replaced DossierContextBox) -->
      <DossierContextBox />

      <!-- Author Editorial Masthead Box -->
      <div class="my-8 p-5 rounded-lg bg-white border border-slate-200 shadow-sm flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <div class="w-10 h-10 rounded-full bg-slate-100 border border-slate-300 flex items-center justify-center text-lg shrink-0">
          🖋️
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-1">
            <h4 class="font-bold text-sm text-slate-900 font-sans">Lead Investigative Analyst</h4>
            <span class="text-[11px] font-mono text-slate-500">
              Desk: Cheltenham, UK
            </span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed font-sans">
            Independent coverage of dating mechanics, fraud vectors, and network integrity. All investigations conducted under FlirtCheck editorial standards.
          </p>
        </div>
      </div>

      <!-- Mid-Article Sticky Inline Radar Quiz (Injected dynamically into article midpoint) -->
      <div id="mid-quiz-container" class="my-8 not-prose">
        <InlineQuiz
          slug={slug}
          quizId="mid-radar-quiz"
          title="⚡ Quick Scan: Is Your Dating Match Real?"
          subtitle="Instant cross-reference against verified anti-bot database and spoofing patterns."
        />
      </div>

      <!-- Conversion Hook: Full AI Match & Integrity Radar Quiz -->
      <section class="mt-10 mb-8">
        <InlineQuiz
          slug={slug}
          quizId="bottom-radar-quiz"
          title="AI Match & Integrity Radar: Complete Profile Verification"
          subtitle="Stop wasting time on catfish profiles and bot swarms. Verify safety clearance and access 100% verified singles."
        />
      </section>

      <!-- Editorial FAQ Section (Comic Dossier Box) -->
      <section class="my-10 p-6 sm:p-8 rounded-2xl bg-white border-2 border-slate-900 shadow-[6px_6px_0px_0px_#0f172a]">
        <div class="flex items-center gap-2 text-xs font-mono uppercase text-rose-600 font-black mb-2">
          <span>● VERIFIED KNOWLEDGEBASE</span>
        </div>
        <h3 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight mb-5 font-sans uppercase">
          Frequently Asked Questions About Profile Safety
        </h3>
        <div class="space-y-4">
          <div class="p-4 rounded-xl bg-amber-50/80 border-2 border-slate-900 shadow-[2px_2px_0px_0px_#0f172a]">
            <h4 class="font-black text-slate-900 text-sm sm:text-base mb-1.5 flex items-center gap-2">
              <span class="text-rose-600 font-mono font-black">Q1:</span> What is the fastest way to verify a dating profile?
            </h4>
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed font-serif italic">
              The fastest zero-cost method is requesting a 15-second live video call or using our integrated safety lookup tool before exchanging personal social media or phone numbers.
            </p>
          </div>

          <div class="p-4 rounded-xl bg-amber-50/80 border-2 border-slate-900 shadow-[2px_2px_0px_0px_#0f172a]">
            <h4 class="font-black text-slate-900 text-sm sm:text-base mb-1.5 flex items-center gap-2">
              <span class="text-rose-600 font-mono font-black">Q2:</span> Can AI detect whether a dating profile is genuine?
            </h4>
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed font-serif italic">
              Yes. Automated security filters evaluate account creation velocity, IP fingerprint anomalies, syntactic repetition across chat logs, and visual GAN artifacts in uploaded gallery pictures.
            </p>
          </div>

          <div class="p-4 rounded-xl bg-amber-50/80 border-2 border-slate-900 shadow-[2px_2px_0px_0px_#0f172a]">
            <h4 class="font-black text-slate-900 text-sm sm:text-base mb-1.5 flex items-center gap-2">
              <span class="text-rose-600 font-mono font-black">Q3:</span> What should I do if I discover a scammer?
            </h4>
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed font-serif italic">
              Immediately capture screenshots of the profile and chat log, report the account within the dating platform's safety center, block all communication channels, and never send funds under any circumstances.
            </p>
          </div>
        </div>
      </section>
    </main>

    <script>
      // Dynamically relocate mid-article quiz into article content midpoint
      function injectMidArticleQuiz() {
        const article = document.querySelector('article');
        const midQuiz = document.getElementById('mid-quiz-container');
        if (!article || !midQuiz) return;

        const h2Elements = article.querySelectorAll('h2');
        if (h2Elements.length >= 2) {
          const targetIndex = Math.floor(h2Elements.length / 2);
          h2Elements[targetIndex].before(midQuiz);
        } else {
          const paragraphs = article.querySelectorAll('p');
          if (paragraphs.length >= 3) {
            paragraphs[2].after(midQuiz);
          }
        }
      }

      document.addEventListener('DOMContentLoaded', injectMidArticleQuiz);
      injectMidArticleQuiz();

      // Ensure in-body article images are lazy-loaded
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('article img').forEach((img) => {
          if (!img.getAttribute('loading')) img.setAttribute('loading', 'lazy');
          if (!img.getAttribute('decoding')) img.setAttribute('decoding', 'async');
        });
      });
    </script>

    <!-- Mobile Sticky Conversion Bar for mobile readers -->
    <MobileStickyCTA />

    <!-- Exit-Intent Retention Modal -->
    <ExitIntentModal slug={slug} />

    <Footer />
  </body>
</html>
