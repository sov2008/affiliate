---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DatingSmartlinkCTA from '../components/DatingSmartlinkCTA.astro';
import DatingRadarQuiz from '../components/DatingRadarQuiz.astro';
import InlineQuiz from '../components/InlineQuiz.astro';
import StickyRadar from '../components/StickyRadar.astro';
import ExitIntentModal from '../components/ExitIntentModal.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  author: string;
  tags: string[];
  seoKeywords: string[];
  canonicalUrl?: string;
  coverImage?: string;
  image?: string;
  slug?: string;
  readingTime?: number;
}

const {
  title,
  description,
  pubDate,
  author,
  tags,
  seoKeywords,
  canonicalUrl = Astro.url.href,
  coverImage,
  image,
  slug,
  readingTime = 4
} = Astro.props;

const siteBaseUrl = 'https://flirtcheck.site';
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || siteBaseUrl;
const effectiveCoverImage = coverImage || (image ? (image.startsWith('/blog') ? image : `/blog${image.startsWith('/') ? '' : '/'}${image}`) : undefined);
const canonicalAbsUrl = canonicalUrl.startsWith('http')
  ? canonicalUrl
  : `${siteBaseUrl}${canonicalUrl.startsWith('/') ? '' : '/'}${canonicalUrl}`;
const ogImageAbsUrl = effectiveCoverImage
  ? (effectiveCoverImage.startsWith('http') ? effectiveCoverImage : `${siteBaseUrl}${effectiveCoverImage.startsWith('/') ? '' : '/'}${effectiveCoverImage}`)
  : `${siteBaseUrl}/blog/images/posts/${slug || 'dating-scam-verification-guide-2026'}.webp`;
const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(pubDate);

// Schema.org Article Structured Data
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "inLanguage": "en-US",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "author": {
    "@type": "Person",
    "name": author,
    "url": `${siteUrl}/author/editorial`
  },
  "publisher": {
    "@type": "Organization",
    "name": "FlirtCheck Safety Editorial",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/avatar.jpg`
    }
  },
  "datePublished": pubDate.toISOString(),
  "dateModified": pubDate.toISOString(),
  "keywords": seoKeywords.join(', ')
};

// Schema.org FAQPage Structured Data
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the fastest way to verify a dating profile?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The fastest zero-cost method is requesting a 15-second live video call or using an automated safety lookup tool before exchanging social media or phone numbers."
      }
    },
    {
      "@type": "Question",
      "name": "Can AI detect whether a dating profile is genuine?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Automated security filters evaluate account creation velocity, IP fingerprint anomalies, syntactic repetition across chat logs, and visual GAN artifacts in uploaded gallery pictures."
      }
    },
    {
      "@type": "Question",
      "name": "What should I do if I discover a scammer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Immediately capture screenshots of the profile and chat log, report the account within the dating platform's safety center, block all communication channels, and never send funds under any circumstances."
      }
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en" class="bg-slate-950 text-slate-100 antialiased scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | FlirtCheck Editorial</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={seoKeywords.join(', ')} />
    <meta name="author" content={author} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex, nofollow, noarchive" />

    <!-- OpenGraph Metadata -->
    <meta property="og:site_name" content="FlirtCheck Editorial" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalAbsUrl} />
    <meta property="og:image" content={ogImageAbsUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/webp" />
    <meta property="article:published_time" content={pubDate.toISOString()} />
    <meta property="article:author" content={author} />
    {tags.map(tag => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@flirtcheck" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsUrl} />

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>

  <body class="min-h-screen flex flex-col bg-[#FBF8F3] text-slate-900">
    <!-- Reading Progress Bar (Fixed Top) -->
    <div
      id="reading-progress-bar"
      class="reading-progress-bar fixed top-0 left-0 h-[4px] bg-rose-600 z-50 transition-[width] duration-75 ease-out pointer-events-none"
      style="width: 0%;"
      role="progressbar"
      aria-label="Reading progress"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    ></div>

    <Header activePath="/blog" />

    <main class="flex-1 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
      <!-- Breadcrumbs Navigation -->
      <Breadcrumbs items={[{ name: title, url: canonicalUrl }]} />

      <!-- Article Header -->
      <header class="my-8 pb-8 border-b-2 border-slate-900">
        <div class="flex flex-wrap items-center gap-2 mb-4">
          {tags.map(tag => (
            <span class="px-2.5 py-0.5 rounded-md text-[11px] font-mono font-black uppercase bg-amber-100 text-slate-900 border border-slate-900 shadow-[1px_1px_0px_0px_#0f172a]">
              {tag}
            </span>
          ))}
          <span id="readingTimeBadge" class="inline-flex items-center gap-1 text-[11px] font-mono font-bold text-slate-900 px-2.5 py-0.5 rounded-md bg-white border border-slate-900 shadow-[1px_1px_0px_0px_#0f172a]">
            ⏱️ {readingTime} min read
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 tracking-tight leading-tight mb-6 font-sans">
          {title}
        </h1>

        <p class="text-lg sm:text-xl text-slate-700 leading-relaxed mb-6 font-serif italic">
          {description}
        </p>

        <div class="flex items-center gap-3 pt-4 border-t-2 border-slate-200 text-xs text-slate-600">
          <div class="w-8 h-8 rounded-lg bg-rose-600 border-2 border-slate-900 flex items-center justify-center font-black text-white text-xs shadow-[2px_2px_0px_0px_#0f172a]">
            FC
          </div>
          <div>
            <div class="font-black text-slate-900">{author}</div>
            <div class="font-mono text-slate-500">Published on {formattedDate}</div>
          </div>
        </div>
      </header>

      <!-- Featured Cover Image in Comic Frame -->
      <div class="mb-10 overflow-hidden rounded-2xl border-2 border-slate-900 shadow-[6px_6px_0px_0px_#0f172a] bg-white">
        <img
          src={effectiveCoverImage || `/blog/images/posts/${slug || 'dating-scam-verification-guide-2026'}.webp`}
          alt={title}
          class="w-full aspect-video object-cover hover:scale-[1.01] transition-transform duration-500"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Article Markdown Typography Content (Vintage Editorial) -->
      <article class="prose prose-slate max-w-none 
        [&_h1]:text-3xl [&_h1]:font-black [&_h1]:text-slate-900 [&_h1]:mt-8 [&_h1]:mb-4
        [&_h2]:text-2xl [&_h2]:font-black [&_h2]:text-slate-900 [&_h2]:mt-10 [&_h2]:mb-4 [&_h2]:pb-2 [&_h2]:border-b-2 [&_h2]:border-slate-900
        [&_h3]:text-xl [&_h3]:font-black [&_h3]:text-rose-600 [&_h3]:mt-6 [&_h3]:mb-3
        [&_p]:text-slate-800 [&_p]:leading-relaxed [&_p]:mb-4 [&_p]:text-base
        [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-4 [&_ul]:space-y-2 [&_ul]:text-slate-800
        [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:mb-4 [&_ol]:space-y-2 [&_ol]:text-slate-800
        [&_li]:text-slate-800
        [&_blockquote]:border-l-4 [&_blockquote]:border-rose-600 [&_blockquote]:border-2 [&_blockquote]:border-slate-900 [&_blockquote]:pl-4 [&_blockquote]:pr-4 [&_blockquote]:py-3 [&_blockquote]:italic [&_blockquote]:text-slate-800 [&_blockquote]:my-6 [&_blockquote]:bg-amber-50/80 [&_blockquote]:rounded-xl [&_blockquote]:shadow-[3px_3px_0px_0px_#0f172a]
        [&_hr]:border-slate-900/30 [&_hr]:my-8">
        <slot />
      </article>

      <!-- Mid-Article Sticky Inline Radar Quiz (Injected dynamically into article midpoint) -->
      <div id="mid-quiz-container" class="my-8 not-prose">
        <InlineQuiz
          slug={slug}
          quizId="mid-radar-quiz"
          title="⚡ Quick Scan: Is Your Dating Match Real?"
          subtitle="Instant cross-reference against verified anti-bot database and spoofing patterns."
        />
      </div>

      <!-- Conversion Hook: Full AI Match & Integrity Radar Quiz -->
      <section class="mt-12 mb-8">
        <InlineQuiz
          slug={slug}
          quizId="bottom-radar-quiz"
          title="AI Match & Integrity Radar: Complete Profile Verification"
          subtitle="Stop wasting time on catfish profiles and bot swarms. Verify safety clearance and access 100% verified singles."
        />
      </section>

      <!-- Editorial FAQ Section (Comic Dossier Box) -->
      <section class="my-12 p-6 sm:p-8 rounded-2xl bg-white border-2 border-slate-900 shadow-[6px_6px_0px_0px_#0f172a]">
        <div class="flex items-center gap-2 text-xs font-mono uppercase text-rose-600 font-black mb-2">
          <span>● VERIFIED KNOWLEDGEBASE</span>
        </div>
        <h3 class="text-2xl font-black text-slate-900 tracking-tight mb-6 font-sans">
          Frequently Asked Questions About Profile Safety
        </h3>
        <div class="space-y-4">
          <div class="p-4 rounded-xl bg-amber-50/80 border-2 border-slate-900 shadow-[2px_2px_0px_0px_#0f172a]">
            <h4 class="font-black text-slate-900 text-sm sm:text-base mb-2 flex items-center gap-2">
              <span class="text-rose-600 font-mono">Q1:</span> What is the fastest way to verify a dating profile?
            </h4>
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed font-serif italic">
              The fastest zero-cost method is requesting a 15-second live video call or using our integrated safety lookup tool before exchanging personal social media or phone numbers.
            </p>
          </div>

          <div class="p-4 rounded-xl bg-amber-50/80 border-2 border-slate-900 shadow-[2px_2px_0px_0px_#0f172a]">
            <h4 class="font-black text-slate-900 text-sm sm:text-base mb-2 flex items-center gap-2">
              <span class="text-rose-600 font-mono">Q2:</span> Can AI detect whether a dating profile is genuine?
            </h4>
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed font-serif italic">
              Yes. Automated security filters evaluate account creation velocity, IP fingerprint anomalies, syntactic repetition across chat logs, and visual GAN artifacts in uploaded gallery pictures.
            </p>
          </div>

          <div class="p-4 rounded-xl bg-amber-50/80 border-2 border-slate-900 shadow-[2px_2px_0px_0px_#0f172a]">
            <h4 class="font-black text-slate-900 text-sm sm:text-base mb-2 flex items-center gap-2">
              <span class="text-rose-600 font-mono">Q3:</span> What should I do if I discover a scammer?
            </h4>
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed font-serif italic">
              Immediately capture screenshots of the profile and chat log, report the account within the dating platform's safety center, block all communication channels, and never send funds under any circumstances.
            </p>
          </div>
        </div>
      </section>
    </main>

    <script>
      // Dynamically relocate mid-article quiz into article content midpoint
      function injectMidArticleQuiz() {
        const article = document.querySelector('article');
        const midQuiz = document.getElementById('mid-quiz-container');
        if (!article || !midQuiz) return;

        const h2Elements = article.querySelectorAll('h2');
        if (h2Elements.length >= 2) {
          const targetIndex = Math.floor(h2Elements.length / 2);
          h2Elements[targetIndex].before(midQuiz);
        } else {
          const paragraphs = article.querySelectorAll('p');
          if (paragraphs.length >= 3) {
            paragraphs[2].after(midQuiz);
          }
        }
      }

      document.addEventListener('DOMContentLoaded', injectMidArticleQuiz);
      injectMidArticleQuiz();

      // Reading Progress Bar & Image Lazy Loading
      function initReadingExperience() {
        const progressBar = document.getElementById('reading-progress-bar');
        function updateProgress() {
          if (!progressBar) return;
          const scrollTop = window.scrollY || document.documentElement.scrollTop;
          const docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
          const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
          const clamped = Math.min(100, Math.max(0, pct));
          progressBar.style.width = `${clamped}%`;
          progressBar.setAttribute('aria-valuenow', Math.round(clamped).toString());
        }

        window.addEventListener('scroll', updateProgress, { passive: true });
        updateProgress();

        // Ensure in-body article images are lazy-loaded
        document.querySelectorAll('article img').forEach((img) => {
          if (!img.getAttribute('loading')) img.setAttribute('loading', 'lazy');
          if (!img.getAttribute('decoding')) img.setAttribute('decoding', 'async');
        });
      }

      document.addEventListener('DOMContentLoaded', initReadingExperience);
      initReadingExperience();
    </script>

    <!-- Mobile Sticky Radar Bar with Geo-Personalization & Activity Ping -->
    <StickyRadar slug={slug} />

    <!-- Exit-Intent Retention Modal -->
    <ExitIntentModal slug={slug} />

    <Footer />
  </body>
</html>
