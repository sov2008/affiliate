---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ReadingProgressBar from '../components/ReadingProgressBar.astro';
import MobileStickyCTA from '../components/MobileStickyCTA.astro';
import InlineQuiz from '../components/InlineQuiz.astro';
import ExitIntentModal from '../components/ExitIntentModal.astro';
import SocialShareBar from '../components/SocialShareBar.astro';
import ScamRiskMatrix from '../components/ScamRiskMatrix.astro';
import CaseNotesFeed from '../components/CaseNotesFeed.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES_METADATA, CategoryEnum, type Category } from '../content.config';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  author: string;
  category?: Category;
  tags: string[];
  seoKeywords: string[];
  canonicalUrl?: string;
  coverImage?: string;
  image?: string;
  slug?: string;
  readingTime?: number;
  motto?: string;
  hook?: string;
  caseId?: string;
  classification?: string;
  telemetryRisk?: string;
}

const {
  title,
  description,
  pubDate,
  author,
  category,
  tags,
  seoKeywords,
  canonicalUrl = Astro.url.href,
  coverImage,
  image,
  slug,
  readingTime = 4,
  caseId: explicitCaseId,
  classification,
} = Astro.props;

const catId: Category = category && CATEGORIES_METADATA[category] ? category : 'safety-dossier';
const catMeta = CATEGORIES_METADATA[catId];
const caseId = explicitCaseId || ((slug || '2026').replace(/[^a-zA-Z0-9]/g, '').slice(-4).toUpperCase() || '2026');

const siteBaseUrl = 'https://flirtcheck.site';
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || siteBaseUrl;
const rawImg = coverImage || image;
const normalizedImg = rawImg ? rawImg.replace(/^\/blog/, '') : undefined;
const effectiveCoverImage = normalizedImg
  ? (normalizedImg.startsWith('/') ? normalizedImg : `/${normalizedImg}`)
  : undefined;
const coverSrc = effectiveCoverImage || `/images/posts/${slug || 'dating-scam-verification-guide-2026'}.webp`;

const normalizedCanonical = canonicalUrl ? canonicalUrl.replace(/https?:\/\/flirtcheck\.site\/blog\//, `${siteBaseUrl}/`) : '';
const canonicalAbsUrl = normalizedCanonical.startsWith('http')
  ? normalizedCanonical
  : `${siteBaseUrl}${normalizedCanonical.startsWith('/') ? '' : '/'}${normalizedCanonical}`;
const ogImageAbsUrl = effectiveCoverImage
  ? (effectiveCoverImage.startsWith('http') ? effectiveCoverImage : `${siteBaseUrl}${effectiveCoverImage.startsWith('/') ? '' : '/'}${effectiveCoverImage}`)
  : `${siteBaseUrl}/images/posts/${slug || 'dating-scam-verification-guide-2026'}.webp`;

const pubDateFormatted = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
}).format(pubDate);

const pubMonthYear = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  year: 'numeric'
}).format(pubDate);

// Abstract key findings
const topicClean = title.replace(/^(the|how to|why|what to say when|what to)\s+/i, '');
const findingsList = [
  `Empirical analysis of ${topicClean.toLowerCase()}: identifying systematic algorithmic bias, behavioral funnels, and data telemetry.`,
  `Audit protocols: recognizing unverified profile signatures, bot farm syntax loops, and high-risk extraction patterns.`,
  `Technical defense checklist: operational guidelines for identity protection and mitigating digital manipulation.`
];

// Related dossiers
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const currentId = slug || '';
const relatedPosts = allPosts
  .filter(p => (p.id || p.slug) !== currentId)
  .map(p => {
    let score = 0;
    if (tags && p.data.tags) {
      const commonTags = p.data.tags.filter(t => tags.includes(t)).length;
      score += commonTags * 10;
    }
    if (p.data.category === catId) score += 5;
    return { post: p, score };
  })
  .sort((a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
  .slice(0, 3)
  .map(item => item.post);

const isSafetyDossier = catId === 'safety-dossier' || (tags && tags.some(t => /scam|crypto|catfish|bot|imposter/i.test(t)));

// Schema.org
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": `${title} | FlirtCheck Investigation`,
  "description": description,
  "inLanguage": "en-US",
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalAbsUrl },
  "author": { "@type": "Person", "name": "Arthur Vance", "url": `${siteUrl}/desk` },
  "publisher": {
    "@type": "Organization",
    "name": "FlirtCheck Independent Forensics",
    "url": siteUrl,
    "logo": { "@type": "ImageObject", "url": `${siteUrl}/avatar.jpg` }
  },
  "datePublished": pubDate.toISOString(),
  "dateModified": pubDate.toISOString(),
  "keywords": seoKeywords.join(', ')
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "Archive", "item": `${siteUrl}/#feed` },
    { "@type": "ListItem", "position": 3, "name": catMeta.shortTitle, "item": `${siteUrl}/category/${catMeta.id}` },
    { "@type": "ListItem", "position": 4, "name": title, "item": canonicalAbsUrl }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the fastest way to verify a dating profile?",
      "acceptedAnswer": { "@type": "Answer", "text": "The fastest zero-cost method is requesting a 15-second live video call or using our integrated safety lookup tool before exchanging personal social media or phone numbers." }
    },
    {
      "@type": "Question",
      "name": "Can AI detect whether a dating profile is genuine?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. Automated security filters evaluate account creation velocity, IP fingerprint anomalies, syntactic repetition across chat logs, and visual GAN artifacts in uploaded gallery pictures." }
    },
    {
      "@type": "Question",
      "name": "What should I do if I discover a scammer?",
      "acceptedAnswer": { "@type": "Answer", "text": "Immediately capture screenshots of the profile and chat log, report the account within the dating platform's safety center, block all communication channels, and never send funds under any circumstances." }
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en" class="bg-[#FAF7F2] text-slate-900 antialiased scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | FlirtCheck Investigation</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={seoKeywords.join(', ')} />
    <meta name="author" content={author} />
    <link rel="canonical" href={canonicalAbsUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="robots" content="noindex, nofollow, noarchive" />

    <!-- Critical Local Fonts Preload -->
    <link rel="preload" href="/fonts/PlayfairDisplay-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JetBrainsMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <!-- LCP cover image preload -->
    <link rel="preload" as="image" href={coverSrc} fetchpriority="high" type="image/webp" />

    <!-- OpenGraph -->
    <meta property="og:site_name" content="FlirtCheck Independent Forensics" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={`${title} | FlirtCheck Investigation`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalAbsUrl} />
    <meta property="og:image" content={ogImageAbsUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/webp" />
    <meta property="article:published_time" content={pubDate.toISOString()} />
    <meta property="article:author" content="https://flirtcheck.site/desk" />
    {tags.map(tag => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@flirtcheck" />
    <meta name="twitter:title" content={`${title} | FlirtCheck Investigation`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsUrl} />

    <!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>

  <body class="min-h-screen flex flex-col bg-[#FAF7F2] text-slate-900">
    <ReadingProgressBar />
    <Header activePath="/" />

    <main class="flex-1 w-full">
      <!-- ═══════════════════════════════════════════════════════════
           ASYMMETRIC 2-COLUMN LAYOUT: max-w-6xl, 12-col grid
           Left:  3 cols — Sticky Reading Sidebar (hidden on mobile)
           Right: 9 cols — Article content column (max 68ch)
           ═══════════════════════════════════════════════════════════ -->
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:grid lg:grid-cols-12 lg:gap-12 items-start">

        <!-- ────────────────────────────────────────────────────────
             LEFT SIDEBAR: Mini Dossier + Table of Contents
             Only visible on lg+ (desktop), sticky
             ──────────────────────────────────────────────────────── -->
        <aside class="hidden lg:block lg:col-span-3">
          <div class="sticky top-24 space-y-5">

            <!-- Mini Case Dossier Card -->
            <div class="bg-white border border-slate-300 rounded-none p-4 font-mono">
              <div class="text-[9px] font-bold uppercase tracking-widest text-slate-500 mb-3 border-b border-slate-200 pb-2">
                CHELTENHAM DESK // CASE FILE
              </div>
              <div class="space-y-2 text-[10px]">
                <div class="flex justify-between gap-2">
                  <span class="text-slate-500 uppercase">Case</span>
                  <span class="font-bold text-slate-900 text-right">FC-{caseId}</span>
                </div>
                <div class="flex justify-between gap-2">
                  <span class="text-slate-500 uppercase">Filed</span>
                  <span class="font-bold text-slate-900 text-right">{pubDateFormatted}</span>
                </div>
                <div class="flex justify-between gap-2">
                  <span class="text-slate-500 uppercase">Read</span>
                  <span class="font-bold text-slate-900">{readingTime} MIN</span>
                </div>
                <div class="flex justify-between gap-2">
                  <span class="text-slate-500 uppercase">Class.</span>
                  <span class="font-bold text-slate-900 text-right truncate max-w-[7rem]">{classification || 'PUBLIC'}</span>
                </div>
                <div class="flex justify-between gap-2">
                  <span class="text-slate-500 uppercase">Desk</span>
                  <span class="font-bold text-slate-900">A. Vance</span>
                </div>
              </div>
              <!-- A- / A+ font scale controls in sidebar -->
              <div class="mt-4 pt-3 border-t border-slate-200 flex items-center justify-between">
                <span class="text-[9px] text-slate-500 uppercase tracking-wider">Type Scale</span>
                <div class="inline-flex items-center border border-slate-300 rounded overflow-hidden">
                  <button
                    type="button"
                    id="fontScaleDownBtn"
                    aria-label="Decrease font size"
                    class="min-h-[36px] min-w-[36px] flex items-center justify-center font-mono font-bold text-[10px] text-slate-700 hover:bg-slate-100 cursor-pointer transition-colors border-r border-slate-300 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-slate-900"
                  >A-</button>
                  <button
                    type="button"
                    id="fontScaleUpBtn"
                    aria-label="Increase font size"
                    class="min-h-[36px] min-w-[36px] flex items-center justify-center font-mono font-bold text-[10px] text-slate-700 hover:bg-slate-100 cursor-pointer transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-slate-900"
                  >A+</button>
                </div>
              </div>
            </div>

            <!-- Table of Contents (auto-generated via JS) -->
            <div class="bg-white border border-slate-300 rounded-none p-4">
              <div class="font-mono text-[9px] font-bold uppercase tracking-widest text-slate-500 mb-3 pb-2 border-b border-slate-200">
                Contents
              </div>
              <nav id="tocNav" aria-label="Table of contents">
                <ul id="tocList" class="space-y-1.5 text-[11px] font-mono">
                  <!-- injected by JS -->
                </ul>
              </nav>
            </div>

            <!-- Sticky Smartlink CTA -->
            <div class="bg-[#FAF7F2] border border-slate-300 p-4">
              <span class="block font-mono text-[9px] font-bold uppercase tracking-widest text-slate-500 mb-2">
                VERIFICATION PORTAL
              </span>
              <p class="text-[11px] text-slate-600 font-sans leading-snug mb-3">
                Cross-check your match against verified ID-confirmed singles.
              </p>
              <a
                href={`/go?source=sidebar_toc&trigger=article_read&intent=verify&ref=${slug || 'article'}`}
                id="tocCtaLink"
                rel="nofollow sponsored"
                target="_blank"
                class="min-h-[40px] w-full flex items-center justify-center text-center px-3 py-2 bg-slate-900 hover:bg-slate-800 text-white font-mono font-bold text-[10px] uppercase tracking-wider transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900"
              >
                VERIFY MATCH ↗
              </a>
            </div>

          </div>
        </aside>

        <!-- ────────────────────────────────────────────────────────
             MAIN CONTENT COLUMN: 9 cols on lg, full width on mobile
             ──────────────────────────────────────────────────────── -->
        <div class="lg:col-span-9 min-w-0">

          <!-- Breadcrumbs -->
          <nav aria-label="Breadcrumbs" class="py-2 mb-5 text-xs font-sans text-slate-500">
            <div class="flex flex-wrap items-center gap-2">
              <a href="/" class="hover:text-slate-900 transition-colors">Home</a>
              <span class="text-slate-300">/</span>
              <a href="/#feed" class="hover:text-slate-900 transition-colors">Archive</a>
              <span class="text-slate-300">/</span>
              <a href={`/category/${catMeta.id}`} class="text-slate-700 hover:text-slate-900 transition-colors font-medium">
                {catMeta.shortTitle}
              </a>
            </div>
          </nav>

          <!-- ══════════════════════════════════════════════
               ARTICLE HEADER: Tags, H1, Byline
               ══════════════════════════════════════════════ -->
          <header class="mb-7 pb-6 border-b border-slate-200">
            <!-- Category + Tags row -->
            <div class="flex flex-wrap items-center gap-2 mb-4">
              <a
                href={`/category/${catMeta.id}`}
                class="px-2.5 py-0.5 rounded-none text-xs font-mono font-bold uppercase tracking-widest bg-slate-900 text-white hover:bg-slate-700 transition-colors"
              >
                {catMeta.shortTitle}
              </a>
              {tags.slice(0, 3).map(tag => (
                <span class="px-2 py-0.5 text-[11px] font-mono text-slate-600 bg-white border border-slate-300">
                  #{tag}
                </span>
              ))}
              <!-- Mobile font controls (only on < lg) -->
              <div class="lg:hidden inline-flex items-center border border-slate-300 rounded overflow-hidden ml-auto">
                <button type="button" id="fontScaleDownBtnMobile" aria-label="Decrease font size"
                  class="min-h-[44px] min-w-[44px] flex items-center justify-center font-mono font-bold text-xs text-slate-700 hover:bg-slate-100 cursor-pointer transition-colors border-r border-slate-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900">A-</button>
                <button type="button" id="fontScaleUpBtnMobile" aria-label="Increase font size"
                  class="min-h-[44px] min-w-[44px] flex items-center justify-center font-mono font-bold text-xs text-slate-700 hover:bg-slate-100 cursor-pointer transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900">A+</button>
              </div>
            </div>

            <!-- H1 Headline -->
            <h1 class="font-serif font-black text-3xl sm:text-4xl lg:text-5xl text-slate-900 leading-tight tracking-tight mb-5">
              {title}
            </h1>

            <!-- Byline -->
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 pt-4 border-t border-slate-200 text-xs font-sans text-slate-600">
              <span class="font-medium text-slate-900">By <a href="/desk" class="underline font-bold hover:text-rose-700">Arthur Vance</a></span>
              <span class="text-slate-300">·</span>
              <span>Cheltenham Bureau</span>
              <span class="text-slate-300">·</span>
              <time datetime={pubDate.toISOString()}>{pubDateFormatted}</time>
              <span class="text-slate-300">·</span>
              <span class="font-mono">{readingTime} min read</span>
              <span class="text-slate-300">·</span>
              <span class="inline-flex items-center gap-1 text-emerald-700 font-medium bg-emerald-50 px-1.5 py-0.5 border border-emerald-200 text-[11px] font-mono">
                ✓ Verified Independent
              </span>
            </div>
          </header>

          <!-- ══════════════════════════════════════════════
               ABSTRACT & KEY FINDINGS
               ══════════════════════════════════════════════ -->
          <div class="border border-slate-300 bg-white p-5 sm:p-6 my-6 rounded-none">
            <span class="font-mono text-[9px] font-bold uppercase tracking-widest text-slate-500 block mb-3">
              [ INVESTIGATION ABSTRACT & KEY FINDINGS ]
            </span>
            <p class="text-sm sm:text-base text-slate-700 leading-relaxed font-sans mb-4">
              {description}
            </p>
            <ul class="space-y-2 text-xs sm:text-sm text-slate-800 font-sans">
              {findingsList.map(item => (
                <li class="flex items-start gap-2 leading-relaxed">
                  <span class="text-slate-400 font-mono font-bold shrink-0 mt-0.5">—</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Social Share (top) -->
          <SocialShareBar title={title} url={canonicalAbsUrl} className="my-5" />

          <!-- ══════════════════════════════════════════════
               FULL-WIDTH COVER IMAGE — 16:9 with archive caption
               ══════════════════════════════════════════════ -->
          <figure class="mb-8 not-prose">
            <div class="border border-slate-300 bg-[#F4EFE6] overflow-hidden">
              <img
                src={coverSrc}
                alt={title}
                class="w-full aspect-[16/9] object-cover select-none pointer-events-none block"
                loading="eager"
                fetchpriority="high"
                width="900"
                height="506"
              />
            </div>
            <figcaption class="font-mono text-[10px] uppercase tracking-wider text-slate-500 mt-2 block">
              FIG 1.0 // FORENSIC FIELD EVIDENCE · CHELTENHAM ARCHIVE · CASE FC-{caseId}
            </figcaption>
          </figure>

          <!-- ══════════════════════════════════════════════
               MAIN ARTICLE BODY (Markdown slot)
               ══════════════════════════════════════════════ -->
          <article
            id="articleContent"
            class="prose prose-slate max-w-none
              [&>p:first-of-type::first-letter]:float-left
              [&>p:first-of-type::first-letter]:text-5xl sm:[&>p:first-of-type::first-letter]:text-6xl
              [&>p:first-of-type::first-letter]:font-serif
              [&>p:first-of-type::first-letter]:font-bold
              [&>p:first-of-type::first-letter]:mr-3
              [&>p:first-of-type::first-letter]:mb-1
              [&>p:first-of-type::first-letter]:leading-none
              [&>p:first-of-type::first-letter]:text-slate-900
              [&_h2]:font-serif [&_h2]:font-bold [&_h2]:text-2xl sm:[&_h2]:text-3xl [&_h2]:text-slate-900 [&_h2]:mt-10 [&_h2]:mb-4 [&_h2]:pt-6 [&_h2]:border-t [&_h2]:border-slate-200
              [&_h3]:font-serif [&_h3]:font-bold [&_h3]:text-xl sm:[&_h3]:text-2xl [&_h3]:text-slate-900 [&_h3]:mt-6 [&_h3]:mb-3
              [&_p]:font-sans [&_p]:text-[17px] sm:[&_p]:text-[18px] [&_p]:text-slate-800 [&_p]:leading-[1.75] [&_p]:tracking-[-0.01em] [&_p]:mb-5
              [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-5 [&_ul]:space-y-2 [&_ul]:text-slate-800 [&_ul]:text-[16px] sm:[&_ul]:text-[17px]
              [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:mb-5 [&_ol]:space-y-2 [&_ol]:text-slate-800 [&_ol]:text-[16px] sm:[&_ol]:text-[17px]
              [&_li]:text-slate-800 [&_li]:leading-relaxed
              [&_blockquote]:border-l-2 [&_blockquote]:border-slate-900 [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:text-slate-700 [&_blockquote]:font-serif [&_blockquote]:my-6 [&_blockquote]:py-1
              [&_hr]:border-slate-200 [&_hr]:my-8"
          >
            <!-- Mid-article quiz injected here by JS -->
            <div id="mid-quiz-container" class="my-8 not-prose">
              <InlineQuiz
                slug={slug}
                quizId="mid-radar-quiz"
                title="⚡ Quick Scan: Is Your Dating Match Real?"
                subtitle="Instant cross-reference against verified anti-bot database and spoofing patterns."
              />
            </div>
            <slot />
          </article>

          <!-- ══════════════════════════════════════════════
               STRICT SEQUENTIAL FOOTER SECTIONS
               Order: 1.ScamRiskMatrix → 2.CaseNotes → 3.AuthorCard → 4.RelatedDossiers
               ══════════════════════════════════════════════ -->

          <!-- 1. [ INCIDENT RISK CHECK ] — only for safety/scam dossiers -->
          {isSafetyDossier && (
            <section class="mt-10 not-prose">
              <div class="font-mono text-[10px] font-bold uppercase tracking-widest text-slate-500 mb-3 flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-rose-700 shrink-0"></span>
                <span>[ INCIDENT RISK CHECK ]</span>
              </div>
              <div class="border border-slate-300">
                <ScamRiskMatrix />
              </div>
            </section>
          )}

          <!-- 2. [ CORROBORATING FIELD NOTES ] -->
          <section class="mt-10 not-prose">
            <div class="font-mono text-[10px] font-bold uppercase tracking-widest text-slate-500 mb-3 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-slate-800 shrink-0"></span>
              <span>[ CORROBORATING FIELD NOTES ]</span>
            </div>
            <CaseNotesFeed postSlug={slug || ''} />
          </section>

          <!-- 3. [ INVESTIGATOR DOSSIER ] — Author card -->
          <section class="mt-10 not-prose">
            <div class="font-mono text-[10px] font-bold uppercase tracking-widest text-slate-500 mb-3 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-slate-800 shrink-0"></span>
              <span>[ INVESTIGATOR DOSSIER ]</span>
            </div>
            <div class="bg-white border border-slate-300 p-5 sm:p-6 flex flex-col sm:flex-row items-start gap-4">
              <img
                src="/images/author/arthur-vance-avatar.webp"
                alt="Arthur Vance"
                class="w-14 h-14 rounded-none border border-slate-300 object-cover shrink-0"
                loading="lazy"
                width="56"
                height="56"
              />
              <div class="flex-1 min-w-0 font-sans">
                <div class="flex flex-wrap items-start justify-between gap-2 mb-1.5">
