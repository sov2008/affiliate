---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DatingSmartlinkCTA from '../components/DatingSmartlinkCTA.astro';
import DatingRadarQuiz from '../components/DatingRadarQuiz.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  author: string;
  tags: string[];
  seoKeywords: string[];
  canonicalUrl?: string;
  coverImage?: string;
  slug?: string;
}

const {
  title,
  description,
  pubDate,
  author,
  tags,
  seoKeywords,
  canonicalUrl = Astro.url.href,
  coverImage,
  slug
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://flirtcheck.site';
const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(pubDate);

// Schema.org Article Structured Data
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "inLanguage": "en-US",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "author": {
    "@type": "Person",
    "name": author,
    "url": `${siteUrl}/author/editorial`
  },
  "publisher": {
    "@type": "Organization",
    "name": "FlirtCheck Safety Editorial",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/avatar.jpg`
    }
  },
  "datePublished": pubDate.toISOString(),
  "dateModified": pubDate.toISOString(),
  "keywords": seoKeywords.join(', ')
};

// Schema.org FAQPage Structured Data
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the fastest way to verify a dating profile?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The fastest zero-cost method is requesting a 15-second live video call or using an automated safety lookup tool before exchanging social media or phone numbers."
      }
    },
    {
      "@type": "Question",
      "name": "Can AI detect whether a dating profile is genuine?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Automated security filters evaluate account creation velocity, IP fingerprint anomalies, syntactic repetition across chat logs, and visual GAN artifacts in uploaded gallery pictures."
      }
    },
    {
      "@type": "Question",
      "name": "What should I do if I discover a scammer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Immediately capture screenshots of the profile and chat log, report the account within the dating platform's safety center, block all communication channels, and never send funds under any circumstances."
      }
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en" class="bg-slate-950 text-slate-100 antialiased scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | FlirtCheck Editorial</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={seoKeywords.join(', ')} />
    <meta name="author" content={author} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- OpenGraph Metadata -->
    <meta property="og:site_name" content="FlirtCheck" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="article:published_time" content={pubDate.toISOString()} />
    <meta property="article:author" content={author} />
    {tags.map(tag => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>

  <body class="min-h-screen flex flex-col bg-slate-950 text-slate-200">
    <Header activePath="/blog" />

    <main class="flex-1 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
      <!-- Breadcrumbs Navigation -->
      <Breadcrumbs items={[{ name: title, url: canonicalUrl }]} />

      <!-- Article Header -->
      <header class="my-8 pb-8 border-b border-slate-800">
        <div class="flex flex-wrap items-center gap-2 mb-4">
          {tags.map(tag => (
            <span class="px-3 py-1 rounded-full text-xs font-semibold bg-rose-500/10 text-rose-400 border border-rose-500/20">
              {tag}
            </span>
          ))}
          <span class="text-xs text-slate-500 font-medium">● ~4 min read</span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-tight mb-6">
          {title}
        </h1>

        <p class="text-lg text-slate-300 leading-relaxed mb-6 font-light">
          {description}
        </p>

        <div class="flex items-center gap-3 pt-4 border-t border-slate-800/60 text-xs text-slate-400">
          <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-rose-500 to-pink-600 flex items-center justify-center font-bold text-white text-xs">
            FC
          </div>
          <div>
            <div class="font-semibold text-white">{author}</div>
            <div>Published on {formattedDate}</div>
          </div>
        </div>
      </header>

      <!-- Featured Cover Image -->
      <div class="mb-10 overflow-hidden rounded-2xl border border-slate-800 shadow-2xl bg-slate-900">
        <img
          src={coverImage || "/blog/images/posts/default-cover.webp"}
          alt={title}
          class="w-full aspect-video object-cover hover:scale-[1.01] transition-transform duration-500"
          loading="eager"
        />
      </div>

      <!-- Article Markdown Typography Content -->
      <article class="prose prose-invert prose-rose max-w-none 
        [&_h1]:text-3xl [&_h1]:font-extrabold [&_h1]:text-white [&_h1]:mt-8 [&_h1]:mb-4
        [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-white [&_h2]:mt-10 [&_h2]:mb-4 [&_h2]:pb-2 [&_h2]:border-b [&_h2]:border-slate-800
        [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:text-rose-300 [&_h3]:mt-6 [&_h3]:mb-3
        [&_p]:text-slate-300 [&_p]:leading-relaxed [&_p]:mb-4 [&_p]:text-base
        [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-4 [&_ul]:space-y-2 [&_ul]:text-slate-300
        [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:mb-4 [&_ol]:space-y-2 [&_ul]:text-slate-300
        [&_li]:text-slate-300
        [&_blockquote]:border-l-4 [&_blockquote]:border-rose-500 [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:text-slate-400 [&_blockquote]:my-6 [&_blockquote]:bg-slate-900/40 [&_blockquote]:py-2 [&_blockquote]:rounded-r
        [&_hr]:border-slate-800 [&_hr]:my-8">
        <slot />
      </article>

      <!-- Mid-Article Sticky Inline Radar Quiz (Injected dynamically into article midpoint) -->
      <div id="mid-quiz-container" class="my-8 not-prose">
        <DatingRadarQuiz
          slug={slug}
          variant="sticky"
          quizId="mid-radar-quiz"
          title="⚡ Quick Scan: Is Your Dating Match Real?"
          subtitle="Instant cross-reference against verified anti-bot database and spoofing patterns."
        />
      </div>

      <!-- Conversion Hook: Full AI Match & Integrity Radar Quiz -->
      <section class="mt-12 mb-8">
        <DatingRadarQuiz
          slug={slug}
          variant="full"
          quizId="bottom-radar-quiz"
          title="AI Match & Integrity Radar: Complete Profile Verification"
          subtitle="Stop wasting time on catfish profiles and bot swarms. Verify safety clearance and access 100% verified singles."
        />
      </section>

      <!-- Editorial FAQ Section -->
      <section class="my-12 p-6 sm:p-8 rounded-2xl bg-slate-900/80 border border-slate-800 shadow-xl">
        <div class="flex items-center gap-2 text-xs font-mono uppercase text-rose-400 font-bold mb-2">
          <span>● Verified Knowledgebase</span>
        </div>
        <h3 class="text-2xl font-black text-white tracking-tight mb-6">
          Frequently Asked Questions About Profile Safety
        </h3>
        <div class="space-y-4">
          <div class="p-4 rounded-xl bg-slate-950/60 border border-slate-800/80">
            <h4 class="font-bold text-white text-sm sm:text-base mb-2 flex items-center gap-2">
              <span class="text-rose-400 font-mono">Q1:</span> What is the fastest way to verify a dating profile?
            </h4>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              The fastest zero-cost method is requesting a 15-second live video call or using our integrated safety lookup tool before exchanging personal social media or phone numbers.
            </p>
          </div>

          <div class="p-4 rounded-xl bg-slate-950/60 border border-slate-800/80">
            <h4 class="font-bold text-white text-sm sm:text-base mb-2 flex items-center gap-2">
              <span class="text-rose-400 font-mono">Q2:</span> Can AI detect whether a dating profile is genuine?
            </h4>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              Yes. Automated security filters evaluate account creation velocity, IP fingerprint anomalies, syntactic repetition across chat logs, and visual GAN artifacts in uploaded gallery pictures.
            </p>
          </div>

          <div class="p-4 rounded-xl bg-slate-950/60 border border-slate-800/80">
            <h4 class="font-bold text-white text-sm sm:text-base mb-2 flex items-center gap-2">
              <span class="text-rose-400 font-mono">Q3:</span> What should I do if I discover a scammer?
            </h4>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              Immediately capture screenshots of the profile and chat log, report the account within the dating platform's safety center, block all communication channels, and never send funds under any circumstances.
            </p>
          </div>
        </div>
      </section>
    </main>

    <script>
      // Dynamically relocate mid-article quiz into article content midpoint
      function injectMidArticleQuiz() {
        const article = document.querySelector('article');
        const midQuiz = document.getElementById('mid-quiz-container');
        if (!article || !midQuiz) return;

        const h2Elements = article.querySelectorAll('h2');
        if (h2Elements.length >= 2) {
          const targetIndex = Math.floor(h2Elements.length / 2);
          h2Elements[targetIndex].before(midQuiz);
        } else {
          const paragraphs = article.querySelectorAll('p');
          if (paragraphs.length >= 3) {
            paragraphs[2].after(midQuiz);
          }
        }
      }

      document.addEventListener('DOMContentLoaded', injectMidArticleQuiz);
      injectMidArticleQuiz();
    </script>

    <Footer />
  </body>
</html>
