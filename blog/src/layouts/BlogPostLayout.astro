              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                {relatedPosts.map((rel) => {
                  const relUrl = `/${rel.id || rel.slug}/`;
                  const relCategoryLabel = rel.data.category ? rel.data.category.toUpperCase() : 'INVESTIGATION';
                  const relDate = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }).format(rel.data.pubDate);
                  return (
                    <article class="bg-white border border-slate-300 hover:border-slate-500 transition-colors flex flex-col">
                      <div class="bg-[#FAF7F2] border-b border-slate-200 px-3.5 py-2 font-mono text-[10px] font-bold text-slate-600 uppercase tracking-wider flex justify-between items-center">
                        <span>[{relCategoryLabel}]</span>
