---
interface Props {
  slug?: string;
  quizId?: string;
  title?: string;
  subtitle?: string;
}

const {
  slug = 'dating-safety-guide',
  quizId = 'inline-quiz-' + Math.random().toString(36).substring(2, 8),
  title = 'RAPID PROFILE SAFETY & COMPATIBILITY AUDIT',
  subtitle = 'Answer 3 questions to evaluate match authenticity against the Cheltenham scam signature registry.'
} = Astro.props;
---

<div
  id={quizId}
  data-slug={slug}
  class="inline-dating-quiz my-8 not-prose bg-white border border-slate-300 text-slate-900"
>
  <div class="relative">

    <!-- Header Ledger Strip -->
    <div class="bg-[#FAF7F2] border-b border-slate-200 px-5 py-3 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-rose-700 shrink-0"></span>
        <span class="font-mono text-[10px] font-bold tracking-widest uppercase text-slate-900">
          FIELD SURVEY // ANTI-BOT QUESTIONNAIRE
        </span>
      </div>
      <span class="font-mono text-[9px] text-slate-500 uppercase tracking-wider">Protocol v3.0</span>
    </div>

    <div class="p-5 sm:p-6">

      <!-- Title & Subtitle -->
      <div class="mb-5 pb-4 border-b border-slate-100">
        <h3 class="font-serif font-bold text-lg sm:text-xl text-slate-900 leading-snug tracking-tight">
          {title}
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 mt-1.5 leading-relaxed font-sans">
          {subtitle}
        </p>
      </div>

      <!-- ── STEP 1: Platform ──────────────────────────────── -->
      <div class="quiz-step quiz-step-1 space-y-3">
        <div class="flex items-center justify-between text-[10px] font-mono font-bold text-slate-500 uppercase tracking-wider mb-3">
          <span>Question 1 of 3 — Origin Platform</span>
          <span class="text-rose-700">[ 1 / 3 ]</span>
        </div>
        <div class="grid grid-cols-2 gap-2.5">
          {[
            { val: 'Tinder',    label: 'Tinder',    icon: '◈' },
            { val: 'Bumble',    label: 'Bumble',    icon: '◈' },
            { val: 'Telegram',  label: 'Telegram',  icon: '◈' },
            { val: 'Instagram', label: 'Instagram', icon: '◈' },
          ].map(({ val, label, icon }) => (
            <button
              type="button"
              data-val={val}
              class="quiz-btn-platform min-h-[48px] px-3 py-2.5 bg-[#FAF7F2] border border-slate-300 hover:border-slate-900 hover:bg-white transition-colors flex items-center gap-2 font-mono font-bold text-xs text-slate-900 cursor-pointer select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900"
            >
              <span class="text-rose-700 font-bold shrink-0">{icon}</span>
              <span>{label}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- ── STEP 2: WhatsApp move ────────────────────────── -->
      <div class="quiz-step quiz-step-2 hidden space-y-3">
        <div class="flex items-center justify-between text-[10px] font-mono font-bold text-slate-500 uppercase tracking-wider mb-3">
          <span>Question 2 of 3 — Communication Shift</span>
          <span class="text-rose-700">[ 2 / 3 ]</span>
        </div>
        <p class="text-sm font-serif font-bold text-slate-900 mb-3">
          Did they ask to move to WhatsApp or external chat within 48 hours?
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          <button
            type="button"
            data-val="Yes"
            class="quiz-btn-whatsapp min-h-[52px] px-4 py-3 bg-[#FAF7F2] border border-slate-300 hover:border-slate-900 hover:bg-white transition-colors flex items-center gap-3 font-mono font-bold text-xs text-slate-900 cursor-pointer select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900"
          >
            <span class="w-6 h-6 border border-rose-700 bg-rose-50 text-rose-700 flex items-center justify-center font-mono font-bold text-xs shrink-0">!</span>
            <div class="text-left">
              <div class="font-bold text-slate-900 text-xs">YES</div>
              <div class="text-[10px] text-slate-500 font-medium font-sans mt-0.5">Pushed for WhatsApp / Telegram</div>
            </div>
          </button>
          <button
            type="button"
            data-val="No"
            class="quiz-btn-whatsapp min-h-[52px] px-4 py-3 bg-[#FAF7F2] border border-slate-300 hover:border-slate-900 hover:bg-white transition-colors flex items-center gap-3 font-mono font-bold text-xs text-slate-900 cursor-pointer select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900"
          >
            <span class="w-6 h-6 border border-slate-300 bg-white text-slate-500 flex items-center justify-center font-mono font-bold text-xs shrink-0">✓</span>
            <div class="text-left">
              <div class="font-bold text-slate-900 text-xs">NO</div>
              <div class="text-[10px] text-slate-500 font-medium font-sans mt-0.5">Stayed inside the dating app</div>
            </div>
          </button>
        </div>
        <button type="button" class="quiz-back-step-1 text-[10px] font-mono text-slate-500 hover:text-slate-900 flex items-center gap-1 cursor-pointer mt-1 transition-colors">
          ← Back to question 1
        </button>
      </div>

      <!-- ── STEP 3: Video call ───────────────────────────── -->
      <div class="quiz-step quiz-step-3 hidden space-y-3">
        <div class="flex items-center justify-between text-[10px] font-mono font-bold text-slate-500 uppercase tracking-wider mb-3">
          <span>Question 3 of 3 — Visual Verification</span>
          <span class="text-rose-700">[ 3 / 3 ]</span>
        </div>
        <p class="text-sm font-serif font-bold text-slate-900 mb-3">
          Have you had an unfiltered, live two-way video call with them?
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          <button
            type="button"
            data-val="Yes"
            class="quiz-btn-videocall min-h-[52px] px-4 py-3 bg-[#FAF7F2] border border-slate-300 hover:border-slate-900 hover:bg-white transition-colors flex items-center gap-3 font-mono font-bold text-xs text-slate-900 cursor-pointer select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900"
          >
            <span class="w-6 h-6 border border-slate-300 bg-white text-slate-500 flex items-center justify-center font-mono font-bold text-xs shrink-0">✓</span>
            <div class="text-left">
              <div class="font-bold text-slate-900 text-xs">YES</div>
              <div class="text-[10px] text-slate-500 font-medium font-sans mt-0.5">Live face-to-face video confirmed</div>
            </div>
          </button>
          <button
            type="button"
            data-val="Never"
            class="quiz-btn-videocall min-h-[52px] px-4 py-3 bg-[#FAF7F2] border border-slate-300 hover:border-slate-900 hover:bg-white transition-colors flex items-center gap-3 font-mono font-bold text-xs text-slate-900 cursor-pointer select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900"
          >
            <span class="w-6 h-6 border border-rose-700 bg-rose-50 text-rose-700 flex items-center justify-center font-mono font-bold text-xs shrink-0">✗</span>
            <div class="text-left">
              <div class="font-bold text-slate-900 text-xs">NEVER</div>
              <div class="text-[10px] text-slate-500 font-medium font-sans mt-0.5">Camera broken, shy, or evasive</div>
            </div>
          </button>
        </div>
        <button type="button" class="quiz-back-step-2 text-[10px] font-mono text-slate-500 hover:text-slate-900 flex items-center gap-1 cursor-pointer mt-1 transition-colors">
          ← Back to question 2
        </button>
      </div>

      <!-- ── STEP 4: Scanning ────────────────────────────── -->
      <div class="quiz-step quiz-scanning hidden space-y-4 py-2">
        <div class="flex items-center justify-between text-[10px] font-mono font-bold">
          <span class="text-slate-700 flex items-center gap-2">
            <svg class="animate-spin h-3.5 w-3.5 text-rose-700 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
            <span class="scan-status-label font-bold text-slate-900 uppercase tracking-wider">Cross-referencing signature database...</span>
          </span>
          <span class="scan-counter-pct text-rose-700 font-black font-mono">0%</span>
        </div>

        <!-- Documentary Progress Bar -->
        <div class="w-full bg-[#F2ECE1] h-2 border border-slate-300 overflow-hidden">
          <div class="scan-bar-fill h-full bg-slate-900 transition-all duration-100 ease-out w-0"></div>
        </div>

        <div class="grid grid-cols-3 gap-2 text-[9px] text-slate-500 font-mono text-center uppercase tracking-wider">
          <span class="scan-badge-1 text-rose-700 font-bold">1. Signature Scan</span>
          <span class="scan-badge-2 opacity-30">2. Bot Heuristics</span>
          <span class="scan-badge-3 opacity-30">3. Human Verify</span>
        </div>
      </div>

      <!-- ── STEP 5: Verdict ─────────────────────────────── -->
      <div class="quiz-step quiz-verdict hidden space-y-4">
        <!-- Verdict card -->
        <div class="verdict-box border border-slate-300 bg-[#FAF7F2] p-4 sm:p-5">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="flex items-start gap-4">
              <!-- Risk score badge -->
              <div class="verdict-score-badge w-14 h-14 border border-slate-900 bg-slate-900 flex flex-col items-center justify-center shrink-0">
                <span class="text-[8px] font-mono tracking-widest text-slate-200 uppercase">RISK</span>
                <span class="verdict-pct-text text-lg font-black leading-none text-white">92%</span>
              </div>
              <div class="min-w-0">
                <div class="flex items-center gap-2 mb-1.5">
                  <span class="verdict-tag font-mono text-[9px] font-bold px-2 py-0.5 uppercase tracking-widest border border-rose-700 text-rose-700 bg-white">
                    HIGH RISK DETECTED
                  </span>
                  <span class="text-[9px] text-slate-500 font-mono">Dossier #819</span>
                </div>
                <h4 class="verdict-title text-sm font-serif font-bold text-slate-900 leading-snug">
                  Critical Romance Fraud Signature Alert
                </h4>
                <p class="verdict-desc text-[11px] text-slate-600 leading-relaxed mt-1 font-sans">
                  Rapid external migration paired with video refusal matches 94% of confirmed dating bot swarms and pig butchering scripts.
                </p>
              </div>
            </div>
            <button type="button" class="quiz-reset-btn shrink-0 text-[10px] font-mono text-slate-500 hover:text-slate-900 transition-colors flex items-center gap-1 cursor-pointer border border-slate-300 px-3 py-1.5 bg-white hover:bg-[#FAF7F2]">
              ← Scan another
            </button>
          </div>
        </div>

        <!-- CTA — documentary style, no bright red -->
        <div class="space-y-3">
          <a
            href={`/go?source=inline_quiz&trigger_source=inline_quiz&intent=quiz_verified&ref=${encodeURIComponent(slug)}`}
            rel="nofollow sponsored"
            target="_blank"
            class="inline-quiz-cta-link w-full min-h-[48px] inline-flex items-center justify-center gap-3 px-5 py-3 bg-slate-900 hover:bg-slate-800 text-white font-mono font-bold text-xs uppercase tracking-wider transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900"
          >
            <span>VERIFY PROFILE CREDENTIALS</span>
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <div class="flex items-center justify-between text-[9px] text-slate-500 font-mono uppercase tracking-wider px-0.5">
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-slate-400 shrink-0"></span>
              100% Free · Human Verified Platform
            </span>
            <span>18+ Adults · SSL Encrypted</span>
          </div>
        </div>
      </div>

    </div>
    <!-- end inner padding -->
  </div>
</div>

<script>
  import anime from 'animejs';

  function initInlineQuizzes() {
    const quizzes = document.querySelectorAll<HTMLElement>('.inline-dating-quiz');

    quizzes.forEach((widget) => {
      const slug = widget.dataset.slug || 'dating-safety-guide';

      let platform = 'Tinder';
      let askedWhatsApp = 'Yes';
      let videoCall = 'Never';

      const step1        = widget.querySelector<HTMLElement>('.quiz-step-1');
      const step2        = widget.querySelector<HTMLElement>('.quiz-step-2');
      const step3        = widget.querySelector<HTMLElement>('.quiz-step-3');
      const stepScanning = widget.querySelector<HTMLElement>('.quiz-scanning');
      const stepVerdict  = widget.querySelector<HTMLElement>('.quiz-verdict');

      const platformBtns  = widget.querySelectorAll<HTMLButtonElement>('.quiz-btn-platform');
      const whatsappBtns  = widget.querySelectorAll<HTMLButtonElement>('.quiz-btn-whatsapp');
      const videocallBtns = widget.querySelectorAll<HTMLButtonElement>('.quiz-btn-videocall');
      const backStep1 = widget.querySelector<HTMLButtonElement>('.quiz-back-step-1');
      const backStep2 = widget.querySelector<HTMLButtonElement>('.quiz-back-step-2');
      const resetBtn  = widget.querySelector<HTMLButtonElement>('.quiz-reset-btn');

      const barFill    = widget.querySelector<HTMLElement>('.scan-bar-fill');
      const counterPct = widget.querySelector<HTMLElement>('.scan-counter-pct');
      const badge2     = widget.querySelector<HTMLElement>('.scan-badge-2');
      const badge3     = widget.querySelector<HTMLElement>('.scan-badge-3');

      const verdictBox   = widget.querySelector<HTMLElement>('.verdict-box');
      const verdictBadge = widget.querySelector<HTMLElement>('.verdict-score-badge');
      const verdictPct   = widget.querySelector<HTMLElement>('.verdict-pct-text');
      const verdictTag   = widget.querySelector<HTMLElement>('.verdict-tag');
      const verdictTitle = widget.querySelector<HTMLElement>('.verdict-title');
      const verdictDesc  = widget.querySelector<HTMLElement>('.verdict-desc');
      const ctaLink      = widget.querySelector<HTMLAnchorElement>('.inline-quiz-cta-link');

      // CID attribution
      let cid = '';
      try {
        cid = sessionStorage.getItem('flirtcheck_cid') || '';
        if (!cid) {
          cid = 'fc_' + Math.random().toString(36).substring(2, 9) + '_' + Date.now().toString(36);
          sessionStorage.setItem('flirtcheck_cid', cid);
        }
      } catch { cid = 'fc_' + Date.now().toString(36); }

      function updateCtaHref() {
        if (!ctaLink) return;
        ctaLink.href = `/go?source=inline_quiz&trigger_source=inline_quiz&intent=quiz_verified&ref=${encodeURIComponent(slug)}&cid=${encodeURIComponent(cid)}`;
      }
      updateCtaHref();

      ctaLink?.addEventListener('click', () => {
        try { navigator.sendBeacon?.(`/go?source=inline_quiz&trigger_source=inline_quiz&intent=quiz_verified&ref=${encodeURIComponent(slug)}&cid=${encodeURIComponent(cid)}&beacon=1`); } catch {}
      });

      function transitionSteps(hideStep: HTMLElement | null, showStep: HTMLElement | null) {
        if (!hideStep || !showStep) return;
        anime({
          targets: hideStep,
          opacity: [1, 0],
          translateY: [0, -6],
          duration: 150,
          easing: 'easeInQuad',
          complete: () => {
            hideStep.classList.add('hidden');
            showStep.classList.remove('hidden');
            anime({
              targets: showStep,
              opacity: [0, 1],
              translateY: [8, 0],
              duration: 250,
              easing: 'easeOutQuad',
            });
          }
        });
      }

      // Step transitions — highlight selected button
      platformBtns.forEach(btn => btn.addEventListener('click', () => {
        platformBtns.forEach(b => b.classList.remove('border-slate-900', 'bg-white'));
        btn.classList.add('border-slate-900', 'bg-white');
        platform = btn.dataset.val || 'Tinder';
        transitionSteps(step1, step2);
      }));

      whatsappBtns.forEach(btn => btn.addEventListener('click', () => {
        askedWhatsApp = btn.dataset.val || 'Yes';
        transitionSteps(step2, step3);
      }));

      videocallBtns.forEach(btn => btn.addEventListener('click', () => {
        videoCall = btn.dataset.val || 'Never';
        if (step3) step3.classList.add('hidden');
        startScanSimulation();
      }));

      backStep1?.addEventListener('click', () => { transitionSteps(step2, step1); });
      backStep2?.addEventListener('click', () => { transitionSteps(step3, step2); });

      resetBtn?.addEventListener('click', () => {
        stepVerdict?.classList.add('hidden');
        stepScanning?.classList.add('hidden');
        step3?.classList.add('hidden');
        step2?.classList.add('hidden');
        step1?.classList.remove('hidden');
        if (barFill) barFill.style.width = '0%';
        if (counterPct) counterPct.textContent = '0%';
        if (badge2) { badge2.classList.add('opacity-30'); badge2.classList.remove('text-rose-700', 'font-bold'); }
        if (badge3) { badge3.classList.add('opacity-30'); badge3.classList.remove('text-rose-700', 'font-bold'); }
      });

      function startScanSimulation() {
        stepScanning?.classList.remove('hidden');
        if (barFill) barFill.style.width = '0%';

        const progressObj = { value: 0 };
        anime({
          targets: progressObj,
          value: 100,
          duration: 1800,
          easing: 'easeInOutQuad',
          update: () => {
            const current = Math.round(progressObj.value);
            if (barFill) barFill.style.width = `${current}%`;
            if (counterPct) counterPct.textContent = `${current}%`;
            if (current >= 35 && badge2) {
              badge2.classList.remove('opacity-30');
              badge2.classList.add('text-rose-700', 'font-bold');
            }
            if (current >= 75 && badge3) {
              badge3.classList.remove('opacity-30');
              badge3.classList.add('text-rose-700', 'font-bold');
            }
          },
          complete: () => {
            setTimeout(renderVerdict, 120);
          }
        });
      }

      function renderVerdict() {
        stepScanning?.classList.add('hidden');
        stepVerdict?.classList.remove('hidden');

        const isHighRisk = (askedWhatsApp === 'Yes' || videoCall === 'Never');
        const targetRisk = isHighRisk ? 92 : 48;

        if (isHighRisk) {
          if (verdictBox) verdictBox.className = 'verdict-box border border-rose-700 bg-[#FAF7F2] p-4 sm:p-5';
          if (verdictBadge) verdictBadge.className = 'verdict-score-badge w-14 h-14 border border-rose-700 bg-rose-700 flex flex-col items-center justify-center shrink-0';
          if (verdictTag) { verdictTag.className = 'verdict-tag font-mono text-[9px] font-bold px-2 py-0.5 uppercase tracking-widest border border-rose-700 text-rose-700 bg-white'; verdictTag.textContent = 'HIGH RISK DETECTED'; }
          if (verdictTitle) verdictTitle.textContent = `Critical ${platform} Fraud Signature Alert`;
          if (verdictDesc) verdictDesc.textContent = 'External messaging migration combined with video call avoidance matches 94% of confirmed dating bot farms and scam networks.';
        } else {
          if (verdictBox) verdictBox.className = 'verdict-box border border-slate-300 bg-[#FAF7F2] p-4 sm:p-5';
          if (verdictBadge) verdictBadge.className = 'verdict-score-badge w-14 h-14 border border-slate-500 bg-slate-500 flex flex-col items-center justify-center shrink-0';
          if (verdictTag) { verdictTag.className = 'verdict-tag font-mono text-[9px] font-bold px-2 py-0.5 uppercase tracking-widest border border-slate-500 text-slate-700 bg-white'; verdictTag.textContent = 'MODERATE RISK INDEX'; }
          if (verdictTitle) verdictTitle.textContent = `Caution Advised on ${platform} Connection`;
          if (verdictDesc) verdictDesc.textContent = 'While video call was reported, profile flags require extra verification. Always confirm identity on verified human platforms.';
        }

        // Animate counter up with Anime.js
        const scoreObj = { val: 0 };
        anime({
          targets: scoreObj,
          val: targetRisk,
          round: 1,
          duration: 900,
          easing: 'easeOutExpo',
          update: () => {
            if (verdictPct) verdictPct.textContent = `${scoreObj.val}%`;
          }
        });

        if (verdictBadge) {
          anime({
            targets: verdictBadge,
            scale: [0.85, 1],
            opacity: [0, 1],
            duration: 400,
            easing: 'easeOutBack',
          });
        }

        updateCtaHref();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initInlineQuizzes);
  document.addEventListener('astro:page-load', initInlineQuizzes);
  initInlineQuizzes();
</script>
