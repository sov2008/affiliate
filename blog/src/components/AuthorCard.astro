---
// AuthorCard.astro - Unified Author & Investigator Dossier Card
// Used consistently across Sidebar, Article desktop sidebar, Article mobile bottom, and Author desk
interface Props {
  variant?: 'compact' | 'full';
  class?: string;
}

const { variant = 'compact', class: className = '' } = Astro.props;
---

<div class={`border border-slate-300 bg-white p-4 rounded-none sm:rounded-sm ${className}`} aria-label="Investigator Dossier">
  <div class="font-mono text-[9px] font-bold uppercase tracking-widest text-slate-500 mb-3 pb-2 border-b border-slate-200 flex items-center justify-between">
    <span class="flex items-center gap-1.5">
      <span class="w-1.5 h-1.5 rounded-full bg-slate-800" aria-hidden="true"></span>
      <span>[ INVESTIGATOR DOSSIER ]</span>
    </span>
    <span class="text-rose-700 font-bold">STATION 04</span>
  </div>

  <div class="flex items-center gap-3.5 mb-3">
    <img
      src="/images/author/arthur-vance-avatar.webp"
      alt="Arthur Vance - Lead Forensic Investigator"
      class="w-14 h-14 rounded-full border border-slate-300 object-cover shrink-0"
      loading="lazy"
      width="56"
      height="56"
    />
    <div class="min-w-0 font-sans">
      <h3 class="font-serif font-bold text-sm sm:text-base text-slate-900 leading-snug">
        <a href="/desk" class="hover:text-rose-700 transition-colors">Arthur Vance</a>
      </h3>
      <span class="text-[10px] font-mono text-slate-600 block leading-tight mt-0.5">
        Lead Forensic Desk
      </span>
      <span class="text-[10px] font-mono text-slate-500 block mt-0.5">
        Cheltenham, UK · Independent
      </span>
    </div>
  </div>

  <p class="text-[11px] text-slate-600 font-sans leading-relaxed mb-3.5">
    Arthur Vance investigates commercial matchmaking telemetry, hidden ELO ranking systems, and deceptive digital persona funnels. Independent forensic reporter operating under confidential source protocols since 2019.
  </p>

  <a
    href="/desk"
    class="min-h-[44px] w-full flex items-center justify-center text-center px-3 py-2 bg-white hover:bg-slate-50 text-slate-900 border border-slate-300 font-mono font-bold text-[10px] uppercase tracking-wider transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900"
  >
    View Investigator Dossier ↗
  </a>
</div>
