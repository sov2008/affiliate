---
// IndependenceProtocol.astro - Authentic Journalistic Independence Manifest
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<section
  id="protocol"
  class:list={[
    "scroll-mt-20 my-12 p-6 sm:p-8 bg-white border border-slate-300 rounded-none sm:rounded-sm shadow-none text-slate-900",
    className
  ]}
>
  <div class="max-w-4xl mx-auto">
    <div class="flex items-center gap-2.5 mb-3">
      <span class="w-2.5 h-2.5 rounded-full bg-slate-900"></span>
      <span class="text-xs font-mono font-bold uppercase tracking-widest text-slate-500">
        [ EDITORIAL CHARTER // CHELTENHAM DESK ]
      </span>
    </div>

    <h2 class="text-2xl sm:text-3xl font-bold font-serif tracking-tight text-slate-900 mb-3">
      The Independence Protocol
    </h2>

    <p class="text-sm sm:text-base text-slate-700 leading-relaxed font-sans mb-6">
      FlirtCheck operates as an independent technical and forensic desk based in Cheltenham, UK. We audit commercial matchmaking black-boxes, document synthetic persona swarms, and expose automated romance fraud operations exploiting commercial dating networks.
    </p>

    <!-- 3 Editorial Pillars -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
      <div class="p-4 bg-[#FAF7F2] border border-slate-200">
        <span class="font-mono text-[10px] font-bold uppercase tracking-widest text-rose-700 block mb-1">
          PILLAR 01 // EMPIRICAL AUDIT
        </span>
        <h3 class="font-serif font-bold text-sm text-slate-900 mb-1">Heuristic Packet Analysis</h3>
        <p class="text-xs text-slate-600 leading-relaxed font-sans">
          Reverse-engineering matching algorithms, hidden ELO resets, and chat payload telemetry without corporate mediation.
        </p>
      </div>

      <div class="p-4 bg-[#FAF7F2] border border-slate-200">
        <span class="font-mono text-[10px] font-bold uppercase tracking-widest text-rose-700 block mb-1">
          PILLAR 02 // ZERO SPONSORSHIP
        </span>
        <h3 class="font-serif font-bold text-sm text-slate-900 mb-1">Strict Commercial Firewall</h3>
        <p class="text-xs text-slate-600 leading-relaxed font-sans">
          Zero paid ranking placements, PR agreements, or favorable safety reviews for dating platforms.
        </p>
      </div>

      <div class="p-4 bg-[#FAF7F2] border border-slate-200">
        <span class="font-mono text-[10px] font-bold uppercase tracking-widest text-rose-700 block mb-1">
          PILLAR 03 // SOURCE PROTECTION
        </span>
        <h3 class="font-serif font-bold text-sm text-slate-900 mb-1">Whistleblower Protocols</h3>
        <p class="text-xs text-slate-600 leading-relaxed font-sans">
          Confidential ingest of victim logs, bot scripts, and telemetric dumps under source anonymity.
        </p>
      </div>
    </div>

    <div class="text-xs sm:text-sm text-slate-700 leading-relaxed font-sans mb-6">
      If you have encountered synthetic bot clusters, coordinated romance scam funnels, or security vulnerabilities within any major dating platform, submit encrypted telemetry and documentation directly to our research desk at <span class="font-mono text-xs text-slate-900 font-bold bg-[#FAF7F2] border border-slate-300 px-2 py-0.5 rounded">desk@flirtcheck.site</span>.
    </div>

    <div class="pt-5 border-t border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="text-xs text-slate-500 font-sans">
        Need to cross-reference an unknown profile or domain against verified scam databases?
      </div>
      <a
        href="/go?source=independence_manifest&trigger=manifesto_cta&intent=verify_match"
        rel="nofollow sponsored"
        target="_blank"
        class="min-h-[44px] inline-flex items-center gap-1.5 text-xs font-mono font-bold text-slate-900 hover:text-rose-700 transition-colors uppercase tracking-wider underline underline-offset-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900"
      >
        <span>Access Verification Directory ↗</span>
      </a>
    </div>
  </div>
</section>
