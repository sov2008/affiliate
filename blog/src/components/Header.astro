---
import ForensicSearchModal from './ForensicSearchModal.astro';

interface Props {
  activePath?: string;
}

const { activePath = '/' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navItems = [
  { title: 'Investigations', href: '/#investigations' },
  { title: 'The Desk', href: '/desk' },
  { title: 'Methodology', href: '/#protocol' },
];
---

<header class="bg-[#FAF7F2] border-b border-slate-300 sticky top-0 z-40 backdrop-blur-md bg-opacity-95 transition-all">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between">
    <!-- Left: Editorial Branding -->
    <div class="flex items-center gap-3 shrink-0">
      <a href={`${base}/`} class="flex items-center gap-2.5 group" aria-label="FlirtCheck Forensic Desk Homepage">
        <img
          src="/images/logo.svg"
          alt="FlirtCheck Investigative Desk"
          class="h-9 sm:h-10 w-auto select-none group-hover:opacity-90 transition-opacity"
          width="280"
          height="40"
        />
      </a>
    </div>

    <!-- Center: Refined Gazette Navigation (3 Key Anchors) -->
    <nav class="hidden md:flex items-center gap-2 lg:gap-4 font-mono text-xs uppercase tracking-wider text-slate-600" aria-label="Main Navigation">
      {navItems.map(item => {
        const isActive = activePath === item.href || (item.href !== '/#investigations' && activePath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class:list={[
              "min-h-[44px] inline-flex items-center px-3 py-2 transition-colors",
              isActive
                ? "text-slate-900 font-bold border-b-2 border-slate-900"
                : "hover:text-slate-900 border-b-2 border-transparent"
            ]}
          >
            {item.title}
          </a>
        );
      })}
    </nav>

    <!-- Right: Search & Gazette Audit Action Button -->
    <div class="flex items-center gap-2.5 sm:gap-3 shrink-0">
      <!-- Quick Search Trigger -->
      <button
        type="button"
        id="openSearchBtn"
        aria-label="Open Search Index"
        class="min-h-[44px] min-w-[44px] flex items-center justify-center gap-2 text-slate-500 hover:text-slate-900 font-mono text-xs border border-slate-300 rounded bg-white hover:bg-slate-50 px-2.5 py-1.5 transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900"
      >
        <svg class="w-3.5 h-3.5 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="hidden sm:inline font-bold text-[10px] text-slate-500">Ctrl K</span>
      </button>

      <!-- Restrained Newspaper Action Button -->
      <a
        href="/go?source=header&trigger=audit_cta&intent=profile_audit"
        target="_blank"
        rel="nofollow sponsored"
        class="min-h-[44px] inline-flex items-center justify-center bg-slate-900 text-white font-mono text-xs font-bold px-4 py-2 rounded hover:bg-slate-800 transition-colors uppercase tracking-wider focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 shadow-none"
      >
        Audit Profile ↗
      </a>
    </div>
  </div>

  <!-- Global Forensic Search Modal -->
  <ForensicSearchModal />
</header>
