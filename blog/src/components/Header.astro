---
interface Props {
  activePath?: string;
}

const { activePath = '/blog' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-slate-900/80 border-b border-slate-800/80 transition-all duration-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href={`${base}/`} class="flex items-center gap-3 group">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-rose-500 via-pink-500 to-amber-400 p-[2px] shadow-lg shadow-rose-500/20 group-hover:scale-105 transition-transform duration-300">
        <div class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center">
          <svg class="w-5 h-5 text-rose-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xl font-black tracking-tight text-white font-sans">Flirt<span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-pink-500">Check</span></span>
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-rose-500/10 text-rose-400 border border-rose-500/20">
            RADAR 2026
          </span>
        </div>
        <p class="text-[11px] text-slate-400 font-medium">Dating Safety & Profile Verification</p>
      </div>
    </a>

    <!-- Navigation -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
      <a href={`${base}/`} class="text-slate-300 hover:text-white transition-colors">Articles</a>
      <a href={`${base}/#safety-quiz`} class="text-slate-300 hover:text-white transition-colors">Profile Quiz</a>
      <a href="/go" rel="nofollow sponsored" target="_blank" class="text-slate-300 hover:text-white transition-colors">Verified Matches</a>
    </nav>

    <!-- Header Action CTA -->
    <div class="flex items-center gap-3">
      <a
        href="/go"
        rel="nofollow sponsored"
        target="_blank"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold text-white bg-gradient-to-r from-rose-500 to-pink-600 hover:from-rose-600 hover:to-pink-700 shadow-md shadow-rose-500/25 transition-all duration-200 hover:scale-[1.02] active:scale-[0.98]"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
        <span>Run Safety Check</span>
      </a>
    </div>
  </div>
</header>
