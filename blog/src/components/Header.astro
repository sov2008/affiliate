---
import ForensicSearchModal from './ForensicSearchModal.astro';

interface Props {
  activePath?: string;
}

const { activePath = '/' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navItems = [
  { title: 'The Desk', href: '/desk' },
  { title: 'Algorithms', href: '/#algo-mechanics' },
  { title: 'Psychology', href: '/#modern-psychology' },
  { title: 'Dialogue', href: '/#digital-dialogue' },
  { title: 'First Dates', href: '/#first-dates' },
  { title: 'Scam Dossier', href: '/#safety-scams' },
];
---

<header class="sticky top-0 z-50 bg-[#FAF7F2]/95 backdrop-blur-md border-b-2 border-slate-900 transition-all duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <!-- Brand Logo: FlirtCheck Forensic Desk -->
    <a href={`${base}/`} class="flex items-center gap-3 group shrink-0" aria-label="FlirtCheck Forensic Desk Homepage">
      <img
        src="/images/logo.svg"
        alt="FlirtCheck Investigative Desk · Cheltenham"
        class="h-9 w-auto select-none group-hover:opacity-95 transition-opacity"
        width="260"
        height="36"
      />
    </a>

    <!-- Desktop Navigation Menu -->
    <nav class="hidden lg:flex items-center gap-1 xl:gap-2 text-xs font-black uppercase font-mono tracking-wider">
      {navItems.map(item => {
        const isActive = activePath === item.href || activePath.startsWith(`${item.href}/`);
        return (
          <a
            href={item.href}
            class:list={[
              "px-2.5 py-1 rounded border transition-all duration-150",
              isActive
                ? "bg-slate-900 text-white border-slate-900 shadow-[2px_2px_0px_0px_#0f172a]"
                : "border-transparent text-slate-800 hover:text-rose-700 hover:border-slate-900 hover:bg-white hover:shadow-[2px_2px_0px_0px_#0f172a]"
            ]}
          >
            {item.title}
          </a>
        );
      })}
    </nav>

    <!-- Header Action CTA & Search Trigger -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <!-- Quick Search Modal Trigger Button -->
      <button
        type="button"
        id="openSearchBtn"
        aria-label="Open Search Index"
        class="min-h-[44px] min-w-[44px] flex items-center justify-center font-mono text-xs font-bold text-slate-800 hover:text-rose-700 border border-slate-900 rounded bg-[#FFFDF9] hover:bg-[#FAF7F2] shadow-[2px_2px_0px_0px_#0f172a] px-2.5 py-2 transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900"
      >
        <svg class="w-4 h-4 text-slate-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="hidden sm:inline-block ml-1.5 px-1.5 py-0.5 text-[10px] bg-slate-100 border border-slate-300 rounded font-mono font-bold text-slate-700">
          Ctrl+K
        </span>
      </button>

      <a
        href="/#safety-quiz"
        class="min-h-[44px] inline-flex items-center gap-1.5 sm:gap-2 px-3 sm:px-4 py-2 rounded text-xs font-black text-white bg-rose-700 hover:bg-rose-800 border-2 border-slate-900 shadow-[3px_3px_0px_0px_#0f172a] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[2px_2px_0px_0px_#0f172a] active:translate-x-[3px] active:translate-y-[3px] active:shadow-none transition-all duration-150 uppercase tracking-wider font-mono focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-700"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
        <span class="hidden md:inline">LAUNCH PROFILE RADAR →</span>
        <span class="md:hidden">RADAR →</span>
      </a>
    </div>
  </div>

  <!-- Mobile Category Navigation Sub-bar -->
  <div class="lg:hidden border-t border-slate-900/10 bg-[#F4EFE6] px-4 py-2 overflow-x-auto no-scrollbar">
    <div class="flex items-center gap-2 min-w-max text-[11px] font-mono font-black uppercase">
      {navItems.map(item => {
        const isActive = activePath === item.href || activePath.startsWith(`${item.href}/`);
        return (
          <a
            href={item.href}
            class:list={[
              "px-2.5 py-1 rounded border transition-all duration-150",
              isActive
                ? "bg-slate-900 text-white border-slate-900 shadow-[1px_1px_0px_0px_#0f172a]"
                : "bg-white text-slate-800 border-slate-900/30 hover:border-slate-900 hover:text-rose-700"
            ]}
          >
            {item.title}
          </a>
        );
      })}
    </div>
  </div>

  <!-- Global Forensic Search Modal -->
  <ForensicSearchModal />
</header>
