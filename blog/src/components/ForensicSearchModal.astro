---
// ForensicSearchModal.astro - Fast, lightweight modal index search (Cheltenham Bureau Standard)
---

<div
  id="forensicSearchModal"
  class="hidden fixed inset-0 z-50 bg-slate-900/80 backdrop-blur-sm flex items-start justify-center pt-16 sm:pt-24 px-4 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-label="Forensic Dossier Search"
>
  <div class="bg-[#FFFDF9] border-2 border-slate-900 w-full max-w-2xl rounded-lg shadow-[8px_8px_0px_0px_#0f172a] overflow-hidden my-auto sm:my-0 transition-transform">
    <!-- Modal Header / Search Bar -->
    <div class="flex items-center bg-[#FAF7F2] border-b-2 border-slate-900 px-4 py-2.5">
      <span class="font-mono text-xs font-black text-rose-700 select-none mr-3">[SEARCH]</span>
      <input
        type="text"
        id="forensicSearchInput"
        placeholder="Query dossiers by keyword, victim pattern, or dating algorithm..."
        autocomplete="off"
        class="min-h-[48px] font-mono text-sm bg-transparent border-none focus:outline-none w-full text-slate-900 placeholder:text-slate-500"
      />
      <button
        type="button"
        id="closeSearchBtn"
        aria-label="Close search modal"
        class="min-h-[44px] min-w-[44px] flex items-center justify-center font-mono text-xs font-bold text-slate-700 hover:text-rose-700 cursor-pointer transition-colors"
      >
        [ESC]
      </button>
    </div>

    <!-- Navigation & Shortcut Hint Strip -->
    <div class="bg-slate-100 border-b border-slate-300 px-4 py-1.5 flex justify-between items-center text-[10px] font-mono text-slate-600 font-bold uppercase tracking-wider">
      <span>CHELTENHAM ARCHIVAL REGISTRY</span>
      <span class="hidden sm:inline">Press ESC to exit · ↑↓ to navigate · Enter to open</span>
    </div>

    <!-- Search Results List -->
    <div id="searchResultsContainer" class="p-3 max-h-[60vh] overflow-y-auto divide-y divide-slate-200">
      <div id="searchEmptyState" class="py-8 text-center text-xs font-mono text-slate-500">
        Type query to search across all published forensic investigations...
      </div>
      <div id="searchNoResults" class="hidden py-8 text-center text-xs font-mono text-slate-700">
        NO MATCHING DOSSIERS FOUND IN THE CHELTENHAM REGISTRY.
      </div>
      <ul id="searchResultsList" class="space-y-1.5 list-none m-0 p-0"></ul>
    </div>
  </div>
</div>

<script>
  interface SearchItem {
    slug: string;
    title: string;
    category: string;
    description: string;
    tags: string[];
    pubDate: string;
  }

  function initForensicSearch() {
    const modal = document.getElementById('forensicSearchModal');
    const input = document.getElementById('forensicSearchInput') as HTMLInputElement | null;
    const closeBtn = document.getElementById('closeSearchBtn');
    const openBtn = document.getElementById('openSearchBtn');
    const emptyState = document.getElementById('searchEmptyState');
    const noResults = document.getElementById('searchNoResults');
    const resultsList = document.getElementById('searchResultsList');

    if (!modal || !input || !resultsList) return;

    let searchIndex: SearchItem[] = [];
    let isIndexLoaded = false;
    let selectedIndex = -1;

    async function loadIndex() {
      if (isIndexLoaded) return;
      try {
        let res = await fetch('/search-index.json');
        if (!res.ok) {
          res = await fetch('/api/search-index.json');
        }
        if (res.ok) {
          searchIndex = await res.json();
          isIndexLoaded = true;
        }
      } catch (e) {
        console.error('Failed to load search index', e);
      }
    }

    function openModal() {
      loadIndex();
      modal?.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
      setTimeout(() => {
        input?.focus();
        input?.select();
      }, 50);
    }

    function closeModal() {
      modal?.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
      if (input) input.value = '';
      if (resultsList) resultsList.innerHTML = '';
      emptyState?.classList.remove('hidden');
      noResults?.classList.add('hidden');
      selectedIndex = -1;
    }

    function renderResults(results: SearchItem[]) {
      if (!resultsList || !emptyState || !noResults) return;

      resultsList.innerHTML = '';
      selectedIndex = -1;

      if (results.length === 0) {
        emptyState.classList.add('hidden');
        noResults.classList.remove('hidden');
        return;
      }

      emptyState.classList.add('hidden');
      noResults.classList.add('hidden');

      results.slice(0, 6).forEach((item, idx) => {
        const li = document.createElement('li');
        li.setAttribute('data-result-index', String(idx));
        li.className = 'search-item group block p-3 rounded border border-transparent hover:border-slate-900 hover:bg-[#FAF7F2] transition-all cursor-pointer';

        const categoryTag = item.category ? item.category.toUpperCase() : 'INVESTIGATION';
        li.innerHTML = `
          <a href="/${item.slug}/" class="block outline-none">
            <div class="flex items-center justify-between gap-2 mb-1">
              <span class="font-mono text-[10px] font-bold text-rose-700 tracking-wider uppercase">
                [${categoryTag}]
              </span>
              <span class="font-mono text-[10px] text-slate-500 font-bold">
                ${item.pubDate || ''}
              </span>
            </div>
            <h4 class="font-serif font-bold text-sm text-slate-900 group-hover:text-rose-700 transition-colors leading-snug">
              ${item.title}
            </h4>
            <p class="font-sans text-xs text-slate-600 line-clamp-1 mt-1">
              ${item.description || ''}
            </p>
          </a>
        `;
        resultsList.appendChild(li);
      });
    }

    function handleSearch() {
      const query = input?.value.trim().toLowerCase() || '';
      if (!query) {
        if (resultsList) resultsList.innerHTML = '';
        emptyState?.classList.remove('hidden');
        noResults?.classList.add('hidden');
        return;
      }

      const matches = searchIndex.filter(item => {
        const titleMatch = item.title.toLowerCase().includes(query);
        const descMatch = item.description?.toLowerCase().includes(query);
        const tagMatch = item.tags?.some(t => t.toLowerCase().includes(query));
        const catMatch = item.category?.toLowerCase().includes(query);
        return titleMatch || descMatch || tagMatch || catMatch;
      });

      renderResults(matches);
    }

    function updateSelection() {
      const items = resultsList?.querySelectorAll('.search-item') || [];
      items.forEach((el, idx) => {
        if (idx === selectedIndex) {
          el.classList.add('bg-[#FAF7F2]', 'border-slate-900', 'shadow-[2px_2px_0px_0px_#0f172a]');
          el.scrollIntoView({ block: 'nearest' });
        } else {
          el.classList.remove('bg-[#FAF7F2]', 'border-slate-900', 'shadow-[2px_2px_0px_0px_#0f172a]');
        }
      });
    }

    // Event Listeners
    input.addEventListener('input', handleSearch);

    input.addEventListener('keydown', (e) => {
      const items = resultsList?.querySelectorAll('.search-item') || [];
      if (items.length === 0) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = (selectedIndex + 1) % items.length;
        updateSelection();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = (selectedIndex - 1 + items.length) % items.length;
        updateSelection();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (selectedIndex >= 0 && selectedIndex < items.length) {
          const anchor = items[selectedIndex].querySelector('a');
          if (anchor) anchor.click();
        } else if (items.length > 0) {
          const firstAnchor = items[0].querySelector('a');
          if (firstAnchor) firstAnchor.click();
        }
      }
    });

    closeBtn?.addEventListener('click', closeModal);
    openBtn?.addEventListener('click', openModal);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    window.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (modal.classList.contains('hidden')) {
          openModal();
        } else {
          closeModal();
        }
      } else if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initForensicSearch);
  initForensicSearch();
</script>
