---
import InlineQuiz from './InlineQuiz.astro';

interface Props {
  slug?: string;
  variant?: 'inline' | 'sticky' | 'full';
  quizId?: string;
  title?: string;
  subtitle?: string;
}

const {
  slug = 'dating-safety-guide',
  quizId = 'quiz-' + Math.random().toString(36).substring(2, 8),
  title = '⚡ Quick Scan: Is Your Dating Match Real?',
  subtitle = 'Instant cross-reference against verified anti-bot database and spoofing patterns.'
} = Astro.props;
---

<InlineQuiz slug={slug} quizId={quizId} title={title} subtitle={subtitle} />
