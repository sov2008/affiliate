  <!-- WIDGET 5: Public Venue Security Protocol (RaynaTours - Safe First Dates) -->
  <div class="bg-white border border-slate-300 p-4">
    <div class="flex items-center justify-between gap-1 mb-2">
      <span class="text-[9px] font-mono text-slate-700 bg-slate-100 border border-slate-300 px-1.5 py-0.5 uppercase tracking-widest font-bold">
