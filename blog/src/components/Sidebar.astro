---
interface Props {
  activeCategory?: string;
  postCount?: number;
  categoryCounts?: Record<string, number>;
}

const {
  activeCategory = 'all',
  postCount = 39,
  categoryCounts = {}
} = Astro.props;
---

<aside class="w-full lg:w-72 shrink-0 space-y-6 lg:sticky lg:top-24 self-start">
  
  <!-- WIDGET 1: Compact Arthur Vance Dossier -->
  <div class="bg-white border border-slate-300 rounded-none sm:rounded-sm p-4">
    <div class="flex items-center gap-3 pb-3 border-b border-slate-200">
      <img
        src="/images/author/arthur-vance-avatar.webp"
        alt="Arthur Vance"
        class="w-12 h-12 rounded border border-slate-300 object-cover shrink-0"
        loading="lazy"
        width="48"
        height="48"
      />
      <div class="min-w-0">
        <h3 class="font-serif font-bold text-sm text-slate-900 truncate">
          <a href="/desk" class="hover:text-rose-700">Arthur Vance</a>
        </h3>
        <span class="text-[10px] font-mono text-slate-500 uppercase tracking-wider block truncate">
          Cheltenham Bureau · Station 04
        </span>
      </div>
    </div>
    
    <p class="text-xs text-slate-600 leading-relaxed mt-2.5 font-sans">
      Deconstructing algorithmic friction, bot syndicates, and digital deception across dating platforms.
    </p>

    <div class="mt-3 pt-2.5 border-t border-slate-100 flex items-center justify-between text-xs font-mono">
      <a
        href="/desk"
        class="min-h-[44px] inline-flex items-center font-bold text-slate-900 hover:text-rose-700 underline underline-offset-4 transition-colors"
      >
        Bureau Manifesto & Arsenal →
      </a>
      <span class="text-[10px] text-emerald-700 font-bold uppercase">● Active</span>
    </div>
  </div>

  <!-- WIDGET 2: Monochrome Service Telemetry Monitoring -->
  <div class="bg-white border border-slate-300 rounded-none sm:rounded-sm p-4">
    <div class="flex items-center justify-between pb-2 border-b border-slate-200 mb-3 font-mono text-xs font-bold">
      <div class="flex items-center gap-1.5 text-slate-900 uppercase tracking-wider">
        <span class="w-1.5 h-1.5 rounded-full bg-slate-800"></span>
        <span>Telemetry Monitor</span>
      </div>
      <span class="text-[10px] text-slate-500 uppercase font-medium">Station 04</span>
    </div>

    <div class="space-y-2 font-mono text-xs">
      <div class="p-2 bg-[#FAF7F2] border border-slate-200 rounded-none sm:rounded-sm">
        <div class="text-[10px] text-slate-500 uppercase">Tinder ELO Pipeline</div>
        <div class="font-bold text-slate-900">ANOMALOUS (HIGH FRICTION)</div>
      </div>
      <div class="p-2 bg-[#FAF7F2] border border-slate-200 rounded-none sm:rounded-sm">
        <div class="text-[10px] text-slate-500 uppercase">Diffusion Profile Clones</div>
        <div class="font-bold text-slate-900">SURGING (+42%)</div>
      </div>
      <div class="p-2 bg-[#FAF7F2] border border-slate-200 rounded-none sm:rounded-sm">
        <div class="text-[10px] text-slate-500 uppercase">Registry Status</div>
        <div class="font-bold text-slate-900">{postCount} DOSSIERS FILED</div>
      </div>
    </div>
  </div>

  <!-- WIDGET 3: Official Bulletin (CPA Smartlink Integration) -->
  <div class="bg-[#FAF7F2] border border-slate-300 rounded-none sm:rounded-sm p-4 relative">
    <span class="text-[9px] font-mono text-slate-500 uppercase tracking-widest block mb-1 font-bold">
      OFFICIAL NOTICE // VERIFICATION DESK
    </span>
    <h4 class="font-serif font-bold text-sm text-slate-900 leading-snug">
      Bypass Algorithmic Dating Casino
    </h4>
    <p class="text-xs text-slate-600 mt-2 leading-relaxed font-sans">
      Commercial dating platforms engineer artificial friction to prolong subscriptions. Access ID-verified local singles ready for unscripted meetings.
    </p>

    <div class="mt-4 pt-3 border-t border-slate-200">
      <a 
        href="/go?source=sidebar_ad&trigger=classified_ad&intent=verified_singles"
        id="sidebarAdCta"
        rel="nofollow sponsored"
        target="_blank"
        class="min-h-[44px] w-full flex items-center justify-center text-center px-4 py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-mono font-bold text-xs uppercase rounded transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 cursor-pointer shadow-none"
      >
        VERIFY CLEARANCE ↗
      </a>
      <span class="block text-center text-[10px] font-mono text-slate-500 font-medium mt-2">
        Zero Gamification · 100% ID-Verified Members
      </span>
    </div>
  </div>

</aside>

<script>
  // Attach session CID to classified ad CTA for flawless attribution
  function initSidebarCta() {
    const cta = document.getElementById('sidebarAdCta') as HTMLAnchorElement | null;
    if (!cta) return;
    let cid = '';
    try {
      cid = sessionStorage.getItem('flirtcheck_cid') || '';
      if (!cid) {
        cid = 'fc_' + Math.random().toString(36).substring(2, 9) + '_' + Date.now().toString(36);
        sessionStorage.setItem('flirtcheck_cid', cid);
      }
    } catch {
      cid = 'fc_' + Date.now().toString(36);
    }
    cta.href = `/go?source=sidebar_ad&trigger=classified_ad&intent=verified_singles&cid=${encodeURIComponent(cid)}`;
  }
  document.addEventListener('DOMContentLoaded', initSidebarCta);
  initSidebarCta();
</script>
