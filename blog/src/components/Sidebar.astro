---
import { CATEGORIES_METADATA, CategoryEnum, type Category } from '../content.config';

interface Props {
  activeCategory?: string;
  postCount?: number;
  categoryCounts?: Record<string, number>;
}

const {
  activeCategory = 'all',
  postCount = 39,
  categoryCounts = {}
} = Astro.props;

const categories = [
  { id: 'algo-mechanics', title: '[•] ALGO MECHANICS', href: '/category/algo-mechanics' },
  { id: 'modern-psychology', title: '[•] MODERN PSYCHOLOGY', href: '/category/modern-psychology' },
  { id: 'digital-dialogue', title: '[•] DIGITAL DIALOGUE', href: '/category/digital-dialogue' },
  { id: 'first-dates', title: '[•] OFFLINE DATES', href: '/category/first-dates' },
  { id: 'safety-dossier', title: '[•] SAFETY & SCAMS', href: '/category/safety-dossier' },
  { id: 'romantic-essays', title: '[•] ROMANTIC ESSAYS', href: '/category/romantic-essays' },
];
---

<aside class="w-full lg:w-80 shrink-0 space-y-6 lg:sticky lg:top-20 self-start">
  
  <!-- WIDGET 1: Author Dossier -->
  <div class="bg-white border-2 border-slate-900 rounded-xl p-4 shadow-[4px_4px_0px_0px_#0f172a]">
    <div class="flex items-center gap-3 pb-3 border-b-2 border-slate-900">
      <img
        src="/images/author/arthur-vance-avatar.webp"
        alt="Arthur Vance"
        class="w-12 h-12 rounded-lg border-2 border-slate-900 object-cover shadow-[2px_2px_0px_0px_#0f172a]"
        loading="lazy"
      />
      <div>
        <h3 class="font-black text-sm text-slate-900 uppercase">
          <a href="/desk" class="hover:text-rose-600 hover:underline">Arthur Vance</a>
        </h3>
        <span class="text-[10px] font-mono text-rose-600 font-bold uppercase tracking-wide">Lead Forensic Investigator</span>
      </div>
    </div>
    <p class="text-xs text-slate-600 leading-relaxed mt-3">
      Investigating synthetic intimacy, algorithmic traps, and commercial dating funnels from Cheltenham, UK.
    </p>
    <div class="mt-3 pt-2 border-t border-slate-200 text-[10px] font-mono text-slate-500 flex justify-between font-bold">
      <a href="/desk" class="text-slate-900 hover:text-rose-600 underline">THE DESK & MANIFESTO →</a>
      <span class="text-emerald-700">● ACTIVE</span>
    </div>
  </div>

  <!-- WIDGET 2: Navigation & Category Stamped Index -->
  <div class="bg-white border-2 border-slate-900 rounded-xl p-4 shadow-[4px_4px_0px_0px_#0f172a]">
    <div class="flex justify-between items-center mb-3 pb-2 border-b border-slate-900">
      <span class="font-black text-xs text-slate-900 uppercase tracking-wider">DOSSIER INDEX</span>
      <span class="text-[10px] font-mono bg-amber-100 px-1.5 py-0.5 border border-slate-900 font-bold shadow-[1px_1px_0px_0px_#0f172a]">VOL. 2026</span>
    </div>
    
    <nav class="space-y-1.5 text-xs font-bold uppercase">
      <!-- All Dispatches Button / Link -->
      <a
        href="/#feed"
        data-sidebar-filter="all"
        class:list={[
          "flex justify-between items-center p-2 rounded-lg border border-slate-900 transition-all cursor-pointer",
          activeCategory === 'all'
            ? "bg-slate-900 text-white shadow-[2px_2px_0px_0px_#0f172a]"
            : "bg-white hover:bg-amber-50 text-slate-900"
        ]}
      >
        <span>[•] ALL DISPATCHES</span>
        <span class="font-mono text-[10px] text-amber-300 font-black">{postCount}</span>
      </a>

      <!-- Category Links -->
      {categories.map((cat) => {
        const count = categoryCounts[cat.id] ?? 0;
        const isActive = activeCategory === cat.id;
        return (
          <a
            href={cat.href}
            data-sidebar-filter={cat.id}
            class:list={[
              "flex justify-between items-center p-2 rounded-lg border border-slate-900 transition-colors cursor-pointer",
              isActive
                ? "bg-slate-900 text-white shadow-[2px_2px_0px_0px_#0f172a]"
                : "bg-white hover:bg-amber-50 text-slate-900"
            ]}
          >
            <span>{cat.title}</span>
            <span class:list={[
              "font-mono text-[10px] font-bold",
              isActive ? "text-amber-300" : "text-slate-500"
            ]}>
              {count}
            </span>
          </a>
        );
      })}
    </nav>
  </div>

  <!-- WIDGET 3: Vintage Classified Ad (CPA Smartlink Integration) -->
  <div class="bg-[#FFFDF7] border-2 border-dashed border-slate-900 rounded-xl p-4 shadow-[4px_4px_0px_0px_#0f172a] relative overflow-hidden">
    <div class="absolute -right-6 top-3 bg-rose-600 text-white text-[9px] font-black uppercase px-6 py-0.5 rotate-45 border-y border-slate-900 shadow-sm pointer-events-none">
      VERIFIED
    </div>
    
    <span class="text-[9px] font-mono text-slate-500 uppercase tracking-widest block mb-1 font-bold">CLASSIFIED AD // N° 402 • UNMASKED</span>
    <h4 class="font-black text-sm text-slate-900 uppercase leading-snug">
      Tired of Corporate Slot-Machine Swipes?
    </h4>
    <p class="text-xs text-slate-600 mt-2 leading-relaxed">
      Dating conglomerates engineer algorithms to keep you paying and swiping. Bypass corporate dopamine traps and connect with ID-verified local singles ready for unscripted meetings.
    </p>

    <div class="mt-4 pt-3 border-t border-slate-300">
      <a 
        href="/go?source=sidebar_ad&trigger=classified_ad&intent=verified_singles"
        id="sidebarAdCta"
        rel="nofollow sponsored"
        target="_blank"
        class="block text-center py-2.5 px-3 bg-rose-600 hover:bg-rose-500 active:translate-x-[1px] active:translate-y-[1px] text-white font-black text-xs uppercase rounded-lg border-2 border-slate-900 shadow-[2px_2px_0px_0px_#0f172a] tracking-wider transition-all cursor-pointer"
      >
        BREAK OUT OF THE CASINO &rarr;
      </a>
      <span class="block text-center text-[9px] font-mono text-slate-500 font-medium mt-1.5">No Gamification • 100% ID-Verified Members</span>
    </div>
  </div>

  <!-- WIDGET 4: Live Radar Telemetry Status -->
  <div class="bg-white border-2 border-slate-900 rounded-xl p-3.5 shadow-[4px_4px_0px_0px_#0f172a] flex items-center justify-between text-xs font-mono">
    <div class="flex items-center gap-2">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-pulse absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
      </span>
      <span class="font-bold text-slate-800 text-[11px]">RADAR TELEMETRY</span>
    </div>
    <span class="text-[10px] text-slate-500 font-bold">ACCURACY: 98.4%</span>
  </div>

</aside>

<script>
  // Attach session CID to classified ad CTA for flawless attribution
  function initSidebarCta() {
    const cta = document.getElementById('sidebarAdCta') as HTMLAnchorElement | null;
    if (!cta) return;
    let cid = '';
    try {
      cid = sessionStorage.getItem('flirtcheck_cid') || '';
      if (!cid) {
        cid = 'fc_' + Math.random().toString(36).substring(2, 9) + '_' + Date.now().toString(36);
        sessionStorage.setItem('flirtcheck_cid', cid);
      }
    } catch {
      cid = 'fc_' + Date.now().toString(36);
    }
    cta.href = `/go?source=sidebar_ad&trigger=classified_ad&intent=verified_singles&cid=${encodeURIComponent(cid)}`;
  }
  document.addEventListener('DOMContentLoaded', initSidebarCta);
  initSidebarCta();
</script>
