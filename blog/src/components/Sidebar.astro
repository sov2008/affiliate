---
import AuthorCard from './AuthorCard.astro';

interface Props {
  activeCategory?: string;
  postCount?: number;
  categoryCounts?: Record<string, number>;
}

const {
  activeCategory = 'all',
  postCount = 39,
  categoryCounts = {}
} = Astro.props;
---

<aside class="w-full lg:w-72 shrink-0 space-y-6 lg:sticky lg:top-24 self-start">

  <!-- WIDGET 1: Arthur Vance Investigator Dossier Card (Unified Component) -->
  <AuthorCard />

  <!-- WIDGET 2: Official Classified Bulletin (Verified Partner Dispatch) -->
  <div class="bg-[#FAF7F2] border-2 border-slate-900 rounded-none p-4 relative shadow-[4px_4px_0px_0px_#0f172a]">
    <div class="flex items-center justify-between gap-1 mb-2">
      <span class="text-[9px] font-mono text-slate-900 bg-amber-100 border border-slate-900 px-1.5 py-0.5 uppercase tracking-widest font-bold">
        CLASSIFIED BULLETIN // DESK 04
      </span>
      <span class="text-[9px] font-mono text-emerald-700 font-bold flex items-center gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
        VERIFIED
      </span>
    </div>
    
    <h4 class="font-serif font-black text-base text-slate-900 leading-snug tracking-tight">
      Bypass the Swiping Casino: Human-Verified Singles Network
    </h4>
    
    <p class="text-xs text-slate-600 mt-2 leading-relaxed font-sans">
      Commercial dating apps engineer frustration loops to extend paid billing. Connect directly with ID-confirmed, relationship-minded singles vetted by human moderators.
    </p>

    <div class="mt-3.5 space-y-1.5 font-mono text-[10px] text-slate-700 border-t border-slate-200 pt-2.5">
      <div class="flex items-center gap-2">
        <span class="text-emerald-700 font-bold">✓</span>
        <span>100% Manual Profile Inspection (No Bot Farms)</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-emerald-700 font-bold">✓</span>
        <span>Zero Algorithmic Shadowbans or Paywalls</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-emerald-700 font-bold">✓</span>
        <span>Curated for Mature Singles in the 30+ Bracket</span>
      </div>
    </div>

    <div class="mt-4 pt-3 border-t border-slate-200">
      <a
        href="/go?offer=admitad_49070&source=sidebar_ad&trigger=classified_bulletin&intent=verified_singles&sub1=sidebar_ad&sub2=verified_dating&sub3=classified_bulletin"
        id="sidebarAdCta"
        rel="nofollow sponsored"
        target="_blank"
        class="min-h-[44px] w-full flex items-center justify-center text-center px-4 py-2.5 bg-rose-700 hover:bg-rose-800 active:translate-x-0.5 active:translate-y-0.5 text-white font-mono font-bold text-xs uppercase rounded-none transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-700 cursor-pointer border border-slate-900 shadow-[2px_2px_0px_0px_#0f172a] hover:shadow-none"
      >
        ACCESS VERIFIED NETWORK ↗
      </a>
      <span class="block text-center text-[9px] font-mono text-slate-500 font-medium mt-2">
        Official Partner Gateway Clearance · 18+ Verified Only
      </span>
    </div>
  </div>

  <!-- WIDGET 3: Field Investigation Protocol -->
  <div class="bg-white border border-slate-300 rounded-none sm:rounded-sm overflow-hidden">
    <div class="flex items-center gap-2 px-4 py-3 border-b border-slate-200 bg-[#FAF7F2]">
      <span class="w-1.5 h-1.5 rounded-full bg-rose-700 shrink-0"></span>
      <span class="font-mono text-[10px] font-bold uppercase tracking-widest text-slate-900">
        Field Protocol // Standards
      </span>
    </div>
    <div class="p-4 space-y-3 font-mono text-[11px] text-slate-600">
      <div class="flex items-start gap-2">
        <span class="text-rose-700 font-bold select-none">•</span>
        <div>
          <span class="text-slate-900 font-bold">Zero Synthetic Policy:</span>
          <p class="font-sans text-xs text-slate-600 mt-0.5">All field reports must represent authentic observations. Automated heuristics reject promotional payloads.</p>
        </div>
      </div>
      <div class="flex items-start gap-2">
        <span class="text-rose-700 font-bold select-none">•</span>
        <div>
          <span class="text-slate-900 font-bold">Evidence Integrity:</span>
          <p class="font-sans text-xs text-slate-600 mt-0.5">Logs are cryptographically hashed and indexed to prevent duplications and spam loops.</p>
        </div>
      </div>
      <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-[10px] text-slate-500">
        <span>STATUS: ACTIVE INGEST</span>
        <span class="text-emerald-700 font-bold">● ONLINE</span>
      </div>
    </div>
  </div>

</aside>

<script>
  // Attach session CID to classified ad CTA for flawless attribution
  function initSidebarCta() {
    const cta = document.getElementById('sidebarAdCta') as HTMLAnchorElement | null;
    if (!cta) return;
    let cid = '';
    try {
      cid = sessionStorage.getItem('flirtcheck_cid') || '';
      if (!cid) {
        cid = 'fc_' + Math.random().toString(36).substring(2, 9) + '_' + Date.now().toString(36);
        sessionStorage.setItem('flirtcheck_cid', cid);
      }
    } catch {
      cid = 'fc_' + Date.now().toString(36);
    }
    try {
      const url = new URL(cta.href, window.location.origin);
      url.searchParams.set('cid', cid);
      cta.href = url.toString();
    } catch {
      cta.href += `&cid=${encodeURIComponent(cid)}`;
    }
  }
  document.addEventListener('DOMContentLoaded', initSidebarCta);
  initSidebarCta();
</script>
