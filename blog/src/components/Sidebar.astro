---
import AuthorCard from './AuthorCard.astro';

interface Props {
  activeCategory?: string;
  postCount?: number;
  categoryCounts?: Record<string, number>;
}

const {
  activeCategory = 'all',
  postCount = 39,
  categoryCounts = {}
} = Astro.props;
---

<aside class="w-full lg:w-72 shrink-0 space-y-6 self-start">

