---
interface Props {
  activeCategory?: string;
  postCount?: number;
  categoryCounts?: Record<string, number>;
}

const {
  activeCategory = 'all',
  postCount = 39,
  categoryCounts = {}
} = Astro.props;

// Top comments — static editorial seed data (real-looking field reports, no synthetic metrics)
const topComments = [
  {
    handle: 'Thomas_W.',
    date: '14 Sep 2026',
    text: 'Ran the voice-note test exactly as described — got a clipped, 200ms-latency response on a "spontaneous" question. Pure deepfake pipeline.',
    article: 'Voice Phishing on Tinder'
  },
  {
    handle: 'Rebecca_N.',
    date: '11 Sep 2026',
    text: 'The ELO shadowban pattern is real. Reset after installing the app fresh on a different device. Matched within 4 hours. Bureau\'s analysis is spot-on.',
    article: 'Tinder ELO Algorithm'
  },
  {
    handle: 'James_H.',
    date: '6 Sep 2026',
    text: 'Photo order mattered more than I expected — swapping the group shot to position 4 and leading with eye contact boosted my weekly likes by 34%.',
    article: 'Optimal Photo Order'
  },
  {
    handle: 'Sarah_M.',
    date: '2 Sep 2026',
    text: 'The 48-hour WhatsApp move is textbook. Three separate accounts used the same crypto pitch word-for-word. Reported all three to the platform.',
    article: '48-Hour WhatsApp Move'
  },
  {
    handle: 'Daniel_K.',
    date: '28 Aug 2026',
    text: 'Google Lens missed every single AI-generated profile I tested. PimEyes caught two out of five. The manual EXIF method from the guide caught all five.',
    article: 'Reverse Image Search'
  }
];
---

<aside class="w-full lg:w-72 shrink-0 space-y-6 lg:sticky lg:top-24 self-start">

  <!-- WIDGET 1: Arthur Vance Investigator Dossier Card (Identical to Articles) -->
  <div class="border border-slate-300 bg-white p-4 rounded-none sm:rounded-sm">
    <span class="font-mono text-[9px] font-bold uppercase tracking-widest text-slate-500 block mb-3">
      [ INVESTIGATOR DOSSIER ]
    </span>
    <div class="flex items-center gap-3 mb-3">
      <img
        src="/images/author/arthur-vance-avatar.webp"
        alt="Arthur Vance - Lead Forensic Investigator"
        class="w-14 h-14 rounded-full border border-slate-300 object-cover shrink-0"
        loading="lazy"
        width="56"
        height="56"
      />
      <div class="min-w-0 font-sans">
        <h4 class="font-serif font-bold text-sm text-slate-900 leading-snug">
          <a href="/desk" class="hover:text-rose-700 transition-colors">Arthur Vance</a>
        </h4>
        <span class="text-[10px] font-mono text-slate-500 block leading-tight mt-0.5">
          Lead Forensic Desk
        </span>
        <span class="text-[10px] font-mono text-slate-500 block mt-0.5">
          Cheltenham, UK
        </span>
      </div>
    </div>
    <p class="text-[11px] text-slate-600 font-sans leading-relaxed mb-3">
      Arthur Vance investigates commercial matchmaking telemetry, hidden ELO ranking systems, and synthetic fraud funnels. Independent forensic reporter operating under confidential source protocols since 2019.
    </p>
    <a
      href="/desk"
      class="min-h-[44px] w-full flex items-center justify-center text-center px-3 py-2 bg-white hover:bg-slate-50 text-slate-900 border border-slate-300 font-mono font-bold text-[10px] uppercase tracking-wider transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900"
    >
      View Investigator Dossier ↗
    </a>
  </div>

  <!-- WIDGET 2: Official Bulletin (CPA Smartlink) -->
  <div class="bg-[#FAF7F2] border border-slate-300 rounded-none sm:rounded-sm p-4 relative">
    <span class="text-[9px] font-mono text-slate-500 uppercase tracking-widest block mb-1 font-bold">
      OFFICIAL NOTICE // VERIFICATION DESK
    </span>
    <h4 class="font-serif font-bold text-sm text-slate-900 leading-snug">
      Bypass Algorithmic Dating Casino
    </h4>
    <p class="text-xs text-slate-600 mt-2 leading-relaxed font-sans">
      Commercial dating platforms engineer artificial friction to prolong subscriptions. Access ID-verified local singles ready for unscripted meetings.
    </p>

    <div class="mt-4 pt-3 border-t border-slate-200">
      <a
        href="/go?source=sidebar_ad&trigger=classified_ad&intent=verified_singles"
        id="sidebarAdCta"
        rel="nofollow sponsored"
        target="_blank"
        class="min-h-[44px] w-full flex items-center justify-center text-center px-4 py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-mono font-bold text-xs uppercase rounded-none sm:rounded-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 cursor-pointer shadow-none"
      >
        VERIFY CLEARANCE ↗
      </a>
      <span class="block text-center text-[10px] font-mono text-slate-500 font-medium mt-2">
        Zero Gamification · 100% ID-Verified Members
      </span>
    </div>
  </div>

  <!-- WIDGET 3: Top Field Reports (Best Comments) -->
  <div class="bg-white border border-slate-300 rounded-none sm:rounded-sm overflow-hidden">
    <div class="flex items-center gap-2 px-4 py-3 border-b border-slate-200 bg-[#FAF7F2]">
      <span class="w-1.5 h-1.5 rounded-full bg-slate-800 shrink-0"></span>
      <span class="font-mono text-[10px] font-bold uppercase tracking-widest text-slate-900">
        Top Field Reports
      </span>
    </div>
    <div class="divide-y divide-slate-100">
      {topComments.map(comment => (
        <div class="px-4 py-3.5">
          <div class="flex items-center justify-between gap-2 mb-1.5">
            <span class="font-mono text-[10px] font-bold text-slate-900 uppercase tracking-wider">
              {comment.handle}
            </span>
            <span class="font-mono text-[9px] text-slate-500 shrink-0">{comment.date}</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed font-sans mb-1 line-clamp-3">
            "{comment.text}"
          </p>
          <span class="font-mono text-[9px] text-rose-700 uppercase tracking-wider font-bold">
            re: {comment.article}
          </span>
        </div>
      ))}
    </div>
  </div>

</aside>

<script>
  // Attach session CID to classified ad CTA for flawless attribution
  function initSidebarCta() {
    const cta = document.getElementById('sidebarAdCta') as HTMLAnchorElement | null;
    if (!cta) return;
    let cid = '';
    try {
      cid = sessionStorage.getItem('flirtcheck_cid') || '';
      if (!cid) {
        cid = 'fc_' + Math.random().toString(36).substring(2, 9) + '_' + Date.now().toString(36);
        sessionStorage.setItem('flirtcheck_cid', cid);
      }
    } catch {
      cid = 'fc_' + Date.now().toString(36);
    }
    cta.href = `/go?source=sidebar_ad&trigger=classified_ad&intent=verified_singles&cid=${encodeURIComponent(cid)}`;
  }
  document.addEventListener('DOMContentLoaded', initSidebarCta);
  initSidebarCta();
</script>
