        target="_blank"
        class="sidebar-partner-link min-h-[44px] w-full flex items-center justify-center text-center px-4 py-2.5 bg-rose-700 hover:bg-rose-800 active:translate-x-0.5 active:translate-y-0.5 text-white font-mono font-bold text-xs uppercase rounded-none transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-700 cursor-pointer border border-slate-900 shadow-[2px_2px_0px_0px_#0f172a] hover:shadow-none"
