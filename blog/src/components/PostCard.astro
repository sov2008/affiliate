---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Format pubDate
const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
}).format(post.data.pubDate);

// Resolve cover image path
const rawCover = post.data.coverImage || post.data.image;
const hasCustomCover = rawCover && !rawCover.includes('default-cover.webp');
const cleanCover = rawCover ? rawCover.replace(/^\/blog/, '') : null;
const coverSrc = cleanCover
  ? (cleanCover.startsWith('/') ? cleanCover : `/${cleanCover}`)
  : null;
---

<article class="flex flex-col bg-white border-2 border-slate-900 rounded-xl shadow-[4px_4px_0px_0px_#0f172a] overflow-hidden transition-all duration-150 hover:-translate-y-0.5 hover:shadow-[6px_6px_0px_0px_#0f172a] active:translate-x-1 active:translate-y-1 active:shadow-none">
  <!-- Image Frame or Fallback Panel -->
  <a href={`${base}/${post.id || post.slug}/`} class="aspect-[16/9] w-full border-b-2 border-slate-900 bg-[#F4EFE6] overflow-hidden relative block">
    {hasCustomCover && coverSrc ? (
      <img
        src={coverSrc}
        alt={post.data.title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full halftone-pattern flex flex-col items-center justify-center p-6 text-center select-none relative">
        <div class="absolute top-2 left-2 border border-slate-900 bg-white font-mono text-[9px] font-black text-slate-900 uppercase px-2 py-0.5 rounded shadow-[1px_1px_0px_0px_#0f172a]">
          DOSSIER FILE #{post.id?.substring(0, 6) || '2026-A'}
        </div>
        <div class="w-12 h-12 rounded-lg bg-white border-2 border-slate-900 flex items-center justify-center shadow-[3px_3px_0px_0px_#0f172a] mb-2 hover:rotate-6 transition-transform">
          <svg class="w-6 h-6 text-rose-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
          </svg>
        </div>
        <span class="font-mono text-xs font-black uppercase text-slate-900 tracking-wider">
          DOSSIER FILE
        </span>
        <span class="text-[10px] font-serif italic text-slate-600 mt-0.5">
          "Safety is... staying alert"
        </span>
      </div>
    )}

    <!-- Vintage Volume Stamp -->
    <div class="absolute bottom-2 right-2 px-2 py-0.5 rounded bg-white border border-slate-900 text-[9px] font-mono font-black text-slate-900 shadow-[1px_1px_0px_0px_#0f172a]">
      VOL. '26
    </div>
  </a>

  <!-- Card Body -->
  <div class="p-4 sm:p-5 flex flex-col flex-1 bg-white">
    <!-- Stamp Category Badge -->
    <div class="flex items-center justify-between gap-2 mb-2.5">
      <div class="flex flex-wrap gap-1.5">
        {post.data.tags.slice(0, 2).map((tag: string) => (
          <span class="border border-slate-900 bg-amber-100 text-slate-900 text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded shadow-[1px_1px_0px_0px_#0f172a]">
            {tag}
          </span>
        ))}
      </div>
      <span class="text-xs font-mono text-slate-500 font-bold">{formattedDate}</span>
    </div>

    <!-- Title -->
    <h3 class="font-extrabold text-slate-900 text-base sm:text-lg leading-snug line-clamp-2 hover:text-rose-600 transition-colors mb-2 font-sans">
      <a href={`${base}/${post.id || post.slug}/`}>
        {post.data.title}
      </a>
    </h3>

    <!-- Description -->
    <p class="text-xs sm:text-sm text-slate-600 line-clamp-3 mb-4 leading-relaxed flex-1">
      {post.data.description}
    </p>

    <!-- Footer: Author & Action Button -->
    <div class="pt-3 border-t-2 border-slate-100 flex items-center justify-between text-xs text-slate-600">
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded-md bg-slate-900 border border-slate-900 flex items-center justify-center font-bold text-white text-[10px]">
          FC
        </div>
        <span class="font-bold text-slate-800">{post.data.author}</span>
      </div>

      <a
        href={`${base}/${post.id || post.slug}/`}
        class="inline-flex items-center gap-1 font-black text-rose-600 hover:translate-x-0.5 transition-transform uppercase tracking-wider text-xs"
      >
        <span>Open Dossier</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</article>
