---
// MobileStickyCTA.astro - Context-aware mobile sticky conversion bar
interface Props {
  offerType?: 'virtual_sim' | 'verified_dating' | 'travel_dating' | 'default';
  customHeadline?: string;
  customCtaText?: string;
  customUrl?: string;
}

const {
  offerType = 'default',
  customHeadline,
  customCtaText,
  customUrl
} = Astro.props;

const MOBILE_PRESETS = {
  virtual_sim: {
    badge: 'DISPOSABLE SIM PROTOCOL',
    headline: 'Shield your WhatsApp & phone identity',
    ctaText: 'Get Virtual SIM ↗',
    url: '/go?offer=admitad_191148&source=mobile_sticky&trigger=unmasked_bar&intent=virtual_sim'
  },
  verified_dating: {
    badge: 'CURATED SINGLES ROSTER',
    headline: 'Bypass bots: connect with verified adults',
    ctaText: 'Verify Singles ↗',
    url: '/go?offer=admitad_49070&source=mobile_sticky&trigger=unmasked_bar&intent=verified_dating'
  },
  travel_dating: {
    badge: 'PUBLIC VENUE PROTOCOL',
    headline: 'Book verified public date venues abroad',
    ctaText: 'Browse Venues ↗',
    url: '/go?offer=admitad_18183&source=mobile_sticky&trigger=unmasked_bar&intent=travel_dating'
  },
  default: {
    badge: 'CHELTENHAM VERIFICATION',
    headline: 'Cross-reference match identity before moving off-app',
    ctaText: 'Verify Match ↗',
    url: '/go?source=mobile_sticky&trigger=unmasked_bar&intent=verified_singles'
  }
};

const activePreset = MOBILE_PRESETS[offerType] || MOBILE_PRESETS.default;
const badgeText = activePreset.badge;
const headlineText = customHeadline || activePreset.headline;
const ctaLabel = customCtaText || activePreset.ctaText;
const targetUrl = customUrl || activePreset.url;
---

<aside
  id="mobile-sticky-cta"
  class="fixed bottom-0 left-0 right-0 z-50 p-2.5 sm:py-3.5 bg-[#FFFDF7] border-t-2 border-slate-900 shadow-[0px_-4px_16px_rgba(15,23,42,0.18)] translate-y-full transition-transform duration-300"
  style="padding-bottom: max(0.65rem, env(safe-area-inset-bottom));"
  role="complementary"
  aria-label="Verification Quick Action"
>
  <!-- Close Button [×] -->
  <button
    type="button"
    id="closeMobileCta"
    class="absolute -top-3.5 right-4 w-6 h-6 rounded-full bg-[#FFFDF7] border-2 border-slate-900 text-slate-900 hover:bg-rose-100 hover:text-rose-600 flex items-center justify-center text-xs font-mono font-black shadow-[1px_1px_0px_0px_#0f172a] cursor-pointer transition-colors"
    aria-label="Close Notification"
    title="Close"
  >
    ×
  </button>

  <div class="max-w-3xl mx-auto flex items-center justify-between gap-2.5 sm:gap-6 px-1 sm:px-4">
    <!-- Left: Compelling Forensic Notice -->
    <div class="flex items-center gap-2 min-w-0 flex-1">
      <span class="w-2 h-2 rounded-full bg-emerald-600 shrink-0 inline-block animate-pulse"></span>
      <div class="min-w-0">
        <span class="text-[9px] font-mono text-slate-600 uppercase tracking-widest block font-bold leading-tight">
          {badgeText}
        </span>
        <span class="text-xs sm:text-sm font-bold text-slate-900 truncate block leading-snug font-sans">
          {headlineText}
        </span>
      </div>
    </div>

    <!-- Right: High-Converting Action Button -->
    <div class="shrink-0">
      <a
        id="mobileStickyCtaLink"
        href={targetUrl}
        rel="nofollow sponsored"
        target="_blank"
        class="px-3.5 py-2.5 bg-rose-700 hover:bg-rose-800 active:translate-x-0.5 active:translate-y-0.5 text-white font-mono font-bold text-xs uppercase tracking-wider rounded-none border border-slate-900 whitespace-nowrap shadow-[2px_2px_0px_0px_#0f172a] hover:shadow-none transition-all inline-block"
      >
        {ctaLabel}
      </a>
    </div>
  </div>
</aside>

<script>
  function initMobileStickyCTA() {
    const bar = document.getElementById('mobile-sticky-cta');
    const closeBtn = document.getElementById('closeMobileCta');
    const ctaLink = document.getElementById('mobileStickyCtaLink') as HTMLAnchorElement | null;

    if (!bar) return;

    // Check session storage for dismissal
    if (sessionStorage.getItem('hideMobileCta') === '1') {
      bar.remove();
      return;
    }

    // Manage CID attribution
    let cid = '';
    try {
      cid = sessionStorage.getItem('flirtcheck_cid') || '';
      if (!cid) {
        cid = 'fc_' + Math.random().toString(36).substring(2, 9) + '_' + Date.now().toString(36);
        sessionStorage.setItem('flirtcheck_cid', cid);
      }
    } catch {
      cid = 'fc_' + Date.now().toString(36);
    }

    if (ctaLink && !ctaLink.dataset.cidBound) {
      ctaLink.dataset.cidBound = 'true';
      try {
        const url = new URL(ctaLink.href, window.location.origin);
        url.searchParams.set('cid', cid);
        ctaLink.href = url.toString();
      } catch {
        ctaLink.href += `&cid=${encodeURIComponent(cid)}`;
      }
    }

    let isVisible = false;
    const footer = document.querySelector('footer');

    function updateVisibility() {
      if (sessionStorage.getItem('hideMobileCta') === '1') {
        bar?.classList.add('translate-y-full');
        return;
      }

      const scrollY = window.scrollY || document.documentElement.scrollTop;

      // Check footer boundary
      let footerVisible = false;
      if (footer) {
        const footerRect = footer.getBoundingClientRect();
        footerVisible = footerRect.top <= (window.innerHeight - 10);
      }

      const shouldShow = scrollY > 350 && !footerVisible;

      if (shouldShow && !isVisible) {
        isVisible = true;
        bar?.classList.remove('translate-y-full');
      } else if (!shouldShow && isVisible) {
        isVisible = false;
        bar?.classList.add('translate-y-full');
      }
    }

    closeBtn?.addEventListener('click', () => {
      try {
        sessionStorage.setItem('hideMobileCta', '1');
      } catch {}
      bar.classList.add('translate-y-full');
      setTimeout(() => {
        bar.remove();
      }, 300);
    });

    window.addEventListener('scroll', updateVisibility, { passive: true });
    window.addEventListener('resize', updateVisibility, { passive: true });
    updateVisibility();
  }

  document.addEventListener('DOMContentLoaded', initMobileStickyCTA);
  initMobileStickyCTA();
</script>
