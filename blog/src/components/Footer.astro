---
const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="bg-slate-950 border-t border-slate-900 mt-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Col 1: About -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-2">
          <span class="text-lg font-black text-white">Flirt<span class="text-rose-500">Check</span></span>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-800 text-slate-300">EST. 2026</span>
        </div>
        <p class="text-sm text-slate-400 max-w-sm leading-relaxed">
          FlirtCheck is an independent safety editorial and digital verification collective helping modern singles navigate dating platforms with confidence, scam detection protocols, and AI verification tools.
        </p>
      </div>

      <!-- Col 2: Navigation -->
      <div class="space-y-3">
        <h4 class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Safety Resources</h4>
        <ul class="space-y-2 text-sm text-slate-400">
          <li><a href={`${base}/`} class="hover:text-rose-400 transition-colors">Safety Guides</a></li>
          <li><a href={`${base}/dating-scam-verification-guide-2026/`} class="hover:text-rose-400 transition-colors">Scam Playbook</a></li>
          <li><a href="/go" rel="nofollow sponsored" target="_blank" class="hover:text-rose-400 transition-colors">Verified Dating Portal</a></li>
        </ul>
      </div>

      <!-- Col 3: Legal / Disclaimer -->
      <div class="space-y-3">
        <h4 class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Legal & Compliance</h4>
        <p class="text-xs text-slate-500 leading-relaxed">
          Disclosure: This site contains affiliate links and may earn compensation when users register through partner referral buttons at no extra cost. All educational content is published for informational safety purposes only.
        </p>
      </div>
    </div>

    <div class="pt-8 border-t border-slate-900 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© {currentYear} FlirtCheck.site Editorial Team. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <a href="/privacy" class="hover:text-slate-400 transition-colors">Privacy Policy</a>
        <span>•</span>
        <a href="/terms" class="hover:text-slate-400 transition-colors">Terms of Service</a>
        <span>•</span>
        <a href="/contact" class="hover:text-slate-400 transition-colors">Security Contact</a>
      </div>
    </div>
  </div>
</footer>
