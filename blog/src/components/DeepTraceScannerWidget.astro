---
// DeepTraceScannerWidget.astro - Tactical Cybersecurity & Chat Audit In-Content Widget
interface Props {
  defaultPlatform?: string;
  defaultLocation?: string;
  headline?: string;
  subheadline?: string;
  caseRef?: string;
  className?: string;
}

const {
  defaultPlatform = 'WHATSAPP',
  defaultLocation = '',
  headline = 'FLIRTCHECK DEEPTRACE™ RADAR // LIVE AUDIT',
  subheadline = 'Audit suspect chat screenshots against Pig Butchering scripts, timezone shifts, and AI generative avataring.',
  caseRef = 'DT-WIDGET-2026',
  className = ''
} = Astro.props;
---

<div id="deeptrace-scanner-widget" class={`deeptrace-widget not-prose my-10 rounded-2xl bg-slate-950 border-2 border-slate-800 hover:border-cyan-500/40 p-5 sm:p-7 text-slate-100 shadow-2xl relative overflow-hidden transition-all duration-300 font-sans ${className}`} data-widget-case={caseRef}>
  {/* Cyber Grid Background Overlay */}
  <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:16px_16px] opacity-40 pointer-events-none"></div>
  <div class="absolute -top-24 -right-24 w-64 h-64 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

  {/* Header Section */}
  <div class="relative z-10 flex flex-wrap items-center justify-between gap-3 border-b border-slate-800/80 pb-4 mb-5">
    <div class="flex items-center gap-2.5">
      <div class="p-2 rounded-xl bg-cyan-950/80 border border-cyan-700/60 text-cyan-400">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 animate-pulse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-[10px] font-mono font-bold tracking-widest text-cyan-400 uppercase">
            FORENSIC TELEMETRY TOOL
          </span>
          <span class="px-2 py-0.5 rounded text-[9px] font-mono uppercase bg-slate-900 text-slate-400 border border-slate-800">
            NVIDIA NIM 11B
          </span>
        </div>
        <h3 class="text-base sm:text-lg font-black text-slate-100 tracking-tight flex items-center gap-2">
          {headline}
        </h3>
      </div>
    </div>
    <div class="hidden sm:flex items-center gap-2 text-[10px] font-mono text-emerald-400 bg-emerald-950/60 px-2.5 py-1 rounded-full border border-emerald-800/60">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping inline-block"></span>
      ZERO DATA RETENTION
    </div>
  </div>

  <p class="relative z-10 text-xs sm:text-sm text-slate-300 mb-5 leading-relaxed">
    {subheadline}
  </p>

  {/* Main Interactive Controls Grid */}
  <div class="relative z-10 grid grid-cols-1 md:grid-cols-12 gap-5 items-stretch">
    {/* Left 7 Cols: Dropzone Area */}
    <div class="md:col-span-7 flex flex-col justify-between">
      <div
        class="deeptrace-dropzone group relative rounded-xl border-2 border-dashed border-slate-800 hover:border-cyan-400/70 bg-slate-900/60 hover:bg-slate-900/90 p-5 sm:p-6 flex flex-col items-center justify-center text-center cursor-pointer transition-all min-h-[160px]"
      >
        <input
          type="file"
          class="deeptrace-file-input hidden"
          accept="image/png,image/jpeg,image/webp"
        />

        <div class="dropzone-default space-y-2">
          <div class="w-12 h-12 mx-auto rounded-xl bg-cyan-950/60 border border-cyan-800/40 text-cyan-400 flex items-center justify-center group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"/>
              <path d="M12 12v9"/>
              <path d="m16 16-4-4-4 4"/>
            </svg>
          </div>
          <div>
            <span class="text-xs sm:text-sm font-bold text-slate-200 block">
              Перетащите скриншот чата сюда
            </span>
            <span class="text-[11px] text-slate-500">
              или кликните для выбора (PNG, JPG до 10MB)
            </span>
          </div>
        </div>

        {/* Selected file preview pill */}
        <div class="dropzone-selected hidden flex-col items-center gap-2">
          <div class="px-3 py-1.5 rounded-lg bg-cyan-950/80 border border-cyan-500/60 text-cyan-300 text-xs font-mono font-bold flex items-center gap-2">
            <span class="file-name truncate max-w-[200px]">file.png</span>
            <button type="button" class="remove-file hover:text-rose-400">✕</button>
          </div>
          <span class="text-[10px] text-slate-400">Готово к форензик-анализу</span>
        </div>
      </div>

      <div class="flex items-center justify-between text-[10px] font-mono text-slate-500 mt-2 px-1">
        <span>ENCRYPTED_TELEMETRY</span>
        <span class="text-cyan-400">CLIENT_SIDE_STRIP</span>
      </div>
    </div>

    {/* Right 5 Cols: Platform Badges & Claimed Location */}
    <div class="md:col-span-5 flex flex-col justify-between space-y-4 rounded-xl bg-slate-900/80 border border-slate-800 p-4">
      {/* Platform Selector */}
      <div class="space-y-1.5">
        <label class="text-[11px] font-mono uppercase text-slate-400 font-semibold block">
          Платформа чата:
        </label>
        <div class="grid grid-cols-2 gap-1.5 text-[11px] font-mono">
          {['WHATSAPP', 'TELEGRAM', 'TINDER', 'INSTAGRAM'].map((p) => (
            <button
              type="button"
              class={`platform-pill py-1.5 px-2 rounded-lg border text-center font-bold transition-all ${
                p === defaultPlatform
                  ? 'active-platform bg-cyan-500 text-slate-950 border-cyan-400 shadow-sm shadow-cyan-500/30'
                  : 'bg-slate-800/80 text-slate-300 border-slate-700/80 hover:bg-slate-700'
              }`}
              data-platform={p}
            >
              {p}
            </button>
          ))}
        </div>
      </div>

      {/* Claimed Location */}
      <div class="space-y-1.5">
        <label class="text-[11px] font-mono uppercase text-slate-400 font-semibold flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          Заявленный город (Geo-Anchor):
        </label>
        <input
          type="text"
          class="claimed-location-input w-full px-3 py-1.5 rounded-lg bg-slate-950 border border-slate-800 text-slate-200 text-xs focus:outline-none focus:border-cyan-500 transition-colors placeholder:text-slate-600 font-mono"
          placeholder="Chicago, London, Kyiv, etc."
          value={defaultLocation}
        />
      </div>

      {/* CTA Button */}
      <button
        type="button"
        class="deeptrace-submit-btn w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-cyan-500 to-cyan-400 hover:from-cyan-400 hover:to-cyan-300 text-slate-950 font-black text-xs uppercase tracking-wider flex items-center justify-center gap-2 transition-all shadow-lg shadow-cyan-500/20 active:scale-[0.98] cursor-pointer"
      >
        <span>Запустить DeepTrace™ аудит</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"/>
          <path d="m12 5 7 7-7 7"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  function setupDeepTraceWidgets() {
    const widgets = document.querySelectorAll<HTMLElement>('.deeptrace-widget');

    widgets.forEach((widget) => {
      const dropzone = widget.querySelector<HTMLElement>('.deeptrace-dropzone');
      const fileInput = widget.querySelector<HTMLInputElement>('.deeptrace-file-input');
      const defaultState = widget.querySelector<HTMLElement>('.dropzone-default');
      const selectedState = widget.querySelector<HTMLElement>('.dropzone-selected');
      const fileNameSpan = widget.querySelector<HTMLElement>('.file-name');
      const removeBtn = widget.querySelector<HTMLElement>('.remove-file');
      const locationInput = widget.querySelector<HTMLInputElement>('.claimed-location-input');
      const submitBtn = widget.querySelector<HTMLButtonElement>('.deeptrace-submit-btn');
      const platformPills = widget.querySelectorAll<HTMLButtonElement>('.platform-pill');

      let currentPlatform = 'WHATSAPP';
      let selectedFileDataUrl: string | null = null;
      let selectedFileName: string | null = null;

      // Platform selection
      platformPills.forEach((pill) => {
        pill.addEventListener('click', () => {
          platformPills.forEach((p) => {
            p.classList.remove('active-platform', 'bg-cyan-500', 'text-slate-950', 'border-cyan-400', 'shadow-sm', 'shadow-cyan-500/30');
            p.classList.add('bg-slate-800/80', 'text-slate-300', 'border-slate-700/80');
          });
          pill.classList.remove('bg-slate-800/80', 'text-slate-300', 'border-slate-700/80');
          pill.classList.add('active-platform', 'bg-cyan-500', 'text-slate-950', 'border-cyan-400', 'shadow-sm', 'shadow-cyan-500/30');
          currentPlatform = pill.dataset.platform || 'WHATSAPP';
        });
      });

      // Handle file selection
      const handleFile = (file: File) => {
        if (!file.type.startsWith('image/')) {
          alert('Пожалуйста, выберите изображение (PNG, JPG, WEBP).');
          return;
        }

        selectedFileName = file.name;
        if (fileNameSpan) fileNameSpan.textContent = file.name;

        const reader = new FileReader();
        reader.onload = (e) => {
          selectedFileDataUrl = e.target?.result as string;
          if (defaultState) defaultState.classList.add('hidden');
          if (selectedState) selectedState.classList.remove('hidden');
          if (selectedState) selectedState.classList.add('flex');
        };
        reader.readAsDataURL(file);
      };

      if (dropzone && fileInput) {
        dropzone.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('.remove-file')) return;
          fileInput.click();
        });

        fileInput.addEventListener('change', () => {
          if (fileInput.files && fileInput.files[0]) {
            handleFile(fileInput.files[0]);
          }
        });

        dropzone.addEventListener('dragover', (e) => {
          e.preventDefault();
          dropzone.classList.add('border-cyan-400', 'bg-slate-900');
        });

        dropzone.addEventListener('dragleave', () => {
          dropzone.classList.remove('border-cyan-400', 'bg-slate-900');
        });

        dropzone.addEventListener('drop', (e) => {
          e.preventDefault();
          dropzone.classList.remove('border-cyan-400', 'bg-slate-900');
          if (e.dataTransfer?.files && e.dataTransfer.files[0]) {
            handleFile(e.dataTransfer.files[0]);
          }
        });
      }

      if (removeBtn) {
        removeBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          selectedFileDataUrl = null;
          selectedFileName = null;
          if (fileInput) fileInput.value = '';
          if (defaultState) defaultState.classList.remove('hidden');
          if (selectedState) selectedState.classList.add('hidden');
          if (selectedState) selectedState.classList.remove('flex');
        });
      }

      // Handle submission
      if (submitBtn) {
        submitBtn.addEventListener('click', () => {
          const loc = locationInput?.value?.trim() || '';

          // If image was selected, save in sessionStorage for instant loading in /deeptrace
          if (selectedFileDataUrl) {
            try {
              sessionStorage.setItem('deeptrace_preloaded_image', selectedFileDataUrl);
              sessionStorage.setItem('deeptrace_preloaded_name', selectedFileName || 'screenshot.png');
              sessionStorage.setItem('deeptrace_preloaded_platform', currentPlatform);
              sessionStorage.setItem('deeptrace_preloaded_location', loc);
            } catch (err) {
              console.warn('[DeepTraceWidget] SessionStorage quota exceeded, passing via query.');
            }
          }

          const targetUrl = new URL('/deeptrace', window.location.origin);
          targetUrl.searchParams.set('source', 'blog_widget');
          targetUrl.searchParams.set('platform', currentPlatform);
          if (loc) targetUrl.searchParams.set('location', loc);
          if (selectedFileDataUrl) targetUrl.searchParams.set('autoScan', '1');

          window.location.href = targetUrl.toString();
        });
      }
    });
  }

  // Support both direct load and Astro view transitions
  setupDeepTraceWidgets();
  document.addEventListener('astro:page-load', setupDeepTraceWidgets);
</script>
