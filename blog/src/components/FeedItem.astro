---
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES_METADATA } from '../content.config';

interface Props {
  post: CollectionEntry<'posts'>;
  index?: number;
}

const { post, index } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Format pubDate
const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
}).format(post.data.pubDate);

// Reading time estimation
const wordCount = post.body ? post.body.split(/\s+/).length : (post.data.description ? post.data.description.split(/\s+/).length * 8 : 600);
const readingTime = Math.max(2, Math.ceil(wordCount / 200));

// Category metadata
const categoryMeta = post.data.category ? CATEGORIES_METADATA[post.data.category] : null;

// Resolve cover image
const rawCover = post.data.coverImage || post.data.image;
const cleanCover = rawCover ? rawCover.replace(/^\/blog/, '') : null;
const postSlug = post.slug || post.id || 'case-2026';
const coverSrc = cleanCover
  ? (cleanCover.startsWith('/') ? cleanCover : `/${cleanCover}`)
  : `/images/posts/${postSlug}.webp`;

// Case ID
const caseId = postSlug.replace(/[^a-zA-Z0-9]/g, '').slice(0, 8).toUpperCase() || 'FC2026A';

// Love is... motto or hook
const motto = post.data.motto || post.data.hook || (categoryMeta ? categoryMeta.motto : null);
const postUrl = `${base}/${post.id || post.slug}/`;
---

<article
  data-category={post.data.category || 'safety-dossier'}
  data-feed-item
  data-index={index}
  class="feed-item bg-white border-2 border-slate-900 rounded-xl overflow-hidden shadow-[4px_4px_0px_0px_#0f172a] hover:-translate-y-1 hover:shadow-[6px_6px_0px_0px_#0f172a] transition-all"
>
  <!-- Full-width 16:9 Image Block on Top (Strictly No Zoom) -->
  {coverSrc && (
    <div class="w-full aspect-[16/9] border-b-2 border-slate-900 bg-[#F4EFE6] overflow-hidden relative">
      <a href={postUrl} class="block w-full h-full">
        <img
          src={coverSrc}
          alt={post.data.title}
          loading="lazy"
          class="w-full h-full object-cover select-none pointer-events-none"
        />
      </a>
      <div class="absolute bottom-3 right-3 px-2 py-0.5 rounded bg-white border border-slate-900 text-[10px] font-mono font-black text-slate-900 shadow-[1px_1px_0px_0px_#0f172a]">
        VOL. '26
      </div>
    </div>
  )}

  <!-- Card Body -->
  <div class="p-6 sm:p-7">
    <!-- Top Row: Category Stamp + PubDate + Reading Time -->
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <span class:list={[
        "border border-slate-900 px-2.5 py-0.5 text-[11px] font-black uppercase tracking-wider rounded shadow-[1px_1px_0px_0px_#0f172a]",
        categoryMeta ? categoryMeta.badgeStyle : "bg-amber-100 text-slate-900"
      ]}>
        {categoryMeta ? `[${categoryMeta.shortTitle}]` : `[${post.data.category || 'DOSSIER'}]`}
      </span>
      <span class="font-mono text-xs text-slate-500">
        {formattedDate} • {readingTime} MIN FORENSIC READ
      </span>
    </div>

    <!-- Title H2 -->
    <h2 class="font-black text-xl sm:text-2xl text-slate-900 leading-tight hover:text-rose-600 transition-colors font-sans mb-2">
      <a href={postUrl}>
        {post.data.title}
      </a>
    </h2>

    <!-- Love is... Motto / Epigraph -->
    {motto && (
      <p class="font-serif italic font-semibold text-rose-600 text-sm mt-2 mb-2">
        "{motto}"
      </p>
    )}

    <!-- Excerpt / Lead (2-3 sentences, line-clamp-3) -->
    <p class="text-slate-600 text-sm sm:text-base leading-relaxed line-clamp-3 mb-4 font-normal">
      {post.data.description || (post.body ? post.body.slice(0, 240) + '...' : '')}
    </p>

    <!-- Bottom Bar: Case ID + READ FULL DISPATCH Button -->
    <div class="pt-3 border-t border-slate-200 flex justify-between items-center text-xs font-mono">
      <span class="text-slate-400 font-bold">CASE ID: #{caseId}</span>
      <a
        href={postUrl}
        class="font-black text-rose-600 hover:text-slate-900 uppercase flex items-center gap-1 tracking-wider text-sm"
      >
        READ FULL DISPATCH &rarr;
      </a>
    </div>
  </div>
</article>
