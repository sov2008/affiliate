---
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES_METADATA } from '../content.config';

interface Props {
  post: CollectionEntry<'posts'>;
  index?: number;
  isFeatured?: boolean;
}

const { post, index, isFeatured = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Format pubDate: "September 14, 2026"
const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(post.data.pubDate);

// Reading time estimation
const wordCount = post.body ? post.body.split(/\s+/).length : (post.data.description ? post.data.description.split(/\s+/).length * 8 : 600);
const readingTime = Math.max(2, Math.ceil(wordCount / 200));

// Category metadata
const categoryMeta = post.data.category ? CATEGORIES_METADATA[post.data.category] : null;

// Resolve cover image
const rawCover = post.data.coverImage || post.data.image;
const cleanCover = rawCover ? rawCover.replace(/^\/blog/, '') : null;
const postSlug = post.slug || post.id || 'case-2026';
const coverSrc = cleanCover
  ? (cleanCover.startsWith('/') ? cleanCover : `/${cleanCover}`)
  : `/images/posts/${postSlug}.webp`;

// Extract natural journalistic lead from the body or clean description
function getAuthenticLead(body: string | undefined, desc: string | undefined): string {
  if (body) {
    const clean = body
      .replace(/^[>#\-*].*$/gm, '')
      .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
      .replace(/\*\*([^*]+)\*\*/g, '$1')
      .replace(/\*([^*]+)\*/g, '$1')
      .replace(/`([^`]+)`/g, '$1')
      .trim();
    const paragraphs = clean.split(/\n\s*\n/).map(p => p.trim()).filter(Boolean);
    if (paragraphs.length > 0) {
      const firstP = paragraphs[0].replace(/\s+/g, ' ');
      const sentences = firstP.match(/[^.!?]+[.!?]+(\s|$)/g);
      if (sentences && sentences.length > 0) {
        const lead = sentences.slice(0, 2).join('').trim();
        if (lead.length >= 60) return lead;
      }
      if (firstP.length >= 60) return firstP.slice(0, 240).trim() + '...';
    }
  }
  if (desc && !/^(discover|learn|in this (comprehensive )?guide|master|explore|uncover)/i.test(desc)) {
    return desc;
  }
  return desc || '';
}

const leadText = getAuthenticLead(post.body, post.data.description);
const postUrl = `${base}/${post.id || post.slug}/`;
---

<article
  id={isFeatured ? "featuredDispatch" : undefined}
  data-category={post.data.category || 'safety-dossier'}
  data-feed-item
  data-index={index}
  class:list={[
    isFeatured ? "featured-item" : "feed-item",
    "feed-card w-full block bg-white border border-slate-300 rounded-lg overflow-hidden shadow-sm hover:shadow-md hover:border-slate-400 transition-all mb-8",
    (index !== undefined && index >= 8) ? "hidden" : ""
  ]}
>
  <!-- 1. Top Cover Block (16:9) -->
  {coverSrc && (
    <div class="w-full aspect-[16/9] border-b border-slate-200 bg-slate-100 overflow-hidden relative block">
      <a href={postUrl} class="block w-full h-full">
        <img
          src={coverSrc}
          alt={post.data.title}
          loading={isFeatured ? "eager" : "lazy"}
          class="w-full h-full object-cover select-none pointer-events-none block transition-transform duration-300 hover:scale-[1.01]"
        />
      </a>
      {isFeatured && (
        <div class="absolute top-3 left-3 bg-slate-900 text-white font-sans font-bold text-[11px] px-2.5 py-1 rounded tracking-wider uppercase">
          Featured Investigation
        </div>
      )}
    </div>
  )}

  <!-- 2. Body Block -->
  <div class="w-full p-6 sm:p-7 block">
    <!-- Clean Newspaper Dateline: "September 14, 2026 · 6 min read · Analysis" -->
    <div class="flex flex-wrap items-center gap-2 text-xs font-sans text-slate-500 mb-3">
      <span>{formattedDate}</span>
      <span class="text-slate-300">·</span>
      <span>{readingTime} min read</span>
      <span class="text-slate-300">·</span>
      <span class="font-semibold text-slate-700 uppercase tracking-wider text-[11px]">
        {categoryMeta ? categoryMeta.shortTitle : 'Analysis'}
      </span>
    </div>

    <h2 class="font-bold text-xl sm:text-2xl text-slate-900 leading-snug hover:text-rose-600 transition-colors font-sans mb-3">
      <a href={postUrl}>{post.data.title}</a>
    </h2>

    <p class="text-slate-600 text-sm sm:text-base leading-relaxed line-clamp-3 mb-4 font-normal font-sans">
      {leadText}
    </p>

    <div class="pt-3 border-t border-slate-100 flex justify-end items-center text-xs font-sans">
      <a href={postUrl} class="font-semibold text-slate-900 hover:text-rose-600 inline-flex items-center gap-1.5 transition-colors text-sm">
        <span>Read Investigation</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</article>
