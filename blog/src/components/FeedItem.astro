---
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES_METADATA } from '../content.config';

interface Props {
  post: CollectionEntry<'posts'>;
  index?: number;
}

const { post, index } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Format pubDate
const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
}).format(post.data.pubDate);

// Reading time estimation
const wordCount = post.body ? post.body.split(/\s+/).length : (post.data.description ? post.data.description.split(/\s+/).length * 8 : 600);
const readingTime = Math.max(2, Math.ceil(wordCount / 200));

// Category metadata
const categoryMeta = post.data.category ? CATEGORIES_METADATA[post.data.category] : null;

// Resolve cover image (render image column for all custom covers)
const rawCover = post.data.coverImage || post.data.image;
const hasCustomCover = Boolean(rawCover && !rawCover.includes('default-cover.webp'));
const cleanCover = rawCover ? rawCover.replace(/^\/blog/, '') : null;
const coverSrc = cleanCover
  ? (cleanCover.startsWith('/') ? cleanCover : `/${cleanCover}`)
  : null;

// Case ID
const postSlug = post.slug || post.id || 'case-2026';
const caseId = postSlug.replace(/[^a-zA-Z0-9]/g, '').slice(0, 8).toUpperCase() || 'FC2026A';

// Love is... motto or hook
const motto = post.data.motto || post.data.hook || (categoryMeta ? categoryMeta.motto : null);
const postUrl = `${base}/${post.id || post.slug}/`;
---

<article
  data-category={post.data.category || 'safety-dossier'}
  data-feed-item
  data-index={index}
  class="feed-item bg-white border-2 border-slate-900 rounded-xl p-5 sm:p-6 shadow-[4px_4px_0px_0px_#0f172a] hover:-translate-y-0.5 hover:shadow-[6px_6px_0px_0px_#0f172a] transition-all flex flex-col sm:flex-row gap-5 items-start"
>
  <!-- 16:9 Image Column (Consistent comic aspect ratio) -->
  {hasCustomCover && coverSrc && (
    <a
      href={postUrl}
      class="w-full sm:w-56 md:w-64 aspect-[16/9] overflow-hidden rounded-lg border-2 border-slate-900 shrink-0 block bg-[#F4EFE6] relative group shadow-[2px_2px_0px_0px_#0f172a]"
    >
      <img
        src={coverSrc}
        alt={post.data.title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
      />
      <div class="absolute bottom-2 right-2 px-1.5 py-0.5 rounded bg-white border border-slate-900 text-[9px] font-mono font-black text-slate-900 shadow-[1px_1px_0px_0px_#0f172a]">
        VOL. '26
      </div>
    </a>
  )}

  <!-- Text Body -->
  <div class="flex-1 flex flex-col justify-between w-full min-w-0">
    <!-- Header: Stamp + Date + Reading Time -->
    <div class="flex flex-wrap items-center gap-2 mb-2">
      <span class:list={[
        "border border-slate-900 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider rounded shadow-[1px_1px_0px_0px_#0f172a]",
        categoryMeta ? categoryMeta.badgeStyle : "bg-amber-100 text-slate-900"
      ]}>
        {categoryMeta ? `[${categoryMeta.shortTitle}]` : `[${post.data.category || 'DOSSIER'}]`}
      </span>
      <span class="font-mono text-xs text-slate-500">
        {formattedDate} • {readingTime} MIN READ
      </span>
    </div>

    <!-- Title -->
    <h2 class="font-black text-lg sm:text-xl text-slate-900 leading-snug hover:text-rose-600 transition-colors font-sans">
      <a href={postUrl}>
        {post.data.title}
      </a>
    </h2>

    <!-- Love is... Motto / Epigraph -->
    {motto && (
      <p class="font-serif italic font-semibold text-rose-600 text-xs sm:text-sm mt-1.5 mb-1.5">
        "{motto}"
      </p>
    )}

    <!-- Excerpt / Lead -->
    <p class="text-slate-600 text-xs sm:text-sm leading-relaxed line-clamp-2 sm:line-clamp-3 mt-1 font-normal">
      {post.data.description || (post.body ? post.body.slice(0, 200) + '...' : '')}
    </p>

    <!-- Forensic Footer -->
    <div class="mt-3.5 pt-2.5 border-t border-slate-200 w-full flex justify-between items-center text-xs font-mono">
      <span class="text-slate-400 font-bold">CASE ID: #{caseId}</span>
      <a
        href={postUrl}
        class="font-black text-rose-600 hover:text-slate-900 uppercase flex items-center gap-1 tracking-wider"
      >
        READ DISPATCH &rarr;
      </a>
    </div>
  </div>
</article>
