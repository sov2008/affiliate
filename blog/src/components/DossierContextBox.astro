---
// DossierContextBox.astro - Natural Editorial Footnote & Verification Callout
interface Props {
  source?: string;
  trigger?: string;
}

const {
  source = 'article_editorial_note',
  trigger = 'in_text_note'
} = Astro.props;
---

<aside
  class="editorial-footnote not-prose my-8 p-4 sm:p-5 bg-slate-50 border-l-4 border-slate-700 rounded-r-lg text-slate-800 text-sm font-sans"
  role="note"
  aria-label="Editorial Verification Note"
>
  <div class="space-y-2">
    <p class="leading-relaxed font-sans text-slate-700">
      <strong class="text-slate-900 font-semibold font-serif italic">Note:</strong> If you are investigating a profile operating under these behavioral patterns, cross-check their registered domain, phone exchange, or photo signatures against our <a
        href={`/go?source=${source}&trigger=${trigger}&intent=verify_match`}
        rel="nofollow sponsored"
        target="_blank"
        class="dossier-box-cta font-medium text-slate-900 underline decoration-slate-400 hover:decoration-rose-600 hover:text-rose-600 transition-colors"
      >centralized verification registry &rarr;</a>
    </p>
    <div class="text-[11px] text-slate-500 font-mono">
      Independent telemetry: identity verification, reverse metadata lookup & bot signature screening.
    </div>
  </div>
</aside>

<script>
  function initDossierContextBoxes() {
    const links = document.querySelectorAll<HTMLAnchorElement>('.dossier-box-cta');
    if (!links.length) return;

    let cid = '';
    try {
      cid = sessionStorage.getItem('flirtcheck_cid') || sessionStorage.getItem('cid') || '';
      if (!cid) {
        cid = 'fc_' + Math.random().toString(36).substring(2, 9) + '_' + Date.now().toString(36);
        sessionStorage.setItem('flirtcheck_cid', cid);
      }
    } catch {
      cid = 'fc_' + Date.now().toString(36);
    }

    links.forEach((link) => {
      try {
        const url = new URL(link.href, window.location.origin);
        url.searchParams.set('cid', cid);
        link.href = url.pathname + url.search;
      } catch {}
    });
  }

  document.addEventListener('DOMContentLoaded', initDossierContextBoxes);
  initDossierContextBoxes();
</script>
