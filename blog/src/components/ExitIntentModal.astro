---
interface Props {
  slug?: string;
}

const { slug = 'dating-safety-guide' } = Astro.props;
---

<aside
  id="exitIntentModal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="exitModalTitle"
  aria-hidden="true"
  data-slug={slug}
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/70 backdrop-blur-xs opacity-0 pointer-events-none transition-all duration-300"
>
  <!-- Modal Card (Cheltenham Bureau Archival Standard) -->
  <div
    id="exitIntentCard"
    class="relative w-full max-w-lg overflow-hidden rounded-none sm:rounded-sm bg-[#FFFDF9] border border-slate-300 shadow-2xl transform scale-95 transition-all duration-300 text-slate-900"
  >
    <!-- Modal Header / Archival Protocol Strip -->
    <div class="bg-[#FAF7F2] border-b border-slate-200 px-5 py-3 flex items-center justify-between">
      <div class="flex items-center gap-2 font-mono text-[10px] font-bold uppercase tracking-widest text-slate-600">
        <span class="w-1.5 h-1.5 rounded-full bg-rose-700"></span>
        <span>PROTOCOL // EXIT CLEARANCE NOTICE</span>
      </div>
      <button
        id="exitModalCloseBtn"
        type="button"
        aria-label="Close modal"
        class="min-h-[32px] min-w-[32px] flex items-center justify-center font-mono text-xs font-bold text-slate-500 hover:text-slate-900 cursor-pointer transition-colors"
      >
        [ESC]
      </button>
    </div>

    <!-- Modal Body -->
    <div class="p-6 sm:p-7 space-y-4 font-sans">
      <!-- Heading -->
      <div>
        <span class="font-mono text-[9px] font-bold uppercase tracking-widest text-rose-700 block mb-1">
          [ PRIORITY ADVISORY // UNVERIFIED ENTITY ]
        </span>
        <h3 id="exitModalTitle" class="text-xl sm:text-2xl font-serif font-bold text-slate-900 tracking-tight leading-snug">
          Hold Execution: Verify Match Integrity
        </h3>
      </div>

      <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-sans">
        Before closing this dossier: independent forensic telemetry shows that over 27% of active profiles on commercial dating networks utilize synthetic GAN imagery or deceptive off-platform extraction scripts.
      </p>

      <!-- Key Verification Protocols -->
      <div class="space-y-2.5 pt-1">
        <div class="bg-white border border-slate-200 p-3 flex items-start gap-3">
          <span class="font-mono text-[10px] font-bold text-rose-700 bg-rose-50 px-1.5 py-0.5 border border-rose-200 shrink-0 mt-0.5">[01]</span>
          <div class="text-xs text-slate-700 leading-snug">
            <strong class="font-mono font-bold text-slate-900 block text-[11px] uppercase tracking-wide">Synthetic Media & Bot Shield</strong>
            Cross-reference uploaded imagery against known AI face-synthesis arrays and scraped social accounts.
          </div>
        </div>

        <div class="bg-white border border-slate-200 p-3 flex items-start gap-3">
          <span class="font-mono text-[10px] font-bold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 border border-emerald-200 shrink-0 mt-0.5">[02]</span>
          <div class="text-xs text-slate-700 leading-snug">
            <strong class="font-mono font-bold text-slate-900 block text-[11px] uppercase tracking-wide">Romance Extraction Interception</strong>
            Heuristically flags scripted WhatsApp / Telegram pivot maneuvers prior to financial solicitation.
          </div>
        </div>

        <div class="bg-white border border-slate-200 p-3 flex items-start gap-3">
          <span class="font-mono text-[10px] font-bold text-slate-700 bg-slate-100 px-1.5 py-0.5 border border-slate-300 shrink-0 mt-0.5">[03]</span>
          <div class="text-xs text-slate-700 leading-snug">
            <strong class="font-mono font-bold text-slate-900 block text-[11px] uppercase tracking-wide">Confidential Forensic Inquiry</strong>
            100% anonymous verification under British investigative standards. Zero personal telemetry stored.
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="pt-3 space-y-3">
        <a
          id="exitModalCta"
          href={`/r/dating?ref=${encodeURIComponent(slug)}&trigger=exit_intent&intent=exit_rescue`}
          class="min-h-[44px] w-full flex items-center justify-center gap-2 px-6 py-3 bg-slate-900 hover:bg-slate-800 text-white font-mono font-bold text-xs uppercase tracking-wider transition-colors cursor-pointer"
        >
          <span>EXECUTE INSTANT CLEARANCE AUDIT ↗</span>
        </a>

        <div class="text-center">
          <button
            id="exitModalDismissBtn"
            type="button"
            class="font-mono text-[10px] uppercase tracking-widest text-slate-500 hover:text-slate-800 underline underline-offset-4 cursor-pointer transition-colors"
          >
            [ Dismiss Notice & Terminate Session ]
          </button>
        </div>
      </div>
    </div>
  </div>
</aside>

<script>
  function initExitIntent() {
    const modal = document.getElementById('exitIntentModal');
    const card = document.getElementById('exitIntentCard');
    const closeBtn = document.getElementById('exitModalCloseBtn');
    const dismissBtn = document.getElementById('exitModalDismissBtn');
    const ctaBtn = document.getElementById('exitModalCta') as HTMLAnchorElement | null;

    if (!modal || !card) return;

    // Attach session CID for seamless attribution
    if (ctaBtn) {
      try {
        let cid = sessionStorage.getItem('flirtcheck_cid');
        if (!cid) {
          cid = 'fc_' + Math.random().toString(36).substring(2, 9) + '_' + Date.now().toString(36);
          sessionStorage.setItem('flirtcheck_cid', cid);
        }
        const url = new URL(ctaBtn.href, window.location.origin);
        url.searchParams.set('cid', cid);
        ctaBtn.href = url.toString();
      } catch {}
    }

    const STORAGE_KEY = 'flirtcheck_exit_intent_shown';
    let isShown = false;

    // Check session frequency limit
    try {
      if (sessionStorage.getItem(STORAGE_KEY)) {
        return; // Already triggered in this session
      }
    } catch {
      // Ignore storage restrictions
    }

    function showModal() {
      if (isShown) return;
      try {
        if (sessionStorage.getItem(STORAGE_KEY)) return;
        sessionStorage.setItem(STORAGE_KEY, '1');
      } catch {}

      isShown = true;
      modal.setAttribute('aria-hidden', 'false');
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100', 'pointer-events-auto');

      if (card) {
        card.classList.remove('scale-95');
        card.classList.add('scale-100');
      }

      // Detach listeners to conserve CPU
      document.removeEventListener('mouseleave', handleDesktopMouseLeave);
      window.removeEventListener('scroll', handleMobileScroll);
    }

    function closeModal() {
      modal.setAttribute('aria-hidden', 'true');
      modal.classList.remove('opacity-100', 'pointer-events-auto');
      modal.classList.add('opacity-0', 'pointer-events-none');

      if (card) {
        card.classList.remove('scale-100');
        card.classList.add('scale-95');
      }
    }

    // 1. Desktop Trigger: mouse leaves top of viewport (e.clientY <= 5)
    function handleDesktopMouseLeave(e: MouseEvent) {
      if (e.clientY <= 5) {
        showModal();
      }
    }

    // 2. Mobile Trigger: fast scroll up after reading (scroll velocity detection)
    let lastScrollY = window.scrollY;
    let lastScrollTime = Date.now();
    let userHasScrolledDown = false;

    function handleMobileScroll() {
      const currentScrollY = window.scrollY;
      const currentTime = Date.now();
      const timeDelta = currentTime - lastScrollTime;

      if (currentScrollY > 400) {
        userHasScrolledDown = true;
      }

      if (userHasScrolledDown && timeDelta > 0 && timeDelta < 200) {
        const scrollDelta = lastScrollY - currentScrollY; // Positive when scrolling up
        const velocity = scrollDelta / timeDelta; // px per ms

        // If user rapidly scrolls up towards exit (velocity > 1.2 px/ms and close to top)
        if (velocity > 1.2 && currentScrollY < 300) {
          showModal();
        }
      }

      lastScrollY = currentScrollY;
      lastScrollTime = currentTime;
    }

    // Attach listeners with a brief delay so page load events don't falsely fire
    setTimeout(() => {
      document.addEventListener('mouseleave', handleDesktopMouseLeave);
      window.addEventListener('scroll', handleMobileScroll, { passive: true });
    }, 1500);

    // Close handlers
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (dismissBtn) dismissBtn.addEventListener('click', closeModal);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isShown) {
        closeModal();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initExitIntent);
  initExitIntent();
</script>
