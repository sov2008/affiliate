---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FeedItem from '../components/FeedItem.astro';
import Sidebar from '../components/Sidebar.astro';
import DatingSmartlinkCTA from '../components/DatingSmartlinkCTA.astro';
import { CATEGORIES_METADATA, CategoryEnum, type Category } from '../content.config';

// Fetch non-draft posts sorted by pubDate descending
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const pageTitle = "FlirtCheck: Modern Dating Chronicles | From Algorithms to the Human Heart";
const pageDescription = "Cultural, psychological, and algorithmic forensic study of modern romance in 2026. From automated black-box feeds to authentic human vulnerability.";

const categoriesList = CategoryEnum.options.map((key) => CATEGORIES_METADATA[key]);

// Real dynamic category counts for strict zero demo data compliance
const categoryCounts: Record<string, number> = {};
CategoryEnum.options.forEach((key) => {
  categoryCounts[key] = sortedPosts.filter((p) => p.data.category === key).length;
});
---

<BaseLayout title={pageTitle} description={pageDescription} activePath="/">
  <!-- Hero Editorial 90s Newspaper / Comic Banner -->
  <section class="text-center py-10 sm:py-14 relative">
    <div class="mb-4">
      <span class="border border-slate-900 bg-amber-100 text-slate-900 px-3 py-1 text-[11px] font-mono font-bold tracking-widest uppercase shadow-[1px_1px_0px_0px_#0f172a]">
        THE 2026 DATING FORENSICS & ROMANCE GAZETTE
      </span>
    </div>

    <!-- Main H1 Header -->
    <h1 class="font-black text-3xl sm:text-5xl text-slate-900 tracking-tight uppercase leading-none mt-4 mb-3">
      MODERN DATING CHRONICLES: <span class="text-rose-600">FROM ALGORITHMS TO THE HUMAN HEART</span>
    </h1>

    <!-- Canonical "Love is..." Signature Motto & Author Epigraph -->
    <div class="my-6 inline-block bg-white border-2 border-slate-900 rounded-xl px-6 py-4 shadow-[4px_4px_0px_0px_#0f172a] transform -rotate-1 hover:rotate-0 transition-transform max-w-3xl">
      <p class="font-serif italic text-base sm:text-xl text-rose-600 font-semibold leading-relaxed">
        "Love is... knowing that in a world of endless swipes and synthetic scripts, real chemistry happens between two imperfect souls."
      </p>
      <div class="mt-2 text-right">
        <span class="text-xs font-mono font-bold text-slate-500 uppercase tracking-widest">— Notes from an Analog Romantic & FlirtCheck Editorial</span>
      </div>
    </div>

    <!-- Author Lead Manifest -->
    <p class="text-slate-600 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed font-normal mb-8">
      Investigating the collision of synthetic AI personas, algorithmic traps, and genuine human vulnerability. Written from the perspective of an analog romantic in an automated age.
    </p>

    <!-- Interactive Category Filter Stamps Bar -->
    <div class="max-w-4xl mx-auto">
      <div class="flex items-center justify-center gap-2 mb-3">
        <span class="text-xs font-mono uppercase text-slate-600 font-black tracking-wider">
          THEMATIC DOSSIERS:
        </span>
      </div>

      <div id="categoryFilterBar" class="flex flex-wrap items-center justify-center gap-2.5">
        <!-- "All" Filter Button -->
        <button
          type="button"
          data-filter="all"
          class="category-btn active px-3.5 py-1.5 rounded-lg text-xs font-mono font-black uppercase tracking-wider border-2 border-slate-900 bg-slate-900 text-white shadow-[2px_2px_0px_0px_#e11d48] transition-all cursor-pointer hover:-translate-y-0.5"
        >
          [ALL DOSSIERS] ({sortedPosts.length})
        </button>

        <!-- Category Buttons -->
        {categoriesList.map((cat) => {
          const count = sortedPosts.filter((p) => p.data.category === cat.id).length;
          return (
            <button
              type="button"
              data-filter={cat.id}
              class:list={[
                "category-btn px-3.5 py-1.5 rounded-lg text-xs font-mono font-bold uppercase tracking-wider border-2 border-slate-900 shadow-[2px_2px_0px_0px_#0f172a] hover:shadow-[3px_3px_0px_0px_#0f172a] hover:-translate-y-0.5 transition-all cursor-pointer",
                cat.badgeStyle
              ]}
              title={cat.description}
            >
              <span>[{cat.shortTitle}]</span>
              <span class="ml-1 opacity-75 font-normal">({count})</span>
            </button>
          );
        })}
      </div>

      <!-- Active Category Motto & Context Display -->
      <div id="categoryInfoBox" class="hidden mt-6 p-4 bg-white border-2 border-slate-900 rounded-xl shadow-[3px_3px_0px_0px_#0f172a] max-w-2xl mx-auto text-left transition-all">
        <div class="flex items-center gap-2 mb-1.5">
          <span id="categoryInfoTitle" class="font-sans font-black text-sm text-slate-900 uppercase"></span>
          <span class="text-xs text-slate-400 font-mono">•</span>
          <span id="categoryInfoMotto" class="font-serif italic text-xs text-rose-600 font-semibold"></span>
        </div>
        <p id="categoryInfoDesc" class="text-xs text-slate-600 leading-relaxed"></p>
      </div>
    </div>
  </section>

  <!-- 2-COLUMN LAYOUT: Sidebar (w-80 shrink-0) + Feed (flex-1) -->
  <section id="feed" class="mt-6 mb-16">
    <div class="flex flex-col lg:flex-row gap-8 items-start">
      <!-- Left Column: Sticky Classifieds & Info Sidebar -->
      <Sidebar
        activeCategory="all"
        postCount={sortedPosts.length}
        categoryCounts={categoryCounts}
      />

      <!-- Right Column: Editorial Dispatch Feed -->
      <div class="flex-1 w-full min-w-0 space-y-6">
        <div class="flex items-center justify-between pb-4 border-b-2 border-slate-900">
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight flex items-center gap-3 font-sans uppercase">
            <span>EDITORIAL DISPATCH FEED</span>
            <span id="displayedCountBadge" class="px-2.5 py-0.5 rounded border border-slate-900 text-xs font-mono font-black bg-rose-600 text-white shadow-[2px_2px_0px_0px_#0f172a]">
              ARCHIVE RECORDS: {sortedPosts.length} DISPATCHES FILED
            </span>
          </h2>
        </div>

        {sortedPosts.length > 0 ? (
          <div id="postsFeed" class="space-y-6">
            {sortedPosts.map(post => (
              <FeedItem post={post} />
            ))}
          </div>
        ) : (
          <div class="text-center py-16 bg-white rounded-xl border-2 border-slate-900 shadow-[4px_4px_0px_0px_#0f172a]">
            <p class="text-slate-600 font-bold">No dispatches filed yet. Stay tuned!</p>
          </div>
        )}

        <!-- Empty State for Filter -->
        <div id="noPostsFound" class="hidden text-center py-16 bg-white rounded-xl border-2 border-slate-900 shadow-[4px_4px_0px_0px_#0f172a]">
          <p class="text-slate-700 font-bold font-sans text-base">No dispatches found in this category.</p>
          <button
            type="button"
            id="resetFilterBtn"
            class="mt-4 px-4 py-2 bg-rose-600 text-white font-mono text-xs font-black uppercase rounded-lg border-2 border-slate-900 shadow-[2px_2px_0px_0px_#0f172a] hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-none cursor-pointer"
          >
            [SHOW ALL DOSSIERS]
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive CTA Section -->
  <section id="safety-quiz">
    <DatingSmartlinkCTA
      title="Instant Profile Safety & Compatibility Scan"
      subtitle="Run our rapid profile verification radar: filter bot swarms, audit photo metadata, and calibrate authentic chemistry."
      offerUrl="/go"
    />
  </section>
</BaseLayout>

<!-- Client-side Interactive Filter Script -->
<script define:vars={{ categoriesList }}>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.category-btn');
    const sidebarFilters = document.querySelectorAll('[data-sidebar-filter]');
    const feedItems = document.querySelectorAll('.feed-item');
    const displayedCountBadge = document.getElementById('displayedCountBadge');
    const noPostsFound = document.getElementById('noPostsFound');
    const resetFilterBtn = document.getElementById('resetFilterBtn');
    const infoBox = document.getElementById('categoryInfoBox');
    const infoTitle = document.getElementById('categoryInfoTitle');
    const infoMotto = document.getElementById('categoryInfoMotto');
    const infoDesc = document.getElementById('categoryInfoDesc');

    const catMetaMap = {};
    categoriesList.forEach(c => { catMetaMap[c.id] = c; });

    const hashAliasMap = {
      'safety-scams': 'safety-dossier',
      'safety-dossier': 'safety-dossier',
      'algo-mechanics': 'algo-mechanics',
      'modern-psychology': 'modern-psychology',
      'digital-dialogue': 'digital-dialogue',
      'first-dates': 'first-dates',
      'romantic-essays': 'romantic-essays'
    };

    function applyFilter(filterVal) {
      let visibleCount = 0;

      // Update top buttons state
      filterButtons.forEach(btn => {
        const isCurrent = btn.getAttribute('data-filter') === filterVal;
        if (isCurrent) {
          btn.classList.add('ring-2', 'ring-slate-900', 'ring-offset-1', 'scale-105');
        } else {
          btn.classList.remove('ring-2', 'ring-slate-900', 'ring-offset-1', 'scale-105');
        }
      });

      // Update sidebar active link state
      sidebarFilters.forEach(link => {
        const isCurrent = link.getAttribute('data-sidebar-filter') === filterVal;
        if (isCurrent) {
          link.classList.add('bg-slate-900', 'text-white', 'shadow-[2px_2px_0px_0px_#0f172a]');
          link.classList.remove('bg-white', 'hover:bg-amber-50', 'text-slate-900');
          const badge = link.querySelector('span:last-child');
          if (badge) {
            badge.classList.add('text-amber-300');
            badge.classList.remove('text-slate-500');
          }
        } else {
          link.classList.remove('bg-slate-900', 'text-white', 'shadow-[2px_2px_0px_0px_#0f172a]');
          link.classList.add('bg-white', 'hover:bg-amber-50', 'text-slate-900');
          const badge = link.querySelector('span:last-child');
          if (badge) {
            badge.classList.remove('text-amber-300');
            badge.classList.add('text-slate-500');
          }
        }
      });

      // Filter feed items
      feedItems.forEach(card => {
        const cardCat = card.getAttribute('data-category');
        if (filterVal === 'all' || cardCat === filterVal) {
          card.classList.remove('hidden');
          card.classList.add('flex');
          visibleCount++;
        } else {
          card.classList.add('hidden');
          card.classList.remove('flex');
        }
      });

      // Update count badge
      if (displayedCountBadge) {
        displayedCountBadge.textContent = `ARCHIVE RECORDS: ${visibleCount} ${visibleCount === 1 ? 'DISPATCH FILED' : 'DISPATCHES FILED'}`;
      }

      // Show/hide empty notice
      if (noPostsFound) {
        if (visibleCount === 0) {
          noPostsFound.classList.remove('hidden');
        } else {
          noPostsFound.classList.add('hidden');
        }
      }

      // Update info banner
      if (infoBox && infoTitle && infoMotto && infoDesc) {
        if (filterVal !== 'all' && catMetaMap[filterVal]) {
          const meta = catMetaMap[filterVal];
          infoTitle.textContent = meta.title;
          infoMotto.textContent = `"${meta.motto}"`;
          infoDesc.textContent = meta.description;
          infoBox.classList.remove('hidden');
        } else {
          infoBox.classList.add('hidden');
        }
      }
    }

    // Bind top filter buttons
    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filterVal = btn.getAttribute('data-filter');
        applyFilter(filterVal);
      });
    });

    // Bind sidebar category filters
    sidebarFilters.forEach(link => {
      link.addEventListener('click', (e) => {
        const filterVal = link.getAttribute('data-sidebar-filter');
        if (filterVal) {
          e.preventDefault();
          applyFilter(filterVal);
          const feedEl = document.getElementById('feed');
          if (feedEl && window.innerWidth < 1024) {
            feedEl.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    });

    if (resetFilterBtn) {
      resetFilterBtn.addEventListener('click', () => {
        applyFilter('all');
      });
    }

    function checkHash() {
      const rawHash = window.location.hash.replace('#', '');
      const mapped = hashAliasMap[rawHash] || rawHash;
      if (mapped && catMetaMap[mapped]) {
        applyFilter(mapped);
      }
    }

    window.addEventListener('hashchange', checkHash);
    checkHash();
  });
</script>
