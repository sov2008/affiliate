---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FeedItem from '../components/FeedItem.astro';
import Sidebar from '../components/Sidebar.astro';
import IndependenceProtocol from '../components/IndependenceProtocol.astro';
import MobileStickyCTA from '../components/MobileStickyCTA.astro';
import { CATEGORIES_METADATA, CategoryEnum, type Category } from '../content.config';

// Fetch non-draft posts sorted by pubDate descending
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Featured Lead Dispatch is the very first (most recent) dispatch
const featuredPost = sortedPosts[0];
const regularPosts = sortedPosts.slice(1);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const pageTitle = "FlirtCheck: Dating Forensics & Algorithmic Analysis";
const pageDescription = "Independent technical and psychological investigations into matchmaking algorithms, synthetic bot farms, and modern digital romance security.";

const categoriesList = CategoryEnum.options.map((key) => CATEGORIES_METADATA[key]);

// Real dynamic category counts for strict zero demo data compliance
const categoryCounts: Record<string, number> = {};
CategoryEnum.options.forEach((key) => {
  categoryCounts[key] = sortedPosts.filter((p) => p.data.category === key).length;
});

// LCP Featured post cover preload calculation
const rawFeaturedCover = featuredPost?.data?.coverImage || featuredPost?.data?.image;
const featuredPostCover = rawFeaturedCover
  ? (rawFeaturedCover.startsWith('/') ? rawFeaturedCover : `/${rawFeaturedCover}`)
  : `/images/posts/${featuredPost?.id || 'dating-scam-verification-guide-2026'}.webp`;
---

<BaseLayout title={pageTitle} description={pageDescription} activePath="/" preloadImage={featuredPostCover}>
  <link rel="preload" as="image" href={featuredPostCover} fetchpriority="high" type="image/webp" slot="head" />
  
  <!-- Hero Editorial Header: Authentic Journalistic Publication -->
  <section class="text-center py-6 sm:py-8 mb-4 border-b border-slate-200">
    <div class="inline-block mb-2">
      <span class="text-xs font-mono font-bold tracking-widest uppercase text-slate-500">
        INDEPENDENT FORENSIC DESK // DATING SECURITY & ALGORITHMS
      </span>
    </div>

    <!-- Main H1 Header -->
    <h1 class="font-bold text-3xl sm:text-4xl lg:text-5xl text-slate-900 tracking-tight font-sans leading-tight mt-1 mb-3">
      Modern Dating Chronicles: <span class="text-rose-600">From Algorithms to Human Chemistry</span>
    </h1>

    <p class="text-slate-600 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed font-sans mb-6">
      Investigating the collision of commercial matchmaking black-boxes, synthetic persona swarms, and authentic human interaction. Empirical reports, heuristic teardowns, and safety telemetry.
    </p>

    <!-- Category Filter Navigation Bar -->
    <div class="max-w-4xl mx-auto">
      <div id="categoryFilterBar" class="flex overflow-x-auto no-scrollbar py-2 gap-2 sm:flex-wrap sm:justify-center items-center">
        <!-- "All" Filter Button -->
        <button
          type="button"
          data-filter="all"
          class="category-btn active shrink-0 px-3.5 py-1.5 rounded-lg text-xs font-sans font-semibold uppercase tracking-wider border border-slate-900 bg-slate-900 text-white shadow-sm transition-all cursor-pointer hover:bg-slate-800"
        >
          All Topics ({sortedPosts.length})
        </button>

        <!-- Category Buttons -->
        {categoriesList.map((cat) => {
          const count = sortedPosts.filter((p) => p.data.category === cat.id).length;
          return (
            <button
              type="button"
              data-filter={cat.id}
              class="category-btn shrink-0 px-3.5 py-1.5 rounded-lg text-xs font-sans font-medium uppercase tracking-wider border border-slate-300 bg-white hover:border-slate-400 hover:bg-slate-50 text-slate-700 shadow-sm transition-all cursor-pointer"
              title={cat.description}
            >
              <span>{cat.shortTitle}</span>
              <span class="ml-1 opacity-70 font-normal">({count})</span>
            </button>
          );
        })}
      </div>

      <!-- Active Category Context Display -->
      <div id="categoryInfoBox" class="hidden mt-4 p-4 bg-white border border-slate-200 rounded-lg shadow-sm max-w-2xl mx-auto text-left transition-all">
        <div class="flex items-center gap-2 mb-1">
          <span id="categoryInfoTitle" class="font-sans font-bold text-xs sm:text-sm text-slate-900 uppercase tracking-wide"></span>
        </div>
        <p id="categoryInfoDesc" class="text-xs text-slate-600 leading-relaxed font-sans"></p>
      </div>
    </div>
  </section>

  <!-- 2-COLUMN LAYOUT: Sidebar (w-80 shrink-0) + Feed (flex-1) -->
  <section id="feed" class="mt-4 mb-16">
    <div class="flex flex-col lg:flex-row gap-8 items-start">
      <!-- Left Column: Sticky Classifieds & Info Sidebar -->
      <Sidebar
        activeCategory="all"
        postCount={sortedPosts.length}
        categoryCounts={categoryCounts}
      />

      <!-- Right Column: Editorial Dispatch Feed -->
      <div class="flex-1 w-full min-w-0 space-y-6">
        <div class="flex items-center justify-between pb-3 border-b border-slate-200">
          <h2 class="text-lg sm:text-xl font-bold text-slate-900 tracking-tight flex items-center gap-2 font-sans">
            <span>Recent Investigations</span>
            <span id="displayedCountBadge" class="text-xs font-mono text-slate-500 font-medium">
              ({sortedPosts.length} reports)
            </span>
          </h2>
        </div>

        <!-- 1. Featured Lead Dispatch (Breaking Investigation) -->
        {featuredPost && (
          <FeedItem post={featuredPost} isFeatured={true} />
        )}

        <!-- 2. Paginated Regular Dispatches Feed -->
        {regularPosts.length > 0 ? (
          <div id="postsFeed" class="w-full">
            {regularPosts.map((post, idx) => (
              <FeedItem post={post} index={idx} />
            ))}
          </div>
        ) : null}

        <!-- 3. Empty State for Filter -->
        <div id="noPostsFound" class="hidden text-center py-16 bg-white rounded-lg border border-slate-200 shadow-sm">
          <p class="text-slate-700 font-medium font-sans text-base">No investigations found in this category.</p>
          <button
            type="button"
            id="resetFilterBtn"
            class="mt-4 px-4 py-2 bg-slate-900 text-white font-sans text-xs font-semibold uppercase rounded-lg border border-slate-900 hover:bg-slate-800 transition-colors cursor-pointer"
          >
            Show All Articles
          </button>
        </div>

        <!-- 4. Archive Pagination Bar -->
        <div id="feedPagination" class="flex flex-wrap justify-center items-center gap-2 pt-6 border-t border-slate-200 font-sans text-xs">
          <!-- Dynamically generated page buttons -->
        </div>
      </div>
    </div>
  </section>

  <!-- Editorial Transparency & Independence Protocol -->
  <IndependenceProtocol />

  <!-- Mobile Sticky Bottom Conversion Bar -->
  <MobileStickyCTA />
</BaseLayout>

<!-- Client-side Interactive Filter & Archive Pagination Script -->
<script define:vars={{ categoriesList }}>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.category-btn');
    const sidebarFilters = document.querySelectorAll('[data-sidebar-filter]');
    const featuredItem = document.getElementById('featuredDispatch');
    const displayedCountBadge = document.getElementById('displayedCountBadge');
    const noPostsFound = document.getElementById('noPostsFound');
    const resetFilterBtn = document.getElementById('resetFilterBtn');
    const paginationContainer = document.getElementById('feedPagination');
    const infoBox = document.getElementById('categoryInfoBox');
    const infoTitle = document.getElementById('categoryInfoTitle');
    const infoDesc = document.getElementById('categoryInfoDesc');

    const catMetaMap = {};
    categoriesList.forEach(c => { catMetaMap[c.id] = c; });

    const hashAliasMap = {
      'safety-scams': 'safety-dossier',
      'safety-dossier': 'safety-dossier',
      'algo-mechanics': 'algo-mechanics',
      'modern-psychology': 'modern-psychology',
      'digital-dialogue': 'digital-dialogue',
      'first-dates': 'first-dates',
      'romantic-essays': 'romantic-essays'
    };

    const POSTS_PER_PAGE = 8;
    let currentCategory = 'all';

    // 1. Initialize page and category from URLSearchParams
    const urlParams = new URLSearchParams(window.location.search);
    let currentPage = parseInt(urlParams.get('page') || '1', 10);
    if (isNaN(currentPage) || currentPage < 1) currentPage = 1;

    let initialCategory = urlParams.get('category');
    if (!initialCategory || !catMetaMap[initialCategory]) {
      const rawHash = window.location.hash.replace('#', '');
      const mapped = hashAliasMap[rawHash] || rawHash;
      if (mapped && catMetaMap[mapped]) {
        initialCategory = mapped;
      } else {
        initialCategory = 'all';
      }
    }
    currentCategory = initialCategory;

    // 2. Synchronize URL state without reload
    function syncUrlState(replace = false) {
      const url = new URL(window.location.href);
      if (currentPage > 1) {
        url.searchParams.set('page', String(currentPage));
      } else {
        url.searchParams.delete('page');
      }

      if (currentCategory && currentCategory !== 'all') {
        url.searchParams.set('category', currentCategory);
      } else {
        url.searchParams.delete('category');
      }

      const targetUrl = url.pathname + (url.search ? url.search : '') + (url.hash ? url.hash : '');
      const state = { page: currentPage, category: currentCategory };

      if (replace) {
        window.history.replaceState(state, '', targetUrl);
      } else {
        window.history.pushState(state, '', targetUrl);
      }
    }

    function renderPaginationControls(totalPages, page) {
      if (!paginationContainer) return;
      paginationContainer.innerHTML = '';

      if (totalPages <= 1) {
        paginationContainer.classList.add('hidden');
        return;
      }
      paginationContainer.classList.remove('hidden');

      // Page buttons: [PAGE 1], [PAGE 2], ...
      for (let p = 1; p <= totalPages; p++) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = `[PAGE ${p}]`;
        btn.setAttribute('data-page', String(p));
        
        const isCurrent = p === page;
        btn.className = `px-3 py-1.5 rounded-lg border-2 border-slate-900 font-bold uppercase transition-all cursor-pointer shadow-[2px_2px_0px_0px_#0f172a] ${
          isCurrent 
            ? 'bg-slate-900 text-white' 
            : 'bg-white text-slate-900 hover:bg-amber-100 hover:-translate-y-0.5'
        }`;

        btn.addEventListener('click', () => {
          if (currentPage === p) return;
          currentPage = p;
          syncUrlState(false);
          updateFeedDisplay(true);
        });
        paginationContainer.appendChild(btn);
      }

      // [NEXT DISPATCHES →] button
      if (page < totalPages) {
        const nextBtn = document.createElement('button');
        nextBtn.type = 'button';
        nextBtn.textContent = '[NEXT DISPATCHES →]';
        nextBtn.className = 'px-3.5 py-1.5 rounded-lg border-2 border-slate-900 font-black uppercase bg-rose-600 text-white shadow-[2px_2px_0px_0px_#0f172a] hover:bg-rose-700 hover:-translate-y-0.5 transition-all cursor-pointer';
        nextBtn.addEventListener('click', () => {
          currentPage++;
          syncUrlState(false);
          updateFeedDisplay(true);
        });
        paginationContainer.appendChild(nextBtn);
      }
    }

    function updateFeedDisplay(scrollUp = false) {
      const allCards = Array.from(document.querySelectorAll('#postsFeed [data-feed-item]'));

      // 1. Featured Post check (только на 1 странице и если подходит по категории)
      let featuredVisible = false;
      if (featuredItem) {
        const featCat = featuredItem.getAttribute('data-category');
        const matchesCat = currentCategory === 'all' || featCat === currentCategory;
        if (matchesCat && currentPage === 1) {
          featuredItem.classList.remove('hidden');
          featuredVisible = true;
        } else {
          featuredItem.classList.add('hidden');
        }
      }

      // 2. Фильтрация по активной категории
      const visibleCards = allCards.filter(card => {
        if (currentCategory === 'all') return true;
        return card.getAttribute('data-category') === currentCategory;
      });

      // 3. Скрытие постов, не подходящих по категории
      allCards.forEach(card => {
        if (!visibleCards.includes(card)) {
          card.classList.add('hidden');
        }
      });

      // 4. Пагинация только для подходящих постов (строго 8 на страницу)
      const totalPages = Math.ceil(visibleCards.length / POSTS_PER_PAGE) || 1;
      if (currentPage > totalPages) {
        currentPage = totalPages;
        syncUrlState(true);
      }

      const startIndex = (currentPage - 1) * POSTS_PER_PAGE;
      const endIndex = startIndex + POSTS_PER_PAGE;

      visibleCards.forEach((card, idx) => {
        if (idx >= startIndex && idx < endIndex) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });

      // 5. Подсчет общего числа записей
      const totalMatching = visibleCards.length + (featuredVisible ? 1 : 0);
      if (displayedCountBadge) {
        displayedCountBadge.textContent = `ARCHIVE RECORDS: ${totalMatching} ${totalMatching === 1 ? 'DISPATCH FILED' : 'DISPATCHES FILED'}`;
      }

      // 6. Состояние отсутствия записей
      if (noPostsFound) {
        if (totalMatching === 0) {
          noPostsFound.classList.remove('hidden');
        } else {
          noPostsFound.classList.add('hidden');
        }
      }

      // 7. Обновление кнопок пагинатора в DOM
      renderPaginationControls(totalPages, currentPage);

      // 8. Скролл к началу фида при переключении страницы
      if (scrollUp) {
        const feedAnchor = document.getElementById('feed');
        if (feedAnchor && window.scrollY > 250) {
          feedAnchor.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    }

    function applyFilter(filterVal, updateHistory = true) {
      const prevCat = currentCategory;
      currentCategory = filterVal;

      if (updateHistory && prevCat !== filterVal) {
        currentPage = 1;
      }

      // Update top buttons styling
      filterButtons.forEach(btn => {
        const isCurrent = btn.getAttribute('data-filter') === filterVal;
        if (isCurrent) {
          btn.classList.add('ring-2', 'ring-slate-900', 'ring-offset-1', 'scale-105');
        } else {
          btn.classList.remove('ring-2', 'ring-slate-900', 'ring-offset-1', 'scale-105');
        }
      });

      // Update sidebar category link styling
      sidebarFilters.forEach(link => {
        const isCurrent = link.getAttribute('data-sidebar-filter') === filterVal;
        if (isCurrent) {
          link.classList.add('bg-slate-900', 'text-white', 'shadow-[2px_2px_0px_0px_#0f172a]');
          link.classList.remove('bg-white', 'hover:bg-amber-50', 'text-slate-900');
          const badge = link.querySelector('span:last-child');
          if (badge) {
            badge.classList.add('text-amber-300');
            badge.classList.remove('text-slate-500');
          }
        } else {
          link.classList.remove('bg-slate-900', 'text-white', 'shadow-[2px_2px_0px_0px_#0f172a]');
          link.classList.add('bg-white', 'hover:bg-amber-50', 'text-slate-900');
          const badge = link.querySelector('span:last-child');
          if (badge) {
            badge.classList.remove('text-amber-300');
            badge.classList.add('text-slate-500');
          }
        }
      });

      // Update info banner
      if (infoBox && infoTitle && infoDesc) {
        if (filterVal !== 'all' && catMetaMap[filterVal]) {
          const meta = catMetaMap[filterVal];
          infoTitle.textContent = meta.title;
          infoDesc.textContent = meta.description;
          infoBox.classList.remove('hidden');
        } else {
          infoBox.classList.add('hidden');
        }
      }

      if (updateHistory) {
        syncUrlState(false);
      }

      updateFeedDisplay(false);
    }

    // Bind filter buttons
    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filterVal = btn.getAttribute('data-filter');
        applyFilter(filterVal, true);
      });
    });

    sidebarFilters.forEach(link => {
      link.addEventListener('click', (e) => {
        const filterVal = link.getAttribute('data-sidebar-filter');
        if (filterVal) {
          e.preventDefault();
          applyFilter(filterVal, true);
          const feedEl = document.getElementById('feed');
          if (feedEl && window.innerWidth < 1024) {
            feedEl.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    });

    if (resetFilterBtn) {
      resetFilterBtn.addEventListener('click', () => {
        applyFilter('all', true);
      });
    }

    // 3. Browser Back / Forward navigation handling (popstate)
    window.addEventListener('popstate', () => {
      const params = new URLSearchParams(window.location.search);
      let pageFromUrl = parseInt(params.get('page') || '1', 10);
      if (isNaN(pageFromUrl) || pageFromUrl < 1) pageFromUrl = 1;
      const catFromUrl = params.get('category') || 'all';

      currentPage = pageFromUrl;
      const validCategory = (catMetaMap[catFromUrl] || catFromUrl === 'all') ? catFromUrl : 'all';
      applyFilter(validCategory, false);
    });

    function checkHash() {
      const rawHash = window.location.hash.replace('#', '');
      const mapped = hashAliasMap[rawHash] || rawHash;
      if (mapped && catMetaMap[mapped]) {
        applyFilter(mapped, true);
      }
    }
    window.addEventListener('hashchange', checkHash);

    // Initial run
    applyFilter(currentCategory, false);
    syncUrlState(true);
  });
</script>
