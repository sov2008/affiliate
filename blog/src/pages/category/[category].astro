---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FeedItem from '../../components/FeedItem.astro';
import Sidebar from '../../components/Sidebar.astro';
import MobileStickyCTA from '../../components/MobileStickyCTA.astro';
import ProfileScanner from '../../components/ProfileScanner.astro';
import { CATEGORIES_METADATA, CategoryEnum, type Category } from '../../content.config';

export async function getStaticPaths() {
  return CategoryEnum.options.map((categoryKey) => ({
    params: { category: categoryKey },
    props: { categoryKey },
  }));
}

const { categoryKey } = Astro.props;
const categoryMeta = CATEGORIES_METADATA[categoryKey as Category];

// Fetch all non-draft posts for sidebar stats and counting
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const categoryCounts: Record<string, number> = {};
CategoryEnum.options.forEach((key) => {
  categoryCounts[key] = allPosts.filter((p) => p.data.category === key).length;
});

// Category-specific posts sorted descending
const categoryPosts = allPosts
  .filter((p) => p.data.category === categoryKey)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const pageTitle = `${categoryMeta.title} | FlirtCheck Safety Editorial`;
const pageDescription = `${categoryMeta.description} Articles and forensic guides filed under ${categoryMeta.title}.`;
---

<BaseLayout title={pageTitle} description={pageDescription} activePath={`/category/${categoryKey}`}>
  <!-- Category Header Banner (Compacted Newsprint Edition) -->
  <section class="text-center py-6 sm:py-8 mb-6 relative">
    <div class="inline-flex items-center gap-2 mb-3">
      <a href="/" class="text-xs font-mono font-bold text-slate-500 hover:text-rose-600 uppercase tracking-wider">
        ← Return to All Chronicles
      </a>
    </div>

    <div class="mb-3">
      <span class:list={[
        "inline-block border-2 border-slate-900 px-3.5 py-1 rounded-lg text-xs font-mono font-black uppercase tracking-wider shadow-[2px_2px_0px_0px_#0f172a]",
        categoryMeta.badgeStyle
      ]}>
        DOSSIER: {categoryMeta.shortTitle}
      </span>
    </div>

    <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight max-w-3xl mx-auto mb-3 font-sans uppercase">
      {categoryMeta.title}
    </h1>

    <!-- Category Love is... Motto -->
    <div class="my-4 inline-block bg-white border-2 border-slate-900 rounded-xl px-5 py-3 shadow-[4px_4px_0px_0px_#0f172a] transform -rotate-1 hover:rotate-0 transition-transform max-w-2xl">
      <p class="font-serif italic text-sm sm:text-base text-rose-600 font-semibold leading-relaxed">
        "{categoryMeta.motto}"
      </p>
    </div>

    <p class="text-xs sm:text-sm text-slate-600 max-w-xl mx-auto leading-relaxed font-normal">
      {categoryMeta.description}
    </p>
  </section>

  <!-- 2-COLUMN LAYOUT: Sidebar (w-80 shrink-0) + Feed (flex-1) -->
  <section class="mt-2 mb-16">
    <div class="flex flex-col lg:flex-row gap-8 items-start">
      <!-- Left Column: Sticky Classifieds & Category Index Sidebar -->
      <Sidebar
        activeCategory={categoryKey}
        postCount={allPosts.length}
        categoryCounts={categoryCounts}
      />

      <!-- Right Column: Category Dispatches Feed -->
      <div class="flex-1 w-full min-w-0 space-y-6">
        <div class="flex items-center justify-between pb-3 border-b-2 border-slate-900">
          <h2 class="text-lg sm:text-xl font-black text-slate-900 tracking-tight flex items-center gap-3 font-sans uppercase">
            <span>DOSSIER DISPATCHES</span>
            <span class="px-2.5 py-0.5 rounded border border-slate-900 text-xs font-mono font-black bg-rose-600 text-white shadow-[2px_2px_0px_0px_#0f172a]">
              {categoryPosts.length} {categoryPosts.length === 1 ? 'RECORD' : 'RECORDS'} FILED
            </span>
          </h2>
        </div>

        {categoryPosts.length > 0 ? (
          <div class="w-full space-y-6">
            {categoryPosts.map((post, idx) => (
              <FeedItem post={post} index={idx} />
            ))}
          </div>
        ) : (
          <div class="text-center py-16 bg-white rounded-xl border-2 border-slate-900 shadow-[4px_4px_0px_0px_#0f172a]">
            <p class="text-slate-700 font-bold font-sans text-base">
              No dispatches filed in this dossier yet.
            </p>
            <a
              href="/"
              class="mt-4 inline-block px-4 py-2 bg-slate-900 text-white text-xs font-mono font-black uppercase rounded-lg border-2 border-slate-900 shadow-[2px_2px_0px_0px_#0f172a] hover:-translate-y-0.5 transition-all cursor-pointer"
            >
              [RETURN TO MAIN ARCHIVE]
            </a>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Interactive Forensic Scanner Section -->
  <section id="safety-quiz">
    <ProfileScanner
      title="Instant Profile Safety & Compatibility Scan"
      subtitle="Run our rapid profile verification radar: filter bot swarms, audit photo metadata, and calibrate authentic chemistry."
    />
  </section>

  <!-- Mobile Sticky Bottom Conversion Bar -->
  <MobileStickyCTA />
</BaseLayout>
