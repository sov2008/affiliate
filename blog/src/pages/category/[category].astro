---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FeedItem from '../../components/FeedItem.astro';
import Sidebar from '../../components/Sidebar.astro';
import MobileStickyCTA from '../../components/MobileStickyCTA.astro';
import IndependenceProtocol from '../../components/IndependenceProtocol.astro';
import { CATEGORIES_METADATA, CategoryEnum, type Category } from '../../content.config';

export async function getStaticPaths() {
  return CategoryEnum.options.map((categoryKey) => ({
    params: { category: categoryKey },
    props: { categoryKey },
  }));
}

const { categoryKey } = Astro.props;
const categoryMeta = CATEGORIES_METADATA[categoryKey as Category];

// Fetch all non-draft posts for sidebar stats and counting
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const categoryCounts: Record<string, number> = {};
CategoryEnum.options.forEach((key) => {
  categoryCounts[key] = allPosts.filter((p) => p.data.category === key).length;
});

// Category-specific posts sorted descending
const categoryPosts = allPosts
  .filter((p) => p.data.category === categoryKey)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const pageTitle = `${categoryMeta.title} | FlirtCheck Safety Editorial`;
const pageDescription = `${categoryMeta.description} Articles and forensic guides filed under ${categoryMeta.title}.`;
---

<BaseLayout title={pageTitle} description={pageDescription} activePath={`/category/${categoryKey}`}>
  <!-- Category Header Banner -->
  <section class="text-center py-6 sm:py-8 mb-6 border-b border-slate-200">
    <div class="inline-flex items-center gap-2 mb-3">
      <a href="/" class="text-xs font-sans text-slate-500 hover:text-slate-900 transition-colors">
        &larr; Return to All Articles
      </a>
    </div>

    <div class="mb-2">
      <span class="inline-block px-3 py-1 rounded text-xs font-sans font-medium uppercase tracking-wider bg-slate-100 text-slate-800 border border-slate-300">
        {categoryMeta.shortTitle}
      </span>
    </div>

    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-900 tracking-tight max-w-3xl mx-auto mb-3 font-sans">
      {categoryMeta.title}
    </h1>

    <p class="text-sm sm:text-base text-slate-600 max-w-xl mx-auto leading-relaxed font-sans">
      {categoryMeta.description}
    </p>
  </section>

  <!-- 2-COLUMN LAYOUT: Sidebar (w-80 shrink-0) + Feed (flex-1) -->
  <section class="mt-2 mb-16">
    <div class="flex flex-col lg:flex-row gap-8 items-start">
      <!-- Left Column: Sticky Classifieds & Category Index Sidebar -->
      <Sidebar
        activeCategory={categoryKey}
        postCount={allPosts.length}
        categoryCounts={categoryCounts}
      />

      <!-- Right Column: Category Dispatches Feed -->
      <div class="flex-1 w-full min-w-0 space-y-6">
        <div class="flex items-center justify-between pb-3 border-b border-slate-200">
          <h2 class="text-lg sm:text-xl font-bold text-slate-900 tracking-tight flex items-center gap-2 font-sans">
            <span>{categoryMeta.shortTitle} Investigations</span>
            <span class="text-xs font-mono text-slate-500 font-medium">
              ({categoryPosts.length} {categoryPosts.length === 1 ? 'report' : 'reports'})
            </span>
          </h2>
        </div>

        {categoryPosts.length > 0 ? (
          <div class="w-full space-y-6">
            {categoryPosts.map((post, idx) => (
              <FeedItem post={post} index={idx} />
            ))}
          </div>
        ) : (
          <div class="text-center py-16 bg-white rounded-lg border border-slate-200 shadow-sm">
            <p class="text-slate-700 font-medium font-sans text-base">
              No investigations filed in this category yet.
            </p>
            <a
              href="/"
              class="mt-4 inline-block px-4 py-2 bg-slate-900 text-white text-xs font-sans font-medium uppercase rounded-lg border border-slate-900 hover:bg-slate-800 transition-colors cursor-pointer"
            >
              Return to Main Archive
            </a>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Editorial Transparency & Independence Protocol -->
  <IndependenceProtocol />

  <!-- Mobile Sticky Bottom Conversion Bar -->
  <MobileStickyCTA />
</BaseLayout>
