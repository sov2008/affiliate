---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES_METADATA, CategoryEnum } from '../content.config';

export const prerender = true;

const categoriesList = CategoryEnum.options.map((key) => CATEGORIES_METADATA[key]);
---

<BaseLayout
  title="Case File Expunged // 404 Not Found | FlirtCheck Investigation"
  description="The requested investigative dossier could not be located in the archival records of the Cheltenham Bureau."
  activePath="/404"
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 text-center">
    <div class="inline-flex items-center gap-2 border border-slate-300 bg-white px-3 py-1.5 font-mono text-[10px] uppercase tracking-widest text-slate-600 mb-6">
      <span class="w-2 h-2 bg-rose-600 rounded-full animate-pulse"></span>
      ARCHIVAL NOTICE // STATUS CODE: 404
    </div>

    <h1 class="font-serif font-black text-4xl sm:text-6xl text-slate-900 tracking-tight mb-4">
      Case File Expunged
    </h1>

    <p class="font-mono text-xs sm:text-sm uppercase tracking-wider text-rose-700 font-bold mb-6">
      [ RECORD NOT LOCATED IN ARCHIVE ]
    </p>

    <div class="max-w-xl mx-auto border-t border-b border-slate-200 py-6 mb-8 text-slate-700 font-sans text-base sm:text-lg leading-relaxed text-left sm:text-center">
      The intelligence dossier, verification log, or dispatch you requested cannot be retrieved. The file may have been reclassified under confidential clearance, moved to cold storage, or purged following telemetric validation failure.
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
      <a
        href="/"
        class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 bg-slate-900 hover:bg-slate-800 text-white font-mono font-bold text-xs uppercase tracking-widest transition-colors"
      >
        ← Return to Active Archive
      </a>
      <a
        href="/#categories"
        class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 bg-white hover:bg-slate-50 text-slate-900 border border-slate-300 font-mono font-bold text-xs uppercase tracking-widest transition-colors"
      >
        Browse Category Dossiers
      </a>
    </div>

    <div class="border border-slate-300 bg-white p-6 text-left max-w-2xl mx-auto">
      <span class="font-mono text-[10px] font-bold uppercase tracking-widest text-slate-500 block mb-4">
        [ ALTERNATIVE INVESTIGATIVE DEPARTMENTS ]
      </span>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 font-sans">
        {categoriesList.map((cat) => (
          <a
            href={`/category/${cat.id}`}
            class="p-3 border border-slate-200 hover:border-slate-400 bg-[#FAF7F2] flex items-center justify-between group transition-colors"
          >
            <div>
              <div class="font-serif font-bold text-sm text-slate-900 group-hover:text-rose-700">
                {cat.shortTitle}
              </div>
              <div class="font-mono text-[10px] text-slate-500">
                {cat.code}
              </div>
            </div>
            <span class="font-mono text-xs text-slate-500 group-hover:text-slate-900 group-hover:translate-x-0.5 transition-transform">↗</span>
          </a>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>
