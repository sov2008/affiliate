---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;

const siteUrl = 'https://flirtcheck.site';

const calculatorSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "FlirtCheck Romance Fraud & Bot Risk Calculator",
  "url": `${siteUrl}/calculator/`,
  "applicationCategory": "SecurityApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": "Client-side forensic audit engine evaluating romance scam signatures, synthetic bot farms, and identity manipulation across dating platforms.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "author": {
    "@type": "Person",
    "name": "Arthur Vance",
    "jobTitle": "Lead Forensic Desk",
    "url": `${siteUrl}/desk`
  }
};
---

<BaseLayout
  title="Romance Scam Risk Calculator // Instant Forensic Audit | FlirtCheck"
  description="Client-side zero-data forensic tool to calculate romance scam risk. Audit communication velocity, video verification, visual GAN markers, and crypto extraction patterns."
  canonicalUrl={`${siteUrl}/calculator/`}
  activePath="/calculator"
  schemas={[calculatorSchema]}
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Top Header Badge -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center gap-2 border border-slate-300 bg-white px-3 py-1 font-mono text-[10px] uppercase tracking-widest text-slate-600 mb-3">
        <span class="w-2 h-2 rounded-full bg-rose-600 animate-pulse"></span>
        CHELTENHAM FORENSIC TOOLKIT // ZERO-DATA ENGINE
      </div>
      <h1 class="font-serif font-black text-3xl sm:text-5xl text-slate-900 tracking-tight leading-tight mb-3">
        Romance Fraud Risk Calculator
      </h1>
      <p class="text-sm sm:text-base text-slate-700 font-sans max-w-2xl mx-auto leading-relaxed">
        Cross-reference suspicious dating behavior against verified cybercrime patterns. All computations occur client-side in your browser; zero personal data is recorded or transmitted.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Interactive Audit Form (7 cols) -->
      <div class="lg:col-span-7 bg-white border border-slate-300 p-5 sm:p-6 space-y-6">
        <div class="border-b border-slate-200 pb-3 flex items-center justify-between">
          <span class="font-mono text-xs font-bold uppercase tracking-wider text-slate-900">
            [ PARAMETERS EVALUATION ]
          </span>
          <span class="font-mono text-[11px] text-slate-500 font-medium">5 Threat Vectors</span>
        </div>

        <!-- Vector 1: Communication Velocity -->
        <div class="space-y-2">
          <label class="font-serif font-bold text-sm text-slate-900 block">
            1. Communication Velocity & External Migration
          </label>
          <p class="text-xs text-slate-600 font-sans leading-relaxed">
            How quickly did this match push to move conversation off the dating app to WhatsApp, Telegram, or SMS?
          </p>
          <div class="space-y-1.5 pt-1 font-sans text-xs">
            <label class="flex items-start gap-2 p-2.5 border border-slate-200 hover:border-slate-400 bg-[#FAF7F2] cursor-pointer transition-colors">
              <input type="radio" name="v1" value="0" checked class="mt-0.5" />
              <span>Normal pacing: stayed on dating app for several days or until first date planned (0 pts)</span>
            </label>
            <label class="flex items-start gap-2 p-2.5 border border-slate-200 hover:border-slate-400 bg-[#FAF7F2] cursor-pointer transition-colors">
              <input type="radio" name="v1" value="20" class="mt-0.5" />
              <span>Aggressive push: asked for WhatsApp / Telegram within 24–48 hours (+20 pts)</span>
            </label>
            <label class="flex items-start gap-2 p-2.5 border border-slate-200 hover:border-slate-400 bg-[#FAF7F2] cursor-pointer transition-colors">
              <input type="radio" name="v1" value="35" class="mt-0.5" />
              <span>Immediate extraction: first or second message provided phone number / Telegram link (+35 pts)</span>
            </label>
          </div>
        </div>

        <!-- Vector 2: Live Video Verification -->
        <div class="space-y-2">
          <label class="font-serif font-bold text-sm text-slate-900 block">
            2. Live Video Call Verification
          </label>
          <p class="text-xs text-slate-600 font-sans leading-relaxed">
            Have you completed a live 15-second two-way video conversation with sound and natural movement?
          </p>
          <div class="space-y-1.5 pt-1 font-sans text-xs">
            <label class="flex items-start gap-2 p-2.5 border border-slate-200 hover:border-slate-400 bg-[#FAF7F2] cursor-pointer transition-colors">
              <input type="radio" name="v2" value="0" checked class="mt-0.5" />
              <span>Clear live video call completed with organic verbal interaction (0 pts)</span>
            </label>
            <label class="flex items-start gap-2 p-2.5 border border-slate-200 hover:border-slate-400 bg-[#FAF7F2] cursor-pointer transition-colors">
              <input type="radio" name="v2" value="25" class="mt-0.5" />
              <span>Glitched video: connection freezes instantly, camera "broken", or pre-recorded looping video (+25 pts)</span>
            </label>
            <label class="flex items-start gap-2 p-2.5 border border-slate-200 hover:border-slate-400 bg-[#FAF7F2] cursor-pointer transition-colors">
              <input type="radio" name="v2" value="35" class="mt-0.5" />
              <span>Repeated refusals: cites military deployment, secret job, broken camera, or personal shyness (+35 pts)</span>
            </label>
          </div>
        </div>

        <!-- Vector 3: Profile Photos & Visual Consistency -->
        <div class="space-y-2">
          <label class="font-serif font-bold text-sm text-slate-900 block">
            3. Visual Imagery & Photo Authenticity
          </label>
          <p class="text-xs text-slate-600 font-sans leading-relaxed">
            What is the aesthetic nature of the profile gallery photographs?
          </p>
          <div class="space-y-1.5 pt-1 font-sans text-xs">
            <label class="flex items-start gap-2 p-2.5 border border-slate-200 hover:border-slate-400 bg-[#FAF7F2] cursor-pointer transition-colors">
              <input type="radio" name="v3" value="0" checked class="mt-0.5" />
              <span>Candid, authentic photos with natural lighting, friends, and recognizable local settings (0 pts)</span>
            </label>
            <label class="flex items-start gap-2 p-2.5 border border-slate-200 hover:border-slate-400 bg-[#FAF7F2] cursor-pointer transition-colors">
              <input type="radio" name="v3" value="20" class="mt-0.5" />
              <span>High-fashion model studio shots exclusively, luxury cars, zero candid friends (+20 pts)</span>
            </label>
            <label class="flex items-start gap-2 p-2.5 border border-slate-200 hover:border-slate-400 bg-[#FAF7F2] cursor-pointer transition-colors">
              <input type="radio" name="v3" value="35" class="mt-0.5" />
              <span>Stolen influencer photos found on Google/PimEyes, or AI GAN artifacts (ears/hands blurred) (+35 pts)</span>
            </label>
          </div>
        </div>

        <!-- Vector 4: Financial & Investment Probing -->
        <div class="space-y-2">
          <label class="font-serif font-bold text-sm text-slate-900 block">
            4. Financial, Crypto, or Investment Mentions
          </label>
          <p class="text-xs text-slate-600 font-sans leading-relaxed">
            Has there been any mention of crypto trading, financial mentors, unexpected fees, or sudden emergencies?
          </p>
          <div class="space-y-1.5 pt-1 font-sans text-xs">
            <label class="flex items-start gap-2 p-2.5 border border-slate-200 hover:border-slate-400 bg-[#FAF7F2] cursor-pointer transition-colors">
              <input type="radio" name="v4" value="0" checked class="mt-0.5" />
              <span>Zero discussion of money, cryptocurrency, investments, or financial hardships (0 pts)</span>
            </label>
            <label class="flex items-start gap-2 p-2.5 border border-slate-200 hover:border-slate-400 bg-[#FAF7F2] cursor-pointer transition-colors">
              <input type="radio" name="v4" value="30" class="mt-0.5" />
              <span>Subtle hints: mentions uncle in finance, passive crypto income, or secondary trading app (+30 pts)</span>
            </label>
            <label class="flex items-start gap-2 p-2.5 border border-slate-200 hover:border-slate-400 bg-[#FAF7F2] cursor-pointer transition-colors">
              <input type="radio" name="v4" value="50" class="mt-0.5" />
              <span>Direct pitch: invites you to invest on a custom platform, send gift cards, or assist with a transfer (+50 pts)</span>
            </label>
          </div>
        </div>

        <!-- Vector 5: Geographic & Linguistic Telemetry -->
        <div class="space-y-2">
          <label class="font-serif font-bold text-sm text-slate-900 block">
            5. Geographic & Linguistic Telemetry
          </label>
          <p class="text-xs text-slate-600 font-sans leading-relaxed">
            Do their chat hours, cultural references, and knowledge of your declared city match up?
          </p>
          <div class="space-y-1.5 pt-1 font-sans text-xs">
            <label class="flex items-start gap-2 p-2.5 border border-slate-200 hover:border-slate-400 bg-[#FAF7F2] cursor-pointer transition-colors">
              <input type="radio" name="v5" value="0" checked class="mt-0.5" />
              <span>Deep familiar knowledge of local neighborhoods, time-zone matches active chatting (0 pts)</span>
            </label>
            <label class="flex items-start gap-2 p-2.5 border border-slate-200 hover:border-slate-400 bg-[#FAF7F2] cursor-pointer transition-colors">
              <input type="radio" name="v5" value="15" class="mt-0.5" />
              <span>Vague local knowledge: claims to live nearby but sleeps during local daytime hours (+15 pts)</span>
            </label>
            <label class="flex items-start gap-2 p-2.5 border border-slate-200 hover:border-slate-400 bg-[#FAF7F2] cursor-pointer transition-colors">
              <input type="radio" name="v5" value="25" class="mt-0.5" />
              <span>Severe discrepancies: translated syntax, mismatched regional phone codes, avoids local cafes (+25 pts)</span>
            </label>
          </div>
        </div>
      </div>

      <!-- Right Column: Live Risk Verdict Gauge (5 cols, sticky) -->
      <div class="lg:col-span-5 sticky top-24 space-y-5">
        <div class="bg-white border border-slate-300 p-5 sm:p-6">
          <div class="border-b border-slate-200 pb-3 flex items-center justify-between mb-4">
            <span class="font-mono text-xs font-bold uppercase tracking-wider text-slate-900">
              [ THREAT VERDICT // LIVE ]
            </span>
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-600" id="statusDot"></span>
          </div>

          <!-- Gauge Score Display -->
          <div class="text-center py-4 bg-[#FAF7F2] border border-slate-200 mb-5">
            <span class="font-mono text-[10px] font-bold uppercase tracking-widest text-slate-500 block mb-1">
              COMPUTED ROMANCE THREAT SCORE
            </span>
            <div class="font-serif font-black text-5xl sm:text-6xl text-slate-900" id="scoreDisplay">
              0%
            </div>
            <span
              id="riskBadge"
              class="inline-block mt-2 font-mono text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 bg-emerald-100 text-emerald-800 border border-emerald-300"
            >
              LOW RISK // VERIFIED SIGNATURE
            </span>
          </div>

          <!-- Remediation Protocol Box -->
          <div class="space-y-3 font-sans text-xs text-slate-700 leading-relaxed mb-6">
            <h4 class="font-serif font-bold text-sm text-slate-900">
              Bureau Operational Guidelines:
            </h4>
            <ul id="recommendationList" class="space-y-2 list-disc pl-4 text-slate-600">
              <li>Profile telemetry exhibits low anomaly deviation across initial matching parameters.</li>
              <li>Continue normal dating precautions: always meet in public venues during daytime hours.</li>
              <li>Never provide personal home address, financial account details, or unredacted ID documents.</li>
            </ul>
          </div>

          <!-- Official Verification CTA Button -->
          <a
            href="/go?source=calculator&trigger=verdict_cta&intent=verified_portal"
            rel="nofollow sponsored"
            target="_blank"
            class="min-h-[44px] w-full flex items-center justify-center text-center px-4 py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-mono font-bold text-xs uppercase tracking-wider transition-colors shadow-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900"
          >
            Run Deep Profile Verification ↗
          </a>
        </div>

        <!-- Dispatches Backlink Card -->
        <div class="border border-slate-300 bg-[#FAF7F2] p-4 text-xs font-mono">
          <span class="text-slate-500 block mb-1 font-bold">[ RELATED CASE FILES ]</span>
          <a href="/pig-butchering-scam-dating-apps-2026s-ultimate-survival-guide/" class="text-slate-900 hover:text-rose-700 block underline underline-offset-2 mb-1">
            Case FC-2026 // Pig Butchering Playbook ↗
          </a>
          <a href="/the-48-hour-whatsapp-move-crypto-dating-funnel-anatomy/" class="text-slate-900 hover:text-rose-700 block underline underline-offset-2">
            Case FC-2026 // The 48-Hour WhatsApp Move ↗
          </a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  function initRiskCalculator() {
    const radios = document.querySelectorAll<HTMLInputElement>('input[type="radio"]');
    const scoreDisplay = document.getElementById('scoreDisplay');
    const riskBadge = document.getElementById('riskBadge');
    const statusDot = document.getElementById('statusDot');
    const recList = document.getElementById('recommendationList');

    function calculateRisk() {
      let sum = 0;
      const maxPossible = 195; // 35 + 35 + 35 + 50 + 25 + bonus

      radios.forEach((r) => {
        if (r.checked) {
          sum += parseInt(r.value, 10) || 0;
        }
      });

      const pct = Math.min(100, Math.round((sum / 145) * 100));

      if (scoreDisplay) {
        scoreDisplay.textContent = `${pct}%`;
      }

      if (pct <= 25) {
        if (riskBadge) {
          riskBadge.textContent = 'LOW RISK // NORMAL PATTERN';
          riskBadge.className = 'inline-block mt-2 font-mono text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 bg-emerald-100 text-emerald-800 border border-emerald-300';
        }
        if (statusDot) {
          statusDot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-600';
        }
        if (recList) {
          recList.innerHTML = `
            <li>Profile telemetry displays zero high-risk pig-butchering signatures.</li>
            <li>Maintain standard dating safety: always choose populated public venues for initial meetings.</li>
            <li>Keep communication on the dating platform until you have met in person.</li>
          `;
        }
      } else if (pct <= 60) {
        if (riskBadge) {
          riskBadge.textContent = 'MODERATE RISK // ANOMALIES FLAGGED';
          riskBadge.className = 'inline-block mt-2 font-mono text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 bg-amber-100 text-amber-800 border border-amber-300';
        }
        if (statusDot) {
          statusDot.className = 'w-2.5 h-2.5 rounded-full bg-amber-600';
        }
        if (recList) {
          recList.innerHTML = `
            <li>Elevated behavioral markers detected: rapid off-platform push or photo inconsistencies.</li>
            <li>Demand a 15-second live video call before disclosing telephone numbers or personal social media.</li>
            <li>Execute a reverse image search on Google Lens and PimEyes to verify photo ownership.</li>
          `;
        }
      } else {
        if (riskBadge) {
          riskBadge.textContent = 'CRITICAL FRAUD SIGNATURE // HIGH RISK';
          riskBadge.className = 'inline-block mt-2 font-mono text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 bg-rose-100 text-rose-800 border border-rose-300';
        }
        if (statusDot) {
          statusDot.className = 'w-2.5 h-2.5 rounded-full bg-rose-600 animate-pulse';
        }
        if (recList) {
          recList.innerHTML = `
            <li><strong>CRITICAL ALERT:</strong> Behavioral telemetry strictly matches commercial romance scam scripts.</li>
            <li><strong>IMMEDIATE ACTION:</strong> Cease communication, capture unedited screenshots of chat logs, and block account.</li>
            <li><strong>NEVER SEND FUNDS:</strong> Do not download third-party trading apps, send cryptocurrency, or wire funds under any pretext.</li>
          `;
        }
      }
    }

    radios.forEach((r) => {
      r.addEventListener('change', calculateRisk);
    });

    calculateRisk();
  }

  document.addEventListener('DOMContentLoaded', initRiskCalculator);
  initRiskCalculator();
</script>
