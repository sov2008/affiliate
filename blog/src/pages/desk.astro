---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  buildAuthorProfileSchema,
  buildOrganizationSchema,
  buildBreadcrumbSchema
} from '../utils/schema';

const moneroAddress = "888tNkZrPN6JsEgekjMnABU4TBmb2AnjC429Yum3A5sCpd4B21x1oF7hH5kQ8wU7vJ9zE3sD8rN1L3W8hP2pZ4V7M3f9X6a";
const siteUrl = 'https://flirtcheck.site';

const deskSchemas = [
  buildOrganizationSchema(siteUrl),
  buildAuthorProfileSchema(siteUrl),
  buildBreadcrumbSchema([
    { name: 'Home', url: `${siteUrl}/` },
    { name: 'Investigator Dossier & Bureau Manifesto', url: `${siteUrl}/desk` }
  ])
];
---

<BaseLayout
  title="Arthur Vance // Lead Forensic Desk — Cheltenham Bureau"
  description="Investigative dossier, methodology, and independence manifesto of Arthur Vance, Lead Forensic Desk in Cheltenham, UK. Reverse-engineering commercial dating algorithms and automated fraud funnels."
  activePath="/desk"
  imageUrl="/images/author/arthur-vance-avatar.webp"
  schemas={deskSchemas}
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    
    <!-- Top Nav Backlink & Breadcrumb -->
    <div class="mb-6 flex items-center justify-between gap-4 text-xs font-mono">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 font-bold text-slate-700 hover:text-rose-600 transition-colors uppercase"
      >
        <span>← RETURN TO DISPATCHES</span>
      </a>
      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="text-slate-500 uppercase font-bold tracking-wider text-[11px]">CHELTENHAM DESK // ACTIVE</span>
      </div>
    </div>

    <!-- 1. HEADER DOSSIER -->
    <div class="bg-white border border-slate-300 rounded-none sm:rounded-sm p-6 sm:p-8 mb-8">
      <div class="flex flex-col md:flex-row items-center md:items-start gap-6 sm:gap-8">
        
        <!-- Author Portrait -->
        <div class="w-full md:w-52 shrink-0">
          <div class="aspect-square rounded-none sm:rounded-sm overflow-hidden border border-slate-300 bg-slate-100">
            <img
              src="/images/author/arthur-vance-avatar.webp"
              alt="Arthur Vance, Lead Forensic Desk in Cheltenham UK"
              class="w-full h-full object-cover object-center"
              loading="eager"
              width="208"
              height="208"
            />
          </div>
          <div class="mt-2.5 text-center">
            <span class="font-mono text-[10px] font-bold text-slate-500 uppercase tracking-wider block">
              OPERATIONAL ID: AV-40-UK
            </span>
          </div>
        </div>

        <!-- Bio Details -->
        <div class="flex-1 min-w-0 text-center md:text-left">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-slate-100 border border-slate-300 text-[10px] font-mono font-bold text-slate-700 mb-3">
            <span>STATION: CHELTENHAM, GLOUCESTERSHIRE, UK</span>
          </div>

          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 uppercase tracking-tight font-serif mb-3">
            Arthur Vance
          </h1>

          <p class="text-sm sm:text-base text-slate-700 leading-relaxed mb-4 font-sans">
            Arthur Vance investigates commercial matchmaking telemetry, hidden ELO ranking systems, and deceptive digital persona funnels. Independent forensic reporter operating under confidential source protocols since 2019.
          </p>

          <!-- Status Bar -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-mono pt-4 border-t border-slate-200">
            <div class="flex items-center gap-2">
              <span class="text-slate-500 font-bold">SPECIALTY:</span>
              <span class="text-slate-900 font-bold">Matchmaking Telemetry & Bot Swarms</span>
            </div>
            <div class="flex items-center gap-2 sm:justify-end">
              <span class="text-slate-500 font-bold">STATUS:</span>
              <span class="inline-flex items-center gap-1 text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 border border-emerald-300 text-[11px]">
                ✓ Verified Independent
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. EDITORIAL MANIFESTO -->
    <article class="bg-white border border-slate-300 rounded-none sm:rounded-sm p-6 sm:p-10 mb-8 prose prose-slate max-w-none">
      <div class="border-b border-slate-200 pb-4 mb-6 not-prose flex justify-between items-end flex-wrap gap-2">
        <div>
          <span class="text-[10px] font-mono font-bold uppercase text-rose-700 tracking-widest block">INVESTIGATIVE MANIFESTO</span>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 uppercase tracking-tight font-serif mt-0.5">
            The Economics of Manufactured Loneliness
          </h2>
        </div>
        <span class="font-mono text-xs text-slate-500">DISPATCH REF // MANIFESTO-2026</span>
      </div>

      <p class="text-base sm:text-lg leading-relaxed text-slate-800 font-sans">
        Commercial dating platforms operate under a fundamental economic conflict of interest: a matched couple that deletes the app represents a permanent loss of recurring subscription revenue. To preserve shareholder valuation, the modern matchmaking ecosystem has quietly abandoned genuine compatibility in favor of variable-ratio dopamine schedules modeled directly on Las Vegas slot machines.
      </p>

      <p class="text-base sm:text-lg leading-relaxed text-slate-800 font-sans">
        Behind polished mobile interfaces lies a calculated architecture of artificial scarcity. Hidden ELO algorithms intentionally depress profile visibility to trigger psychological panic, immediately followed by the predatory upselling of microtransactions: <em>Spotlight Boosts</em>, <em>Super Likes</em>, and tiered tiers engineered to extract capital from acute social isolation.
      </p>

      <p class="text-base sm:text-lg leading-relaxed text-slate-800 font-sans">
        Compounding this engineered despair is the industrial proliferation of synthetic fraud. Transnational criminal syndicates exploit dating apps as primary acquisition funnels for <em>Pig Butchering (Sha Zhu Pan)</em> operations, deploying diffusion-generated hyper-realistic identities and LLM conversational engines to systematically drain victims' life savings through fraudulent liquidity contracts.
      </p>

      <p class="text-base sm:text-lg leading-relaxed text-slate-800 font-sans">
        This bureau was established with a singular directive: to strip away corporate PR obfuscation and provide ordinary users with cold, empirical forensic intelligence. We treat dating platforms not as lifestyle products, but as adversarial networks requiring rigorous reverse-engineering, perimeter security, and continuous verification.
      </p>

      <div class="not-prose mt-8 pt-4 border-t border-slate-200 flex items-center justify-between text-xs font-mono text-slate-500">
        <span class="font-bold text-slate-900">— Arthur Vance, Cheltenham Bureau</span>
        <span>Cheltenham, Gloucestershire, United Kingdom</span>
      </div>
    </article>

    <!-- 3. FIELD METHODOLOGY PROTOCOLS -->
    <div class="bg-white border border-slate-300 rounded-none sm:rounded-sm p-6 sm:p-8 mb-8">
      <div class="border-b border-slate-200 pb-4 mb-6 flex justify-between items-center">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 uppercase tracking-tight font-serif">
          Technical Field Methodology
        </h2>
        <span class="text-xs font-mono bg-slate-900 text-slate-100 px-2.5 py-1 font-bold">
          3-TIER VERIFICATION
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Protocol 1 -->
        <div class="p-4 border border-slate-200 bg-slate-50/60">
          <div class="w-8 h-8 flex items-center justify-center text-slate-700 bg-white border border-slate-300 mb-3">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <h3 class="font-bold text-sm text-slate-900 uppercase mb-2 font-mono">01. Image & Diffusion Forensics</h3>
          <p class="text-xs text-slate-600 leading-relaxed font-sans">
            Cross-spectral frequency analysis to detect GAN/diffusion artifacts, lighting inconsistency vectors, EXIF metadata stripping, and reverse matching against syndicated stolen model repositories.
          </p>
        </div>

        <!-- Protocol 2 -->
        <div class="p-4 border border-slate-200 bg-slate-50/60">
          <div class="w-8 h-8 flex items-center justify-center text-slate-700 bg-white border border-slate-300 mb-3">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="font-bold text-sm text-slate-900 uppercase mb-2 font-mono">02. Packet & Telemetry Intercept</h3>
          <p class="text-xs text-slate-600 leading-relaxed font-sans">
            Decoupled man-in-the-middle packet inspection of mobile dating APIs to document real-time ELO adjustments, geolocation spoofing clusters, and shadow-throttling mechanisms.
          </p>
        </div>

        <!-- Protocol 3 -->
        <div class="p-4 border border-slate-200 bg-slate-50/60">
          <div class="w-8 h-8 flex items-center justify-center text-slate-700 bg-white border border-slate-300 mb-3">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h3 class="font-bold text-sm text-slate-900 uppercase mb-2 font-mono">03. LLM Pattern Deconstruction</h3>
          <p class="text-xs text-slate-600 leading-relaxed font-sans">
            Token distribution and perplexity scoring to identify automated chatbot swarms, script execution triggers, and conversational escalation funnels migrating targets to encrypted messengers.
          </p>
        </div>
      </div>
    </div>

    <!-- 4. INDEPENDENT FORENSIC FUND -->
    <div class="bg-white border border-slate-300 rounded-none sm:rounded-sm p-6 sm:p-8">
      <div class="flex items-center gap-3 border-b border-slate-200 pb-4 mb-6">
        <div class="w-10 h-10 bg-slate-900 text-white flex items-center justify-center font-mono font-bold text-sm">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <div>
          <span class="text-[10px] font-mono font-bold uppercase text-rose-700 tracking-wider">TARGETED COMMUNITY ENDOWMENT</span>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 uppercase tracking-tight font-serif">
            The Independent Forensic Fund
          </h2>
        </div>
      </div>

      <p class="text-sm sm:text-base text-slate-800 leading-relaxed mb-6 font-sans">
        We refuse commercial corporate sponsorships, algorithmic affiliate kickbacks from predatory dating apps, and programmatic tracking networks. <strong>100% of community contributions</strong> fund hardware testbenches, cellular SIM farms for penetration audits, and cloud infrastructure for tracking adversarial bot clusters.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <!-- Option 1: Card / Ko-fi -->
        <a
          href="https://ko-fi.com/flirtcheck"
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col justify-between p-4 bg-white border border-slate-300 hover:border-slate-400 transition-colors group"
        >
          <div>
            <div class="text-xs font-mono font-bold text-rose-700 uppercase mb-1">[ CARD / COFFEE ]</div>
            <h4 class="font-bold text-sm text-slate-900 mb-2 font-serif">Support via Ko-fi</h4>
            <p class="text-xs text-slate-600 leading-relaxed font-sans">
              Direct micro-grants for server and research costs.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-200 text-xs font-mono font-bold text-slate-900 group-hover:text-rose-700 flex items-center justify-between">
            <span>DISPATCH GRANT</span>
            <span>→</span>
          </div>
        </a>

        <!-- Option 2: Monero XMR -->
        <div class="flex flex-col justify-between p-4 bg-white border border-slate-300">
          <div>
            <div class="text-xs font-mono font-bold text-amber-700 uppercase mb-1">[ CRYPTOGRAPHIC LEDGER ]</div>
            <h4 class="font-bold text-sm text-slate-900 mb-2 font-serif">Monero (XMR)</h4>
            <p class="text-xs text-slate-600 leading-relaxed font-sans">
              Private, untraceable support for whistleblowers and researchers.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-200">
            <button
              id="copyXmrBtn"
              data-xmr={moneroAddress}
              class="w-full text-center px-2 py-1.5 bg-slate-900 text-white font-mono text-[11px] font-bold hover:bg-slate-800 transition-colors cursor-pointer"
            >
              COPY XMR ADDRESS
            </button>
            <span id="copyFeedback" class="hidden text-[10px] font-mono text-emerald-700 font-bold text-center block mt-1">
              ✓ Address copied to clipboard
            </span>
          </div>
        </div>

        <!-- Option 3: Encrypted Tips -->
        <a
          href="mailto:desk@flirtcheck.site"
          class="flex flex-col justify-between p-4 bg-white border border-slate-300 hover:border-slate-400 transition-colors group"
        >
          <div>
            <div class="text-xs font-mono font-bold text-emerald-700 uppercase mb-1">[ ENCRYPTED TIP LINE ]</div>
            <h4 class="font-bold text-sm text-slate-900 mb-2 font-serif">Leaks & Dossiers</h4>
            <p class="text-xs text-slate-600 leading-relaxed font-sans">
              Submit leaked corporate documentation, scam funnels, or telemetry logs.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-200 text-xs font-mono font-bold text-slate-900 group-hover:text-rose-700 flex items-center justify-between">
            <span>desk@flirtcheck.site</span>
            <span>✉</span>
          </div>
        </a>
      </div>

      <div class="text-[11px] font-mono text-slate-500 text-center border-t border-slate-300 pt-3">
        CHELTENHAM FORENSIC DESK // CERTIFIED INDEPENDENT REPOSITORY // NON-CORPORATE ALIGNED
      </div>
    </div>

  </main>
</BaseLayout>

<script>
  const copyBtn = document.getElementById('copyXmrBtn');
  const feedback = document.getElementById('copyFeedback');

  if (copyBtn && feedback) {
    copyBtn.addEventListener('click', async () => {
      const address = copyBtn.getAttribute('data-xmr');
      if (address) {
        try {
          await navigator.clipboard.writeText(address);
          feedback.classList.remove('hidden');
          setTimeout(() => {
            feedback.classList.add('hidden');
          }, 3500);
        } catch (err) {
          console.error('Failed to copy Monero address:', err);
        }
      }
    });
  }
</script>
