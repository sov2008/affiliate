---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Editorial & Security Contact | FlirtCheck Gazette";
const description = "Contact the FlirtCheck forensic dating intelligence editorial bureau in Cheltenham, UK. Media inquiries, security disclosures, and partnership communication.";
---

<BaseLayout title={title} description={description} activePath="/contact">
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="mb-8 border-b-2 border-slate-900 pb-4">
      <div class="font-mono text-xs text-rose-700 uppercase tracking-widest font-bold mb-2">
        COMMUNICATION GATEWAY • CHELTENHAM DESK
      </div>
      <h1 class="text-3xl sm:text-4xl font-serif font-black text-slate-950 tracking-tight">
        Editorial & Security Bureau Contact
      </h1>
      <p class="text-sm font-mono text-slate-600 mt-2">
        Direct routing for investigative tips, affiliate network verification, and security vulnerability disclosures.
      </p>
    </div>

    <!-- Contact Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      <!-- Card 1: Publisher & Partnerships -->
      <div class="border-2 border-slate-900 p-6 bg-white shadow-[4px_4px_0_0_#0f172a]">
        <div class="font-mono text-xs font-bold text-rose-700 uppercase tracking-wider mb-2">
          AFFILIATE & PUBLISHER RELATIONS
        </div>
        <h2 class="text-xl font-serif font-bold text-slate-950 mb-3">
          Ad Networks & Commercial Partnerships
        </h2>
        <p class="text-sm text-slate-700 mb-4 leading-relaxed">
          For affiliate network managers (Admitad, Mitgo, MyLead, LosPollos), space approval verification, campaign syndication, and private offer access.
        </p>
        <div class="font-mono text-xs space-y-1 text-slate-900 border-t border-slate-200 pt-3">
          <p><strong>Department:</strong> Publisher Alliances Desk</p>
          <p><strong>Email:</strong> <a href="mailto:partners@flirtcheck.site" class="text-rose-700 hover:underline">partners@flirtcheck.site</a></p>
          <p><strong>Support Fast-Track:</strong> <a href="mailto:sapegin.oleg@gmail.com" class="text-rose-700 hover:underline">sapegin.oleg@gmail.com</a></p>
          <p><strong>Publisher ID (Mitgo):</strong> <code class="bg-slate-100 px-1">sov2018</code></p>
        </div>
      </div>

      <!-- Card 2: Editorial Desk -->
      <div class="border-2 border-slate-900 p-6 bg-white shadow-[4px_4px_0_0_#0f172a]">
        <div class="font-mono text-xs font-bold text-rose-700 uppercase tracking-wider mb-2">
          INVESTIGATIVE DISPATCHES
        </div>
        <h2 class="text-xl font-serif font-bold text-slate-950 mb-3">
          Editorial & Scam Intelligence Tips
        </h2>
        <p class="text-sm text-slate-700 mb-4 leading-relaxed">
          Submit suspicious dating profile forensics, newly emerged romance scam scripts, or synthetic media samples for forensic deconstruction.
        </p>
        <div class="font-mono text-xs space-y-1 text-slate-900 border-t border-slate-200 pt-3">
          <p><strong>Desk:</strong> Forensic Deconstruction Team</p>
          <p><strong>Email:</strong> <a href="mailto:editorial@flirtcheck.site" class="text-rose-700 hover:underline">editorial@flirtcheck.site</a></p>
          <p><strong>PGP Fingerprint:</strong> <span class="text-slate-500 font-mono text-[10px]">7F3C 91B2 E41A 8D99</span></p>
          <p><strong>Response Time:</strong> Within 24-48 business hours</p>
        </div>
      </div>

      <!-- Card 3: Technical & Vulnerabilities -->
      <div class="border-2 border-slate-900 p-6 bg-white shadow-[4px_4px_0_0_#0f172a]">
        <div class="font-mono text-xs font-bold text-rose-700 uppercase tracking-wider mb-2">
          SECURITY & COMPLIANCE
        </div>
        <h2 class="text-xl font-serif font-bold text-slate-950 mb-3">
          Responsible Disclosure & Privacy
        </h2>
        <p class="text-sm text-slate-700 mb-4 leading-relaxed">
          Report technical vulnerabilities in our client-side calculators or submit statutory GDPR / UK DPA data rights requests.
        </p>
        <div class="font-mono text-xs space-y-1 text-slate-900 border-t border-slate-200 pt-3">
          <p><strong>Security Office:</strong> InfoSec & Governance</p>
          <p><strong>Email:</strong> <a href="mailto:security@flirtcheck.site" class="text-rose-700 hover:underline">security@flirtcheck.site</a></p>
          <p><strong>Protocol:</strong> RFC 9116 / <code>security.txt</code> compliant</p>
        </div>
      </div>

      <!-- Card 4: Postal / Physical Bureau -->
      <div class="border-2 border-slate-900 p-6 bg-white shadow-[4px_4px_0_0_#0f172a]">
        <div class="font-mono text-xs font-bold text-rose-700 uppercase tracking-wider mb-2">
          GEOGRAPHIC HEADQUARTERS
        </div>
        <h2 class="text-xl font-serif font-bold text-slate-950 mb-3">
          Cheltenham Intelligence Desk
        </h2>
        <p class="text-sm text-slate-700 mb-4 leading-relaxed">
          Physical registry and jurisdiction for legal, formal notice, and international regulatory correspondence.
        </p>
        <div class="font-mono text-xs space-y-1 text-slate-900 border-t border-slate-200 pt-3">
          <p><strong>Registry:</strong> FlirtCheck Technical Bureau</p>
          <p><strong>Location:</strong> Cheltenham, Gloucestershire</p>
          <p><strong>Postcode Area:</strong> GL50 1, United Kingdom</p>
          <p><strong>Governing Law:</strong> Courts of England & Wales</p>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
