{
  "name": "affiliate-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm --prefix core test",
    "typecheck": "npm --prefix core run typecheck",
    "audit": "npm --prefix core run audit",
    "start:gateway": "node mock-gateway.js",
    "verify:keys": "tsx src/scripts/verifyCredentials.ts",
    "pipeline:test": "tsx src/scripts/runPipelineTest.ts",
    "queue:generate": "tsx src/scripts/generateBatch.ts",
    "queue:review": "tsx src/scripts/reviewQueue.ts",
    "affiliate:test": "tsx src/scripts/testAffiliateAdapters.ts",
    "worker:dry-run": "tsx src/scripts/testPostingWorker.ts",
    "worker:test": "tsx src/scripts/testPostingWorker.ts",
    "scout:test": "tsx src/scripts/testDualScoutPipeline.ts",
    "hitl:review": "tsx core/src/index.ts",
    "deploy:pages": "npx wrangler pages deploy campaigns/ --project-name affiliate-campaigns --branch main --commit-dirty=true"
  },
  "workspaces": [
    "core",
    "packages/*"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "axios": "^1.13.6",
    "dotenv": "^17.4.2",
    "openai": "^6.27.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "ssh2": "^1.17.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
